#comment G_testvar  "Just a test to see if it works"
#comment G_testvar123  "Just another test to see if it works"

#comment COLUMN          "a column in a dataset"
#comment COLUMN name     "the column name"
#comment COLUMN version  "the column version"
#comment COLUMN inbase   "the base version in which this column resides"
#comment COLUMN type     "the column type"
#comment COLUMN datatype "the column data type"
#comment COLUMN size     "the column size"
#comment COLUMN descript "description of this column"
#comment COLUMN comment  "comment for this version-base"
#comment COLUMNPTR "a pointer to a column structure"

#comment INDEX "an index to a dataset"
#comment INDEX name     "the index name"
#comment INDEX version  "the index version"
#comment INDEX inbase   "the base version in which this index resides"
#comment INDEX numcol   "the number of columns in the index"
#comment INDEX colname  "the column names in the index"
#comment INDEX descript "description of this index"
#comment INDEX comment  "comment for this version-base"
#comment INDEXPTR "a pointer to an index structure"

#comment DATASET "a dataset in a database"
#comment DATASET name     "the dataset name"
#comment DATASET version  "the dataset version"
#comment DATASET inbase   "the base version in which this dataset resides"
#comment DATASET active   "TRUE if dataset is currently active"
#comment DATASET numcol   "the number of columns in the dataset"
#comment DATASET column   "the columns in the dataset"
#comment DATASET primidx  "the primary index"
#comment DATASET numidx   "the number of indexes"
#comment DATASET index    "the indexs in this dataset (one is the primary)"
#comment DATASET descript "description of this dataset"
#comment DATASET comment  "comment for this version-base"
#comment DATASETPTR "a pointer to an dataset structure"
                               
#comment DATABASE            "a database"
#comment DATABASE name       "the database name"
#comment DATABASE password   "the database password"
#comment DATABASE currver    "the current database version"
#comment DATABASE currbase   "the current database base version"
#comment DATABASE numdataset "the number of datasets in the database"
#comment DATABASE dataset    "the datasets in the database"
#comment DATABASE descript   "description of this database"

