#define  TRUE  1
#define  FALSE 0

#deftype CHAR    {char CHAR}
#deftype UCHAR   {unsignedœchar UCHAR}
#deftype SPTR    {CHARœ*  SPTR}
#deftype USPTR   {UCHARœ* USPTR}
#deftype INT     {int INT }
#deftype UINT    {unsignedœint UINT}
#deftype INT16   {short INT16 }
#deftype UINT16  {unsignedœshort UINT16}
#deftype LONG    {long LONG}
#deftype ULONG   {unsignedœlong ULONG}
#deftype BOOL    {int BOOL}
#deftype COUNTER {int COUNTER}

#comment TRUE    "used for boolean operations"
#comment FALSE   "used for boolean operations"
#comment CHAR    "signed character (8 bits)"
#comment UCHAR   "unsigned character (8 bits)"
#comment SPTR    "pointer to signed characters (8 bits) i.e. string"
#comment USPTR   "pointer to unsigned characters (8 bits)"
#comment INT     "signed integer (machine width i.e. 16 or 32 bits)"
#comment UINT    "unsigned integer (machine width i.e. 16 or 32 bits)"
#comment INT16   "signed integer (16 bits)"
#comment UINT16  "unsigned integer (16 bits)"
#comment LONG    "signed integer (32 bits)"
#comment ULONG   "unsigned integer (32 bits)"
#comment BOOL    "Boolean type can be of either TRUE or FALSE"
#comment COUNTER "Used for all counters"
