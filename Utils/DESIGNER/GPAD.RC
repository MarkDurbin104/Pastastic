#define ICON_1	1001

#include <windows.h>
#include <owlrc.h>
#include <filedial.dlg>

MENU_1 MENU LOADONCALL MOVEABLE PURE DISCARDABLE 
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&Save", 101
		MENUITEM "Save &As", 102
		MENUITEM SEPARATOR
		MENUITEM "&Print", 103,  GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Import", 104, GRAYED
		MENUITEM "&Export", 105, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "E&xit", 106
	END

	POPUP "&Edit", GRAYED
	BEGIN
		MENUITEM "&Undo", 201, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Cut", 202, GRAYED
		MENUITEM "C&opy", 203, GRAYED
		MENUITEM "&Paste", 204, GRAYED
	END

	POPUP "F&orm", GRAYED
	BEGIN
		MENUITEM "&New", 301
		MENUITEM "&Delete", 302
		MENUITEM SEPARATOR
		MENUITEM "&Rename", 303
		MENUITEM "D&uplicate", 304
	END

	MENUITEM "&View", 401 , GRAYED
END

FDBUTT  BITMAP FDBUTT.BMP
SDBUTT  BITMAP SDBUTT.BMP
AEBUTT  BITMAP AEBUTT.BMP
FEBUTT  BITMAP FEBUTT.BMP
KDBUTT  BITMAP KDBUTT.BMP
CEBUTT  BITMAP CEBUTT.BMP
STARTUP BITMAP START.BMP
FTBUTT  BITMAP FTBUTT.BMP
PTBUTT  BITMAP PTBUTT.BMP
STBUTT  BITMAP STBUTT.BMP
MTBUTT  BITMAP MTBUTT.BMP
RTBUTT  BITMAP RTBUTT.BMP
PPBUTT  BITMAP PPBUTT.BMP

GPADICON ICON GPADICON.ICO
