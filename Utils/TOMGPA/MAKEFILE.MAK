#.SILENT
.AUTODEPEND

BCPATH        = M:\D\BC45

MODEL         = l
LINKPARMS     = -Txe -l -s -v -L$(BCPATH)\LIB
LINK32PARMS   = -Tpe -ax -v -L$(BCPATH)\LIB
NORM32LIBS    = DPMI32+CW32
NORMLIBS      = DPMI16+EMUX+MATHWL+CWL
STDLIBS       = EMU+MATHL+CL
GPALIBS       = GPA+$(NORMLIBS)
TEMPFILE      = TEMPFILE.GPA

PP32OBJS      = PP,CONFIG,CONTROL,FORMHAND,ACTIONC,DST,GLOBAL,
FR32OBJS      = FR,CONFIG,CONTROL,FORMHAND,ACTIONC,
GOBJS         = GPRIM.OBJ $(BCPATH)\LIB\PKWARE.OBJ
GPAROBJS      = GPAR.OBJ
OBJS          = GPAMAIN.OBJ
INCS          = INSTRUCT.H KEYNAMES.H KEYDEF.H SCANCODE.H
BOTH1         = CONFIG,CONTROL,ACTIONC,FUNCTION,DST,MONEY,ARITH,
BOTH2         = GLOBAL,ACTIONS,LANG,MESSAGE,CALC,TRANSLOG,FORMHAND,
BOTH3         = FORMPROC,MENUPROC,TABPROC,FLDPROC,REPPROC,
DEVS          = KBD,VFON,DISK,PDX,CAPRN,OSS,COMM, #SCALE,MOUSE,8255,STAMP,HERC,NET,
# TAI DEVS          = KBD,VFON,PDX,DISK,PRN,SCALE,MOUSE,8255,COMM,STAMP,OSS,

BOTHDEPS      = $(BOTH1) $(BOTH2) $(BOTH3)
LIBDEPS       = $(BOTHDEPS:,=.OBJ )
INCDEPS       = $(INCS) $(BOTHDEPS:,=.H )   $(DEVS:,=DEV.H )

.ASM.OBJ:
              TASM /Zi $<

.C.OBJ:
	      M:\D\BC45\BIN\BCC -I$(BCPATH)\INCLUDE +GPAB16.CFG { $< }

.C.O32:
	      M:\D\BC45\BIN\BCC32 -I$(BCPATH)\INCLUDE +GPAB32.CFG -o$*.O32 $<

ALL:          SETCFG          \
              BGPAHEAD.EXE    \
 	      BLIBLIST.EXE    \
              GPA.H           \
              GPA.EXE         \
              FR.EXE          \
              PP.EXE          \
              GPA.BIN         \
              GPAR.EXE        \
              PLAY.EXE        \
              REC.EXE         \
              GENKEYS.EXE     \
              GENSCRPT.EXE    \
              CLRCFG

CLEAN:        DELOBJS         \
              ALL

BGPAHEAD.OBJ: BGPAHEAD.C
              M:\D\BC45\BIN\BCC -I$(BCPATH)\INCLUDE -ml -c BGPAHEAD.C 

BGPAHEAD.EXE: BGPAHEAD.OBJ
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB C0L+BGPAHEAD,BGPAHEAD,,$(STDLIBS)

BLIBLIST.OBJ: BLIBLIST.C
              M:\D\BC45\BIN\BCC -I$(BCPATH)\INCLUDE -ml -c BLIBLIST.C 

BLIBLIST.EXE: BLIBLIST.OBJ
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB C0L+BLIBLIST,BLIBLIST,,$(STDLIBS)

GPA.H:        TYPES.H $(INCDEPS) BGPAHEAD.EXE GPASIZES.H
	      BGPAHEAD GPA.H <<! 
	      $(INCDEPS)
!
##$** 

START.OBJ:    START.C
              M:\D\BC45\BIN\BCC -I$(BCPATH)\INCLUDE -ml -c -v START.C 

START.OBR:    START.C
              M:\D\BC45\BIN\BCC -I$(BCPATH)\INCLUDE -ml -c -oSTART.OBR -DRECORDING START.C 

START.OBP:    START.C
              M:\D\BC45\BIN\BCC -I$(BCPATH)\INCLUDE -ml -c -oSTART.OBP -DPLAYBACK START.C 

GPA.EXE:      START.OBJ
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB -v C0L+START,GPA,START.MAP,$(STDLIBS)

REC.EXE:      START.OBR
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB -v C0L+START.OBR,REC,,$(STDLIBS)

PLAY.EXE:     START.OBP
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB -v C0L+START.OBP,PLAY,,$(STDLIBS)

GENKEYS.EXE:  GENKEYS.OBJ
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB C0L+GENKEYS,GENKEYS,,$(STDLIBS)

GENSCRPT.EXE: GENSCRPT.OBJ
	      M:\D\BC45\BIN\TLINK -L$(BCPATH)\LIB C0L+GENSCRPT,GENSCRPT,,$(STDLIBS)

GPA.BIN:      SETCFG \
              GPA.H CAPGPA.OBJ EXCEPT.OBJ MAXFH.OBJ $(OBJS) GPA.LIB $(DEVS:,=DEV.OBJ ) $(GOBJS) GPA.DEF
	      M:\D\BC45\BIN\TLINK $(LINKPARMS) @&&!
	      C0X CAPGPA.OBJ EXCEPT.OBJ MAXFH.OBJ $(OBJS) $(DEVS:,=DEV.OBJ ) $(GOBJS),GPA.BIN,GPABIN.MAP,$(GPALIBS)+PXENGWIN,GPA.DEF
!

PP.EXE:       $(PP32OBJS:,=.O32 )
	      M:\D\BC45\BIN\TLINK32 $(LINK32PARMS) @&&!
	      C0X32+$(PP32OBJS:,=.O32 ),$*,,$(NORM32LIBS)
!

FR.EXE:       $(FR32OBJS:,=.O32 )
	      M:\D\BC45\BIN\TLINK32 $(LINK32PARMS) @&&!
	      C0X32+$(FR32OBJS:,=.O32 ),$*,,$(NORM32LIBS)
!

GPAR.EXE:     GPA.H CAPGPA.OBJ EXCEPT.OBJ $(GPAROBJS) GPA.LIB $(DEVS:,=DEV.OBJ ) $(GOBJS)
	      M:\D\BC45\BIN\TLINK $(LINKPARMS) @&&!
	      C0X CAPGPA.OBJ EXCEPT.OBJ $(GPAROBJS) $(DEVS:,=DEV.OBJ ) $(GOBJS),GPAR,,$(GPALIBS)+PXENGWIN,$(BCPATH)\LIB\DEFAULT.DEF
!

.PRECIOUS:    GPA.LIB
GPA.LIB:      $(LIBDEPS)
	      BLIBLIST $(TEMPFILE) $*.LIB <<! 
	      $? 
!
              M:\D\BC45\BIN\TLIB /E $* @$(TEMPFILE)
	      DEL $(TEMPFILE)

SETCFG:       GPAB16.CFG GPAB32.CFG

GPAB16.CFG : 
    @COPY &&|
-WX -m$(MODEL) -O2 -Ot -Ox -Oi -G -d -w -v -c 
-L$(BCPATH)\LIB
-I$(BCPATH)\INCLUDE
| $@ >NUL

GPAB32.CFG : 
    @COPY &&|
-WX -O2 -Ot -Ox -Oi -G -w -d -v -c
-L$(BCPATH)\LIB
-I$(BCPATH)\INCLUDE
| $@ >NUL

CLRCFG:
 @DEL GPAB16.CFG >NUL
 @DEL GPAB32.CFG >NUL

DELOBJS:
 @DEL *.OBJ >NUL
 @DEL *.O32 >NUL

