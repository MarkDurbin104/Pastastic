.SILENT
.AUTODEPEND

BCPATH        = \BC\   #  CHANGE THIS LINE TO \BC4\ or D:\BORLANDC\ etc...

MODEL         = l
LINKPARMS     = -Txe -v -L$(BCPATH)LIB
NORMLIBS      = DPMI16+EMUX+MATHWL+CWL
STDLIBS       = EMU+MATHL+CL
GPALIBS       = GPA+$(NORMLIBS)
TEMPFILE      = TEMPFILE.GPA

GOBJS         = $(BCPATH)LIB\PKWARE.OBJ
OBJS          = GPAMAIN.OBJ
INCS          = INSTRUCT.H KEYNAMES.H KEYDEF.H SCANCODE.H
BOTH1         = CONFIG,CONTROL,ACTIONC,FUNCTION,DST,MONEY,ARITH,
BOTH2         = GLOBAL,ACTIONS,LANG,MESSAGE,CALC,TRANSLOG,FORMHAND,
BOTH3         = FORMPROC,MENUPROC,TABPROC,FLDPROC,REPPROC,
DEVS          = SKBD,SCR,PDX,DISK,CAPRN,OSS, #SCALE,MOUSE,8255,COMM,STAMP,HERC,NET,

BOTHDEPS      = $(BOTH1) $(BOTH2) $(BOTH3)
LIBDEPS       = $(OBJS) $(BOTHDEPS:,=.OBJ )
INCDEPS       = $(INCS) $(BOTHDEPS:,=.H )   $(DEVS:,=DEV.H )

.C.OBJ:
	      BCC -DTEXTMODE -WX -ml -O2 -Ot -Ox -Oi -G -d -w -v -c { $< }

ALL:          BGPAHEAD.EXE    \
 	      BLIBLIST.EXE    \
              GPA.H           \
              GPA.EXE         \
              GPA.BIN

BGPAHEAD.OBJ: BGPAHEAD.C
              BCC -ml -c BGPAHEAD.C 

BGPAHEAD.EXE: BGPAHEAD.OBJ
	      TLINK C0L+BGPAHEAD,BGPAHEAD,,$(STDLIBS)

BLIBLIST.OBJ: BLIBLIST.C
              BCC -ml -c BLIBLIST.C 

BLIBLIST.EXE: BLIBLIST.OBJ
	      TLINK C0L+BLIBLIST,BLIBLIST,,$(STDLIBS)

GPA.H:        $(INCDEPS) BGPAHEAD.EXE TYPES.H
	      BGPAHEAD GPA.H <<! 
$** 
!

TSTART.OBJ:   TSTART.C
              BCC -ml -c TSTART.C 

GPA.EXE:      TSTART.OBJ
	      TLINK C0L+TSTART,GPA,TSTART.MAP,$(STDLIBS)

GPA.BIN:      GPA.H CAPGPA.OBJ GPA.LIB $(DEVS:,=DEV.OBJ ) $(GOBJS)
	      TLINK $(LINKPARMS) @&&!
	      C0X CAPGPA.OBJ $(DEVS:,=DEV.OBJ ) $(GOBJS),GPA.BIN,GPABIN.MAP,$(GPALIBS)+PXENGWIN
!

.PRECIOUS:    GPA.LIB
GPA.LIB:      $(LIBDEPS)
	      BLIBLIST $(TEMPFILE) $*.LIB <<! 
	      $? 
!
              TLIB /E $* @$(TEMPFILE)
	      DEL $(TEMPFILE)
