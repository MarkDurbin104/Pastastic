ID_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&Dial"
    BEGIN
        MENUITEM "RWNodeDialDir&Connect",       IDM_DIALDIR
        MENUITEM "RWNodeDialDir&Dialog",        IDM_DIALDIALOG
    END
    POPUP "&Objects"
    BEGIN
        MENUITEM "RWNodeObjectQuery&Info",      IDM_OBJINFO
        MENUITEM "RWNodeObjectQuery&Objects",   IDM_OBJOBJS
    END
    POPUP "&Worklists"
    BEGIN
        MENUITEM "RWNAddWorklist&Record",       IDM_WORKLISTS_ADDWORKLISTRECORD

        MENUITEM SEPARATOR
        MENUITEM "RWNWorklist&Open",            IDM_WORKLISTS_WORKLISTOPEN
        POPUP "RWNWorklist&Action"
        BEGIN
            MENUITEM "WLA_APPEND",                  IDM_WORKLISTS_APPEND
            MENUITEM "WLA_READ",                    IDM_WORKLISTS_READ
            MENUITEM "WLA_WRITE",                   IDM_WORKLISTS_WRITE
            MENUITEM "WLA_DELETE",                  IDM_WORKLISTS_DELETE
        END
        MENUITEM "RWNWorklist&Close",           IDM_WORKLISTS_WORKLISTCLOSE
    END
    POPUP "O&ther"
    BEGIN
        MENUITEM "RWNodeRe&quest",              IDM_OTHER_NODEREQUEST
        MENUITEM "RWNode&GetInfo",              IDM_OTHER_GETINFO
        MENUITEM "RWNode&ReadData/RWNodeWriteData",IDM_OTHER_READDATA
    END
END


