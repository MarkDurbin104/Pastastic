\f1\cf0\fs20\tx500\tx1000\tx1500\tx2000\tx2500\tx3000\tx3500\tx4000
\b\i void\b0\i0  AddReMACSPLU\'28REMACSPLU \'2A\'2Aplulist\'2CREMACSPLU \'2Aplu\'2CLONG price\'2CINT plevel\'29\par
\'7B\par
    \b\i static\b0\i0  LONG today\'3D0L\'3B   \'2F\'2F integer of today\'27s date \par
    \b\i struct\b0\i0  tm \'2At\'3B           \'2F\'2F used to find \b if\b0  PLU newer than current\par
    \b\i struct\b0\i0  timeb tb\'3B        \'2F\'2F used to find \b if\b0  PLU newer than current\par
    REMACSPLU \'2Apluptr\'3B      \'2F\'2F current PLU in list\par
\par
    \b if\b0  \'28today\'3D\'3D0L\'29 \'7B        \'2F\'2F first time in \'2D get date\par
       \tab ftime\'28\'26tb\'29\'3B\par
    \tab t\'3Dlocaltime\'28\'26tb\'2Etime\'29\'3B\par
        t\'2D\'3Etm_mon\'2B\'2B\'3B\par
        today \'3D\'28LONG\'29t\'2D\'3Etm_year\'2A10000L\'3B  \'2F\'2F date as number i\'2Ee\'2E 960618L\par
        today\'2B\'3D\'28LONG\'29t\'2D\'3Etm_mon \'2A100L  \'3B  \'2F\'2F is 18th June 1996\par
        today\'2B\'3D\'28LONG\'29t\'2D\'3Etm_mday       \'3B\par
    \'7D\par
    \b if\b0  \'28plulist\'3D\'3DNULL\'29 \b return\b0 \'3B  \'2F\'2F this is not a pointer to a list \b return\b0\par
                                                                   \par
    pluptr\'3D\'2Aplulist\'3B        \'2F\'2F point to start of list\par
    \b while\b0  \'28pluptr\'21\'3DNULL\'29 \'7B  \'2F\'2F \b for\b0  each item in list\par
        \b if\b0  \'28pluptr\'2D\'3Eplu_code\'3D\'3Dplu\'2D\'3Eplu_code\'29 \'7B \'2F\'2F the same plu code\par
            \b if\b0  \'28pluptr\'2D\'3Eedate\'3D\'3Dplu\'2D\'3Eedate\'29 \'7B   \'2F\'2F same date \'2D add price\par
                pluptr\'2D\'3Eprice\'5Bplevel\'5D\'3Dprice\'3B\par
                pluptr\'2D\'3Edone1\'3DTRUE\'3B            \'2F\'2F set flag to stop removal of PLU\par
                free\'28plu\'29\'3B                     \'2F\'2F don\'27t need this structure\par
                \b return\b0 \'3B\par
            \'7D\par
            \b if\b0  \'28pluptr\'2D\'3Eedate\'3Cplu\'2D\'3Eedate\'29 \'7B     \'2F\'2F later date \par
                \b if\b0  \'28plu\'2D\'3Eedate\'3C\'3Dtoday\'2B1L\'29 \'7B     \'2F\'2F \b if\b0  ready \b for\b0  load \'2D change\par
                    pluptr\'2D\'3Eedate\'3Dplu\'2D\'3Eedate\'3B\par
                    pluptr\'2D\'3Eprice\'5Bplevel\'5D\'3Dprice\'3B\par
                    pluptr\'2D\'3Edone1\'3DTRUE\'3B         \'2F\'2F set flag to stop removal of PLU\par
                    free\'28plu\'29\'3B                  \'2F\'2F don\'27t need this structure\par
                    \b return\b0 \'3B\par
                \'7D\par
            \'7D \b else\b0  \'7B                            \'2F\'2F current is newer than latest \'2D ignore latest\par
                pluptr\'2D\'3Edone1\'3DTRUE\'3B             \'2F\'2F set flag to stop removal of PLU\par
                free\'28plu\'29\'3B                      \'2F\'2F don\'27t need this structure\par
                \b return\b0 \'3B\par
            \'7D\par
        \'7D\par
        pluptr\'3Dpluptr\'2D\'3Enext\'3B   \'2F\'2F next item in list\par
    \'7D\par
    plu\'2D\'3Eprice\'5Bplevel\'5D\'3Dprice\'3B  \'2F\'2F add \b new\b0  or add one \b for\b0  later\par
    plu\'2D\'3Edone1\'3DTRUE\'3B           \'2F\'2F set flag to stop removal of PLU\par
    plu\'2D\'3Enext\'3D\'2Aplulist\'3B        \'2F\'2F add at begining of list\par
    \'2Aplulist\'3Dplu\'3B      \par
\'7D\par
\pard \par \page
