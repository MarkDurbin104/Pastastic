SORTRPLU \'2ASortList\'28REMACSPLU \'2Aplulist\'2CBOOL by_code\'29\par
\'7B\par
    SORTRPLU \'2Afirstelem\'3DNULL\'3B  \'2F\'2F first element in sorted list\par
    SORTRPLU \'2Atraverse\'3B        \'2F\'2F pointer used to traverse list\par
    SORTRPLU \'2Alastelem\'3B        \'2F\'2F last element in sorted list\par
    SORTRPLU \'2Acurelem\'3B         \'2F\'2F current element in sorted list\par
    BOOL additem\'3B              \'2F\'2F true \b if\b0  item should be added\par
\par
    \b while\b0  \'28plulist\'21\'3DNULL\'29 \'7B \'2F\'2F \b for\b0  each item\par
        \b if\b0  \'28\'28curelem\'3Dmalloc\'28\b sizeof\b0 \'28SORTRPLU\'29\'29\'29\'3D\'3DNULL\'29 \b return\b0  NULL\'3B \'2F\'2F get space\par
        curelem\'2D\'3Eelem\'3Dplulist\'3B    \'2F\'2F set current element\par
        \b if\b0  \'28firstelem\'3D\'3DNULL\'29 \'7B    \'2F\'2F \b if\b0  this is the first line\par
            firstelem\'3Dcurelem\'3B    \'2F\'2F just add it in\par
            firstelem\'2D\'3Enext\'3DNULL\'3B\par
        \'7D \b else\b0  \'7B\par
            traverse\'3Dfirstelem\'3B   \'2F\'2F start of sorted list\par
            lastelem\'3DNULL\'3B\par
            \b while\b0  \'28traverse\'21\'3DNULL\'29 \'7B \'2F\'2F work through list\par
                \b if\b0  \'28by_code\'29 \'7B    \'2F\'2F set \b if\b0  item should be added here\par
                    additem\'3D\'28curelem\'2D\'3Eelem\'2D\'3Eplu_code\'3Ctraverse\'2D\'3Eelem\'2D\'3Eplu_code\'29\'3B\par
                \'7D \b else\b0  \'7B\par
                    additem\'3D\'28strcmp\'28curelem\'2D\'3Eelem\'2D\'3Edesc\'2Ctraverse\'2D\'3Eelem\'2D\'3Edesc\'29\'3C\'3D0\'29\'3B\par
                \'7D\par
                \b if\b0  \'28additem\'29 \'7B  \'2F\'2F it should \'2D so insert item in list\par
                    \b if\b0  \'28lastelem\'3D\'3DNULL\'29 \'7B\par
                        curelem\'2D\'3Enext\'3Dtraverse\'3B\par
                        firstelem\'3Dcurelem\'3B\par
                    \'7D \b else\b0  \'7B\par
                        curelem\'2D\'3Enext\'3Dtraverse\'3B\par
                        lastelem\'2D\'3Enext\'3Dcurelem\'3B\par
                    \'7D\par
                    \b break\b0 \'3B\par
                \'7D \b else\b0  \'7B  \'2F\'2F end of list \'2D put it here\par
                    \b if\b0  \'28traverse\'2D\'3Enext\'3D\'3DNULL\'29 \'7B\par
                        curelem\'2D\'3Enext\'3DNULL\'3B\par
                        traverse\'2D\'3Enext\'3Dcurelem\'3B\par
                        \b break\b0 \'3B\par
                    \'7D\par
                \'7D\par
                lastelem\'3Dtraverse\'3B\par
                traverse\'3Dtraverse\'2D\'3Enext\'3B \'2F\'2F next element\par
            \'7D\par
        \'7D\par
        plulist\'3Dplulist\'2D\'3Enext\'3B \'2F\'2F next item\par
    \'7D\par
    \b return\b0  firstelem\'3B \'2F\'2F start of sorted list\par
\'7D\par
