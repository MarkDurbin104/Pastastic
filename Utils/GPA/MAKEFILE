#.SILENT
.AUTODEPEND

BCPATH        = M:\D\BC45\   #  CHANGE THIS LINE TO \BC4\ or D:\BORLANDC\ etc...

MODEL         = l
LINKPARMS     = -Txe -v -s -l -L$(BCPATH)LIB
LINK32PARMS   = -Tpe -ax -v -L$(BCPATH)LIB
NORM32LIBS    = DPMI32+CW32
NORMLIBS      = DPMI16+EMUX+MATHWL+CWL
STDLIBS       = EMU+MATHL+CL
GPALIBS       = GPA+$(NORMLIBS)
TEMPFILE      = TEMPFILE.GPA

PP32OBJS      = PP,CONFIG,CONTROL,FORMHAND,ACTIONC,DST,GLOBAL,
FR32OBJS      = FR,CONFIG,CONTROL,FORMHAND,ACTIONC,
GOBJS         = GPRIM.OBJ $(BCPATH)LIB\PKWARE.OBJ
OBJS          = GPAMAIN.OBJ
INCS          = INSTRUCT.H KEYNAMES.H KEYDEF.H SCANCODE.H
BOTH1         = CONFIG,CONTROL,ACTIONC,FUNCTION,DST,MONEY,ARITH,
BOTH2         = GLOBAL,ACTIONS,LANG,MESSAGE,CALC,TRANSLOG,FORMHAND,
BOTH3         = FORMPROC,MENUPROC,TABPROC,FLDPROC,REPPROC,
DEVS          = KBD,VFON,PDX,DISK,PTPRN,OSS,SCALE, #MOUSE,8255,COMM,STAMP,HERC,NET,

BOTHDEPS      = $(BOTH1) $(BOTH2) $(BOTH3)
LIBDEPS       = $(OBJS) $(BOTHDEPS:,=.OBJ )
INCDEPS       = $(INCS) $(BOTHDEPS:,=.H )   $(DEVS:,=DEV.H )

.C.OBJ:
	      BCC -I$(BCPATH)INCLUDE -DMEM_DEBUG -DDOS -DWIEN -WX -Od -ml -G -d -w -v -c { $< }

.C.O32:
	      BCC32 -I$(BCPATH)INCLUDE -DDOS -DWIEN -WX -w -d -v -c -o$*.O32 $<

ALL:          BGPAHEAD.EXE    \
 	      BLIBLIST.EXE    \
              GPA.H           \
              GPA.EXE         \
              REC.EXE         \
              PLAY.EXE        \
              FR.EXE          \
              PP.EXE          \
              GPA.BIN

BGPAHEAD.OBJ: BGPAHEAD.C
              BCC -ml -I$(BCPATH)INCLUDE -c BGPAHEAD.C 

BGPAHEAD.EXE: BGPAHEAD.OBJ
	      TLINK -L$(BCPATH)LIB C0L+BGPAHEAD,BGPAHEAD,,$(STDLIBS)

BLIBLIST.OBJ: BLIBLIST.C
              BCC -ml -I$(BCPATH)INCLUDE -c BLIBLIST.C 

BLIBLIST.EXE: BLIBLIST.OBJ
	      TLINK -L$(BCPATH)LIB C0L+BLIBLIST,BLIBLIST,,$(STDLIBS)

GPA.H:        $(INCDEPS) BGPAHEAD.EXE TYPES.H
	      BGPAHEAD GPA.H <<! 
$** 
!

START.OBJ:    START.C
              BCC -ml -c -I$(BCPATH)INCLUDE START.C 

START.OBR:    START.C
              BCC -ml -c -I$(BCPATH)INCLUDE -oSTART.OBR -DRECORDING START.C 

START.OBP:    START.C
              BCC -ml -c -I$(BCPATH)INCLUDE -oSTART.OBP -DPLAYBACK START.C 

GPA.EXE:      START.OBJ
	      TLINK -L$(BCPATH)LIB C0L+START,GPA,START.MAP,$(STDLIBS)
!
              copy gpa.exe \gpaexe

REC.EXE:      START.OBR
	      TLINK -L$(BCPATH)LIB C0L+START.OBR,REC,,$(STDLIBS)

PLAY.EXE:     START.OBP
	      TLINK -L$(BCPATH)LIB C0L+START.OBP,PLAY,,$(STDLIBS)

GPA.BIN:      GPA.H GPA.OBJ GPA.LIB $(DEVS:,=DEV.OBJ ) $(GOBJS)
	      TLINK $(LINKPARMS) @&&!
              C0X GPA.OBJ $(DEVS:,=DEV.OBJ ) $(GOBJS),GPA.BIN,GPABIN.MAP,$(GPALIBS)+PXENGWIN
!
              copy gpa.bin \gpaexe

PP.EXE:       $(PP32OBJS:,=.O32 )
	      TLINK32 $(LINK32PARMS) @&&!
	      C0X32+$(PP32OBJS:,=.O32 ),$*,,$(NORM32LIBS)
!
	      $(COMPRESS)
              copy pp.exe \gpaexe

FR.EXE:       $(FR32OBJS:,=.O32 )
	      TLINK32 $(LINK32PARMS) @&&!
	      C0X32+$(FR32OBJS:,=.O32 ),$*,,$(NORM32LIBS)
!
	      $(COMPRESS)
              copy fr.exe \gpaexe

.PRECIOUS:    GPA.LIB
GPA.LIB:      $(LIBDEPS)
	      BLIBLIST $(TEMPFILE) $*.LIB <<! 
	      $? 
!
              TLIB /E $* @$(TEMPFILE)
