#.SILENT
.AUTODEPEND

#COMPRESS      = PKLITE $*
COMPRESS      = 
MODEL         = l
LINKPARMS     = -Txe -v -l -L\BC4\LIB
NORMLIBS      = DPMI16+EMUX+MATHWL+CWL
STDLIBS       = EMU+MATHL+CL
GPALIBS       = GPA+$(NORMLIBS)
TEMPFILE      = TEMPFILE.GPA

GOBJS         = GPRIM.OBJ
OBJS          = GPAMAIN.OBJ
INCS          = INSTRUCT.H KEYNAMES.H KEYDEF.H SCANCODE.H
BOTH1         = CONFIG,CONTROL,ACTIONC,FUNCTION,DST,MONEY,ARITH,
BOTH2         = GLOBAL,ACTIONS,LANG,MESSAGE,CALC,TRANSLOG,FORMHAND,
BOTH3         = FORMPROC,MENUPROC,TABPROC,FLDPROC,REPPROC,
DEVS          = KBD,VFON,PDX,DISK,PRN,SCALE,MOUSE,8255,COMM,STAMP,HERC, #NET,

BOTHDEPS      = $(BOTH1) $(BOTH2) $(BOTH3)
LIBDEPS       = $(OBJS) $(BOTHDEPS:,=.OBJ )
INCDEPS       = $(INCS) $(BOTHDEPS:,=.H )   $(DEVS:,=DEV.H )

.C.OBJ:
	      BCC -WX -ml -w -v -c { $< }

ALL:          BGPAHEAD.EXE    \
 	      BLIBLIST.EXE    \
              GPA.H           \
              GPA.BIN         \
#              FEX.EXE         \
#              FIN.EXE         \
              FR.EXE          \
              PP.EXE         

BGPAHEAD.OBJ: BGPAHEAD.C
              BCC -ml -c BGPAHEAD.C 

BGPAHEAD.EXE: BGPAHEAD.OBJ
	      TLINK C0L+BGPAHEAD,BGPAHEAD,,$(STDLIBS)

BLIBLIST.OBJ: BLIBLIST.C
              BCC -ml -c BLIBLIST.C 

BLIBLIST.EXE: BLIBLIST.OBJ
	      TLINK C0L+BLIBLIST,BLIBLIST,,$(STDLIBS)

GPA.H:        $(INCDEPS) BGPAHEAD.EXE TYPES.H
	      BGPAHEAD GPA.H <<! 
$** 
!

GPA.BIN:      GPA.H GPA.OBJ GPA.LIB $(DEVS:,=DEV.OBJ ) $(GOBJS)
	      TLINK $(LINKPARMS) @&&!
	      C0X $* $(DEVS:,=DEV.OBJ ) $(GOBJS),$*,,$(GPALIBS)+PXENGWIN
!
              DEL GPA.BIN
              REN GPA.EXE GPA.BIN
              COPY START.EXE GPA.EXE
	      $(COMPRESS)

PP.EXE:       PP.OBJ CONFIG.OBJ CONTROL.OBJ FORMHAND.OBJ ACTIONC.OBJ DST.OBJ GLOBAL.OBJ
	      TLINK $(LINKPARMS) @&&!
	      C0X+$*+CONFIG+CONTROL+FORMHAND+ACTIONC+DST+GLOBAL,$*,,$(NORMLIBS)
!
	      $(COMPRESS)

FR.EXE:       FR.OBJ CONFIG.OBJ CONTROL.OBJ FORMHAND.OBJ ACTIONC.OBJ
	      TLINK $(LINKPARMS) @&&!
	      C0X+$*+CONFIG+CONTROL+FORMHAND+ACTIONC,$*,,$(NORMLIBS)
!
	      $(COMPRESS)
FEX.EXE:      FEX.OBJ GPA.OBJ GPA.LIB
	      TLINK $(LINKPARMS) @&&!
	      C0X $* GPA,$*,,$(GPALIBS)
!
	      $(COMPRESS)
FIN.EXE:      FIN.OBJ GPA.OBJ GPA.LIB
	      TLINK $(LINKPARMS) @&&!
	      C0X $* GPA,$*,,$(GPALIBS)
!
	      $(COMPRESS)

GPAR.EXE:     GPAR.OBJ GPA.OBJ GPA.LIB
	      TLINK $(LINKPARMS) @&&!
	      C0X $* GPA,$*,,$(GPALIBS)+GPRIM
!
	      $(COMPRESS)

.PRECIOUS:    GPA.LIB
GPA.LIB:      $(LIBDEPS)
	      BLIBLIST $(TEMPFILE) $*.LIB <<! 
	      $? 
!
              TLIB /E $* @$(TEMPFILE)
	      DEL $(TEMPFILE)
