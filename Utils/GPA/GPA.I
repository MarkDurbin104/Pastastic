gpa.c 183: int frmtfrmt(long l,char *o,char *m)
gpa.c 184: {
gpa.c 185: char u[16],f[32],k[32],*pu,*pf,*pm,c;
gpa.c 186: int i,si=0;
gpa.c 187: 
gpa.c 188: strcpy(k+1,m);
gpa.c 189: m=k+1;
gpa.c 190: if(l==-2147483648){
gpa.c 191: strcpy(u+1,"2147483648");
gpa.c 192: }
gpa.c 193: else{
gpa.c 194: if(l<0)l=-l;
gpa.c 195: sprintf(u+1,"%ld",l);
gpa.c 196: }
gpa.c 197: pf=&f[31];
gpa.c 198: *(pf)=0;
gpa.c 199: pu=&(u[strlen(u+1)]);
gpa.c 200: pm=&(m[strlen(m)-1]);
gpa.c 201: while(pm>=m){
gpa.c 202: c=*(pm--);
gpa.c 203: if((c!='Z')&&(c!='9')){
gpa.c 204: if((pu>u)||si){
gpa.c 205: *(--pf)=c;
gpa.c 206: }
gpa.c 207: continue;
gpa.c 208: }
gpa.c 209: if(c=='9')si=1;else si=0;
gpa.c 210: if(pu>u){
gpa.c 211: *(--pf)=*(pu--);
gpa.c 212: continue;
gpa.c 213: }
gpa.c 214: if(!si)break;
gpa.c 215: *(--pf)='0';
gpa.c 216: }
gpa.c 217: strcpy(o,pf);
gpa.c 218: }
