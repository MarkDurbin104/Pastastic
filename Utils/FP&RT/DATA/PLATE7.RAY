FILE_NAME = Pyramid.RAW


BEGIN_INSTANCES
	name = PYRAMID

BEGIN_BBOX
		TRIANGLE (loc 0, 0, 0)
				v1 = (52, 0, 30)
				v2 = (34.3, 30, 0)
				diff = (.72, .41, .14)
		)
		TRIANGLE (loc 0, 0, 0)
				v1 = (52, 0, -30)
				v2 = (34.3, 30, 0)
				diff = (.72, .41, .14)
		)
		TRIANGLE (loc 52, 0, -30)
				v1 = (0, 0, 60)
				v2 = (-17.7, 30, 30)
				diff = (.72, .41, .14)
		)
END_BBOX
END_INSTANCES

