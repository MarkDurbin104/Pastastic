\f1\cf0\fs20\tx500\tx1000\tx1500\tx2000\tx2500\tx3000\tx3500\tx4000
BOOL DoPolyErase\'28XYPOINT \'2Apoly\'2C\b\i int\b0\i0  numply\'2C\b\i int\b0\i0  increment\'29\par
\'7B\par
    NUMB minY\'2CmaxY\'3B     \'2F\'2A upper and lower bounds \'2A\'2F\par
    NUMB tmpy\'3B          \'2F\'2A Y co\'2Dordinate index counter \'2A\'2F\par
    NUMB \'2Aimap\'3B         \'2F\'2A intersection map \'2A\'2F\par
    PLIST \'2Apnts\'3B        \'2F\'2A rectangle points structure \'2A\'2F\par
    PLIST \'2Afirstp\'3DNULL\'3B \'2F\'2A first point in list of rectangle points \'2A\'2F\par
    BOOL found\'3B         \'2F\'2A flag to signify end of merge \'2A\'2F\par
\par
    {\uldb GetUpLowBounds}{\v GetUpLowBounds_Source}\'28\'26minY\'2C\'26maxY\'2Cpoly\'2Cnumply\'29\'3B     \'2F\'2A get upper \'26 lower bounds \'2A\'2F\par
\par
    \b for\b0  \'28tmpy\'3DminY\'3Btmpy\'3CmaxY\'3Btmpy\'2B\'3Dincrement\'29 \'7B\par
        imap\'3D{\uldb GetPointsofIntersection}{\v GetPointsofIntersection_Source}\'28tmpy\'2Cpoly\'2Cnumply\'29\'3B\par
        \b while\b0  \'28\'28imap\'21\'3DNULL\'29\'26\'26\'28\'2Aimap\'3E\'3D0\'29\'29 \'7B          \'2F\'2A list ok and not at end \'2A\'2F\par
            \b if\b0  \'28\'28pnts\'3Dmalloc\'28\b sizeof\b0 \'28PLIST\'29\'29\'29\'3D\'3DNULL\'29 \b return\b0 \'28FALSE\'29\'3B\par
            pnts\'2D\'3EX \'3D\'2A\'28imap\'2B\'2B\'29\'3B\par
            pnts\'2D\'3EY \'3Dtmpy\'3B\par
            pnts\'2D\'3EX1\'3D\'2A\'28imap\'2B\'2B\'29\'3B\par
            pnts\'2D\'3EY1\'3Dtmpy\'2Bincrement\'3B\par
            pnts\'2D\'3Enext\'3Dfirstp\'3B                                \'2F\'2A add to list \'2A\'2F\par
            firstp\'3Dpnts\'3B                              \'2F\'2A reset start of list \'2A\'2F\par
        \'7D\par
    \'7D\par
    {\uldb GetPointsofIntersection}{\v GetPointsofIntersection_Source}\'28\'2D1\'2CNULL\'2C0\'29\'3B                  \'2F\'2A free used memory \'2A\'2F\par
    \b do\b0  \'7B\par
        pnts\'3Dfirstp\'3B\par
        found\'3DFALSE\'3B\par
        \b while\b0  \'28pnts\'21\'3DNULL\'29 \'7B                     \'2F\'2A join adjacent rectangles \'2A\'2F\par
            \b if\b0  \'28{\uldb YAdjRect}{\v YAdjRect_Source}\'28pnts\'2Cfirstp\'29\'29 found\'3DTRUE\'3B\par
            pnts\'3Dpnts\'2D\'3Enext\'3B\par
        \'7D\par
    \'7D \b while\b0  \'28found\'29\'3B\par
    {\uldb EraseRect}{\v EraseRect_Source}\'28firstp\'29\'3B                                       \'2F\'2A \b do\b0  the erase \'2A\'2F\par
    \b return\b0 \'28TRUE\'29\'3B\par
\'7D\par
\pard \par \page
