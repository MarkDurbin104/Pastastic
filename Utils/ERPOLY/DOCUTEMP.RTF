        msg_issue\'28\cf1 \'22erase_polygon\'3A Failed to get parameter\'22\cf0 \'2C\'27e\'27\'29\'3B\par
        state\'3D0\'3B\par
        \b return\b0 \'28FALSE\'29\'3B\par
    \'7D\par
    \b if\b0  \'28state\'3D\'3D0\'29 \'7B                                         \'2F\'2A initial state \'2A\'2F\par
        \b if\b0  \'28strcmp\'28parameter\'2C\cf1 \'22add\'22\cf0 \'29\'29 \'7B                      \'2F\'2A must be \cf1 \'22add\'22\cf0  \'2A\'2F\par
            msg_issue\'28\cf1 \'22erase_polygon\'3A parameter out of sequence\'22\cf0 \'2C\'27e\'27\'29\'3B\par
            \b return\b0 \'28FALSE\'29\'3B\par
        \'7D\par
