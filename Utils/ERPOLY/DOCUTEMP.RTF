    \b\i char\b0\i0  parameter\'5BGMLI_MAX_PARM_SIZE\'5D\'3B  \'2F\'2A Space \b for\b0  parameter \'2A\'2F\par
    \b\i static\b0\i0  \b\i int\b0\i0  state\'3D0\'3B                  \'2F\'2A current parameter state \'2A\'2F\par
    \b\i static\b0\i0  XYPOINT \'2Apolypoint\'3DNULL\'3B      \'2F\'2A Space \b for\b0  poly points \'2A\'2F\par
