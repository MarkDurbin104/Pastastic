/* Resources for Windows test bed
   see PMWIN.C for instructions */

#include "windows.h"
#include "pmwin.h"

WinPMMenu MENU
BEGIN
    POPUP        "&File"
    BEGIN
        MENUITEM "&Run Test Program",IDM_TEST
        MENUITEM "&About WinPM...",IDM_ABOUT
        MENUITEM "&Exit",IDM_STOP
    END
END

AboutBox DIALOG 22,17,144,75
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About WinPM"
BEGIN
    CTEXT "WinPM"     -1,0,5,144,8
    CTEXT "By Al Williams" -1,0,14,144,8
    CTEXT "Version 1.0"           -1,0,34,144,8
    DEFPUSHBUTTON "OK"          IDOK,53,59,32,14,WS_GROUP
END

InputBox DIALOG 22,17,144,75
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
BEGIN
   LTEXT "Prompt" 101,0,5,144,32
   EDITTEXT 102,10,34,130,12,WS_TABSTOP | ES_AUTOHSCROLL
   DEFPUSHBUTTON "OK" IDOK,53,59,32,14,WS_GROUP
END
