TABLE NETWORK_ACCESS_POINTS A\NAP {
   G_VERSION              NUMBER  10 
   FEAT_NUM               NUMBER  10 
   EX_1141CD              CHAR     9 
   CTG                    CHAR     4 
   NAP_NO                 CHAR     9 
   PT                     CHAR     2 
   HS_1141CD              CHAR     9 
   FP_ACP_CD              CHAR     1 
   AB_IND                 CHAR     1 
   NAP_LOC                CHAR    60 
   LICENCE_CD             CHAR     2 
   NAP_NB                 CHAR   255 
   EQUIPMENT_GR_IND       CHAR     1 
   HAZARD_GR_IND          CHAR     1 
   ANTICREEP_GR_IND       CHAR     1 
   PUBLIC_IND             CHAR     1 
   G_NEXT_VERSION         NUMBER  10 
   G_GENERATION           NUMBER  10 
   ROW_LOCK               NUMBER  10
   ROW_LOCK_TYPE          CHAR     1
}
