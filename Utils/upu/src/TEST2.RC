IDD_FLIGHT_SCHED_ENTRY DIALOG DISCARDABLE  0, 0, 359, 270
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Manual Entry of Flight Schedule ( UPUxxx)"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Flight &Details",IDC_STATIC,8,4,344,128
    LTEXT           "&Flight Nb:",IDC_STATIC,16,20,35,8
    COMBOBOX        IDC_CB_CARRIER,16,32,36,58,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EB_SEGMENT_CODE,56,32,40,12,ES_UPPERCASE | 
                    ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_PB_SEL_CARRIER,100,32,16,12
    RTEXT           "&Orig. Airport:",IDC_STATIC,132,18,44,8
    COMBOBOX        IDC_CB_O_AIRPORT,180,16,84,60,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_PB_SEL_O_AIRPORT,268,16,16,12
    RTEXT           "Dest. A&irport:",IDC_STATIC,128,34,48,8
    COMBOBOX        IDC_CB_D_AIRPORT,180,32,84,58,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_PB_SEL_D_AIRPORT,268,32,16,12
    GROUPBOX        "Op. Da&ys",IDC_STATIC,288,12,60,112
    CONTROL         "Daily",IDC_CH_DAILY,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,24,35,10
    CONTROL         "Monday",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,39,40,10
    CONTROL         "Tuesday",IDC_CHECK2,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,51,44,10
    CONTROL         "Wednesday",IDC_CHECK3,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,63,51,10
    CONTROL         "Thursday",IDC_CHECK4,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,75,44,10
    CONTROL         "Friday",IDC_CHECK5,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,87,32,10
    CONTROL         "Saturday",IDC_CHECK6,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,99,40,10
    CONTROL         "Sunday",IDC_CHECK7,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,292,111,40,10
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,16,52,268,1
    RTEXT           "D&ep. Time:",IDC_STATIC,12,62,36,8
    EDITTEXT        IDC_EB_TIME_DEPART,49,60,40,12,ES_AUTOHSCROLL
    RTEXT           "A&rr. Time:",IDC_STATIC,16,82,32,8
    EDITTEXT        IDC_EB_TIME_ARR,49,80,40,12,ES_AUTOHSCROLL
    RTEXT           "Days Af&ter:",IDC_STATIC,113,62,40,8
    EDITTEXT        IDC_EB_DAY_AFTER,156,60,40,12,ES_AUTOHSCROLL
    RTEXT           "&Weight Limit (kg):",IDC_STATIC,93,82,60,8
    EDITTEXT        IDC_EB_WEIGHT_LIMIT,156,80,40,12,ES_AUTOHSCROLL
    RTEXT           "Valid From:",IDC_STATIC,199,62,40,8,WS_DISABLED
    EDITTEXT        IDC_EB_VALID_FROM,244,60,40,12,ES_UPPERCASE | 
                    ES_AUTOHSCROLL | WS_DISABLED
    RTEXT           "Valid To:",IDC_STATIC,205,82,34,8,WS_DISABLED
    EDITTEXT        IDC_EB_VALID_TO,244,80,40,12,ES_UPPERCASE | 
                    ES_AUTOHSCROLL | WS_DISABLED
    CONTROL         "Suspended",IDC_CH_SUSPENDED,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,120,96,52,10
    PUSHBUTTON      "&Add (Ins.)",IDC_PB_ADD,92,112,52,16
    PUSHBUTTON      "&Modify (F6)",IDC_PB_MODIFY,148,112,52,16
    GROUPBOX        "&List of Flights",IDC_STATIC,8,136,344,108
    CONTROL         "Generic1",IDC_LV_FLIGHT,"SysListView32",WS_BORDER | 
                    WS_TABSTOP | 0x18d,16,148,328,72
    PUSHBUTTON      "&Edit (F5)",IDC_PB_EDIT,64,224,52,16
    PUSHBUTTON      "&Remove",IDC_PB_REMOVE,120,224,52,16
    PUSHBUTTON      "&Print (F8)",IDC_PB_PRINT,188,224,52,16
    PUSHBUTTON      "Reset",IDC_RESET,244,224,52,16
    PUSHBUTTON      "Select Fli&ght",IDC_PB_SEL_FLIGHT,244,224,52,16,NOT 
                    WS_VISIBLE
    DEFPUSHBUTTON   "&Store (F2)",IDC_PB_STORE,8,248,52,16
    PUSHBUTTON      "Searc&h (F3)",IDC_PB_SEARCH,64,248,52,16
    PUSHBUTTON      "Exit (Esc)",IDCANCEL,244,248,52,16
    PUSHBUTTON      "Help (F1)",ID_HELP,300,248,52,16
END

