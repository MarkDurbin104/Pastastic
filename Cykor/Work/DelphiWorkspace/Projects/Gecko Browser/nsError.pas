function NS_FAILED(rv: Longword): Boolean;
function NS_SUCCEEDED(rv: Longword): Boolean;

implementation

function NS_FAILED(rv: Longword): Boolean;
begin
  Result := (rv and $80000000) <> 0;
end;

function NS_SUCCEEDED(rv: Longword): Boolean;
begin
  Result := (rv and $80000000) = 0;
end;

