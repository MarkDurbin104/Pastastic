object MainPad: TScrollBox
  Left = 0
  Top = 0
  Width = 1294
  Height = 609
  HorzScrollBar.Tracking = True
  VertScrollBar.Tracking = True
  Align = alClient
  Color = clWindow
  ParentColor = False
  PopupMenu = UCSDForm.PopupMenu1
  TabOrder = 0
  object U0000: TUCNode
    Caption = 'Normal Tasks'
    Text = 'The clerk performs their normal tasks'
    User = 'Clerk'
    Verb = 'Performs'
  end
  object U0001: TUCNode
    ParentNode = U0000
    Caption = 'Logs On To System'
    Text = 
      'The clerk logs on to the system using the standard Windows NT pr' +
      'ocedure.'#13#10'The system displays the menu of options, which may dif' +
      'fer depending on the User who has logged on or the Workstation t' +
      'hat is being used.'
    User = 'Clerk'
  end
  object U0002: TUCNode
    ParentNode = U0000
    Caption = 'Begins Customer Serving Session'
    Text = 'The clerk selects the service requested by the customer'
    User = 'Clerk'
  end
  object U0003: TUCNode
    ParentNode = U0000
    Caption = 'Ends Customer Serving Session'
    Text = 
      'If the customer is required to pay for the service provided, the' +
      ' clerk selects the method of payment requested by the customer a' +
      'nd enters the details needed to complete the transaction.'#13#10'Any p' +
      'ayments made from the clerk to the customer are made in cash.'#13#10'T' +
      'he clerk either prints a receipt for the customer or finishes th' +
      'e customer session without a receipt.'
    User = 'Clerk'
  end
  object U0004: TUCNode
    ParentNode = U0000
    Caption = 'Admin Functions'
    Text = 'The clerk selects the required admin function.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U0005: TUCNode
    ParentNode = U0000
    Caption = 'Logs Off The System'
    Text = 
      'The clerk logs off from the system.'#13#10'The system will perform a W' +
      'indows NT log-off function or return the User to the Windows NT ' +
      'desktop.'
    User = 'Clerk'
  end
  object U000A: TUCNode
    ParentNode = U0002
    Caption = 'Postal Item From "individual" Customer'
    Text = 
      'The clerk accepts the item from the customer and places it on th' +
      'e electronic scale or enters the weight via the keyboard.'#13#10'Posta' +
      'ge stamps must be sold to cover the total of the postage and any' +
      ' additional services requested by the customer.'
    User = 'Clerk'
    Verb = 'Accepts '
  end
  object U0098: TUCNode
    ParentNode = U0002
    Caption = 'Postage Prepaid Mail'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U0037: TUCNode
    ParentNode = U0002
    Caption = 'Franked Postal Item'
    Text = 
      'The clerk accepts the item from the customer.'#13#10'No cash is accept' +
      'ed at the counter to cover the postage or other charges levied a' +
      'gainst any Franked Item accepted at the counter.'
    User = 'Clerk'
    Verb = 'Accepts '
  end
  object U0047: TUCNode
    ParentNode = U0002
    Caption = 'Government Postal Item'
    Text = 
      'The clerk accepts the item from the customer and places it on th' +
      'e electronic scale or enters the weight via the keyboard.'#13#10'Posta' +
      'ge must be charged to a specific government department, selected' +
      ' from a list.'#13#10'No cash is accepted at the counter.'
    User = 'Clerk'
    Verb = 'Accepts '
  end
  object U0079: TUCNode
    ParentNode = U0002
    Caption = 'EMS'
    Text = 
      'The clerk accepts the item from the customer and places it on th' +
      'e electronic scale or enters the weight via the keyboard.'#13#10'On co' +
      'mpletion of the transaction, the system prints a receipt for the' +
      ' customer.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U006A: TUCNode
    ParentNode = U0002
    Caption = 'Bulk Mail'
    Text = 
      'Bulk Mail is accepted for domestic delivery only and at least 50' +
      '0 items must be booked to obtain the discounted tariff.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U000C: TUCNode
    ParentNode = U0002
    Caption = 'Postal Item to Customer'
    Text = 
      'The item to be delivered to the customer is brought to the count' +
      'er and the clerk enters the details into the system.'
    User = 'Clerk'
    Verb = 'Delivers'
  end
  object U008E: TUCNode
    ParentNode = U0002
    Caption = 'Savings Certificates'
    Text = 
      'The clerk accepts the request from the customer and selects the ' +
      'required function.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U0086: TUCNode
    ParentNode = U0002
    Caption = 'Postbanking'
    Text = 
      'The clerk accepts the request from the customer and selects the ' +
      'required function for the type of account being processed.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U000D: TUCNode
    ParentNode = U0002
    Caption = 'Money Order'
    Text = 
      'The clerk accepts the request from the customer and enters detai' +
      'ls about the money order into the system.'#13#10'On completion of the ' +
      'transaction the system must print a receipt for the customer.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U0095: TUCNode
    ParentNode = U0002
    Caption = 'Pensions'
    Text = 
      'The clerk accepts the request from the customer and selects the ' +
      'required function.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U009B: TUCNode
    ParentNode = U0002
    Caption = 'Other Counter Services'
    Text = 
      'The clerk accepts the request from the customer and selects the ' +
      'required function.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U000B: TUCNode
    ParentNode = U000A
    Caption = 'International Postal Item From "individual" Customer'
    Text = 
      'The clerk enters the destination country of the item being accep' +
      'ted and indicates whether the item is being posted airmail or su' +
      'rface mail'
    User = 'Clerk'
    Verb = 'Accepts '
  end
  object U000E: TUCNode
    ParentNode = U000A
    Caption = 'Domestic Postal Item From "individual" Customer'
    Text = 
      'Domestic mail has a single tariff and makes no distinction betwe' +
      'en airmail and surface mail.'
    User = 'Clerk'
    Verb = 'Accepts '
  end
  object U0042: TUCNode
    ParentNode = U000B
    Caption = 'International Letter'
    Text = 
      'The system calculates the postage based on the item'#39's size, the ' +
      'item'#39's destination and whether the item is sent airmail or surfa' +
      'ce mail.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0043: TUCNode
    ParentNode = U000B
    Caption = 'International Postcard'
    Text = 
      'The system calculates the postage based on the item'#39's weight, it' +
      's destination and whether the item is sent airmail or surface ma' +
      'il.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0045: TUCNode
    ParentNode = U000B
    Caption = 'International Aerogramme'
    Text = 
      'The system calculates the postage based on the item'#39's weight and' +
      ' its destination.'#13#10'An aerogramme may only be sent by airmail.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0028: TUCNode
    ParentNode = U000B
    Caption = 'International Small Packets'
    Text = 
      'The system calculates the postage based on the item'#39's weight and' +
      ' its destination.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0041: TUCNode
    ParentNode = U000B
    Caption = 'International Literature for the blind'
    Text = 
      'International Literature for the blind may only be sent by surfa' +
      'ce mail and is accepted by the Post free of charge.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U00BD: TUCNode
    ParentNode = U000B
    Caption = 'International Parcel'
    Text = 
      'The system calculates the postage based on the item'#39's destinatio' +
      'n, weight and whether the item is sent airmail or surface mail.'#13 +
      #10'The system prints a receipt on completion of the transaction on' +
      'ly if requested by the customer.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0053: TUCNode
    ParentNode = U0042
    Caption = 'Registration'
    Text = 
      'Registration of a postal item is an optional service that may be' +
      ' requested by the customer.  If requested, the clerk enters the ' +
      'information required to accept the service.'#13#10'The system calculat' +
      'es and displays the additional fee to be charged.'#13#10'If the custom' +
      'er requests registration, a receipt is always printed.'
    User = 'Clerk'
    Verb = 'Selects '
  end
  object U005C: TUCNode
    ParentNode = U0042
    Caption = 'Express Delivery'
    Text = 
      'Express Delivery of a postal item is an optional service that ma' +
      'y be requested by the customer.'#13#10'Express Delivery is available t' +
      'o a limited number of destination countries and the option must ' +
      'only be displayed on screen if the destination country of the it' +
      'erm being posted is among the list.'#13#10'No additional data is enter' +
      'ed by the clerk when the service is requested.'#13#10'The system calcu' +
      'lates and displays the additional fee to be charged.'#13#10'No custome' +
      'r receipt is necessary if the customer requests express delivery' +
      '.'
    User = 'Clerk'
    Verb = 'Selects '
  end
  object U005B: TUCNode
    ParentNode = U0053
    Caption = 'Advice of Delivery'
    Text = 
      'Advice of Delivery for a postal item is an optional service that' +
      ' may be requested by the customer only if the item being booked ' +
      'is registred.'#13#10'If requested, the clerk enters the information re' +
      'quired to accept the service.'#13#10'The system calculates and display' +
      's the additional fee to be charged.'#13#10'If the customer requests ad' +
      'vice of delivery, a receipt is always printed.'
    User = 'Clerk'
    Verb = 'Selects'
  end
