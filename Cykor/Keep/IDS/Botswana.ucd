  object U0070: TUCNode
    ParentNode = U000C
    Caption = 'Letter'
    Text = 
      'The system cannot display any charges due from the customer unti' +
      'l at least one of the optional fees is selected.'
    User = 'Clerk'
    Verb = 'Delivers'
  end
  object U0071: TUCNode
    ParentNode = U000C
    Caption = 'Parcel'
    Text = 
      'The system displays the handling charges due and the clerk enter' +
      's any additional charges to be applied.'
    User = 'Clerk'
    Verb = 'Delivers'
  end
  object U00B7: TUCNode
    ParentNode = U000C
    Caption = 'Postcard'
    Text = 
      'The system cannot display any charges due from the customer unti' +
      'l at least one of the optional fees is selected.'
    User = 'Clerk'
    Verb = 'Delivers'
  end
  object U00B8: TUCNode
    ParentNode = U000C
    Caption = 'Aerogramme'
    Text = 
      'The system cannot display any charges due from the customer unti' +
      'l at least one of the optional fees is selected.'
    User = 'Clerk'
    Verb = 'Delivers'
  end
  object U006B: TUCNode
    ParentNode = U000C
    Caption = 'EMS'
    Text = 
      'On completion of the transaction, the system must produce a rece' +
      'ipt.'
    User = 'Clerk'
    Verb = 'Delivers'
  end
  object U00B5: TUCNode
    ParentNode = U0070
    Caption = 'Registered POOC'
    Text = 
      'A fee is charge for any letter that is marked as registered, but' +
      ' posted out of course (POOC).'#13#10'If selected by the clerk, the cle' +
      'rk enters the fee to be charged to the customer.'#13#10'The system dis' +
      'plays the fee to be charged and adds it to any other fee payable' +
      ' by the customer for the delivery of the item.'#13#10'If POOC is charg' +
      'ed, special Postage Due stamps must be sold to the value of the ' +
      'amount received from the customer.'#13#10'If POOC is charged, a receip' +
      't is always printed.'
    User = 'Clerk'
    Verb = 'Selects '
  end
  object U00B4: TUCNode
    ParentNode = U0070
    DuplicateOf = U0077
  end
  object U00BF: TUCNode
    ParentNode = U0070
    DuplicateOf = U0026
  end
  object U00C0: TUCNode
    ParentNode = U0070
    DuplicateOf = U00BC
  end
  object U0020: TUCNode
    ParentNode = U0071
    Caption = 'Demurrage'
    Text = 
      'If demurrage is due on a parcel handed to the customer, the cler' +
      'k enters the fee to be collected.'#13#10'The fee is added to any other' +
      ' fees due and the total fee payable by the custromer is displaye' +
      'd on the screen.'
    User = 'Clerk'
    Verb = 'Collects'
  end
  object U0025: TUCNode
    ParentNode = U0071
    Caption = 'COD Trade Charge'
    Text = 
      'If the parcel is handed to the customer as Cash on Delivery the ' +
      'clerk will enter the COD Trade Charge to be collected.'#13#10'This fee' +
      ' is added to any other fee due and the total is displayed oin th' +
      'e screen.'
    User = 'Clerk'
    Verb = 'Collects'
  end
  object U00C2: TUCNode
    ParentNode = U0071
    Caption = 'COD Handling Charge'
    Text = 
      'COD Handling Charges apply to international mail only.'#13#10'When the' +
      ' parcel is handed to the customer the clerk enters the fee to be' +
      ' collected.'#13#10'This fee is added to any other fee due and the tota' +
      'l is displayed oin the screen.'
    User = 'Clerk'
    Verb = 'Collects'
  end
  object U0026: TUCNode
    ParentNode = U0071
    Caption = 'Customs Handling Charges'
    Text = 
      'Customs Handling Charges apply to international mail only.'#13#10'When' +
      ' an international item is handed to the customer the clerk will ' +
      'enter any Customs Handling Charges to be collected.'
    User = 'Clerk'
    Verb = 'Collects'
  end
  object U00BC: TUCNode
    ParentNode = U0071
    Caption = 'Customs Duty'
    Text = 
      'Customs Handling Charges apply to international mail only.'#13#10'When' +
      ' an international item is handed to the customer the clerk will ' +
      'enter any Customs Charges to be collected.'
    User = 'Clerk'
    Verb = 'Collects'
  end
  object U00B9: TUCNode
    ParentNode = U00B7
    Caption = 'Insufficient Postage'
    Text = 
      'Insufficient Postage may be charged against any item being deliv' +
      'ered to a customer where the postage attached to the item is ins' +
      'ufficient to cover the actual charges incurred.  If selected by ' +
      'the clerk, the clerk enters the fee to be charged to the custome' +
      'r.'#13#10'The system displays the fee to be charged and adds it to any' +
      ' other fee payable by the customer for the delivery of the item.' +
      #13#10'If Insufficient Postage is charged, special Postage Due stamps' +
      ' must be sold to the value of the amount received from the custo' +
      'mer.'#13#10'If Insufficient Postage is charged, a receipt is always pr' +
      'inted.'
    User = 'Clerk'
    Verb = 'Selects '
  end
  object U00BA: TUCNode
    ParentNode = U00B8
    DuplicateOf = U00B5
  end
  object U00BB: TUCNode
    ParentNode = U00B8
    DuplicateOf = U00B9
  end
  object U0072: TUCNode
    ParentNode = U00B8
    DuplicateOf = U00BF
  end
  object U00C1: TUCNode
    ParentNode = U00B8
    DuplicateOf = U00C0
  end
  object U00C3: TUCNode
    ParentNode = U006B
    DuplicateOf = U00C0
  end
  object U008F: TUCNode
    ParentNode = U008E
    Caption = 'Application for Certificate'
    Text = 
      'The clerk enters information regarding the customer purchase. Th' +
      'e customer request certificates for a specific value(eg. P400) b' +
      'ut the system will not show the denominations to be issued.'#13#10'The' +
      ' total amount of the certificates should not exceed P50000.'#13#10'Pay' +
      'ment by the customer may be made by cash or cheque.'#13#10'When the tr' +
      'ansaction is completed, two copies of the receipt must be printe' +
      'd.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0090: TUCNode
    ParentNode = U008E
    Caption = 'Certificate (Full payment)'
    Text = 
      'The clerk enters information regarding the customer redeeming th' +
      'e certificate and the certificate details.'#13#10'The system must calc' +
      'ulate the interest payable on the certifficate and display the t' +
      'otal to be paid to the customer (certificate value plus interest' +
      ').'#13#10'For payments between P1001 and P5000 the clerk must enter an' +
      ' authorisation code issued by Bank of Botswana.'#13#10'The maximum pay' +
      'ment that can be made is P5000 pula.'#13#10'No receipt is printed on c' +
      'ompletion of the transaction.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U0064: TUCNode
    ParentNode = U008E
    Caption = 'Certificate (Partial payment)'
    Text = 
      'The clerk enters information regarding the customer redeeming th' +
      'e certificate, the certificate details and the amount to be paid' +
      ' to th ecustomer.  The amount to be paid nmust be in multiples o' +
      'f P50.'#13#10'The system must calculate the interest payable on the ce' +
      'rtifficate and display the total to be paid to the customer (int' +
      'erest plus partial payment requested).'#13#10'For payments between P10' +
      '01 and P5000 the clerk must enter an authorisation code issued b' +
      'y Bank of Botswana.'#13#10'The maximum payment that can be made is P50' +
      '00 pula.'#13#10'No receipt is printed on completion of the transaction' +
      '.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U0087: TUCNode
    ParentNode = U0086
    Caption = 'Opens Account'
    Text = 
      'The clerk enters the details of the new account to be opened.'#13#10'T' +
      'he minimum deposit when opening an Ordinary or Trust account is ' +
      'P20.  For a Special Account the minimum deposit is P200.'#13#10'Paymen' +
      't for the initial deposit amount may be made by cash or cheque.'#13 +
      #10'When the transaction is completed, the system must print a cust' +
      'omer receipt and a New Account Particulars card.'
    User = 'Clerk'
  end
  object U0088: TUCNode
    ParentNode = U0086
    Caption = 'Deposit'
    Text = 
      'The clerk enters the details of the account to be credited and t' +
      'he amount to be deposited.'#13#10'The minimum deposit is P5 for  any t' +
      'ype of account.'#13#10'Payment for the deposit amount may be made by c' +
      'ash or cheque.'#13#10'When the transaction is completed, two copies of' +
      ' the receipt must be printed.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0089: TUCNode
    ParentNode = U0086
    Caption = 'Withdrawal (Trust Account)'
    Text = 
      'The clerk enters the details of the account to be debited and th' +
      'e amount to be withdrawn.'#13#10'The clerk must enter the warrant refe' +
      'rence for any withdrawal from this type of account.'#13#10'Payment of ' +
      'the withdrawal to the customer may only be made in cash.'#13#10'When t' +
      'he transaction is completed, two copies of the receipt must be p' +
      'rinted.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U0065: TUCNode
    ParentNode = U0086
    Caption = 'Withdrawal (Normal and Special Accounts)'
    Text = 
      'The clerk enters the details of the account to be debited and th' +
      'e amount to be withdrawn.'#13#10'The clerk must enter the warrant refe' +
      'rence for any withdrawal greater than P500.'#13#10'Payment of the with' +
      'drawal to the customer may only be made in cash.'#13#10'When the trans' +
      'action is completed, two copies of the receipt must be printed.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U008A: TUCNode
    ParentNode = U0086
    Caption = 'Closes Account'
    Text = 
      'The clerk must capture the Customer Name, Account number, the am' +
      'ount of withdrawal and the warrant reference.'#13#10'When the transact' +
      'ion is completed, the system must print a customer receipt.'
    User = 'Clerk'
  end
  object U008B: TUCNode
    ParentNode = U0086
    Caption = 'SAYE Deposit'
    Text = 
      'The system should be able to capture the Account number, the cus' +
      'tomer name and the amount of deposit.'#13#10'There are no minimum or m' +
      'aximum limits for the deposit.'#13#10'Payment may be made by cash or c' +
      'heque.'#13#10'When the transaction is completed, the system must print' +
      ' a customer receipt.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0081: TUCNode
    ParentNode = U000D
    Caption = 'Issues Domestic Money Order'
    Text = 
      'The system calculates the charges for a domestic money order and' +
      ' displays the total amount to be paid by the customer.'
    User = 'Clerk'
  end
  object U0082: TUCNode
    ParentNode = U000D
    Caption = 'Pays Domestic Money Order'
    Text = 
      'The clerk accepts the request for payment from the customer and ' +
      'enters details about the money order into the system.'#13#10'No receip' +
      't is printed on completion of this transaction.'
    User = 'Clerk'
  end
  object U0083: TUCNode
    ParentNode = U000D
    Caption = 'Domestic Money Order Modification'
    Text = 
      'The clerk accepts the request to change the details of the domes' +
      'tic money order into the system.'#13#10'The system calculates and disp' +
      'lays the appropriate charges.'#13#10'A receipt is printed on completio' +
      'n of this transaction.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0084: TUCNode
    ParentNode = U000D
    Caption = 'Domestic Money Order Refund'
    Text = 
      'The clerk accepts the request for refund from the customer and e' +
      'nters details of the money order into the system.'#13#10'The system ca' +
      'lculates the second commission payable and displays the amount t' +
      'o be refunded to the customer.'#13#10'On completion of the transaction' +
      ' the system must print a receipt for the customer.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U0096: TUCNode
    ParentNode = U0095
    Caption = 'Pension Payment (normal payment)'
    Text = 
      'The clerk enters the details of the Pension Payment Voucher, the' +
      ' identification details of the customer and the amount to be pai' +
      'd.'#13#10'Payment must be made to the pensioner in cash.'#13#10'No receipt i' +
      's issued on completion of the transaction.'
    User = 'Clerk'
    Verb = 'Makes'
  end
  object U0066: TUCNode
    ParentNode = U0095
    Caption = 'Pension Payment (arrears payment)'
    Text = 
      'The clerk enters the details of the Pension Payment Voucher, the' +
      ' identification details of the customer and the amount to be pai' +
      'd.'#13#10'Payment must be made to the pensioner in cash.'#13#10'No receipt i' +
      's issued on completion of the transaction.'
    User = 'Clerk'
    Verb = 'Makes'
  end
  object U001C: TUCNode
    ParentNode = U009B
    Caption = 'Postal Order Transactions'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U001D: TUCNode
    ParentNode = U009B
    Caption = 'PO Box and Private Bag Transactions'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U001E: TUCNode
    ParentNode = U009B
    Caption = 'Group Funeral Scheme Transationss'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U00A3: TUCNode
    ParentNode = U009B
    Caption = 'Phone Cards'
    Text = 
      'The clerk enters the denomination and serial number of the card ' +
      'being sold'#13#10'The system displays the fee to be paid.'#13#10'No receipt ' +
      'is issued on completion of the transaction.'
    User = 'Clerk'
    Verb = 'Sells'
  end
  object U00A4: TUCNode
    ParentNode = U009B
    Caption = 'General Refund'
    Text = 
      'The clerk enters the details of the Refund Voucher presented for' +
      ' payment.'#13#10'The system displays the amount to be paid to the cust' +
      'omer.'#13#10'A receipt must be issued on request from the customer on ' +
      'completion of the transaction.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U00A5: TUCNode
    ParentNode = U009B
    Caption = 'Exchange of stamps and stationery'
    Text = 
      'The clerk enters the details of the stamps and stationery being ' +
      'returned by the customer and the stamps to be provided in exchan' +
      'ge.'#13#10'The custoemr will always receive stamps and stationery in r' +
      'eturn, but only to 90% of the value presented to the Post Office' +
      '.'#13#10'A receipt must be issued on request by the customer on comple' +
      'tion of the transaction.'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U00A6: TUCNode
    ParentNode = U009B
    Caption = 'Registration of Newspaper'
    Text = 
      'The clerk enters the details of the company requesting the regis' +
      'tration and the Newspaper being registered.'#13#10'The system calculat' +
      'es and displays the fee to be paid to the customer.'#13#10'Payment by ' +
      'the customer may be made by cash or cheque.'#13#10'A miscellaneous rec' +
      'eipt is issued on completion of the transaction.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0069: TUCNode
    ParentNode = U009B
    Caption = 'Advertising Leaflets'
    Text = 
      'The clerk enters the details of the company presenting the leafl' +
      'ets and the total number of leaflets being posted.'#13#10'The system c' +
      'alculates and displays the fee to be paid to the customer.'#13#10'Paym' +
      'ent by the customer may be made by cash or cheque.'#13#10'A miscellane' +
      'ous receipt is issued on completion of the transaction.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U009C: TUCNode
    ParentNode = U001C
    Caption = 'Postal Order'
    Text = 
      'The clerk scans the barcode or enters the details of the serial ' +
      'number of the Postal Order being issued.'#13#10'The system must displa' +
      'y the denomination and serial number of the Postal Order.'#13#10'The s' +
      'ystem calculates the commission and displays the the total to be' +
      ' paid by the customer.'#13#10'Payment by the customer must be accepted' +
      ' as cash only.'#13#10'A receipt must be issued if requested by the cus' +
      'tomer.'
    User = 'Clerk'
    Verb = 'Issues'
  end
  object U009D: TUCNode
    ParentNode = U001C
    Caption = 'Domestic Postal Order'
    Text = 
      'The clerk scans the barcode or enters the details of the serial ' +
      'number of the Postal Order being paid.'#13#10'The system must display ' +
      'the denomination and serial number of the Postal Order.'#13#10'The cle' +
      'rk enters the details of the Postal Order being paid and the ide' +
      'ntification details of the customer presenting the Postal Order.' +
      #13#10'A receipt must be issued if requested by the customer.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U009E: TUCNode
    ParentNode = U001C
    Caption = 'International Postal Order'
    Text = 
      'The clerk enters the details of the Postal Order being paid (dat' +
      'e of issue, country of origin and face value) and the identifica' +
      'tion details of the customer presenting the Postal Order.'#13#10'The s' +
      'ystem converts the foreign currency amount to local currency and' +
      ' displays the amount to be paid to the customer.'#13#10'A receipt must' +
      ' be issued if requested by the customer.'
    User = 'Clerk'
    Verb = 'Pays'
  end
  object U00A0: TUCNode
    ParentNode = U001D
    Caption = 'PO Box Yearly Rental'
    Text = 
      'The clerk enters the details of the Post Office Box for which re' +
      'ntal is due - Post Office, Box Number, customer name, customer i' +
      'dentification.'#13#10'The customer may pay rental for more than one ye' +
      'ar in a single counter transaction.'#13#10'The system must allow the c' +
      'lerk to charge the customer an additional fee for late payment o' +
      'f the yearly rental.  The system must charge this additional fee' +
      ' only once,  regardless of how nmany years'#39' rental is being paid' +
      ' by the customer.'#13#10'The system calculates and displays the total ' +
      'fee to be paid by the customer.'#13#10'Payment by the customer may be ' +
      'made by cash or cheque.'#13#10'On completion of the transaction a misc' +
      'ellaneous receipt is issued.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U00A1: TUCNode
    ParentNode = U001D
    Caption = 'Replacement PO Box Lock Payment'
    Text = 
      'The clerk enters the details of the Post Office Box lock being r' +
      'eplaced - Post Office, Box Number, customer name, customer ident' +
      'ification.'#13#10'The system calculates and displays the fee to be pai' +
      'd.'#13#10'Payment by the customer may be made by cash or cheque.'#13#10'On c' +
      'ompletion of the transaction a miscellaneous receipt is issued.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U00A2: TUCNode
    ParentNode = U001D
    Caption = 'Private Bag Annual Rental'
    Text = 
      'The clerk enters the details of the Private Bag being rented - P' +
      'ost Office, Bag Number, customer name, customer identification.'#13 +
      #10'The customer may pay rental for more than one year in a single ' +
      'counter transaction.'#13#10'The system must allow the clerk to charge ' +
      'the customer an additional fee for late payment of the yearly re' +
      'ntal.  The system must charge this additional fee only once, reg' +
      'ardless of how nmany years'#39' rental is being paid by the customer' +
      '.'#13#10'The system calculates and displays the total fee to be paid b' +
      'y the customer.'#13#10'Payment by the customer may be made by cash or ' +
      'cheque.'#13#10'On completion of the transaction a miscellaneous receip' +
      't is issued.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0067: TUCNode
    ParentNode = U001D
    Caption = 'PO Box Quarterly Rental'
    Text = 
      'The clerk enters the details of the Post Office Box for which re' +
      'ntal is due - Post Office, Box Number, customer name, customer i' +
      'dentification.'#13#10'The customer may pay rental for a minimum of one' +
      ' and a maximum of three quarters in a single counter transaction' +
      '.'#13#10'The system must allow the clerk to charge the customer an add' +
      'itional fee for late payment of the rental.  The system must add' +
      ' this additional fee to the total fee only once, regardless of h' +
      'ow nmany quarterly rents are being paid by the customer.'#13#10'The sy' +
      'stem calculates and displays the total fee to be paid by the cus' +
      'tomer.'#13#10'Payment by the customer may be made by cash or cheque.'#13#10 +
      'On completion of the transaction a miscellaneous receipt is issu' +
      'ed.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0068: TUCNode
    ParentNode = U001D
    Caption = 'Private Bag Quarterly Rental'
    Text = 
      'The clerk enters the details of the Private Bag for which rental' +
      ' is due - Post Office, Bag Number, customer name, customer ident' +
      'ification.'#13#10'The customer may pay rental for a minimum of one and' +
      ' a maximum of three quarters in a single counter transaction.'#13#10'T' +
      'he system must allow the clerk to charge the customer an additio' +
      'nal fee for late payment of the rental.  The system must add thi' +
      's additional fee to the total fee only once, regardless of how n' +
      'many quarterly rents are being paid by the customer.'#13#10'The system' +
      ' calculates and displays the total fee to be paid by the custome' +
      'r.'#13#10'Payment by the customer may be made by cash or cheque.'#13#10'On c' +
      'ompletion of the transaction a miscellaneous receipt is issued.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U001F: TUCNode
    ParentNode = U001E
    Caption = 'Group Funeral Scheme Payment'
    Text = 
      'The clerk enters the details of the Funeral Scheme, the customer' +
      ' name, customer identification and the amount being paid.'#13#10'Payme' +
      'nt by the customer may be made by cash only.'#13#10'A receipt must be ' +
      'issued on completion of the transaction.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0021: TUCNode
    ParentNode = U001E
    Caption = 'RIPC Payment'
    Text = 
      'The clerk enters the details of the customer name, customer iden' +
      'tification and the amount being paid.'#13#10'Payment by the customer m' +
      'ay be made by cash only.'#13#10'A receipt must be issued on completion' +
      ' of the transaction.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0022: TUCNode
    ParentNode = U001E
    Caption = 'Ipolokeng Payment'
    Text = 
      'The clerk enters the details of the customer name, customer iden' +
      'tification and the month for which payment is being made.'#13#10'Payme' +
      'nt may be made for multiple months, and the clerk must capture a' +
      ' receipt nunber for each month being paid.'#13#10'An optional Policy F' +
      'ee may also be charged by the clerk.'#13#10'A receipt must be issued o' +
      'n completion of the transaction.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U007E: TUCNode
    ParentNode = U0004
    Caption = 'Reports'
    Text = 'The clerk selects the required report to be printed'
    User = 'Clerk'
    Verb = 'Prints'
  end
  object U0073: TUCNode
    ParentNode = U0004
    Caption = 'Parcels Delivered By Other Offices'
    Text = 
      'The clerk records the details of parcels delivered by Sub Post O' +
      'ffice reporting to GPO.'
    User = 'Clerk'
    Verb = 'Records'
  end
  object U00A7: TUCNode
    ParentNode = U0004
    Caption = 'Stock and Cash Transfers'
    User = 'Clerk'
    Verb = 'Processes'
  end
  object U008D: TUCNode
    ParentNode = U007E
    Caption = 'EMS Reports'
    Text = 'The clerk selects the required report to be printed'
    User = 'Clerk'
    Verb = 'Prints'
  end
  object U00C4: TUCNode
    ParentNode = U007E
    Caption = 'Letters Reports'
    Text = 'The clerk selects the required report to be printed'
    User = 'Clerk'
    Verb = 'Prints'
  end
  object U00C5: TUCNode
    ParentNode = U007E
    Caption = 'Parcels Reports'
    Text = 'The clerk selects the required report to be printed'
    User = 'Clerk'
    Verb = 'Prints'
  end
  object U0012: TUCNode
    ParentNode = U007E
    Caption = 'Financial Reports'
    Text = 'The clerk selects the required report to be printed'
    User = 'Clerk'
    Verb = 'Prints'
  end
  object U007F: TUCNode
    ParentNode = U008D
    Caption = 'EMS End of Day Report'
    Text = 
