  object U007A: TUCNode
    ParentNode = U0079
    Caption = 'Domestic EMS from Cash Customer'
    Text = 
      'The system calculates the postage for Domestic EMS'#13#10'The clerk mu' +
      'st accept cash to cover postage for the item. Stamps cannot be s' +
      'old to cover the postage.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U007B: TUCNode
    ParentNode = U0079
    Caption = 'Domestic EMS from Contract Customer'
    Text = 
      'The Clerk enters details about the contract customer being serve' +
      'd'#13#10'The system calculates the postage for Domestic EMS'#13#10'Stamps ca' +
      'nnot be sold to cover the postage.'#13#10'Payment may be made in cash ' +
      'or "on credit".  Payment cannot be made by cheque.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U007C: TUCNode
    ParentNode = U0079
    Caption = 'International EMS from Cash Customer'
    Text = 
      'The clerk enters the country of destination for the item.'#13#10'The s' +
      'ystem calculates the postage for Domestic EMS'#13#10'The clerk must ac' +
      'cept cash to cover postage for the item. Stamps cannot be sold t' +
      'o cover the postage.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U007D: TUCNode
    ParentNode = U0079
    Caption = 'International EMS from Contract Customer'
    Text = 
      'The Clerk enters details about the contract customer being serve' +
      'd'#13#10'The clerk enters the country of destination for the item and ' +
      'the system then calculates the postage required.'#13#10'Stamps cannot ' +
      'be sold to cover the postage.'#13#10'Payment may be made in cash or "o' +
      'n credit".  Payment cannot be made by cheque.'
    User = 'Clerk'
    Verb = 'Accepts'
  end
  object U0057: TUCNode
    ParentNode = U006A
