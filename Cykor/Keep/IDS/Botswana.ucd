  object U0077: TUCNode
    Caption = 'Insufficient Postage'
    Text = 
      'Insufficient Postage may be charged against any item being deliv' +
      'ered to a customer where the postage attached to the item is ins' +
      'ufficient to cover the actual charges incurred.  If selected by ' +
      'the clerk, the clerk enters the fee to be charged to the custome' +
      'r.'#13#10'The system displays the fee to be charged and adds it to any' +
      ' other fee payable by the customer for the delivery of the item.' +
      #13#10'If Insufficient Postage is charged, special Postage Due stamps' +
      ' must be sold to the value of the amount received from the custo' +
      'mer.'#13#10'If Insufficient Postage is charged, a receipt is always pr' +
      'inted.'
    User = 'Clerk'
    Verb = 'Selects '
  end
