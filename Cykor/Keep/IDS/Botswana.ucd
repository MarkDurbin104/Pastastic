  object TUCConfig
    Left = 0
    Top = 0
    Width = 0
    Height = 0
    Introduction = 
      'This document identifies the requirements of each of the typical' +
      ' '#13#10'interactions between one of the many users of the system and ' +
      'the '#13#10'system itself.'#13#10#13#10'It is intended to explain in everyday la' +
      'nguage what the system expects '#13#10'to receive as input from the Us' +
      'er and what the system will provide '#13#10'either as an "internal" pr' +
      'ocess (e.g. calculating postage), a deliverable '#13#10'to the User (e' +
      '.g. displaying the total cash due from the customer) or a '#13#10'deli' +
      'verable to the customer (e.g. printing a receipt).'#13#10#13#10'Each secti' +
      'on in the document describes a typical "scenario" '#13#10'encountered ' +
      'during a working day by one of the Post'#39's personnel.  '#13#10#13#10'Each s' +
      'cenario involves a User and their interaction with the computer ' +
      #13#10'system.  The Users identified and involved throughout this doc' +
      'ument '#13#10'are'#13#10#13#10'·   Counter Clerk'#13#10'·   Strongroom Supervisor'#13#10'·  ' +
      ' Cash Account Clerk'#13#10#13#10'It is important to understand that the do' +
      'cument does not refer to a '#13#10'specific User of the system.  In th' +
      'e context of this document the word '#13#10'"User" refers to a group o' +
      'f one or more people who perform the same '#13#10'function.  For examp' +
      'le, each Counter Clerk in the CPO will perform at '#13#10'least one, b' +
      'ut quite possibly more than one, of the scenarios shown '#13#10'below ' +
      'that involve "Counter Clerk".'#13#10#13#10'While the Post'#39's customers obvi' +
      'ously have an impact on the system in '#13#10'that it would not be use' +
      'd without them, they do not interact directly with '#13#10'the softwar' +
      'e.  Therefore the Customer is not included as a member of '#13#10'any ' +
      'of the groups of Users mentioned above.'#13#10
    OutputFile = 'C:\UseCase.doc'
    TemplateFile = 'D:\PSL\Projects\Document Templates\CORVUS Use Case template.dot'
    HeadingStyle = 'Heading 1'
    NormalStyle = 'Normal'
    EmphasisStyle = 'Message Header'
  end
end
