Include 'Pay Money Order.ids'
Groups
{

//
//-------------------------------------------------------------------------------------------
//

   Clerk__A {
     BitMap  { '..\images\G_Altkey.bmp'   }
     Title { 'ALT HOTKEYS' }
     Items {
       'Product.Cash'
       'Receipt'
       'End Customer'
       'Exit'
       'Product.Cheque'
       'Product.AccountPay'
       'Product.AccountGOVPay'
       'Product.OpenCashDrawer'
     }              
   }
   Clerk_C_ {
     BitMap  { '..\images\G_Altkey.bmp'   }
     Title { 'CTRL HOTKEYS' }
     Items {
         'Product.Stamps'
         'Product.QuickStamp55'
     }
   }

   //Clerk_C_ { Title { 'CTRL HOTKEYS'           } }
   //Clerk_CA { Title { 'CTRL-ALT HOTKEYS'       } }
   //ClerkS__ { Title { 'SHIFT HOTKEYS'          } }
   //ClerkS_A { Title { 'SHIFT-ALT HOTKEYS'      } }
   //ClerkSC_ { Title { 'SHIFT-CTRL HOTKEYS'     } }
   //ClerkSCA { Title { 'SHIFT-CTRL-ALT HOTKEYS' } }

   //Supervisor_C_ { Title { 'CTRL HOTKEYS'           } }
   //Supervisor_CA { Title { 'CTRL-ALT HOTKEYS'       } }
   //SupervisorS__ { Title { 'SHIFT HOTKEYS'          } }
   //SupervisorS_A { Title { 'SHIFT-ALT HOTKEYS'      } }
   //SupervisorSC_ { Title { 'SHIFT-CTRL HOTKEYS'     } }
   //SupervisorSCA { Title { 'SHIFT-CTRL-ALT HOTKEYS' } }

  Main {
     Caption { 'Botswana Post'                          }
     BitMap  { '..\images\SmallLogo.bmp'   }
     Title   { 'Botswana Post'                          }
     Prompt  { 'Select a Menu Item:'                           }
     Hint    { 'Select a menu item by pressing the Function Key^or by using the UP/DOWN arrows and [Enter]' }
     Items   { 'Group.MailServices'
               'Group.Services'
               'Group.FinancialServices'
               'Group.Philatelic'
               'Product.Stamps'
               'Group.Retail'
               'Group.Admin'
               'Product.Cash'
               'End Customer'
               'Receipt'
     }
  }


  Reports {
     Caption { 'Reports' }
     Title   { 'Reports' }
     BitMap  { '..\images\G_SuperReports.bmp'   }
     Prompt  { 'Select a Menu Item:' }
     Hint    { 'Select a menu item by pressing the Function Key^or by using the UP/DOWN arrows and [Enter]' }
     Items   {
        'Product.RepMonthlyCert'
        'Product.RepBankAcc'
        'Product.RepPensions'
        'Product.RepPostalOrder'
        'Product.RepMoneyOrder'
       // 'Product.RepParcels'
        'Product.ClientReturns'
        'Product.ClientRetSum'
        'Product.GenReport'
           }
  }

  Philatelic {
         Caption { 'Philatelic Items'                          }
