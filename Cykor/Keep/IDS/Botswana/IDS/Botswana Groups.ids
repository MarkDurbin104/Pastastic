      Hint         { 'Select a menu item by pressing the Function Key^or by using the UP/DOWN arrows and [Enter]' }
      Items {
            'Product.OrderCash'
            'Product.OrderStamps'
            'Group.RequestStockItems'
            'Product.OrderPostOrd'
            'Group.RequestPhilItems'
            'Product.OrderPrint'
      }
   }

