Products
{

//**                                                                                    **//
//**                              Electricity Bill Payment                              **//
//**                                                                                    **//
//          Department of Electrical
//------------------------------------------------------------------------------------------
//

  ElecBillPayDOE { BasedOn     { BaseAgency                            }
                   RegDesc     { 'Corvus Electricity Bill Payment DOE' }
                   Caption     { 'Elec Bill Payment - Dep of Elec'     }
                   Description { 'Elec Bill Payment - Dep of Elec'     }
                   Title       { 'Elec Bill Payment - Dep of Elec'     }
                   BitMap      { '..\images\P_Electricity.bmp'         }
                   Domains     { ElecBillAccountNo
                                 CustomerName
                                 BillAmount
                                 ElecBillDate                          }
                   LogAs       { ElecBill                              }
                   PLU         { PLU_ElecBillPayDOE                    }
                  }


//          Botswana Power Corporation
//------------------------------------------------------------------------------------------
//
  ElecBillPayBPC { BasedOn     { BaseAgency                            }
                   RegDesc     { 'Corvus Electricity Bill Payment BPC' }
                   Caption     { 'Elec Bill Payment - BPC'             }
                   Description { 'Elec Bill Payment - BPC'             }
                   Title       { 'Elec Bill Payment - BPC'             }
                   BitMap      { '..\images\P_Electricity.bmp'         }
                   Domains     { ElecBillAccountNo
                                 CustomerName
                                 BillAmount
                                 ElecBillDate                          }
                   LogAs       { ElecBill                              }
                   PLU         { PLU_ElecBillPayBPC                    }
                  }


//**                                                                                    **//
//**                                Telecom Bill Payment                                **//
//**                                                                                    **//
//
//------------------------------------------------------------------------------------------
//

  TelecomBillPayment { BasedOn     { BaseAgency                                        }
                       RegDesc     { 'Corvus Private Box AnnualRent Product'           }
                       Caption     { 'Telecom Bill Payment'                            }
                       BitMap      { '..\images\P_BoxAnnualRent.bmp' }
                       Description { 'Telecom Bill Payment'                            }
                       Title       { 'Telecom Bill Payment'                            }
                       Domains     { TelecomBillID
                                     CustomerTelNo
                                     CustomerName
                                     BillAmount
                                     TelecomBillPeriod                                 }
                       LogAs       { TelecomBill                                       }
                       PLU         { PLU_TelecomBillPayment  }
                      }

