   FuneralScheme {
      BasedOn     { BaseAgency }
      Caption     { 'Group Funeral Scheme'}
      BitMap      { '..\images\P_FuneralScheme.bmp' }
      Description { 'Group Funeral Scheme' }
      Title       { 'Group Funeral Scheme' }
