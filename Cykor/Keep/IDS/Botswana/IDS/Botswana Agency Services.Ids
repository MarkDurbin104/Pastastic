//
//------------------------------------------------------------------------------------------
//

 IpolokengScheme { BasedOn     {  BaseAgency                       }
                   Caption     { 'Ipolokeng Funeral Scheme(BLI)'   }
                   BitMap      { '..\images\P_IpolokengScheme.bmp' }
                   Description { 'Ipolokeng Funeral Scheme(BLI)'   }
                   Title       { 'Ipolokeng Funeral Scheme(BLI)'   }
                   Domains     {  IpolokengContractNumber
                                  CustomerName
                                  NumberOfMonths
                                  MonthlyCost
                                  TotalAmountToPay
                                 }
                   Items       { 'Product.IpolokengJoin'           }
                   Snippets    {  IpolokengVal IpolokengSchemeLog  }
                   PLU         {  PLU_IpolokengScheme              }
                  }

  IpolokengJoin {
                   BasedOn     { BaseOptionalServices                 }
                   RegDesc     { 'Ipolokeng Joining Product'          }
                   Caption     { 'Joining Fee'                        }
                   Description { 'Joining Fee'                        }
                   Title       { 'Joining Fee'                        }
                   BitMap      { '..\images\P_AdviceDelivery.bmp'     }
                   UnitPrice   { 25.00                                }
                   Domains     { IpolokengJoiningFee { UnitPrice }    }
                   LogAs       { IplokengJoin                         }
                   PLU         { PLU_IpolokengScheme                  }
                 }

}

//
//------------------------------------------------------------------------------------------
//
Snippets {

 IpolokengVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
        If Result then
        begin
            if ( NumberOfMonths.Text = '' ) then
	         TotalAmountToPay.Text := '0.00'
	     else
            TotalAmountToPay.Text := CurrToStrF(StrToIntDef(NumberOfMonths.Text,0) * StrToCurrDef(MonthlyCost.Text,0), ffNumber, 2);
        end;
       *]

      }
   }

  IpolokengSchemeLog {
         InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
         CodeBlock {
         [*
            FQuantity := StrToIntDef(ProdForm.NumberOfMonths.Text,1);

            TxnLog.LogTransaction(
                            Index,
                            FQuantity, // Quantity
                            Get_PLU, // PLU
                            FQuantity*StrToCurrDef(ProdForm.MonthlyCost.Text,0), // Value
                            StrToCurrDef(ProdForm.MonthlyCost.Text,0), // Price
                            'Ipolokeng Funeral Scheme (BLI)', // Description
                            '', // Additional Info
                            Get_ProgramID, // ProgID
                            Enumerate(ProdForm)); // Domain Info
                            Inc(Index);
            TxnLog.LogTransaction(
                      Index,
                      1, // Quantity
                      0, // PLU
                      0, // Value
                      0, // Price
                      'Contract Number - ', // Description
                      ProdForm.IpolokengContractNumber.Text, // Additional Info
                      '', // ProgID
                      ''); // Domain Info
                Inc(Index);
            TxnLog.LogTransaction(
                      Index,
                      1, // Quantity
                      0, // PLU
                      0, // Value
                      0, // Price
                      'Customer Name - ', // Description
                      ProdForm.CustomerName.Text, // Additional Info
                      '', // ProgID
                      ''); // Domain Info
                Inc(Index);
            if CombineList <> nil then
                   CombineList.LogTransactions(Index,TxnLog);
         *]

      }
   }
}
