   Housing {
      BasedOn     { BaseAgency }
      Caption     { 'Botswana Housing Corporation' }
      BitMap      { '..\images\P_Housing.bmp'   }
      Description { 'Botswana Housing Corporation' }
      Title       { 'Botswana Housing Corporation' }
      Domains {
         AccountNumber
         CustomerName
         AmountPaidTotal
       }
      LogAs { GenericBill }
      Customer { 'B. Housing Corp.','^','Total ','P',TotalFee }
      PLU   { PLU_Housing }
  }

