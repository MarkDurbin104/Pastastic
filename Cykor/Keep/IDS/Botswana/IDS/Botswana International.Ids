// Air International -----------------------------------------------------

//                             Air Letter
//---------------------------------------------------------------------------------
//

  IntAirLetter {
                 BasedOn     { BaseAirInternational                                }
                 RegDesc     { 'Corvus IntAirLetter Product'                    }
                 Caption     { 'International Air Letter'                       }
                 BitMap      { '..\images\P_IntAirLetter.bmp' }
                 Description { 'International Air Letter'                       }
                 Title       { 'International Air Letter'                       }
                 Domains     { StandardFee { Weight
                                             MailAirDestination
                                             'LookUp.IntAirLetter' }            }
                 Items       { 'Product.IntRegArticle'
                               'Product.AdviceDelivery'
                               'Product.ExpressDelivery'                        }
                 LogAS       { IntAirMail                                       }
	}

//                             Air Postcard
//---------------------------------------------------------------------------------
//

  IntAirPostCard {
                   BasedOn     { BaseAirInternational                                  }
                   RegDesc     { 'Corvus IntAirPostCard Product'                    }
                   Caption     { 'International Air Postcard'                       }
                   BitMap      { '..\images\P_IntAirPostcard.bmp' }
                   Description { 'International Air Postcard'                       }
                   Title       { 'International Air Postcard'                       }
                   Domains     { StandardFee { Weight
                                               MailAirDestination
                                               'LookUp.IntAirPostCard' }            }
                   Items       {
                                  'Product.ExpressDelivery'
                        }
                   LogAS       { IntAirMail                                         }
                  }

//                             Air Aerogramme
//---------------------------------------------------------------------------------
//

  IntAirAerogramme {
                     BasedOn     { BaseAirInternational                                    }
                     RegDesc     { 'Corvus IntAirAerogramme Product'                    }
                     Caption     { 'International Air Aerogramme'                       }
                     BitMap      { '..\images\P_IntAirAerogramme.bmp' }
                     Description { 'International Air Aerogramme'                       }
                     Title       { 'International Air Aerogramme'                       }
                     Domains     { StandardFee { Weight
                                                 MailAirDestination
                                                 'LookUp.IntAirAerogramme' }            }
                     Items       { 'Product.IntRegArticle'
                                   'Product.AdviceDelivery'
                                   'Product.ExpressDelivery'                            }
                     LogAS       { IntAirMail                                           }
	}

//                             Air Printed Paper
//---------------------------------------------------------------------------------
//

  IntAirPrintedPaper {
                       BasedOn     { BaseAirInternational                                      }
                       RegDesc     { 'Corvus IntAirPrintedPaper Product'                    }
                       Caption     { 'International Air Printed Paper'                      }
                       BitMap      { '..\images\P_IntAirPrintedPaper.bmp' }
                       Description { 'International Air Printed Paper'                      }
                       Title       { 'International Air Printed Paper'                      }
                       Domains     { StandardFee { Weight
                                                   MailAirDestination
                                                   'LookUp.IntAirPrintedPaper' }            }
                       Items       { 'Product.IntRegArticle'
                                     'Product.AdviceDelivery'
                                     'Product.ExpressDelivery'                              }
                       LogAS       { IntAirMail                                             }
                      }

