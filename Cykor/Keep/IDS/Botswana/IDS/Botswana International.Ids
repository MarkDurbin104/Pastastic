Products
{

//                             Surface Letter
//---------------------------------------------------------------------------------
//

  IntSurLetter {
                 BasedOn     { BaseSurInternational                             }
                 Caption     { 'International Surface Letter'                   }
                 BitMap      { '..\images\P_IntSurLetter.bmp' }
                 Description { 'International Surface Letter'                   }
                 Title       { 'International Surface Letter'                   }
                 Domains     { StandardFee { Weight
                                             MailSurDestination
                                             'LookUp.IntSurLetter' }            }
                 Items       {
                               'Product.IntRegArticle'
                               'Product.AdviceDelivery'
                               'Product.ExpressDelivery'
                             }
                 LogAS       { IntSurMail                                       }
                }

//                             Surface Postcard
//---------------------------------------------------------------------------------
//

  IntSurPostCard {
                   BasedOn     { BaseSurInternational                               }
                   RegDesc     { 'Corvus IntSurPostCard Product'                    }
                   Caption     { 'International Surface Postcard'                   }
                   BitMap      { '..\images\P_IntSurPostcard.bmp' }
                   Description { 'International Surface Postcard'                   }
                   Title       { 'International Surface Postcard'                   }
                   Domains     { StandardFee { Weight
                                               MailSurDestination
                                               'LookUp.IntSurPostCard' }            }
                   Items       {
                                  'Product.ExpressDelivery'
                        }
                   LogAS       { IntSurMail                                         }
                  }

//                             Surface Small Packet
//---------------------------------------------------------------------------------
//

  IntSurSmallPacket {
                      BasedOn     { BaseSurInternational                             }
                      RegDesc     { 'Corvus IntSurSmallPacket Product'               }
                      Caption     { 'International Surface Small Packet'             }
                      BitMap      { '..\images\P_IntSurPacket.bmp' }
                      Description { 'International Surface Small Packet'             }
                      Title       { 'International Surface Small Packet'             }
                      Domains     { StandardFee { Weight
                                                  MailSurDestination
                                                  'LookUp.IntSurSmallPacket' }       }
                      Items       { 'Product.IntRegArticle'
                                    'Product.AdviceDelivery'
                                    'Product.ExpressDelivery'                        }
                      LogAS       { IntSurMail                                       }
                     }

//                             Surface Printed Paper
//---------------------------------------------------------------------------------
//

  IntSurPrintedPaper {
                       BasedOn     { BaseSurInternational }
                       RegDesc     { 'Corvus IntSurPrintedPapers Product'             }
                       Caption     { 'International Surface Printed Paper'            }
                       BitMap      { '..\images\P_IntSurPPaper.bmp' }
                       Description { 'International Surface Printed Paper'            }
                       Title       { 'International Surface Printed Paper'            }
                       Domains     { StandardFee { Weight
                                                   MailSurDestination
                                                   'LookUp.IntSurPrintedPaper' }      }
                       Items       { 'Product.IntRegArticle'
                                     'Product.AdviceDelivery'
                                     'Product.ExpressDelivery'                        }
                       LogAS       { IntSurMail                                       }
                      }

//                             Surface Literature for the blind
//---------------------------------------------------------------------------------
//

 IntSurBlindLit {
                  BasedOn     { BaseSurInternational                               }
                  RegDesc     { 'Corvus IntSurBlindLit Product'                    }
                  Caption     { 'International Surface Blind Literature'           }
                  BitMap      { '..\images\P_IntSurBlindLit.bmp' }
                  Description { 'International Surface Blind Literature'           }
                  Title       { 'International Surface Blind Literature'           }
                  Domains     { StandardFee { Weight
                                              MailSurDestination
                                              'LookUp.IntSurBlindLit' }            }
                  LogAS       { IntSurMail                                         }
                 }

