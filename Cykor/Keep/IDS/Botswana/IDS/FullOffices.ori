                  Makaleng, Ramokwebana, Tsesebe
               }
               Tonota {
                  Shashe
               }
               Monarch
            }
            Orapa  {
               Letlhakane, Mopipi, Rakops
            }
            Kasane {
               Kavimba
            }
            Maun {
               Boseja, Sehitwa, Gumare, Etsha, Shakawe
            }
         }
      }
   }
}

