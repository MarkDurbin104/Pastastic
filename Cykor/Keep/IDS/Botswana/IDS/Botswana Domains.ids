//-------------------------------------------------------------------------------------------
//

 BSBLostBookFee { Title        { 'BSB Lost Book Fee' }
                  Prompt       { 'BSB Lost Book Fee' }
                  TotalIn      { TotalFee            }
                  DefaultValue { '5.00'              }
//                      InputFrom { Attrib { UnitPrice }  }
                   }


}
