//******************************************************************************************//
//*                                                                                        *//
//*                           Botswana Postal Service                                      *//
//*                                                                                        *//
//*                                 Base Domains                                           *//
//*                                                                                        *//
//******************************************************************************************//

Domains
{

//
//--------------------------------------------------------------------------------------------
//

  IntExpressDestination {
               Title  { 'Express Destination' }
               Prompt { 'Express Destination' }
               Hint   { 'Select the entry required'                }
               Error  { 'The entry you have Selected is invalid' }
               Format {  PickList { 'PickList.IntExpress' }         }
               InputFrom { 'Keyboard' }
  }

  IntGovExpressDestination {
               Title  { 'Express Destination' }
               Prompt { 'Express Destination' }
               Hint   { 'Select the entry required'                }
               Error  { 'The entry you have Selected is invalid' }
               Format {  PickList { 'PickList.IntGovExpress' }         }
               InputFrom { 'Keyboard' }
  }

  IntGovSurRegDestination {
               Title  { 'Destination Country' }
               Prompt { 'Destination Country' }
               Hint   { 'Select the entry required'                }
               Error  { 'The entry you have Selected is invalid' }
               Format {  PickList { 'PickList.SurGovReg' }        }
               InputFrom { 'Keyboard' }
  }

  IntGovAirRegDestination {
               Title  { 'Destination Country' }
               Prompt { 'Destination Country' }
               Hint   { 'Select the entry required'                }
               Error  { 'The entry you have Selected is invalid' }
               Format {  PickList { 'PickList.AirGovReg' }        }
               InputFrom { 'Keyboard' }
  }


  ParcelInsurance {
               Title  { 'Parcel Insurance' }
               Prompt { 'Parcel Insurance' }
               Hint   { 'Select the entry required'                }
               Error  { 'The entry you have Selected is invalid' }
               Format {  PickList { 'PickList.ParcelInsurance' }  }
               InputFrom { 'Keyboard' }
  }

  ParcelExpress {
               Title  { 'Parcel Express' }
               Prompt { 'Parcel Express' }
               Hint   { 'Select the entry required'                }
               Error  { 'The entry you have Selected is invalid' }
               Format {  PickList { 'PickList.ParcelExpress' }  }
               InputFrom { 'Keyboard' }
  }
  ParcelNumber {
        Title  { 'Parcel Number' }
        Prompt { 'Parcel Number' }
        Hint   { 'Enter the Parcel Number' }
        Error  { 'Enter a Valid Parcel Number' }
        Format { Mask { 'xxxxxxxxxxxxx'} }
        InputFrom { 'Keyboard'}

  }
  FuneralCompanies {
              Title  { 'Scheme Name'                                     }
              Prompt { 'Scheme Name'                                     }
              Hint   { 'Select a Funeral Scheme'                         }
              Error  { 'The Funeral Scheme you have Selected is invalid' }
              Format {  PickList { 'PickList.FuneralCompanies' }         }
              InputFrom { 'Keyboard' }
  }

 BulkMOCompany { Title     { 'Bulk Money Order Companies'                                  }
                 Prompt    { 'Bulk Money Order Company'                                    }
                 Hint      { 'Select a Bulk Money Order Company'                           }
                 Error     { 'The Bulk Money Order Company you have Selected is invalid'   }
                 //Format    {  PickList { 'PickList.BulkMoneyOrderCompanies' }              }
                 Format    {  PickList { '' }              }
                 InputFrom { 'Keyboard'                                                    }
                }

 BulkMORepName { Title     { 'Representative Name'                    }
                 Prompt    { 'Representative Name'                    }
                 Hint      { 'Enter the Representative''s Name'       }
                 Error     { 'Enter a Valid Representative Name'      }
                 Format    { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
                 InputFrom { 'Keyboard'                               }
                }

 BulkMORepID { Title     { 'Representative Identification'               }
               Prompt    { 'Representative Identification'               }
               Hint      { 'Enter the Representative''s Identification'  }
               Error     { 'Enter a Valid Representative Identification' }
               Format    { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'}      }
               InputFrom { 'Keyboard'                                    }
              }

 Comment { Title     { 'Comment'               }
           Prompt    { 'Comment'               }
           Hint      { 'Enter a Comment'       }
           Error     { 'Enter a Valid Comment' }
           Format    {  None                   }
           InputFrom { 'Keyboard'              }
          }

//
//--------------------------------------------------------------------------------------------
//


DiscountValue { Title  { 'Discount Fee' }
                Prompt { 'Discount Fee' }
                InputFrom { Params      }
                TotalIn   { TotalFee    }
           }

//
//--------------------------------------------------------------------------------------------
//

DiscountBulk { Title  { 'Discount' }
               Prompt { 'Discount' }
               TotalIn   { TotalFee    }
            }


//
//--------------------------------------------------------------------------------------------
//


GrossBulk { Title    { 'Gross Fee' }
            Prompt   { 'Gross Fee' }
            TotalIn  { TotalFee }
           }


//
//--------------------------------------------------------------------------------------------
//

GrossPay  { Title    { 'Gross Fee' }
            Prompt   { 'Gross Fee' }
            TotalIn  { TotalFee }
           }

//
//--------------------------------------------------------------------------------------------
//

  StartCash { Title     { 'Start Cash (0)'               }
              Prompt    { 'Start Cash (0)'               }
              Hint      { 'Enter your Start of day Cash' }
              Error     { 'Enter your Start of day Cash' }
              Format    { Currency { 0,9999999999 }      }
              InputFrom { 'Keyboard'                     }
             }

//
//--------------------------------------------------------------------------------------------
//

  StartStock { Title     { 'Start Stock (0)'               }
               Prompt    { 'Start Stock (0)'               }
               Hint      { 'Enter your Start of day Stock' }
               Error     { 'Enter your Start of day Stock' }
               Format    { Currency { 0,9999999999 }       }
               InputFrom { 'Keyboard'                      }
              }

//
//--------------------------------------------------------------------------------------------
//

  Weight      {  Title     { 'Weight'              }
                 Prompt    { 'Weight'              }
                 Hint      { 'The scale is either not attached or^is out of order, please type the Weight in grams' }
                 Error     { 'The Weight you have entered is invalid' }
                 Format    {  Range { '0,32000' }  }
                 InputFrom { 'Scale'  'Keyboard'   }
              }
//
//--------------------------------------------------------------------------------------------
//

  StandardFee      {  Title     { 'Standard Fee' }
                      Prompt    { 'Standard Fee' }
                      InputFrom { Params         }
                      TotalIn   { TotalFee       }
                   }

//
//--------------------------------------------------------------------------------------------
//

  StampFee      {  Title     { 'Stamp Fee' }
                   Prompt    { 'Stamp Fee' }
                   Hint      { 'Stamp Fee' }
                   Error     { 'Error Stamp Fee' }
                   InputFrom { None }
                   TotalIn   { TotalFee  }
                }


//
//-------------------------------------------------------------------------------------------
//
  CashFee      {  Title     { 'Cash Fee' }
                  Prompt    { 'Cash Fee' }
                  Prompt    { 'Cash Fee' }
                  Hint      { 'Cash Fee' }
                  Error     { 'Error Cash Fee' }
                  InputFrom { None }
                  TotalIn   { TotalFee   }
                }

//
//-------------------------------------------------------------------------------------------
//

  IndividualFee      {  Title     { 'Standard Fee' }
                        Prompt    { 'Standard Fee' }
                        InputFrom { Params         }
                     }

//
//-------------------------------------------------------------------------------------------
//

//
//-------------------------------------------------------------------------------------------
//

  RegFee           {  Title     { 'Registration Fee'    }
                      Prompt    { 'Registration Fee'    }
                      TotalIn   { TotalFee              }
                      DefaultValue { '2.80' }
//                      InputFrom { Attrib { UnitPrice }  }
                   }

//
//-------------------------------------------------------------------------------------------
//

//  ComFee           {  Title     { 'Compulsory Registration Fee' }
//                      Prompt    { 'Compulsory Registration Fee' }
//                      TotalIn   { TotalFee                      }
//                      InputFrom { Attrib { UnitPrice }          }
//                   }

//
//-------------------------------------------------------------------------------------------
//

  AdvOfDelFee      {  Title     { 'Advice of Delivery Fee' }
                      Prompt    { 'Advice of Delivery Fee' }
                      TotalIn   { TotalFee                 }
                      InputFrom { Attrib { UnitPrice }     }
                   }

//
//-------------------------------------------------------------------------------------------
//

  ExpressDelFee      {  Title     { 'Express Delivery Fee' }
                        Prompt    { 'Express Delivery Fee' }
                        TotalIn   { TotalFee                 }
                        InputFrom { Attrib { UnitPrice }     }
                      //  DefaultValue { '6.65' }
                       }

//
//-------------------------------------------------------------------------------------------
//

  CODFee      {  Title     { 'COD Fee' }
                 Prompt    { 'COD Fee' }
                 TotalIn   { TotalFee                 }
                 //DefaultValue { '2.20' }
                 InputFrom { Attrib { UnitPrice }     }
              }

//
//-------------------------------------------------------------------------------------------
//

//  AcceptFee        { Title     { 'Acceptance Fee'      }
//                     Prompt    { 'Acceptance Fee'      }
//                     TotalIn   { TotalFee              }
//                     InputFrom { Attrib { UnitPrice }  }
//                   }


//
//-------------------------------------------------------------------------------------------
//

 IpolokengContractNumber { Title     { 'Contract Number'               }
                           Prompt    { 'Contract Number'               }
                           Hint      { 'Enter the Contract Number'     }
                           Error     { 'Enter a Valid Contract Number' }
                           Format    {  Mask { 'BX999999' }            }
                           InputFrom { 'Keyboard'                      }
                          }

 NumberOfMonths { Title        { 'Number Of Months to pay'               }
                  Prompt       { 'Number Of Months to pay'               }
                  Hint         { 'Enter Number Of Months to pay'         }
                  Error        { 'Enter a Valid Number Of Months to pay' }
                  DefaultValue { '1'                                     }
                  Format       { Range { '0,99999' }                     }
                 }

 MonthlyCost { Title        { 'Monthly Cost'         }
               Prompt       { 'Monthly Cost'         }
               Hint         { 'Enter Monthly Cost'   }
               Error        { 'Enter a Monthly Cost' }
               InputFrom    { Attrib { UnitPrice  }  }
               DefaultValue { '25.00'                }
              }

 IpolokengJoiningFee { Title        { 'Ipolokeng Joining Fee'         }
                       Prompt       { 'Ipolokeng Joining Fee'         }
                       Hint         { 'Enter Ipolokeng Joining Fee'   }
                       Error        { 'Enter a Ipolokeng Joining Fee' }
                       InputFrom    { Attrib { UnitPrice  }           }
                       DefaultValue { '25.00'                         }
                       TotalIn      { TotalFee                        }
                      }
//
//-------------------------------------------------------------------------------------------
//

   AccountNumber{
      Title  { 'Account Number' }
      Prompt { 'Account Number' }
      Hint   { 'Enter the Account Number' }
      Error  { 'Enter a Valid Account Number' }
      Format { Currency { 0,99999999999 }     }
      InputFrom {
         'Keyboard'
      }
   }

//
//-------------------------------------------------------------------------------------------
//

   AccountName {
      Title  { 'Account Holder' }
      Prompt { 'Account Holder' }
      Hint   { 'Enter the Account Holder' }
      Error  { 'Enter a Valid Account Holder' }
      Format { None }
      InputFrom {
         'Keyboard'
      }
   }

//
//-------------------------------------------------------------------------------------------
//
  BulkQuantity {
    Title  { 'Quantity' }
    Prompt { 'Quantity' }
    Hint   { 'Enter the Quantity' }
    Error  { 'Enter a Valid Quantity' }
    Format    { Range { '1,9999' } }
    DefaultValue { '1' }
    InputFrom { 'Keyboard' }
   }

  BulkTotal {
    Title  { 'Bulk Total' }
    Prompt { 'Bulk Total' }
    Hint   { 'Enter the Bulk Total' }
    Error  { 'Enter a Valid Bulk Total' }
    DefaultValue { '0.00' }
  }
//
//-------------------------------------------------------------------------------------------
//

   FirstRegBulkNumber {
      Title  { 'First Register Number' }
      Prompt { 'First Register Number' }
      Hint   { 'Enter First Registration Number' }
      Error  { 'Enter a Valid Registration Number' }
      Format    { Mask { 'RXXXXXXXXXXX' }                             }
      InputFrom {
         'Keyboard'
      }
   }


//
//-------------------------------------------------------------------------------------------
//

   LastRegBulkNumber {
      Title  { 'Last Register Number' }
      Prompt { 'Last Register Number' }
      Hint   { 'Enter Last Registration Number' }
      Error  { 'Enter a Valid Registration Number' }
      Format    { Mask { 'RXXXXXXXXXXX' }                             }
      InputFrom {
         'Keyboard'
      }
   }


//
//-------------------------------------------------------------------------------------------
//

   ServiceCharge  {
      Title { 'Service Charge' }
      Prompt { 'Service Charge' }
      InputFrom { Params      }
      TotalIn   { TotalFee    }
   }

//
//-------------------------------------------------------------------------------------------
//

  IntEMSID { Title     { 'International EMS Identifier'                          }
             Prompt    { 'Please enter the Identifier'                                         }
             Hint      { 'Please type in format EE999999999BW or scan the Barcode Label'              }
             Error     { 'The Identifier you have entered is invalid' }
             Format    { Mask { 'EE99999999XUU' }                             }
             InputFrom { 'Barcode' 'Keyboard'                                 }
           }

//
//-------------------------------------------------------------------------------------------
//

  DomEMSID { Title     { 'Domestic EMS Identifier'                              }
             Prompt    { 'Please enter the Identifier'                                         }
             Hint      { 'Please type in format EE999999999BW ^ or scan the Barcode Label'              }
             Error     { 'The Identifier you have entered is invalid' }
             Format    { Mask { 'EE99999999XUU' }                             }
             InputFrom { 'Barcode' 'Keyboard'                                 }
           }

//
//-------------------------------------------------------------------------------------------
//

  IntLetterRegFirstID {
             BasedOn { IntEMSID                           }
             Title   { 'Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format  { Mask { 'RXXXXXXXXXXX' }                             }
           }

  IntLetterRegLastID {
             BasedOn { IntEMSID                           }
             Title   { 'Registered Number Up To' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }


//
//-------------------------------------------------------------------------------------------
//

  IntAerogrammeRegFirstID {
             BasedOn { IntEMSID                           }
             Title   { 'Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

  IntAerogrammeRegLastID {
             BasedOn { IntEMSID                           }
             Title   { 'Registered Number Up To' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

//
//-------------------------------------------------------------------------------------------
//

  IntPostCardRegFirstID {
             BasedOn { IntEMSID }
             Title   { 'Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

  IntPostCardRegLastID {
             BasedOn { IntEMSID }
             Title   { 'Registered Number Up To' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

//
//-------------------------------------------------------------------------------------------
//

  IntPrintedPaperRegFirstID {
             BasedOn { IntEMSID }
             Title   { 'Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

  IntPrintedPaperRegLastID {
             BasedOn { IntEMSID }
             Title   { 'Registered Number Up To' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }


//
//-------------------------------------------------------------------------------------------
//

  IntSmallPacketRegFirstID {
             BasedOn { IntEMSID }
             Title   { 'Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

  IntSmallPacketRegLastID {
             BasedOn { IntEMSID }
             Title   { 'Registered Number Up To' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }


//
//-------------------------------------------------------------------------------------------
//


  DomRegFirstID { BasedOn { IntEMSID }
             Title   { 'Domestic Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }

  DomRegLastID { BasedOn { IntEMSID }
             Title   { 'Domestic Registered Number' }
             Hint    { 'Please type in the number in the format RXXXXXXXXXXX ^ or scan the Barcode Label'              }
             Format    { Mask { 'RXXXXXXXXXXX' }                             }
           }


//
//-------------------------------------------------------------------------------------------
//

  IntParcelID { BasedOn { IntEMSID                       }
                Title   { 'Type the International Parcel Identifier or scan the barcode' }
                Hint    { 'Type in format CP99999999XUU' }   
                Format  { Mask { 'CP99999999XUU' }       }
              }

//
//-------------------------------------------------------------------------------------------
//

  DomParcelID { BasedOn { IntEMSID                  }
                Title   { 'Type in the Domestic Parcel Identifier or scan the barcode' }
                Hint    { 'Type in format CA99999999XBW or scan the barcode' }
                Format  { Mask { 'CA99999999XBW' }  }
               }

//
//-------------------------------------------------------------------------------------------
//

 InsValue { Title     { 'Insurance Value' }
            Format    { Range { '0,9999' } }
            InputFrom { 'Keyboard' }
           }

//
//-------------------------------------------------------------------------------------------
//

 InsFee { Title     { 'Insurance Fee' }
          Prompt    { 'Insurance Fee' }
          InputFrom { Params          }
          TotalIn   { TotalFee        }
         }

//
//-------------------------------------------------------------------------------------------
//

  TotalFee         { Title  { 'Total Fee' }
                     Prompt { 'Total Fee' }
                   }

//
//-------------------------------------------------------------------------------------------
//

//  TotalToPay { Title  { 'Total to Pay'           }
//               Prompt { 'Total to Pay'           }
//               Hint   { 'Enter the Total to Pay' }
//               Error  { 'Invalid Total to Pay'   }
//              }

//
//-------------------------------------------------------------------------------------------
//

  AmountPaid { Title     { 'Amount Paid'           }
               Prompt    { 'Amount Paid'           }
               Hint      { 'Enter the Amount Paid' }
               Error     { 'Invalid Amount Paid'   }
               Format    { Currency { '0,999999' } }
               InputFrom { 'Keyboard'              }
              }
  VoucherReference
  {
      Title  { 'Voucher Number'}
      Prompt { 'Voucher Number' }
      Hint   { 'Enter Voucher Number' }
      Error  { 'Enter a Valid Voucher Number' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxx' }
      }
  }

  ReasonforRefund
  {
      Title  { 'Reason For Refund' }
      Prompt { 'Reason For Refund' }
      Hint   { 'Enter Reason For Refund' }
      Error  { 'Enter a Valid Reason For Refund' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' }
      }

  }

 ReasonForReceipt { Title  { 'Reason For Receipt' }
                    Prompt { 'Reason For Receipt' }
                    Hint   { 'Enter Reason For Receipt' }
                    Error  { 'Enter a Valid Reason For Receipt' }
                    Format {  Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' }   }
                   }

 ReasonForPayment { Title  { 'Reason For Payment' }
                    Prompt { 'Reason For Payment' }
                    Hint   { 'Enter Reason For Payment' }
                    Error  { 'Enter a Valid Reason For Payment' }
                    Format {  Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' }  }
                   }

 PaymentDescription { Title  { 'Description of payment'                             }
                      Prompt { 'Description of payment'                             }
                      Hint   { 'Enter Description of payment'                       }
                      Error  { 'Enter a Valid Description of payment'               }
                      Format {  Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
                     }

  NewspaperName {
      Title  { 'Newspaper Name' }
      Prompt { 'Newspaper Name' }
      Hint   { 'Enter Newspaper Name' }
      Error  { 'Enter a Valid Newspaper Name' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxx' }
      }
 }

 RegNumber { Title  { 'Registration Number'                           }
             Prompt { 'Registration Number'                           }
             Hint   { 'Enter a Registration Number for the newspaper' }
             Error  { 'Enter a Valid Registration Number'             }
             Format { Mask { 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' }       }
            }

 RegAmount {

       Title        { 'Registration Amount'               }
       Prompt       { 'Registration Amount'               }
       Hint         { 'Enter Registration Amount'         }
       Error        { 'Enter a Valid Registration Amount' }
       DefaultValue { '539.00'                            }
       InputFrom    { None                                }
 }

  CompanyName {
      Title  { 'Company Name' }
      Prompt { 'Company Name' }
      Hint   { 'Enter Company Name' }
      Error  { 'Enter a Valid Company Name' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxx' }
      }

  }
  NumberOfLeaflets {
       Title  { 'Number Of Leaflets' }
       Prompt { 'Number Of Leaflets' }
       Hint   { 'Enter Number Of Leaflets' }
       Error  { 'Enter a Valid Number Of Leaflets' }
       DefaultValue { '1' }
       Format { Range { '0,99999' }
       }
  }
  LeafletCost {
       Title  { 'Leaflet Cost' }
       Prompt { 'Leaflet Cost' }
       Hint   { 'Enter Leaflet Cost' }
       Error  { 'Enter a Leaflet Cost' }
       InputFrom { Attrib { UnitPrice  } }
       DefaultValue { '0.70' }
 }

 NumberOfReplies { Title        { 'Number Of Replies'               }
                   Prompt       { 'Number Of Replies'               }
                   Hint         { 'Enter Number Of Replies'         }
                   Error        { 'Enter a Valid Number Of Replies' }
                   DefaultValue { '1'                               }
                   Format       { Range { '0,99999' }               }
                  }

  LetterSize { Title     { 'Letter Size'                          }
               Prompt    { 'Letter Size'                          }
               Hint      { 'Enter Letter Size'                    }
               Error     { 'Enter a Letter Size'                  }
               Format    {  PickList { 'PickList.DomLetterSize' } }
               InputFrom {  Keyboard                              }
              }

  LetterCost      {  Title     { 'Letter Cost' }
                      Prompt    { 'Letter Cost' }
                      InputFrom { Params         }
                   }

 FaxDestination { Title  { 'Fax Destination'                          }
                  Prompt { 'Fax Destination'                          }
                  Hint   { 'Enter the Destination for the Fax'        }
                  Error  { 'Enter a Valid Destination'                }
                  Format {  Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
                 }

 NumberOfPages { Title        { 'Number Of Pages'               }
                 Prompt       { 'Number Of Pages'               }
                 Hint         { 'Enter Number Of Pages'         }
                 Error        { 'Enter a Valid Number Of Pages' }
                 DefaultValue { '1'                             }
                 Format       { Range { '0,99999' }             }
                }

 FaxPageCost { Title        { 'Page Cost'           }
               Prompt       { 'Page Cost'           }
               Hint         { 'Enter Page Cost'     }
               Error        { 'Enter the Page Cost' }
               InputFrom    { Attrib { UnitPrice  } }
               DefaultValue { '7.70'                }
              }

 FaxPageCostInt { Title        { 'Page Cost'           }
                  Prompt       { 'Page Cost'           }
                  Hint         { 'Enter Page Cost'     }
                  Error        { 'Enter the Page Cost' }
                  InputFrom    { Attrib { UnitPrice  } }
                  DefaultValue { '23.10'               }
                 }

  TotalAmountToPay {
       Title  { 'Total Amount To Pay' }
       Prompt { 'Total Amount To Pay' }
       TotalIn { TotalFee }
  }


//
//-------------------------------------------------------------------------------------------
//


   Amount {
      Title  { 'Amount' }
      Prompt { 'Amount' }
      Hint   { 'Enter the Amount' }
      Error  { 'Enter a Valid Amount' }
      Format {
         //Mask { 'xxxxxxxxxxxxx' }
         Currency { '0,999999999' } 
      }
      InputFrom {
         'Keyboard'
      }
   }


//
//-------------------------------------------------------------------------------------------
//


   IntPosOrdSerialNumber {
      Title  { 'Serial Number' }
      Prompt { 'Serial Number' }
      Hint   { 'Enter Serial Number' }
      Error  { 'Enter a Valid Serial Number' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxx' }
      }
      InputFrom {
         'Keyboard'
      }
   }


//
//-------------------------------------------------------------------------------------------
//

//  OpeningBalance { Title     { 'Opening Balance'           }
//                   Prompt    { 'Opening Balance'           }
//                   Hint      { 'Enter the Opening Balance' }
//                   Error     { 'Invalid Opening Balance'   }
//                   Format    { Currency { '0,99999999' }  }
//                   InputFrom { 'Keyboard'                  }
//                  }
   OpeningBalance {
      Title  { 'Opening Balance' }
      Prompt { 'Opening Balance' }
      Hint   { 'Enter the Amount' }
      Error  { 'Enter a Valid Amount' }
      Format {  Currency { '0,99999999' }  }

      InputFrom {
         'Keyboard'
      }
   }

//
//-------------------------------------------------------------------------------------------
//


   Warrant  {
      Title  { 'Warrant Reference' }
      Prompt { 'Warrant Reference' }
      Hint   { 'Enter the Warrant Reference' }
      Error  { 'Enter a Warrant Reference' }
      Format {
         Mask { 'xxxxxxxxxxxxx' }
      }
      InputFrom {
         'Keyboard'
      }
   }

 SAAuthorityNumber { Title     { 'Authority Number'           }
                     Prompt    { 'Authority Number'           }
                     Hint      { 'Enter the Authority Number' }
                     Error     { 'Enter a Authority Number'   }
                     Format    {  Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
                     InputFrom { 'Keyboard'                   }
                    }

//
//-------------------------------------------------------------------------------------------
//

//  ClosingBalance { Title     { 'Closing Balance'           }
//                   Prompt    { 'Closing Balance'           }
//                   Hint      { 'Enter the Closing Balance' }
//                   Error     { 'Invalid Closing Balance'   }
//                   Format    { Currency { '0,999999.99' }  }
//                   InputFrom { 'Keyboard'                  }
//                  }

