//-------------------------------------------------------------------------------------------
//

//  DepositAmount { Title     { 'Deposit Amount'           }
//                  Prompt    { 'Deposit Amount'           }
//                  Hint      { 'Enter the Deposit Amount' }
//                  Error     { 'Invalid Deposit Amount'   }
//                  Format    { Currency { '0,999999.99' } }
//                  InputFrom { 'Keyboard'                 }
