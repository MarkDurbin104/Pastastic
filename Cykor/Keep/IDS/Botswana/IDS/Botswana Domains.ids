               Hint      { 'Enter the Reply Coupon Value' }
               Error     { 'Invalid Reply Coupon Value'   }
               Format    {  Currency { '0,999999' }       }
               InputFrom { 'Keyboard'                     }
              }

//
//-------------------------------------------------------------------------------------------
//

   MOOptionalServiceFee {
      Title     { 'Optional Service Fee' }
      Prompt    { 'Optional Service Fee' }
      InputFrom { Params }
      TotalIn   { TotalFee }
   }

//
//-------------------------------------------------------------------------------------------
//

   StartDomainEdit{
      Title  { 'Start Date' }
      Prompt { 'Start Date' }
      Hint   { 'Enter required start date' }
      Error  { 'Enter required start date' }
      DefaultValue {'Now' }

      Format {
         Date
      }
      InputFrom {
         'Keyboard'
      }
   }

   EndDomainEdit{
      Title  { 'End Date' }
      Prompt { 'End Date' }
      Hint   { 'Enter required end date' }
      Error  { 'Enter required end date' }
      DefaultValue {'Now' }
      Format {
         Date
      }
      InputFrom {
         'Keyboard'
      }
   }

 CustomerIdentification { Title     { 'Customer Identification'                         }
                          Prompt    { 'Enter Details of Identification Used'            }
                          Hint      { 'Enter Details of Identification Used^e.g PASSPORT No. or ID CARD details' }
                          Error     { 'Invalid Identification '                         }
                          Format    { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
                          InputFrom { 'Keyboard'                                        }
                        }

 PayeeIdentification { Title     { 'Payee Identification'                         }
                       Prompt    { 'Enter Details of Identification Used'            }
                       Hint      { 'Enter Details of Identification Used^e.g PASSPORT No. or ID CARD details' }
                       Error     { 'Invalid Identification '                         }
                       Format    { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
                       InputFrom { 'Keyboard'                                        }
                     }

   CustID_Number    {
            Title  { 'Omang Number' }
            Prompt { 'Omang Number' }
            Hint   { 'Enter Omang' }
            Error  { 'Enter a Valid Omang Number' }
            Format {
              Mask { '999999999' }
            }
            InputFrom {
                'Keyboard'
            }
    }

////------
//
 RegisterPOOCFee {
      Title  { 'Register Fee' }
      Prompt { 'Register Fee' }
      Hint   { 'Register Fee' }
      Error  { 'Enter Register Fee' }
      InputFrom { none } // Params }
      DefaultValue { '2.55' }
      //TotalIn   { TotalFee }
      //TotalIn   { StampFee }
   }

 //ExpressPOOCFee {
 //     Title  { 'Express Number' }
 //     Prompt { 'Express Number' }
 //     InputFrom { Params }

 //     TotalIn   { TotalFee }
 //   }

 InsufficentPstFee {
      Title  { 'Insufficient Postage Fee' }
      Prompt { 'Insufficient Postage Fee' }
      Hint   { 'Insufficient Postage Fee' }
      Error  { 'Error Insufficient Postage Fee' }
      Format  { Currency { '0,9999999' } }
      InputFrom { 'Keyboard' }
      //TotalIn   { TotalFee }
      //TotalIn   { StampFee }

    }

  CustomsHandChargeFee
  {
      Title  { 'Customs Handling Charge' }
      Prompt { 'Customs Handling Charge' }
      Hint   { 'Customs Handling Charge' }
      Error  { 'Error - Customs Handling Charge' }
      InputFrom { None } // Params }
      DefaultValue { '1.95' }
   }

  CustomsDutyFee
  {
      Title  { 'Customs Duty Fee' }
      Prompt { 'Customs Duty Fee' }
      Hint   { 'Customs Duty Fee' }
      Error  { 'Error Customs Duty Fee' }
      Format  { Currency { '0,9999999' } }
      InputFrom { 'Keyboard' }
   }

  DemurrageOnParcelFee
  {
      Title  { 'Demurrage Fee' }
      Prompt { 'Demurrage Fee' }
   }

   CODHandChargeFee
   {
      Title  { 'COD Handling Fee' }
      Prompt { 'COD Handling Fee' }
      Hint   { 'COD Handling Fee' }
      Error  { 'Error COD Handling Fee' }
      InputFrom { None } //Params }
      DefaultValue { '5.50' }
      //TotalIn   { TotalFee }
      //TotalIn   { CashFee }
   }

   CODTradeChargeFee
   {
      Title  { 'COD Trade Charge' }
      Prompt { 'COD Trade Charge' }
      Hint   { 'COD Trade Charge' }
      Error  { 'Error COD Trade Charge' }
      Format  { Currency { '0,9999999' } }
      InputFrom { 'Keyboard' }
      //TotalIn   { TotalFee }
      //TotalIn   { CashFee }
   }

  PaymentPeriod {
        Title  { 'Payment Period' }
        Prompt { 'Payment Period' }
        Hint   { 'Enter Payment Period' }
        Error  { 'Enter a Valid Payment Period' }
        Format {
           Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'}
        }
      InputFrom { 'Keyboard' }
  }

  PayrollNumber {
       Title  { 'Payroll Number' }
       Prompt { 'Payroll Number' }
       Hint   { 'Enter Payroll Number' }
       Error  { 'Enter a Valid Payroll Number' }
       Format { Range { '0,999999999' }
       }
  }

 EmployeeNumber { Title     { 'Employee Number'                        }
                  Prompt    { 'Employee Number'                        }
                  Hint      { 'Enter Employee Number'                  }
                  Error     { 'Enter a Valid Employee Number'          }
                  Format    {  Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
                  InputFrom { 'Keyboard'                               }
                 }

