Products {


   BaseEMSSuper {
                 DontBuild
                 SubGroup { 'EMS Super' }
                }

   AccountPay {
      BasedOn { BaseServices }
      BitMap {  '..\IMAGES\P_Refunds.bmp' }
      Caption      { 'Charge To Account - EMS' }
      Description  { 'Charge To Account - EMS' }
      Title        { 'Charge To Account - EMS' }
      PLU          { PLU_AccPay }
      Domains {
         ShowAmount
         PaymentDescription
         CustomerList
      }
      Items {
         'Complete'
      }
      Snippets {
         UtilsUses
         CustomerPayFill
         CustomerPayLog
         CustomerPayExecVars
      }
      //PLU { PLU_AccountPay }
   }

   AccountPayment {
      BasedOn { BaseServices }
      BitMap {  '..\IMAGES\P_Refunds.bmp' }
      Caption      { 'Account Payment - EMS' }
      Description  { 'Account Payment - EMS' }
      Title        { 'Account Payment - EMS' }
      PLU          { PLU_AccPayment }
      Domains {
         Amount
         CustomerList
      }
      Items {
         'Complete'
      }
      Snippets {
         UtilsUses
         CustomerPaymentFill
         CustomerPaymentLog
         CustomerPayExecVars
      }
 
   }

   AddModCust {
      BasedOn{ BaseEMSSuper }
      Caption { 'Add/Modify EMS Customer' }
      Bitmap { '..\images\P_AddModStockItem.bmp' }
      Description  { 'Add/Modify EMS Customer' }
      Title        { 'Add/Modify EMS Customer' }
      Domains {
         CustomerList
         CustomerName
         CustomerType
         CustomerNumber
         CustomerAdd1
         CustomerAdd2
         CustomerPOBox
         CustomerTelNo
      }
      Items {
         'Complete'
      }
      Snippets {
         CustomerListFill
         CustomerListDec
         CustomerListDef
         CustomerListUses
         CustomerListVars
         CustomerListLog
      }
      PLU { PLU_AddModCust }
   }

   DelCust {
      BasedOn{ BaseEMSSuper }
      Caption { 'Delete EMS Customer' }
      Bitmap { '..\images\P_DelStockItem.bmp' }
      Description  { 'Permanently Delete EMS Customer' }
      Title        { 'Permanently Delete EMS Customer' }
      Domains {
               CustomerType
               CustomerList
               }
      Items {
         'Complete'
      }
      Snippets {
         DelCustomerFill
         CustomerListUses
         CustomerListVars
         CustomerDelLog
         CustomerDelDec
         CustomerDelDef
      }
      PLU { PLU_DelCust }
   }

   CustStatement {
      BasedOn{ BaseEMSSuper }
      Caption { 'EMS Customer Statement' }
      BitMap {  '..\IMAGES\P_MOReport.bmp' }
      Description  { 'EMS Customer Statement' }
      Title        { 'EMS Customer Statement' }
      Domains {
         CustomerType
         CustomerList
         StartDomainEdit
         EndDomainEdit
      }
      Items {
         'Complete'
      }
      Snippets {
         CustomerTxnFill
         CustomerListUses
         CustomerStmtLogVars
         CustomerStmtLog
      }
      PLU { PLU_CustStatement }
   }

   CustInvoice {
      BasedOn{ BaseEMSSuper }
      Caption { 'Print EMS Customer Invoice' }
      BitMap {  '..\IMAGES\P_MOReport.bmp' }
      Description  { 'Print EMS Customer Invoice' }
      Title        { 'Print EMS Customer Invoice' }
      Domains {
         CustomerType
         CustomerList
         StartDomainEdit
         EndDomainEdit
      }
      Items {
         'Complete'
      }
      Snippets {
         CustomerTxnFill
         CustomerListUses
      }
      PLU { PLU_CustInvoice }
   }

   CustTransact {
      BasedOn{ BaseEMSSuper }
      Caption { 'EMS Customer Transaction' }
      BitMap {  '..\IMAGES\P_MOReport.bmp' }
      Description  { 'EMS Customer Transaction' }
      Title        { 'EMS Customer Transaction' }
      Domains {
         CustomerType
         CustomerList
         TransactionType
         Amount
      }
      Items {
         'Complete'
      }
      Snippets {
         CustomerTxnFill
         CustomerListUses
         CustomerTxnLog
      }
      PLU { PLU_CustTransact }
   }

