  AdviceDelivery {
                   BasedOn     { BaseOptionalServices }
                   Caption     { 'Advice of Delivery'                               }
                   Description { 'Advice of delivery'                               }
                   Title       { 'Advice of delivery'                               }
                   BitMap      { '..\images\P_AdviceDelivery.bmp' }
