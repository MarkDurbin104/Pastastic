                      'Company - ', // Description
                      ProdForm.CompanyName.Text, // Additional Info
                      '', // ProgID
                      ''); // Domain Info
                Inc(Index);
            if CombineList <> nil then
                   CombineList.LogTransactions(Index,TxnLog);
