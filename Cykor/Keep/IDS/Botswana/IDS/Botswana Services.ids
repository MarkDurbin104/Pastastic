 BusReplyVal {
      InsertBetween { '{ValidateStart}','{ValidateEnd}' }
      CodeBlock {
      [*

       Result:=CheckMaskEdits(Self);
       LetterSize.ItemIndex:=LetterSize.Items.IndexOf(LetterSize.Text);
       if LetterSize.ItemIndex >= 0 then
          LetterCost.Text:=LookUp(TStringObject(LetterSize.Items.Objects[LetterSize.ItemIndex]).Value,'0','BusReply',CompanyName,Result);

        If Result then
        begin
            if ( NumberOfReplies.Text = '' ) then
	         TotalAmountToPay.Text := '0.00'
	     else
            TotalAmountToPay.Text := CurrToStrF(StrToIntDef(NumberOfReplies.Text,0) * StrToCurrDef(LetterCost.Text,0), ffNumber, 2);
        end;
       *]

      }
   }

