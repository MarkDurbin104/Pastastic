   CustomsDutyBotswanaLogNoHandling {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(
                Index,
                1, // Quantity
                StrToInt(PLU_CustomsDutyBotswanaFee), // PLU
                StrToCurrDef(ProdForm.CustomsDutyFee.Text,0), // Value
                StrToCurrDef(ProdForm.CustomsDutyFee.Text,0), // Price
                Get_Description, // Description
                '', // Additional Info
