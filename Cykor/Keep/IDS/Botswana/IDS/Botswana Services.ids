//
//                            Domestic Insurance Service
//------------------------------------------------------------------------------------------
//

   SurParInsurance {
      SubGroup { Services }
      BitMap   { '..\images\P_Insurance.bmp' }
      Title    { 'Insurance'                                   }
      TotalIn  { TotalFee                                      }
      Domains  {
                 ParSurDestination
//                 IntRecipientName
//                 IntRecipientAddress
                 InsValue
                 InsFee { InsValue,ParSurDestination,'LookUp.SurParcelIns' }
               }
      LogAs    { SurParInsurance }
      PLU      { PLU_SurParInsurance }
   }

//
//---------------------------------------------------------------------------------
//

   AirParInsurance {
      SubGroup { Services }
      BitMap   { '..\images\P_Insurance.bmp' }
      Title    { 'Insurance' }
      TotalIn  { TotalFee }
      Domains  {
                 ParAirDestination
//                 IntRecipientName
//                 IntRecipientAddress
                 InsValue
                 InsFee { InsValue,ParAirDestination,'LookUp.AirParcelIns' }
               }
      LogAs    { AirParInsurance }
      PLU      { PLU_AirParInsurance }
   }


//
//---------------------------------------------------------------------------------
//

   CODFee {
      BasedOn     { BaseOptionalServices }
      BitMap    { '..\images\P_CODFee.bmp' }
      Title     { 'COD Fee' }
      UnitPrice { 7.70 }
      TotalIn   { TotalFee }
      Domains   { CODTradeChargeFee
                  CODFee
                 }
      LogAs     { CODFee }
      PLU       { PLU_CODFee }
   }

//
//---------------------------------------------------------------------------------
//


  PrePaidStamps {
      BasedOn { BaseOptionalServices }
      BitMap { '..\images\P_PrePaidStamps.bmp' }
      Title   { 'Pre-Paid Stamps' }
      Domains {
         PrePaidStampValue
      }
      Snippets {
         //PrePayStampsVALVar
         PrePayStampsVAL
         PrePayStampsLOG
      }
      PLU { PLU_PrePaidStamps }
  }

  FrankingMachine {
      SubGroup { 'Agency' }
      BitMap  { '..\images\Frank.bmp'   }
      Title   { 'Franking Machine Refill' }
      Domains {
         AmountPaid
         CustomerName
         FrankMachineLicenceNo
      }
      LogAs { FrankMachine }
      Customer    { 'Fq. Machine Refill','^','Total ','P',AmountPaid }
      PLU   { PLU_FrankingMachine }
  }

   AccUnaddrAdvtLeaflets {
      SubGroup { 'Services' }
         BitMap  { '..\images\P_UnAddLeaflets.bmp' }
         Caption     { 'Unaddressed Leaflets' }
         Title       { 'Unaddressed Leaflets' }
         Domains {
          CompanyName
          NumberOfLeaflets
          LeafletCost
          TotalAmountToPay
         }
        PLU { PLU_AccUnaddrAdvtLeaflets }
        Customer { 'Unaddressed Leaflets','^','Total ','P',TotalFee }
        Snippets {AccUnaddrAdvtLeafletsVal,AccUnaddrAdvtLeafletsLog}
      }

   CustomerFax {
      SubGroup { 'Services' }
         BitMap  { '..\images\P_Fax.bmp' }
         Caption { 'Customer Fax' }
         Description { 'Customer Fax' }
         Title       { 'Customer Fax' }
         Domains {
          FaxDestination
          NumberOfPages
          FaxPageCost
          TotalAmountToPay
         }
        PLU { PLU_CustomerFax }
        Customer    { 'Fax','Pg. ',NumberOfPages,'^','Total ','P',TotalFee }
        Snippets {CustomerFaxVal,CustomerFaxLog}
      }

 CustomerFaxInt { SubGroup    { 'Services'                     }
                  BitMap      { '..\images\P_Fax.bmp'          }
                  Caption     { 'Customer Fax (International)' }
                  Description { 'Customer Fax (International)' }
                  Title       { 'Customer Fax (International)' }
                  Domains     {  FaxDestination
                                 NumberOfPages
                                 FaxPageCostInt
                                 TotalAmountToPay              }
                  Snippets    {  CustomerFaxIntVal
                                 CustomerFaxIntLog             }
                  Customer    { 'Fax(Int) Pg. ',NumberOfPages,'^','Total ','P',TotalFee }
                  PLU         {  PLU_CustomerFax               }
                 }

 BusinessReply { SubGroup { 'Services' }
                 BitMap   { '..\images\P_UnAddLeaflets.bmp' }
                 Caption  { 'Business Reply' }
                 Domains  {  CompanyName
                             //Weight
                             LetterSize
                             NumberOfReplies
                             LetterCost { LetterSize,'LookUp.BusReply' }
                             TotalAmountToPay         }
                 PLU      {  PLU_BusReply }
                 Customer    { 'Business Reply','^','Total ','P',TotalFee }
                 Snippets {  BusReplyVal,BusReplyLog}
                }

 RegOfNewsPapers { SubGroup  { 'Services'                     }
                   BitMap    { '..\images\P_RegNewsPaper.bmp' }
                   Caption   { 'Registration Of NewsPapers'   }
                   TotalIn   {  TotalFee                      }
                   Domains   {  NewspaperName
                                RegAmount                     }
                   LogAs     { RegOfNewsPapers                }
                   PLU       { PLU_RegOfNewsPapers            }
                   Customer    { 'Reg. Newspapers','^','Total ','P',RegAmount }
                  }

   CustomerVoucher {
      SubGroup { 'Services' }
      BitMap  { '..\images\P_PensionPayment.bmp' }
      Caption { 'Customer Voucher' }
      Domains {
         AmountPaid
         CustomerName
         VoucherReference
         ReasonforRefund
      }
      //LogAs { CustomerVoucher }
      Snippets {CustomerVoucherLog }
      Customer    { 'Customer Voucher','^','Total ','P',AmountPaid }
      PLU { PLU_CustomerVoucher }
  }

