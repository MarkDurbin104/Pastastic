LogFormats {
// ItemDelivery { 'Name,^,"*Country of Origin ",MailSurOrigin
//                  ,^,"*Customer Name ",CustomerName
//                  ,^,"*Omang Number ",CustID_Delivery',DummyDomain}
//
// ItemIntDelivery { 'Name,^,"*Country of Origin ",MailAirOrigin
//                  ,^,"*Customer Name ",CustomerName
//                  ,^,"*Omang Number ",CustID_Delivery',DummyDomain}
//

  // InsufficentPst {'Name',InsufficentPstFee}
 CODTradeCharge {'Name',CODTradeChargeFee}
// CODHandCharge {'Name' ,CODTradeCharge}
  // DemurrageOnParcel {'Name',DemurrageOnParcelFee}
 CustomerVoucher {'Name,^,"*Voucher Reference - ",VoucherReference,^,"*Reason for Refund - ",ReasonforRefund',AmountPaid }
 RegOfNewsPapers { 'Name,^,"*Newspaper Name - ",NewspaperName',RegAmount}
 AccUnaddrAdvtLeaflets {'Name,^,"*Company Name",CompanyName',TotalFee}
}
Domains {

   CODNumber {
      Title  { 'COD Number' }
      Prompt { 'COD Number' }
      Hint   { 'Enter COD Number' }
      Error  { 'Enter a Valid COD Number' }
      Format {
        Mask { 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' }
      }
      InputFrom {
          'Keyboard'
      }
 }

   CODTradeCharge {
      Title  { 'COD Trade Charge' }
      Prompt { 'COD Trade Charge' }
      Hint   { 'Enter COD Trade Charge' }
      Error  { 'Error Insufficient COD Trade Charge' }
      Format  { Currency { '0,9999999' } }
      InputFrom { 'Keyboard' }
   }

   CustID_Delivery    {
            Title  { 'Identity Number' }
            Prompt { 'Identity Number' }
            Hint   { 'Enter Identity' }
            Error  { 'Enter a Valid Identity Number' }
            Format {
              Mask { 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' }
            }
            InputFrom {
                'Keyboard'
            }
    }

   CMisc42Number    {
            Title  { 'C Misc 42 Number' }
            Prompt { 'C Misc 42 Number' }
            Hint   { 'Enter Number' }
            Error  { 'Enter a Valid C Misc 42 Number' }
            Format {
              Mask { 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' }
            }
            InputFrom {
                'Keyboard'
            }
    }

   ManifestNumber    {
            Title  { 'Manifest Number' }
            Prompt { 'Manifest Number' }
            Hint   { 'Enter Number' }
            Error  { 'Enter a Valid Manifest' }
            Format {
              Mask { 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' }
            }
            InputFrom {
                'Keyboard'
            }
    }

 DateArrival {
      Title  { 'Arrival Date' }
      Prompt { 'Arrival Date' }
      Hint   { 'Enter arrival date' }
      Error  { 'Enter arrival date' }
      Format {
         Date
      }
      InputFrom {
         'Keyboard'
      }
 }

 NumberDays {
      Title  { 'Number of Days' }
      Prompt { 'Number of Days' }
 }

 IntFrankRegFirstID { BasedOn { IntEMSID                }
                      Title   { 'Registered Barcode'    }
                      Hint    { 'Please type in the number in the format R99999999999 ^ or scan the Barcode Label'              }
                      Format  { Mask { 'R99999999999' } }
                     }

 IntFrankRegLastID { BasedOn { IntEMSID                   }
                     Title   { 'Registered Barcode Up To' }
                     Hint    { 'Please type in the number in the format R99999999999 ^ or scan the Barcode Label'              }
                     Format  { Mask { 'R99999999999' }    }
                    }
}

