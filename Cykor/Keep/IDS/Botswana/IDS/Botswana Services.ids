                    Title       { 'Express delivery'                                 }
                    BitMap      { '..\images\P_ExpressDelivery.bmp' }
                    UnitPrice   { 10.30                                              }
                    Domains     {
                                   ExpressDelFee { UnitPrice }
                                  }
                    LogAs       { ExpressDel                                         }
                    PLU         { PLU_ExpressDelivery }
                   }


  ExpressDeliveryFree  {
                    SubGroup    { Services                                           }
