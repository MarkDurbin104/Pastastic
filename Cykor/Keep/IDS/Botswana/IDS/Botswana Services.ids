 AccUnaddrAdvtLeafletsVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
        If Result then
        begin
            if ( NumberOfLeaflets.Text = '' ) then
	         TotalAmountToPay.Text := '0.00'
	     else
            TotalAmountToPay.Text := CurrToStrF(StrToIntDef(NumberOfLeaflets.Text,0) * StrToCurrDef(LeafletCost.Text,0), ffNumber, 2);
        end;
       *]

      }
   }

  AccUnaddrAdvtLeafletsLog {
         InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
         CodeBlock {
         [*
            FQuantity := StrToIntDef(ProdForm.NumberOfLeaflets.Text,1);

            TxnLog.LogTransaction(
                            Index,
                            FQuantity, // Quantity
                            Get_PLU, // PLU
                            FQuantity*StrToCurrDef(ProdForm.LeafletCost.Text,0), // Value
                            StrToCurrDef(ProdForm.LeafletCost.Text,0), // Price
                            'Unaddressed Leaflets @ 70t', // Description
                            '', // Additional Info
                            Get_ProgramID, // ProgID
                            Enumerate(ProdForm)); // Domain Info
                            Inc(Index);
            TxnLog.LogTransaction(
                      Index,
                      1, // Quantity
                      0, // PLU
                      0, // Value
                      0, // Price
                      'Company Name - ', // Description
                      ProdForm.CompanyName.Text, // Additional Info
                      '', // ProgID
                      ''); // Domain Info
                Inc(Index);
            if CombineList <> nil then
                   CombineList.LogTransactions(Index,TxnLog);
         *]

      }
   }

