            //          'Cost of each reply - P',
            //          ProdForm.LetterCost.Text,
            //          '', // ProgID
            //          ''); // Domain Info
            //    Inc(Index);
            TxnLog.LogTransaction(
                      Index,
                      1, // Quantity
                      0, // PLU
                      0, // Value
