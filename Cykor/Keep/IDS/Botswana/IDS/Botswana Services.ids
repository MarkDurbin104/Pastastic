//-----------------------------------------------------------------------

   BaseDeliveryStamp {
         DontBuild
         BasedOn         { BaseDelivery }
         Items           {
                           'Complete'
                           'SwapTo.Stamps'
                         }
         Snippets        {
                          MailItemSwapVar
                          DeliveryItemLogVars
                          MailItemPreLog
                          MailItemLogStamps
                          DeliverySWAPTO
                          DeliveryDisableComple
                          DeliveryItemPreLog
                         }
   }

  StandardLetterDel {
     BasedOn      { BaseDeliveryStamp }
     Caption      { 'Letter Delivery'                        }
     BitMap       { '..\images\P_MailDel.bmp'  }
     Title        { 'Letter Delivery'                        }
     Description  { 'Letter Delivery'                        }
     Items {
        'Product.RegisterPOOC'
        'Product.InsufficentPst'
        'Product.CustomsDutyBotswana'
        'Product.CustomsDutySA'
     }
     Domains {
        CustomerName
        CustID_Delivery
        MailSurOrigin
        StampFee
        CashFee
     }
     PLU         { PLU_StandardLetterDel }
     Customer    { 'Letter Std. Dlv. ','^','Total ','P',TotalFee }
     Snippets    { DeliveryFeesVal, DeliveryFeesVarVal, LetterPreVal}
  }

