                      'Letter Size - ', // Description
                      ProdForm.LetterSize.Text + ' (P'+ProdForm.LetterCost.Text+')', // Additional Info
                      '', // ProgID
                      ''); // Domain Info
                Inc(Index);
            TxnLog.LogTransaction(
