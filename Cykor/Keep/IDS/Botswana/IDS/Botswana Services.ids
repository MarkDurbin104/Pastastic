                0, // Value
                0, // Price
                'C Misc 42 Number', // Description
                ProdForm.CMisc42Number.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);

          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }

  CODTradeChargeLOG {
    InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
    CodeBlock {
    [*
      TxnLog.LogTransaction(
            Index,
            FQuantity, // Quantity
            Get_PLU, // PLU
            FQuantity*StrToCurrDef(ProdForm.CODTradeChargeFee.Text,0), // Value
            StrToCurrDef(ProdForm.CODTradeChargeFee.Text,0), // Price
            Get_Description, // Description
            '', // Additional Info
            Get_ProgramID, // ProgID
            Enumerate(ProdForm)); // Domain Info
      Inc(Index);
      TxnLog.LogTransaction(
            Index,
            FQuantity, // Quantity
            StrToInt(PLU_CODHandCharge), // PLU
            FQuantity*StrToCurrDef(ProdForm.CODHandChargeFee.Text,0), // Value
            StrToCurrDef(ProdForm.CODHandChargeFee.Text,0), // Price
            'COD Handling Fee', // Description
            '', // Additional Info
            Get_ProgramID, // ProgID
            ''); // Domain Info
       Inc(Index);
       if CombineList <> nil then
         CombineList.LogTransactions(Index,TxnLog);
    *]
    }
  }
}
