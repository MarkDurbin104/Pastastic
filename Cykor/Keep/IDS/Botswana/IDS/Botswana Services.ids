//
//                            Late payment for a private PO Box
//------------------------------------------------------------------------------------------
//

  PBLatePayment { SubGroup    { Services                                         }
                  Caption     { 'PO Box Late Payment'                            }
                  BitMap      { '..\images\P_BoxSurcharge.bmp' }
                  Description { 'Fee for late payment of PO Box rent'            }
                  Title       { 'Fee for late payment of PO Box rent'            }
                  UnitPrice   { 55.00                                            }
                  Domains     { PBLatePaymentFee { UnitPrice }                   }
                  LogAs       { POBoxLatePayment                                 }
                 PLU          { PLU_PBLatePayment }
                 }


//
//------------------------------------------------------------------------------------------
//

  PBQuarterLatePayment { SubGroup    { Services                                  }
                  Caption     { 'PO Box Late Payment'                            }
                  BitMap      { '..\images\P_BoxSurcharge.bmp' }
                  Description { 'Fee for late payment of PO Box rent'            }
                  Title       { 'Fee for late payment of PO Box rent'            }
                  UnitPrice   { 55.00                                            }
                  Domains     { PBLatePaymentFee { UnitPrice }                   }
                  LogAs       { POBoxLatePayment                                 }
                 PLU          { PLU_PBLatePayment }
                 }

