//
//=================  Snippets  =======================
//

Snippets {
//   DummyDomainHide {
//    InsertBetween { '{SetProgStart}','{SetProgEnd}'  }
//          CodeBlock {
//      [*
//       ProdForm.DummyDomain.Ignore := TRUE ;
//    //   Result := False ;
//      *]
//    }
//   }

//   ExecuteDuty {
//      InsertBetween { '{SetProgStart}','{SetProgEnd}' }
//      CodeBlock {
//      [*
//         ProdForm.CustomsHandChargeFee.Text := '1.75';
//      *]
//      }
//   }


   PayStaffChequeVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
      [*
         var
//            Value:Currency;
//            SL:TStringList;
            Stock:IStock;
      *]
      }
   }

   PayStaffChequeVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
        If Result then
        begin
            result := ( StrToCurrDef( AmountPaid.Text, 0 ) > 0 );
        end;
       *]

      }
   }

   PayStaffChequeLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               -(FQuantity*StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Value
               -(StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Price
               Get_Description, // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Payee Name -', // Description
               ProdForm.PayeeName.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Payee Identification -', // Description
               ProdForm.PayeeIdentification.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);
        if ProdForm.StaffChequeNumber.Text <> '' then
        begin
           TxnLog.LogTransaction(
                  Index,
                  FQuantity, // Quantity
                  0, // PLU
                  0, // Value
                  0, // Price
                  'Cheque Number -', // Description
                  ProdForm.StaffChequeNumber.Text, // Additional Info
                  '', // ProgID
                  ''); // Domain Info
            Inc(Index);
         end ;

         Stock:=CreateStock;

         TxnLog.WriteTransaction('StockUsed'
                                ,0
                                ,-Trunc((StrToCurrDef(ProdForm.AmountPaid.Text,0))*100)
                                ,6100000
                                ,0.01
                                ,0.01
                                ,'Cheques'
                                ,''
                                ,'Product.Cheque'
                                ,'');

         try
            Stock.AdjustStockLevel(TxnLog.User
                                  ,'*Cheques'
                                  ,-Trunc((StrToCurrDef(ProdForm.AmountPaid.Text,0))*100));
         except
            // Error in Stock
         end;
         Stock := nil ;

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);

      *]
      }
   }

   DeliveryFeesVarVal {
     InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
     CodeBlock {
       [*
         var
              CHandChargeFee : Currency ;
              CDutyBotsFee,CDutySAFee : Currency ;
              CODHChargeFee     : Currency ;
              CODTChargeFee    : Currency ;
              RPOOCFee      : Currency ;
              IPstFee    : Currency ;
              DOnParcelFee : Currency ;
              SFee, CFee    : Currency ;
              //CODHandling : Currency ;
              CountryOrg: String ;
      *]
     }
   }

   PoscardFeesVarVal {
     InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
     CodeBlock {
       [*
         var
              CHandChargeFee : Currency ;
              CDutyBotsFee,CDutySAFee : Currency ;
              CODHChargeFee     : Currency ;
              CODTChargeFee    : Currency ;
              RPOOCFee      : Currency ;
              IPstFee    : Currency ;
              DOnParcelFee : Currency ;
              SFee, CFee    : Currency ;
              //CODHandling : Currency ;
      *]
     }
   }


   DeliveryFeesVal {
     InsertBetween { '{ValidateStart}','{ValidateEnd}' }
     CodeBlock {
       [*
            Result := False ;
            try

              MoveFocusTo(Self);


              // Cash

              CHandChargeFee  := 0 ;
              CDutyBotsFee    := 0 ;
              CDutySAFee      := 0 ;
              CODHChargeFee   := 0 ;
              CODTChargeFee   := 0 ;
              //CODHandling     := 0 ;

               if BaseProduct.CombineList.IsSelected('Product.CustomsDutyBotswana') and
                  BaseProduct.CombineList.IsEnabled('Product.CustomsDutyBotswana') then
               begin
                  CHandChargeFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CustomsHandChargeFee)'), 0 );
                  CDutyBotsFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CustomsDutyBotswanaFee)'), 0);
               end ;

               if BaseProduct.CombineList.IsSelected('Product.CustomsDutySA') and
                  BaseProduct.CombineList.IsEnabled('Product.CustomsDutySA') then
               begin
                  CHandChargeFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CustomsHandChargeFee)'), 0 );
                  CDutySAFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CustomsDutySAFee)'), 0);
               end ;

               if BaseProduct.CombineList.IsSelected('Product.CustomsDutyBotswanaNoHandling') and
                  BaseProduct.CombineList.IsEnabled('Product.CustomsDutyBotswanaNoHandling') then
               begin
                  CDutyBotsFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CustomsDutyBotswanaFee)'), 0);
               end ;

               if BaseProduct.CombineList.IsSelected('Product.CustomsDutySANoHandling') and
                  BaseProduct.CombineList.IsEnabled('Product.CustomsDutySANoHandling') then
               begin
                  CDutySAFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CustomsDutySAFee)'), 0);
               end ;

               if BaseProduct.CombineList.IsSelected('Product.CODTradeCharge') and
                  BaseProduct.CombineList.IsEnabled('Product.CODTradeCharge') then
               begin
                  CODHChargeFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CODHandChargeFee)'), 0);
                  CODTChargeFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CODTradeChargeFee)'), 0);
               end ;

              // if BaseProduct.CombineList.IsSelected('Product.CODHandCharge') and
              //    BaseProduct.CombineList.IsEnabled('Product.CODHandCharge') then
              //    CODHandling  := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(CODHandling)'), 0);


               CFee := CHandChargeFee + CDutyBotsFee + CDutySAFee + CODHChargeFee + CODTChargeFee ;

               if FindComponent('CashFee') <> nil then
                  TDomainEdit( FindComponent('CashFee')).Text := CurrToStrF( CFee ,ffNumber, 2 ) ;


               // Stamp

               RPOOCFee     := 0 ;
               IPstFee      := 0 ;
               DOnParcelFee := 0 ;

               if BaseProduct.CombineList.IsSelected('Product.RegisterPOOC') and
                  BaseProduct.CombineList.IsEnabled('Product.RegisterPOOC')then
                  RPOOCFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(RegisterPOOCFee)'), 0);

               if BaseProduct.CombineList.IsSelected('Product.InsufficentPst') and
                  BaseProduct.CombineList.IsEnabled('Product.InsufficentPst') then
                  IPstFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(InsufficentPstFee)'), 0);

               if BaseProduct.CombineList.IsSelected('Product.DemurrageOnParcel') and
                  BaseProduct.CombineList.IsEnabled('Product.DemurrageOnParcel') then
                  DOnParcelFee := StrToCurrDef( BaseProduct.UIEventSink.ReferenceData('GET(DemurrageOnParcelFee)'), 0);

               SFee := RPOOCFee + IPstFee + DOnParcelFee ;

               if FindComponent('StampFee') <> nil then
                  TDomainEdit( FindComponent('StampFee')).Text := CurrToStrF( SFee ,ffNumber, 2 ) ;

              //If (CustomerName.Text <> '') and (CustID_Delivery.Text <> '') and
               if  ( SFee + CFee > 0 ) then
                 Result := True ;


               if result and  ( SFee > 0 ) then
                  ProdForm.BaseProduct.CombineList.Enable('Product.Stamps')
               else
                  ProdForm.BaseProduct.CombineList.Disable('Product.Stamps');

            except
            end ;

            if Result then
               Result := CheckMaskEdits( Self ) ;


       *]
     }
  }

   LetterPreVal {
     InsertBetween { '{PreValidateStart}','{PreValidateEnd}'  }
     CodeBlock {
       [*

         if ProdForm.FindComponent('MailSurOrigin') <> nil then
            CountryOrg := TDomainCombo( ProdForm.FindComponent('MailSurOrigin')).Text ;

         if ProdForm.FindComponent('MailAirOrigin') <> nil then
            CountryOrg := TDomainCombo( ProdForm.FindComponent('MailAirOrigin')).Text ;


         if UpperCase( CountryOrg  ) = 'BOTSWANA' then
         begin
            BaseProduct.CombineList.Enable('Product.RegisterPOOC');
            BaseProduct.CombineList.Disable('Product.CustomsDutyBotswana');
            BaseProduct.CombineList.Disable('Product.CustomsDutySA');
         end
         else
         begin
            BaseProduct.CombineList.Disable('Product.RegisterPOOC');
            BaseProduct.CombineList.Enable('Product.CustomsDutyBotswana');
            BaseProduct.CombineList.Enable('Product.CustomsDutySA');
         end ;


         if ( BaseProduct.CombineList.IsSelected('Product.RegisterPOOC') and
              BaseProduct.CombineList.IsEnabled('Product.RegisterPOOC') ) or
            ( BaseProduct.CombineList.IsSelected('Product.CustomsDutyBotswana') and
              BaseProduct.CombineList.IsEnabled('Product.CustomsDutyBotswana') ) or
            ( BaseProduct.CombineList.IsSelected('Product.CustomsDutySA') and
              BaseProduct.CombineList.IsEnabled('Product.CustomsDutySA') ) then
         begin
            CustomerName.Ignore    := False ;
            CustID_Delivery.Ignore := False ;
         end
         else
         begin
            CustomerName.Ignore    := True ;
            CustID_Delivery.Ignore := True ;
         end ;

       *]
     }
  }

