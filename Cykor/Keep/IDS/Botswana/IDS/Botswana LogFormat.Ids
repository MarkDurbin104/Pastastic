//   LetterRegID       { 'Name,"*ID ",IntLetterRegID',RegFee }
//   AerogrammeRegID   { 'Name,"*ID ",IntAerogrammeRegID',RegFee }
//   PostCardRegID     { 'Name,"*ID ",IntPostCardRegID',RegFee }
//   PrintedPaperRegID { 'Name,"*ID ",IntPrintedPaperRegID',RegFee }
//   SmallPacketID     { 'Name,"*ID ",IntSmallPacketRegID',RegFee }
//   DomRegID          { 'Name,"*ID ",DomRegID',RegFee }
   CODFee            { 'Name,^,"*Trade Charge -",CODTradeChargeFee',CODFee }
   SurParInsurance   { 'Name,InsValue', InsFee }
   AirParInsurance   { 'Name,InsValue', InsFee }

//
//-----------------------------------------------------------------------------------------
//

   BaseSurParcelGov { 'Name,Weight,"*g",^,
                       "*Parcel Number -",ParcelNumber,^,
                       "*To ",ParSurDestination,^,
                       "*Recipient ",AddresseeName', StandardFee }

   BaseAirParcelGov { 'Name,Weight,"*g",^,
                      "*Parcel Number -",^,ParcelNumber,^,
                      "*To ",ParAirDestination,^,
                      "*Recipient ",AddresseeName', StandardFee }


   PaySalary { 'Name,^,
                "*Payee Name -",PayeeName,^,
                "*Payroll Number -",PayrollNumber', AmountPaid }


   Claims { 'Name,^,
            "*Payee Name -", PayeeName,^,
            "*Payee Identification -",PayeeIdentification,^,
            "*Comment -",Comment', AmountPaid }

}


