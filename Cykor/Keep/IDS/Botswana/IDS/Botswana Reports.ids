GetClerkList {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         FUIEventSink := UIEventSink ;
         ProdForm.UserName.Items.CommaText := 'All,' + ListUsers ;
         FUIEventSink := nil ;
      *]
      }
   }

}


Products {
//----------------------------------------
  SupBaseStockReport {
     DontBuild
     Items    { 'Complete' }
     SubGroup { 'Reports' }
  
  Domains {
          UserName
     }
  Snippets {
          GetClerkList
   }
  }

  SupBaseMonthlyReport {
     DontBuild
     BasedOn { SupBaseStockReport }
     Domains {
        ReportType
        ReportingMonth
     }
  }

  SupBaseTxnReport {
     DontBuild
     BasedOn { SupBaseStockReport }
     Domains {
        StartDomainEdit
        EndDomainEdit
     }
  }
//----------------------------------------
  RepMonthlyCert {
    BasedOn { SupBaseMonthlyReport }
    Title    { 'Certificates Issued and Redeemed'  }
    Bitmap   { '..\Images\RepMthlyJournalSavCertificate.bmp' }
    Domains {
       StartDomainEdit
       EndDomainEdit
    }
    Snippets {
        RepTxnTranslateUSES
        RepJourSumStartEndVAL
        RepMonthlyCertLOGVAR
        RepMonthlyCertLOG
    }
  }

  RepBankAcc {
