   //                           FUIEventSink.User, // User
   //                           IntToStr(FUIEventSink.Office), // Office
   //                           ProdForm.StartDomainEdit.Text, // StartDate
   //                           ProdForm.EndDomainEdit.Text,   // EndDate
   //                           'Postal Orders Issued', // Report Title
   //                           '" ","<Denomination","<No",">Value",">Comm"',  // Column Headers
