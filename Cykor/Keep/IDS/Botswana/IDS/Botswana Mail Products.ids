Products {

//_______________________________________________________________
//
//                      BASE MAIL
//_______________________________________________________________


   BaseSurValue {
      DontBuild
      BasedOn { BaseSurfaceDest }
      Items   {
                'SwapTo.Stamps'
                'Product.PrePaidStamps'
               }
      Domains  {
               StandardFee
               }
      Snippets {
                MailItemSwapVar
                MailItemLogVars
                MailItemPreLog
                MailItemLogStamps
                MailSWAPTO
                MailStampTrigger
                //MailStampTriggerVar
                GranVarAU
                DisableComple
               }
   }

   BaseAirValue {
      DontBuild
      BasedOn { BaseAirDest }
      Items    {
               'SwapTo.Stamps'
               'Product.PrePaidStamps'
               }
      Domains  {
               StandardFee
               }
      Snippets {
               MailItemSwapVar
               MailItemLogVars
               MailItemPreLog
               MailItemLogStamps
               MailSWAPTO
               MailStampTrigger
               //MailStampTriggerVar
               GranVarAU
               DisableComple
               }
   }



//________________Express + ( Register ) Value

   BaseAirExpAdvValue {
      DontBuild
      BasedOn { BaseAirValue }
      Items {
               'Product.ExpressDelivery'
               'Product.AdviceDelivery'
      }
      Domains {
         IntExpressDestination
      }
      Snippets {
                  DisableExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                }
   }


   BaseSurExpAdvValue {
      DontBuild
      BasedOn { BaseSurValue }
      Items {
               'Product.ExpressDelivery'
               'Product.AdviceDelivery'
      }
      Domains {
         IntExpressDestination
      }
      Snippets {
                  DisableExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                  LetterWeightPosVal
                }
   }


   BaseAirExpValue {
      DontBuild
      BasedOn { BaseAirValue }
      Items {
               'Product.ExpressDelivery'
            }
      Domains {
         IntExpressDestination
      }
      Snippets {
                  DisableExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                }
   }

   BaseSurExpValue {
      DontBuild
      BasedOn { BaseSurValue }
      Items {
               'Product.ExpressDelivery'
            }
      Domains {
         IntExpressDestination
      }
      Snippets {
                  DisableExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                  LetterWeightPosVal
                }
   }


//________________Franked

   BaseAirFrq {
      DontBuild
      BasedOn { BaseAirDest }
      Domains {
                IntExpressDestination
                StandardFee
              }
      Items  {
               'Product.ExpressDeliveryFree'
               'Product.AdviceDeliveryFree'
             }
      Snippets {
                  BaseFrqVarVal
                  BaseFrqPreVal
                  BaseFrqPosVal
                  DisableExpressExecute
               }
   }

   BaseSurFrq {
      DontBuild
      BasedOn { BaseSurfaceDest }
      Domains {
                IntExpressDestination
                StandardFee
              }
      Items  {
               'Product.ExpressDeliveryFree'
               'Product.AdviceDeliveryFree'
             }
      Snippets {
                  BaseFrqVarVal
                  BaseFrqPreVal
                  DisableExpressExecute
               }
   }

//________________Government

   BaseAirAdvGov {
      DontBuild
      BasedOn { BaseGovAirDest }
      Items {
               'Product.AdviceDelivery'
               'Product.ExpressDelivery'
            }
      Domains  {
               IntGovExpressDestination
               //IntGovRegDestination
               StandardFee
               }
      Snippets {
                  DisableGovExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                  SelectRegister
                }
   }

   BaseSurAdvGov {
      DontBuild
      BasedOn { BaseGovSurfaceDest }
      Domains  {
               IntGovExpressDestination
               //IntGovRegDestination
               StandardFee
               }
      Items {
               'Product.AdviceDelivery'
               'Product.ExpressDelivery'
            }
      Snippets {
                  DisableGovExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                  SelectRegister
                }
   }


   BaseAirGov {
      DontBuild
      BasedOn { BaseGovAirDest }
      Domains  {
               IntGovExpressDestination
               StandardFee
               }
      Items    {
               'Product.ExpressDelivery'
               }
      Snippets {
                  DisableGovExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                  SelectRegister
                }
   }

   BaseSurGov {
      DontBuild
      BasedOn { BaseGovSurfaceDest }
      Domains  {
               IntGovExpressDestination
               //IntGovRegDestination
               StandardFee
               }
      Items    {
               'Product.ExpressDelivery'
               'Product.AdviceDelivery'
               }
      Snippets {
                  DisableGovExpressExecute
                  DisableBottomVar
                  DisableAdviceBottom
                  SelectRegister
                }
   }


//________________Bulk


   BaseSurBulk {
      DontBuild
      BasedOn { BaseSurface }
      Domains {
         IndividualFee
         CustomerName
         GrossBulk
         DiscountBulk
      }
      Items {
         'Product.Sorted'
         'Product.UnSorted'
      }
      Snippets {
         PostExecuteBulk
         PostValidBulk
         BulkNotifyChild
      }
   }

//________________Parcel

   BaseSurParcel {
      DontBuild
      BasedOn  { BaseParcel  }
      Domains  {
                 ParSurDestination
                 PostOffice
                 //CustomerName
                 //CustomerAddress
                 AddresseeName
                 ParcelNumber
                 Weight
                 //BulkQuantity
                 StandardFee { Weight,ParSurDestination,'LookUp.SurParcel' }
               }
      Items    { 'SwapTo.Stamps'
                 'Product.PrePaidStamps'
                 'Product.AdviceDelivery'
                 'Product.ExpressDelivery'
                 'Product.CODFee'
                 'Product.SurParInsurance'
               }
      Snippets { MailItemSwapVar
                 MailItemLogVars
                 MailItemLog
                 MailItemPreLog
                 MailItemLogStamps
                 ParcelMailSWAPTO
                 DisableParcelBottomVar
                 DisableParcelBottom
                 DisableComple
               }
   }

   BaseSurParcelGov {
      DontBuild
      BasedOn  { BaseParcel  }
      Domains  {
                 ParSurDestination
                 PostOffice
                 //CustomerName
                 //CustomerAddress
                 AddresseeName
                 ParcelNumber
                 Weight
                 //BulkQuantity
                 StandardFee { Weight,ParSurDestination,'LookUp.SurParcel' }
               }
      Items    {
                 'Product.PrePaidStamps'
                 'Product.AdviceDelivery'
                 'Product.ExpressDelivery'
                 'Product.CODFee'
                 'Product.SurParInsurance'
               }
      Snippets {
                 DisableParcelBottomVar
                 DisableParcelBottom
               }
      LogAs    { BaseSurParcelGov }
   }

   BaseAirParcel {
      DontBuild
      BasedOn  { BaseParcel  }
      Domains  {
                 ParAirDestination
                 PostOffice
                 //CustomerName
                 //CustomerAddress
                 AddresseeName
                 ParcelNumber
                 Weight
                 //BulkQuantity
                 StandardFee { Weight,ParAirDestination,'LookUp.AirParcel' }
               }
      Items    { 'SwapTo.Stamps'
                 'Product.PrePaidStamps'
                 'Product.AdviceDelivery'
                 'Product.ExpressDelivery'
                 'Product.CODFee'
                 'Product.AirParInsurance'
               }
      Snippets { MailItemSwapVar
                 MailItemLogVars
                 MailItemLog
                 MailItemPreLog
                 MailItemLogStamps
                 ParcelMailSWAPTO
                 DisableParcelBottomVar
                 DisableParcelBottom
                 DisableComple
               }
   }

   BaseAirParcelGov {
      DontBuild
      BasedOn  { BaseParcel  }
      Domains  {
                 ParAirDestination
                 PostOffice
                 //CustomerName
                 //CustomerAddress
                 AddresseeName
                 ParcelNumber
                 Weight
                 //BulkQuantity
                 StandardFee { Weight,ParAirDestination,'LookUp.AirParcel' }
               }
      Items    {
                 'Product.PrePaidStamps'
                 'Product.AdviceDelivery'
                 'Product.ExpressDelivery'
                 'Product.CODFee'
                 'Product.AirParInsurance'
               }
      Snippets {
                 DisableParcelBottomVar
                 DisableParcelBottom
               }
      LogAs    { BaseAirParcelGov }
   }


//_______________________________________________________________
//
//                     Parcel Mail
//_______________________________________________________________


   SurParcel {
      Caption { 'Surface Parcel' }
      Title   { 'Surface Parcel' }
      BitMap  { '..\images\P_DomSurParcel.bmp' }
      Domains {
               StandardFee { Weight,ParSurDestination,'LookUp.SurParcel' }
      }
      BasedOn { BaseSurparcel }
      Customer { 'S. Parcel ',Weight,'g','^','Total ','P',TotalFee }
      PLU     { PLU_SurParcel }
   }

   AirParcel {
      Caption { 'Air Parcel' }
      Title   { 'Air Parcel' }
      BitMap   { '..\images\P_DomAirParcel.bmp' }
      BasedOn { BaseAirparcel }
      Domains {
               StandardFee { Weight,ParAirDestination,'LookUp.AirParcel' }
      }
      Customer { 'A. Parcel ',Weight,'g','^','Total ','P',TotalFee }
      PLU     { PLU_AirParcel }
   }

   GovSurParcel {
      Caption { 'Surface Government Parcel' }
      Title   { 'Surface Government Parcel' }
      BitMap   { '..\images\P_DomSurParcel.bmp' }
      BasedOn { BaseSurParcelGov }
   //BaseSurparcel }
      Domains {
               StandardFee { Weight,ParSurDestination,'LookUp.SurParcel' }
      }
      Customer { 'S. Gv.Parcel ',Weight,'g','^','Total ','P',TotalFee }
      PLU     { PLU_GovSurParcel }
   }

   GovAirParcel {
      Caption { 'Air Government Parcel' }
      Title   { 'Air Government Parcel' }
      BitMap   { '..\images\P_DomAirParcel.bmp' }
      BasedOn { BaseAirParcelGov }
      Domains {
               StandardFee { Weight,ParAirDestination,'LookUp.AirParcel' }
      }
      Customer { 'A. Gv.Parcel ',Weight,'g','^','Total ','P',TotalFee }
      PLU     { PLU_GovAirParcel }
   }


//_______________________________________________________________
//
//                Air Ordinary
//_______________________________________________________________

   AirLetterStd {
      BasedOn { BaseAirExpAdvValue }
      Caption      { 'Air Standard Letter' }
      BitMap       { '..\images\P_DomAirLetter.bmp' }
      Domains { StandardFee { Weight,MailAirDestination,'LookUp.AirStdLetter' }  }
      Items {
         'Product.AirLetterRegID'
         'Product.AirLetterRedeemIRC'
      }
      Snippets {
         AirLetterNOTIFYVAR
         AirLetterSWAPTO
      }
      Customer { 'A. Letter Std','^','Total ','P',TotalFee }
      PLU     { PLU_AirLetterStd }
   }

