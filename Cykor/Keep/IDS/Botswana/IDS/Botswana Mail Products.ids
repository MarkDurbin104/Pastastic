//________________________________________________________________
//
//                     SNIPPETS
//________________________________________________________________

Snippets {


  ExecuteNeedsWeight {
    InsertBetween { '{NeedsWeightStart}','{NeedsWeightEnd}' }
    CodeBlock {
      [*
         ProdForm.Weight.Ignore:=True;
         ProdForm.Weight.Text :='0';
         NeedsWeight:=False;
      *]
     }
  }

  BulkBoxUses {
    InsertBetween { '{UsesStart}','{UsesEnd}' }
    CodeBlock {
      [*
         uses StringUtil;
      *]
    }
  }


   PostExecuteBulk {
      InsertBetween { '{PostExecuteStart}','{PostExecuteEnd}' }
      CodeBlock {
      [*
         CombineList.ForceSelect('Product.Sorted') ;
      *]
      }
   }

   PostValidBulk {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*

         if ( IndividualFee.Text <> 'Invalid' ) then
         begin
            if ( IndividualFee.Text <> '' ) and (BulkQuantity.Text<> '') then
               GrossBulk.Text := CurrToStrF( StrToCurr(IndividualFee.Text)* StrToCurr(BulkQuantity.Text),ffNumber,2);

            if ( IndividualFee.Text <> '' ) and ( StrToIntDef( BulkQuantity.Text, 0 ) > 499 ) then
            begin
               if BaseProduct.CombineList.IsSelected('Product.Sorted') then
                  DiscountBulk.Text := CurrToStrF( -( StrToCurr(IndividualFee.Text)*
                                                      StrToCurr(BulkQuantity.Text) *
                                                      (5/100)
                                                     ),ffNumber,2)
               else
                  //DiscountBulk.Text := CurrToStrF( -( StrToCurr(IndividualFee.Text)*
                  //                                     StrToCurr(BulkQuantity.Text) *
                  //                                    (2/100)
                  //                                   ),ffNumber,2);
                  DiscountBulk.Text := '0.00';  // no discount for unsorted as from 1 May 2004
            end
            else DiscountBulk.Text := '0.00';
            
         end ;

         if Result and ( StrToIntDef( BulkQuantity.Text, 0 ) < 100 ) then
         begin
            Result := false ;
            MoveFocusTo( BulkQuantity );
         end ;

         if Result then
         begin
            if ( Pos( 'Letter', BaseProduct.Get_ProgramID) > 0 ) then
            begin
               result :=  ( StrToIntDef( Weight.Text, 0 ) <= 1000 ) ;
               if not result then IndividualFee.Text := 'Invalid'
            end ;
         end ;

      *]
      }
   }

   DisableBottomVar {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
         ActProd : String ;
         CountrySelected : String ;
      *]
      }
   }

   DisableParcelBottomVar  {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
         Zone : String ;
         ActProd : String ;
         CountrySelected : String ;
      *]
      }
   }

   BaseFrqVarVal {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
            CountrySelected,ActProd:String;
      *]
      }
   }

   FrqVarAU {
      InsertBetween { '{VarAUStart}','{VarAUEnd}' }
      CodeBlock {
      [*
         var
            ActProd:String;

      *]
      }
   }
   BaseFrqPosVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
         if  result and not BaseProduct.CombineList.IsSelected( ActProd ) and
                        not BaseProduct.CombineList.IsSelected('Product.ExpressDeliveryFree') then
            result := false ;

      *]
      }
   }


   BaseFrqPreVal {
      InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
      CodeBlock {
      [*
         ActProd := '' ;
         if BaseProduct.CombineList.IndexOf('Product.AirFrankRegID') >= 0 then ActProd := 'Product.AirFrankRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.AirFrankRegID') >= 0 then ActProd := 'Product.AirFrankRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurFrankRegID') >= 0 then ActProd := 'Product.SurFrankRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurFrankRegID') >= 0 then ActProd := 'Product.SurFrankRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurFrankRegID') >= 0 then ActProd := 'Product.SurFrankRegID' ;

         //if ActProd <> '' then
         //   BaseProduct.CombineList.Select(ActProd);

         if ProdForm.FindComponent('MailSurDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('MailSurDestination')).Text ;
         end ;

         if ProdForm.FindComponent('MailAirDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('MailAirDestination')).Text ;
         end ;

        if IntExpressDestination.Items.IndexOf( CountrySelected ) >=0 then
           BaseProduct.CombineList.Enable('Product.ExpressDeliveryFree')
        else
           BaseProduct.CombineList.Disable('Product.ExpressDeliveryFree') ;


         if BaseProduct.CombineList.IsSelected( ActProd ) then //or
            //BaseProduct.CombineList.IsSelected('Product.ExpressDeliveryFree') then
            BaseProduct.CombineList.Enable('Product.AdviceDeliveryFree')
         else
            BaseProduct.CombineList.Disable('Product.AdviceDeliveryFree') ;

      *]
      }
   }



   DisableAdviceBottom {
      InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
      CodeBlock {
      [*

         ActProd := '' ;
         if BaseProduct.CombineList.IndexOf('Product.AirLetterRegID')        >= 0 then ActProd := 'Product.AirLetterRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurLetterRegID')        >= 0 then ActProd := 'Product.SurLetterRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.AerogrammeRegID')       >= 0 then ActProd := 'Product.AerogrammeRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.AirPostCardRegID')      >= 0 then ActProd := 'Product.AirPostCardRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurPostCardRegID')      >= 0 then ActProd := 'Product.SurPostCardRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.AirPrintedPaperRegID')  >= 0 then ActProd := 'Product.AirPrintedPaperRegID' ;
         // if BaseProduct.CombineList.IndexOf('Product.SurPrintedPaperRegID')  >= 0 then ActProd := 'Product.SurPrintedPaperRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurSmallPacketRegID')   >= 0 then ActProd := 'Product.SurSmallPacketRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurBlindRegID')         >= 0 then ActProd := 'Product.SurBlindRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.AirSmallPacketRegID')   >= 0 then ActProd := 'Product.AirSmallPacketRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.AirGovRegID')           >= 0 then ActProd := 'Product.AirGovRegID' ;
         if BaseProduct.CombineList.IndexOf('Product.SurGovRegID')           >= 0 then ActProd := 'Product.SurGovRegID' ;

         CountrySelected := '' ;
         if ProdForm.FindComponent('MailAirDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('MailAirDestination')).Text ;
         end ;

         if ProdForm.FindComponent('MailSurDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('MailSurDestination')).Text ;
         end ;

         if ProdForm.FindComponent('IntGovSurRegDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('IntGovSurRegDestination')).Text ;
         end ;

         if ProdForm.FindComponent('IntGovAirRegDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('IntGovAirRegDestination')).Text ;
         end ;


         if CountrySelected = '' then
         begin
            //if BaseProduct.CombineList.IndexOf('Product.AdviceDelivery')  >= 0 then
            //   BaseProduct.CombineList.Disable('Product.AdviceDelivery');
            //BaseProduct.CombineList.Disable( ActProd);
            BaseProduct.CombineList.Disable('Product.ExpressDelivery')

         end
         else
         begin
            if ( BaseProduct.CombineList.IndexOf('Product.ExpressDelivery') >= 0 ) and
               ( ProdForm.FindComponent('IntExpressDestination') <> nil ) then
               if TDomainCombo( ProdForm.FindComponent('IntExpressDestination')).Items.IndexOf( CountrySelected ) >=0 then
                  BaseProduct.CombineList.Enable('Product.ExpressDelivery')
               else
                  BaseProduct.CombineList.Disable('Product.ExpressDelivery') ;

            if ( BaseProduct.CombineList.IndexOf('Product.ExpressDelivery') >= 0 ) and
               ( ProdForm.FindComponent('IntGovExpressDestination') <> nil ) then
               if TDomainCombo( ProdForm.FindComponent('IntGovExpressDestination')).Items.IndexOf( CountrySelected ) >=0 then
                  BaseProduct.CombineList.Enable('Product.ExpressDelivery')
               else
                  BaseProduct.CombineList.Disable('Product.ExpressDelivery') ;


            //BaseProduct.CombineList.Enable( ActProd );

         end ;

         if BaseProduct.CombineList.IndexOf('Product.PrePaidStamps') >= 0 then
            if StrToIntDef(ProdForm.BulkQuantity.Text,0) = 1 then
               BaseProduct.CombineList.Enable('Product.PrePaidStamps')
            else
               BaseProduct.CombineList.Disable('Product.PrePaidStamps') ;

         if BaseProduct.CombineList.IndexOf('Product.AdviceDelivery')  >= 0 then
            if BaseProduct.CombineList.IsSelected(ActProd) and
               BaseProduct.CombineList.IsEnabled(ActProd) then
               BaseProduct.CombineList.Enable('Product.AdviceDelivery')
            else
               BaseProduct.CombineList.Disable('Product.AdviceDelivery');

      *]
      }
   }



   DisableParcelBottom {
      InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
      CodeBlock {
      [*

         CountrySelected := '' ;
         if ProdForm.FindComponent('ParAirDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('ParAirDestination')).Text ;
         end
         else if ProdForm.FindComponent('ParSurDestination') <> nil then
         begin
            CountrySelected := TDomainCombo( ProdForm.FindComponent('ParSurDestination')).Text ;
         end ;

         ActProd := '' ;
         if BaseProduct.CombineList.IndexOf('Product.SurParInsurance') >= 0 then ActProd := 'Product.SurParInsurance';
         if BaseProduct.CombineList.IndexOf('Product.AirParInsurance') >= 0 then ActProd := 'Product.AirParInsurance';


         if CountrySelected = '' then
         begin
            BaseProduct.CombineList.Disable('Product.AdviceDelivery');
            BaseProduct.CombineList.Disable('Product.CODFee' );
            BaseProduct.CombineList.Disable('Product.ExpressDelivery');
            BaseProduct.CombineList.Disable( ActProd );
         end
         else
         begin
            BaseProduct.CombineList.Enable('Product.AdviceDelivery');
            if UpperCase( CountrySelected ) = 'BOTSWANA' then
               BaseProduct.CombineList.Enable('Product.CODFee' )
            else
               BaseProduct.CombineList.Disable('Product.CODFee' );


            Zone := '';

            if ParcelExpress.Items.IndexOf( CountrySelected ) >=0 then
               Zone := TStringObject(ParcelExpress.Items.Objects[ParcelExpress.Items.IndexOf( CountrySelected )]).Value ;

            if Zone = 'Express' then
               BaseProduct.CombineList.Enable('Product.ExpressDelivery')
            else
               BaseProduct.CombineList.Disable('Product.ExpressDelivery') ;

            Zone := '';
            if ParcelInsurance.Items.IndexOf( CountrySelected ) >=0 then
                Zone := TStringObject(ParcelInsurance.Items.Objects[ParcelInsurance.Items.IndexOf( CountrySelected )]).Value ;

            if Zone = 'Insurance' then
            begin
               BaseProduct.CombineList.Enable( ActProd );
               if BaseProduct.CombineList.IsSelected(ActProd) then
                  BaseProduct.CombineList.Enable('Product.AdviceDelivery')
               else
                  BaseProduct.CombineList.Disable('Product.AdviceDelivery');
            end
            else
            begin
               BaseProduct.CombineList.Disable( ActProd );
               BaseProduct.CombineList.Disable( 'Product.AdviceDelivery' );
            end ;

         end ;

         PostOffice.Ignore := not BaseProduct.CombineList.IsEnabled('Product.CODFee' );

      *]
      }
   }

  SelectRegister {
    InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
    CodeBlock {
    [*
      if not BaseProduct.CombineList.IsSelected( ActProd ) then
        BaseProduct.CombineList.Select( ActProd );

      if Result then
      begin
        if (ProdForm.FindComponent('IntGovSurRegDestination') <> nil)
        and (TDomainCombo(ProdForm.FindComponent('IntGovSurRegDestination')).Items.IndexOf( CountrySelected ) < 0) then
          Result := False ;

        if  (ProdForm.FindComponent('IntGovAirRegDestination') <> nil)
        and (TDomainCombo(ProdForm.FindComponent('IntGovAirRegDestination')).Items.IndexOf( CountrySelected ) < 0) then
          Result := false ;
      end;

      if  (BaseProduct.CombineList.IndexOf('Product.AdviceDelivery')  >= 0)
      and (BaseProduct.CombineList.IsSelected(ActProd)) then
        BaseProduct.CombineList.Enable('Product.AdviceDelivery')
      else
        BaseProduct.CombineList.Disable('Product.AdviceDelivery');

      BaseProduct.GetFormData(self);
      BulkTotal.text  := CurrToStrF( StrToIntDef(BulkQuantity.text,0)
                                      * StrToCurrDef(TotalFee.Text,0),ffNumber, CurrencyDecimals);

      if Result
      and ( Pos( 'Letter', BaseProduct.Get_ProgramID) > 0 )
      and ( UpperCase( CountrySelected ) = 'BOTSWANA' ) then
      begin
        Result :=  ( StrToIntDef( Weight.Text, 0 ) <= 200 ) ;
        if not Result then StandardFee.Text := 'Invalid'
      end ;
    *]
    }
  }

   DisableGovExpressExecute {
      InsertBetween { '{SetProgStart}','{SetProgEnd}' }
      CodeBlock {
      [*
      //if ProdForm.FindComponent('IntGovExpressDestination') <> nil then
         ProdForm.IntGovExpressDestination.Ignore := TRUE ;
         //ProdForm.IntGovRegDestination.Ignore := TRUE ;
      *]
      }
   }

  LetterWeightPosVal {
    InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
    CodeBlock {
    [*
      BaseProduct.GetFormData(self);
      BulkTotal.text  := CurrToStrF( StrToIntDef(BulkQuantity.text,0)
                                      * StrToCurrDef(TotalFee.Text,0),ffNumber, CurrencyDecimals);
      if Result
      and  ( Pos( 'Letter', BaseProduct.Get_ProgramID) > 0 )
      and ( UpperCase( CountrySelected ) <> 'BOTSWANA' ) then
      begin
        Result :=  ( StrToIntDef( Weight.Text, 0 ) <= 200 ) ;
        if not Result then StandardFee.Text := 'Invalid'
      end ;
    *]
    }
  }

   //DisableFrqReg {
