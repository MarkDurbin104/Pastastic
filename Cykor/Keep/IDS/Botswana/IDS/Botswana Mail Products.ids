      Customer { 'S. Gv.PostCard','^','Total ','P',TotalFee }
      PLU     { PLU_SurGovPostCard }
      Snippets { ExecuteNeedsWeight }
   }

   SurGovSmallPacket {
      BasedOn { BaseSurGov }
      Caption      { 'Surface Government Small Packet' }
      BitMap       { '..\images\P_DomSurSmallPacket.bmp' }
      Domains { StandardFee { Weight,IntGovSurRegDestination,'LookUp.SurSmallPacket' }  }
      Items { 'Product.SurGovRegID' }
      Customer { 'S. Gv.Sml Pkt ',Weight,'g','^','Total ','P',TotalFee }
      PLU     { PLU_SurGovSmallPacket }
   }

