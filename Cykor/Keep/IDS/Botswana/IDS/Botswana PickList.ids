    M01 { 'January'   }
    M02 { 'February'  }
    M03 { 'March'     }
    M04 { 'April'     }
    M05 { 'May'       }
    M06 { 'June'      }
    M07 { 'July'      }
    M08 { 'August'    }
    M09 { 'September' }
    M10 { 'October'   }
    M11 { 'November'  }
    M12 { 'December'  }
 }

 BankAcc {
    Ordinary  { 'Ordinary Savings Bank' }
    Trust     { 'Trust Savings Bank'    }
    Special   { 'Special Savings Bank'  }
    SAYE      { 'SAYE' }
 }

 Pensions {
    Normal  { 'Normal Pension Payments' }
    Arrears { 'Pension Payment Arrears' }
 }

 IssuePaid {
    Issued  { 'Issued' }
    Paid    { 'Paid'   }
 }

 DomInt {
    Domestic      { 'Domestic'      }
    International { 'International' }
 }

