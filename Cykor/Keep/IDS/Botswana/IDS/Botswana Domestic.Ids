                   Title       { 'Domestic Surface Postcard'                        }
                   Domains     { StandardFee { Weight,'LookUp.DomSurPostCard' }     }
                   Items       {
                                 'Product.ExpressDelivery'
                               }
                   LogAs       { DomMail                                            }
                  }

