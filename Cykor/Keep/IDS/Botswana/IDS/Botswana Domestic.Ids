  DomSurPostcard { BasedOn     { BaseDomestic                                       }
                   RegDesc     { 'CORVUS DomSurPostcard Product'                    }
                   Caption     { 'Domestic Surface Postcard'                        }
                   BitMap      { '..\images\P_DomSurPostcard.bmp' }
