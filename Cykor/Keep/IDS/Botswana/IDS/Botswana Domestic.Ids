Products
{

//**                                                                                    **//
//**                          Domestic Surface Mail                                     **//
//**                                                                                    **//
//
//------------------------------------------------------------------------------------------
//

  DomSurLetter       { BasedOn      { BaseDomestic                                     }
                       RegDesc      { 'CORVUS DomSurLetter Product'                    }
                       Caption      { 'Domestic Surface Letter'                        }
                       BitMap       { '..\images\P_DomSurLetter.bmp' }
                       Description  { 'Domestic Surface Letter'                        }
                       Title        { 'Domestic Surface Letter'                        }
                       Domains      {  StandardFee { Weight,'LookUp.DomSurLetter' }    }
                       Items        { 'Product.DomRegArticle'
                                      'Product.AdviceDelivery'
                                      'Product.ExpressDelivery'
                                    }
                       LogAs        { DomMail                                          }
                     }

//
//------------------------------------------------------------------------------------------
//

  DomSurSmallPacket  {  BasedOn     { BaseDomestic                                          }
                        RegDesc     { 'CORVUS DomSurSmallPacket Product'                    }
                        Caption     { 'Domestic Surface Small Packet'                       }
                        BitMap      { '..\images\P_DomSurSmallPacket.bmp' }
                        Description { 'Domestic Surface Small Packet'                       }
                        Title       { 'Domestic Surface Small Packet'                       }
                        Domains     {  StandardFee { Weight,'LookUp.DomSurSmallPacket' }    }
                        Items       {
                                       'Product.DomRegArticle'
                                       'Product.AdviceDelivery'
                                       'Product.ExpressDelivery'
                                    }
                        LogAs       { DomMail                                               }
                       }

//
//------------------------------------------------------------------------------------------
//

  DomSurPrintedPaper { BasedOn     { BaseDomestic                                           }
                       RegDesc     { 'CORVUS DomSurPrintedPaper Product'                    }
