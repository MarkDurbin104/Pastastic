//---------------------------- Normal Pension Payment --------------------------
   PNormalPayments {
      Header { 'HeadFoot.CentralHeader' }
//      FitWidth
      Title    { 'Normal Pension Payments' }
      PLURange { 050040001 }
      Columns  {
         CustomerName              { Heading { 'Name' } Width { -500 } }
         OmangNumber               { Heading { 'Omang No' } Width { -250 } Text }
//         PaymentPeriod             { Heading { 'Payment Period' } }
         VoucherNumber             { Heading { 'Voucher No' } Width { -250 } Text }
         Amount                    { Heading { 'Amount' } Width { -250 } Justify { Right } Total Currency }
         AmountPaid                { Heading { 'Remarks' } Width {-600 } Justify { Centre } }
      }
   }
//--------------------------- Arrears Pension Payment --------------------------
   PArrearsPayments {
      Header { 'HeadFoot.CentralHeader' }
//      FitWidth
      Title    { 'Arrears Pension Payments' }
      PLURange { 050040002 }
      Columns  {
         CustomerName              { Heading { 'Name' } Width { -500 } }
         OmangNumber               { Heading { 'Omang No' } Width { -250 } Text }
//         PaymentPeriod             { Heading { 'Payment Period' } }
         VoucherNumber             { Heading { 'Voucher No' } Width { -250 } Text }
         Amount                    { Heading { 'Amount' } Width { -250 } Justify { Right } Total Currency }
         AmountPaid                { Heading { 'Remarks' } Width {-600 } Justify { Centre } }
      }
   }
//--------------------------- Month Summary Pension Payment --------------------------
   PSummaryPayments {
      Header { 'HeadFoot.CentralHeaderSummary' }
//      FitWidth
      Title    { 'Summary Pension Payments' }
      CSVFile  { 'C:\Botswana\Database\CentralRepMonthlyPension.csv' }
      //SecondQuery { ' select cast('''' as Char (20)) as Fx1, sum(ItemQuantity) as Quantity1, '
      //              ' sum(ItemValue) as TxnValue1, cast(Datetime as Date) as DateX, '
      //              ' cast(''0'' as Integer) as Quantity2, cast(''0'' as Money) as TxnValue2, '
      //              ' cast('''' as Char (20)) as Fx2 '
      //              ' from ReportResult '
      //              ' where PLU = 050040001 '
      //              ' union select cast('''' as Char (20)), cast(''0'' as Integer) , cast(''0'' as Money), '
      //              ' cast(Datetime as Date), '
      //              ' sum(ItemQuantity), sum(ItemValue) , '
      //              ' cast('''' as Char (20)) '
      //              ' from ReportResult '
      //              ' where PLU = 050040002 '
      //              ' group by DateX' }
      PLURange { 050040001, 050040002 }
      Columns  {
         //ItemQuantity       { Heading { 'Norm Pay' } Width { -200 } Justify { Right } Total }
         //Amount             { Heading { 'Value' } Width { -200 } Justify { Right } Total Currency }
         //TotalFee                    { Width {-100 } }
         ItemQuantity           { Heading { 'Normal Pay' } Width { -200 } Justify { Right } Total }
         Amount                 { Heading { 'Value' } Width { -210 } Justify { Right } Total Currency }
         DateTime               { Heading { 'Date' } Width { -340 } Justify { Centre } Text }
         ItemQuantity2          { Heading { 'Arrears Pay' } Width { -190 } Justify { Right } Total }
         Amount2                { Heading { 'Value' } Width { -210 } Justify { Right } Total Currency }
         Remark                 { Heading { 'Remarks' } Width {-650 } Justify { Centre } }
      }
   }
//------------------------- South Africa Pension Payment -----------------------
   PSAPayments {
      FitWidth
      Title    { 'South Africa Pension Payment' }
      PLURange { 050040003 }
      Columns  {
         CustomerName              { Heading { 'Customer Name' } }
         PayeeIdentification       { Heading { 'Payee Identification' } }
         VoucherNumber             { Heading { 'Voucher Number' } }
         PaymentPeriod             { Heading { 'Payment Period' } }
         Amount                    { Heading { 'Amount' } Justify { Right }}
         CurrentExchangeRate       { Heading { 'Exchange Rate' }  Justify { Right } }
         TotalFee                  { Heading { 'Total Fee' }   Justify { Right } Total }
      }
   }

