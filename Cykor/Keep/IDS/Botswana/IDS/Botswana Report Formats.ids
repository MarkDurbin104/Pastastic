// Fixed column names available in any report
// 'TransactionID'
// 'RecordID'
// 'WSNumber'
// 'OfficeCode'
// 'AccountingPeriod'
// 'TransactionType'
// 'DateTime'
// 'Teller'
// 'ProgramID'
// 'ProgramVersion'
// 'PLU'
// 'ItemPrice'
// 'ItemQuantity'
// 'ItemValue'
// 'Description'

// Typical First Query:
// FirstQuery { 'select * from txnlog where (RecType = ''TxnLine'' or RecType = ''TxnTotal'')' }
// Typical Second Query:
// SecondQuery { 'select Description,ItemValue from ReportResult where PLU in ( 12345678,2345678 )' }

// DummyReport {
//    Alias { 'PSL' }  // default is PSL                                   
//    TableName { 'ReportResult' } // default is ReportResult
//    FirstQuery { 'select * from txnlog where (RecType = ''TxnLine'' or RecType = ''TxnTotal'')' } // default takes username office workstation periods into account
//    SecondQuery { 'select Description,ItemValue from ReportResult where PLU in (123456,234567 )' } // default uses Column names and PLURanges
//    FitWidth // Fit to paper (no need to define Widths for each column)
//    ColumnLines // place a line between each column
//    RowLines // place a line between each Row
//    Landscape // rotate the paper
//    Title    { 'Dummy Report' } // appears at top of report
//    PLURange { 12345678,2345678 } // main product PLUs
//    Columns {
//       Description {  // Column Name
//          Heading { 'The Description' } // Column Heading
//          Justify { Left } // Column Justification Left Right Centre - default is Left
//          Width   { 4000 } // Column Width in 100th mm i.e. 1000 = 1cm
//       }
//       ItemPrice {
//          Heading { 'Item Price' }
//          Justify { Right }
//          Width   { 4000 }
//          Currency  // format as money
//          Total // Total up this column at the end of the report
//       }
//    }
// }

Reports {
   WeeklyProdSum {
      FitWidth
      Landscape
      ColumnLines
      RowLines
      HeaderCallBack { WeeklyProdSum,3000 }
      Title { 'Sales Summary - Weekly' }
      DataExtractor { 'SalesSum.WeekByProd' }
      UseRanges {
         SavingBankDeposit        ,BSBLostBookFees              ,CustomsHandlingCharges  ,
         CustomsDutyFeesBotswana  ,CustomsDutyFeesSouthAfrica   ,CODTradeCharges         ,
         CODHandlingCharges       ,EMSReceiptsIndividual        ,EMSReceiptsContract     ,
         EMSContractAccountPayment,POBagReceipts                ,POBoxReceipts           ,
         BulkPosting              ,NationalSavingCertificates   ,GroupFuneralBLI         ,
         IpolokengBLI             ,RIPC                         ,RegistrationofNewspapers,
         MoneyOrderInlandIssued   ,MoneyOrderForeignIssued      ,MoneyOrderCommission    ,
         MoneyOrderOtherCharges   ,MoneyOrderTransmissionCharges,PostalOrderCommission   ,
         UnaddressedLeaflets      ,CustomerFax                  ,BusinessReply           ,
         FrankingMachine          ,WaterAffairs                 ,WaterUtilities          ,
         HousingCorporation       ,ElectricityDOE               ,ElectricityBPC          ,
         BotswanaTelecom          ,MiscellaneousReceipts        ,ImprestandTravelReceipts,
         WesternUnion             ,PostageLabels
         Line
         StampsItems              ,RetailItems                  ,BWCourier               ,
         Merchandise              ,PostalOrders                 ,PhilFirstDayCovers      ,
         PhilSouvenirSheets       ,PhilYearPacks                ,PhilOtheritems          ,
         Line
         MoneyOrderInlandPaid     ,MoneyOrderForeignPaid        ,MoneyOrderBulkPaid      ,
         MoneyOrderInlandRefund   ,PostOrdPaidInland            ,PostOrdPaidUK           ,
         PostOrdPaidOtherForeign  ,PostOrdPaidBulk              ,SavingsBankWithdrawals  ,
         NationalSavingsCertsPaid ,Refunds                      ,PensionsPaidRSA         ,
         OldAgePensionBotswana    ,DiscountToVendors            ,MiscellaneousPayments   ,
         WesternUnion             ,Imprestandtravelclaims       ,SalariesPP              ,
         WagesIndustrialClass     ,TemporaryStaff               ,DeathClaim              ,
         Humana                   ,
         Line
         Other
      }
      Columns  {
         Description { Width { 4600 } }
         MonVal      { Width { 1500 } Total Justify { Right } BlankZeros Round }
         MonQty      { Width { 1200 } Total Justify { Right } BlankZeros       }
         TueVal      { Width { 1500 } Total Justify { Right } BlankZeros Round }
         TueQty      { Width { 1200 } Total Justify { Right } BlankZeros       }
         WedVal      { Width { 1500 } Total Justify { Right } BlankZeros Round }
         WedQty      { Width { 1200 } Total Justify { Right } BlankZeros       }
         ThuVal      { Width { 1500 } Total Justify { Right } BlankZeros Round }
         ThuQty      { Width { 1200 } Total Justify { Right } BlankZeros       }
         FriVal      { Width { 1500 } Total Justify { Right } BlankZeros Round }
         FriQty      { Width { 1200 } Total Justify { Right } BlankZeros       }
         SatVal      { Width { 1500 } Total Justify { Right } BlankZeros Round }
         SatQty      { Width { 1200 } Total Justify { Right } BlankZeros       }
         TotVal      { Width { 1600 } Total Justify { Right } BlankZeros Round }
         TotQty      { Width { 1300 } Total Justify { Right } BlankZeros       }
      }
   }

   MonthlyProdSum {
      FitWidth
      Landscape
      ColumnLines
      RowLines
      HeaderCallBack { MonthlyProdSum,3000 }
      Title { 'Sales Summary - Monthly' }
      DataExtractor { 'SalesSum.MonthByProd' }
      UseRanges {
         SavingBankDeposit        ,BSBLostBookFees              ,CustomsHandlingCharges  ,
         CustomsDutyFeesBotswana  ,CustomsDutyFeesSouthAfrica   ,CODTradeCharges         ,
         CODHandlingCharges       ,EMSReceiptsIndividual        ,EMSReceiptsContract     ,
         EMSContractAccountPayment,POBagReceipts                ,POBoxReceipts           ,
         BulkPosting              ,NationalSavingCertificates   ,GroupFuneralBLI         ,
         IpolokengBLI             ,RIPC                         ,RegistrationofNewspapers,
         MoneyOrderInlandIssued   ,MoneyOrderForeignIssued      ,MoneyOrderCommission    ,
         MoneyOrderOtherCharges   ,MoneyOrderTransmissionCharges,PostalOrderCommission   ,
         UnaddressedLeaflets      ,CustomerFax                  ,BusinessReply           ,
         FrankingMachine          ,WaterAffairs                 ,WaterUtilities          ,
         HousingCorporation       ,ElectricityDOE               ,ElectricityBPC          ,
         BotswanaTelecom          ,MiscellaneousReceipts        ,ImprestandTravelReceipts,
         WesternUnion             ,PostageLabels
         Line
         StampsItems              ,RetailItems                  ,BWCourier               ,
         Merchandise              ,PostalOrders                 ,PhilFirstDayCovers      ,
         PhilSouvenirSheets       ,PhilYearPacks                ,PhilOtheritems          ,
         Line
         MoneyOrderInlandPaid     ,MoneyOrderForeignPaid        ,MoneyOrderBulkPaid      ,
         MoneyOrderInlandRefund   ,PostOrdPaidInland            ,PostOrdPaidUK           ,
         PostOrdPaidOtherForeign  ,PostOrdPaidBulk              ,SavingsBankWithdrawals  ,
         NationalSavingsCertsPaid ,Refunds                      ,PensionsPaidRSA         ,
         OldAgePensionBotswana    ,DiscountToVendors            ,MiscellaneousPayments   ,
         WesternUnion             ,Imprestandtravelclaims       ,SalariesPP              ,
         WagesIndustrialClass     ,TemporaryStaff               ,DeathClaim              ,
         Humana                   ,
         Line
         Other
      }
      Columns  {
         Description { Width { 4600 } }
         W1Val       { Width { 1500 } Total Justify { Right } BlankZeros Round }
         W1Qty       { Width { 1200 } Total Justify { Right } BlankZeros       }
         W2Val       { Width { 1500 } Total Justify { Right } BlankZeros Round }
         W2Qty       { Width { 1200 } Total Justify { Right } BlankZeros       }
         W3Val       { Width { 1500 } Total Justify { Right } BlankZeros Round }
         W3Qty       { Width { 1200 } Total Justify { Right } BlankZeros       }
         W4Val       { Width { 1500 } Total Justify { Right } BlankZeros Round }
         W4Qty       { Width { 1200 } Total Justify { Right } BlankZeros       }
         W5Val       { Width { 1500 } Total Justify { Right } BlankZeros Round }
         W5Qty       { Width { 1200 } Total Justify { Right } BlankZeros       }
         W6Val       { Width { 1500 } Total Justify { Right } BlankZeros Round }
         W6Qty       { Width { 1200 } Total Justify { Right } BlankZeros       }
         TotVal      { Width { 1600 } Total Justify { Right } BlankZeros Round }
         TotQty      { Width { 1300 } Total Justify { Right } BlankZeros       }
      }
   }
   DailySavingsDepSum {
      FitWidth
      ColumnLines
      RowLines
      Header { 'HeadFoot.Standard' }
      Title { 'Savings Bank Breakdown' }
      DataExtractor { 'SalesSum.DayByProd' }
      UseRanges {
         SavingBank1
         SavingBank2
         SavingBank3
         SavingBank4
         SavingBank5
         SavingBank6
         SavingBank7
         SavingBank8
      }
      Columns  {
         Description { Heading { 'Description' }  }
         Value       { Heading { 'Value' }      Total Justify { Right } BlankZeros  Currency }
         Quantity    { Heading { 'Quantity' }   Total Justify { Right } BlankZeros           }
      }
   }


   DailyProdSum {
      FitWidth
      ColumnLines
      RowLines
      Header { 'HeadFoot.Standard' }
      Title { 'Sales Summary - Daily' }
      DataExtractor { 'SalesSum.DayByProd' }
      UseRanges {
         SavingBankDeposit        ,BSBLostBookFees              ,CustomsHandlingCharges  ,
         CustomsDutyFeesBotswana  ,CustomsDutyFeesSouthAfrica   ,CODTradeCharges         ,
         CODHandlingCharges       ,EMSReceiptsIndividual        ,EMSReceiptsContract     ,
         EMSContractAccountPayment,POBagReceipts                ,POBoxReceipts           ,
         BulkPosting              ,NationalSavingCertificates   ,GroupFuneralBLI         ,
         IpolokengBLI             ,RIPC                         ,RegistrationofNewspapers,
         MoneyOrderInlandIssued   ,MoneyOrderForeignIssued      ,MoneyOrderCommission    ,
         MoneyOrderOtherCharges   ,MoneyOrderTransmissionCharges,PostalOrderCommission   ,
         UnaddressedLeaflets      ,CustomerFax                  ,BusinessReply           ,
         FrankingMachine          ,WaterAffairs                 ,WaterUtilities          ,
         HousingCorporation       ,ElectricityDOE               ,ElectricityBPC          ,
         BotswanaTelecom          ,MiscellaneousReceipts        ,ImprestandTravelReceipts,
         WesternUnion             ,PostageLabels
         Line
         StampsItems              ,RetailItems                  ,BWCourier               ,
         Merchandise              ,PostalOrders                 ,PhilFirstDayCovers      ,
         PhilSouvenirSheets       ,PhilYearPacks                ,PhilOtheritems          ,
         Line
         MoneyOrderInlandPaid     ,MoneyOrderForeignPaid        ,MoneyOrderBulkPaid      ,
         MoneyOrderInlandRefund   ,PostOrdPaidInland            ,PostOrdPaidUK           ,
         PostOrdPaidOtherForeign  ,PostOrdPaidBulk              ,SavingsBankWithdrawals  ,
         NationalSavingsCertsPaid ,Refunds                      ,PensionsPaidRSA         ,
         OldAgePensionBotswana    ,DiscountToVendors            ,MiscellaneousPayments   ,
         WesternUnion             ,Imprestandtravelclaims       ,SalariesPP              ,
         WagesIndustrialClass     ,TemporaryStaff               ,DeathClaim              ,
         Humana                   ,
         Line
         Other
      }
      Columns  {
         Description { Heading { 'Description' }  }
         Value       { Heading { 'Value' }      Total Justify { Right } BlankZeros  Currency }
         Quantity    { Heading { 'Quantity' }   Total Justify { Right } BlankZeros           }
      }
   }

  CashAccountAdjustments {
    FitWidth
    ColumnLines
    RowLines
    Title       { 'Cash Account Adjustments' }
    FirstQuery  { 'select * from txnlog where (RecType = ''CashAccAdj'') and :TellerCondition: and :OfficeCondition:'  }
    SecondQuery { 'select OfficeCode,Person,DateDet,CashAccountLine,AdjustmentAmount,AdjustmentType from ReportResult' }
    Columns  {
      OfficeCode       { Width { 1000 } Heading { 'Office Code'       } }
      Person           { Width { 2000 } Heading { 'Person'            } }
      DateDet          { Width { 2000 } Heading { 'Date'              } }
      CashAccountLine  { Width { 5000 } Heading { 'Cash Account Line' } }
      AdjustmentAmount { Width { 3500 } Heading { 'Adjustment Amount' } Currency Justify { Right } }
      AdjustmentType   { Width { 3000 } Heading { 'Adjustment Type'   } Justify { Centre } }
    }
  }

  PrintedLabels {
    FitWidth
    Title { 'Printed Labels' }
    FirstQuery {
      ' select * from txnlog '
      ' where rectype="PrLabel"'
      ' and :TellerCondition: and :OfficeCondition: '
      ' and (                                          '
      '       ( plu BETWEEN 020000000 AND 059999999)   '
      '    or ( plu IN (070000100,070000110) )         '
      '    or ( plu BETWEEN 091000000 AND 091000300)   '
      '     )                                          '
      ' order by datetime'
    }
    SecondQuery {
      ' select teller, description, sum(itemquantity) as discrepancy, itemvalue, plu, guid from ReportResult '
      ' where transactiontype=''PrLabel'''
      ' group by plu, teller, guid, description, itemvalue'
      ' having sum(itemquantity) <> 0 '
      ' order by plu'
    }
    Columns {
      Teller      { Heading { 'User' } }
      Description { Heading { 'Description' } Width { 6000 }  }
      Discrepancy { Heading { 'Discrepancy' }  }
      ItemValue   { Heading { 'Value' }  Currency Total }
    }
  }

//-------------------------------- Cheque Payment ------------------------------
   PCheque {
      FitWidth
      Title    { 'Cheque Payment' }
      PLURange { 6100000 }
      Columns  {
         AccountNumber             { Heading { 'Account Number' } }
         ChequeNumber              { Heading { 'Cheque Number' } }
         AmountPaid                { Heading { 'Amount Paid' } Justify { Right } Total}
      }
   }
//--------------------------- Franking Machine Refill --------------------------
   PFrankingMachine {
      Landscape
      Title    { 'Franking Machine Refill' }
      RowLines
      ColumnLines
      PLURange { 050031004 }
      FitWidth
      Columns  {
     	   LineNumber                { Heading { 'No.'              } LineNumber }
     	   DateTime                  { Heading { 'Date         Time'} }
         CustomerName              { Width { 5000 } Heading { 'Customer Name' } }
         FrankingMachineLicenceNo  { Heading { 'Licence No' } Text Justify { Right } }
         AmountPaid                { Heading { 'Amount Paid' } Currency Justify { Right } Total }
      }
   }
//-----------------------Customer Voucher-------------------------------------
   PCustomerVoucher {
      FitWidth
      Title    { 'Customer Voucher' }
      PLURange { 050031006 }
      Columns  {
         AmountPaid                { Heading { 'Amount Paid' } Justify { Right } }
         CustomerName              { Heading { 'Customer Name' } }
         VoucherNumber             { Heading { 'Voucher Number' } }
         ReasonForRefund           { Heading { 'Reason For Refund' } }
      }
   }
//--------------News Paper Registration  -------------------------------------
 PRegOfNewsPapers { Title    { 'Registration of Newspapers' }
                    FitWidth
                    PLURange { 050031009 }
                    Columns  { NewspaperName      { Heading { 'Newspaper Name' } }
                               RegistrationAmount { Heading { 'Registration Amount' } Justify {Right} Total }
                              }
                   }
//----------------------------- Unaddressed Leaflets ---------------------------
   PAccUnaddrAdvtLeaflets {
     Title    { 'Unaddressed Leaflets' }
     FitWidth
     PLURange { 050031010 }
     Columns  { CompanyName       { Heading { 'Company Name'       }                         }
               LeafletCost       { Heading { 'Leaflet Cost'       } Justify { Right }       }
               NumberOfLeaflets  { Heading { 'Number Of Leaflets' } Justify { Right } Total }
               TotalAmountToPay  { Heading { 'Total'              } Justify { Right } Total }
              }
  }
//-------------------Business Reply-------------------------------------
   PBusinessReply {
      FitWidth
      Title    { 'Business Reply' }
      PLURange { 050031012 }
      Columns  { CompanyName       { Heading { 'Company Name'    } }
                 LetterSize        { Heading { 'Letter Size'     } }
                 LetterCost        { Heading { 'Letter Cost'     } Justify { Right } }
                 NumberOfReplies   { Heading { 'No. Of Replies'  } Justify { Right } Total }
                 TotalAmountToPay  { Heading { 'Amount Paid'     } Justify { Right } Total }
                }
   }

//--------------------------------- Customer Fax -------------------------------
// This report covers both domestic and international
   PCustomerFax {
      FitWidth
      Title    { 'Customer Fax' }
      PLURange { 050031011 }
      Columns  { FaxDestination    { Heading { 'Destination'  }                         }
                 PageCost          { Heading { 'Cost / Page'  } Justify { Right }       }
                 NumberOfPages     { Heading { 'No. Of Pages' } Justify { Right } Total }
                 TotalAmountToPay  { Heading { 'Total Paid'   } Justify { Right } Total }
                }
   }
//---------------------------- Miscellaneous Receipt ---------------------------
   PMiscReceipt {
      FitWidth
      Title    { 'Miscellaneous Receipt' }
      PLURange { 050032001 }
      Columns  { ReasonForReceipt  { Heading { 'Reason For Receipt' }                         }
                 Amount            { Heading { 'Amount'             } Justify { Right } Total }
                }
   }
//---------------------------- Miscellaneous Payment ---------------------------
   PMiscPayment {
      FitWidth
      Title    { 'Miscellaneous Payment' }
      PLURange { 050032002 }
      Columns  { ReasonForPayment  { Heading { 'Reason For Payment' }                         }
                 Amount            { Heading { 'Amount'             } Justify { Right } Total }
                }
   }
//-------------------------- Imprest and travel Claims -------------------------
   PClaims {
