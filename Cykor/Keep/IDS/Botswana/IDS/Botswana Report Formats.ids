//--------------------------- Private Box Annual Rent --------------------------
   PPrivBoxAnnualRent {
      FitWidth
      Title    { 'PO Box - Annual Rent' }
      PLURange { 030000015 }
      Columns  { Location                  { Heading { 'Location'         }                         }
                 PrivateBoxNumber          { Heading { 'Box No.'       }                         }
                 CustomerName              { Heading { 'Customer Name'    }                         }
                 PaymentPeriod             { Heading { 'Payment Period'   }                         }
                 Years                     { Heading { 'Years'            } Justify { Right }       }
                 AnnualRentalFee           { Heading { 'Annual Rent'    } Justify { Right }       }
                 GrossFee                  { Heading { 'Total'         } Justify { Right } Total Currency }
                 Feeforlatepaymentofrental { Heading { 'Late pay fee' } Justify { Right } Total Currency }
                }
   }
//------------------------- Private Box - Quarterly Rent -----------------------
   PPBQuarterRent {
      FitWidth
      Title    { 'PO Box - Quarterly Rent' }
      PLURange { 030000016 }
      Columns  { Location                  {  Heading { 'Location'      }                         }
                 PrivateBoxNumber          {  Heading { 'Box No.'       }                         }
                 CustomerName              {  Heading { 'Customer Name' }                         }
                 Quarter                   {  Heading { 'Quarter'       }                         }
                 StandardFee               {  Heading { 'Standard Fee'  } Justify { Right } Total }
                 Feeforlatepaymentofrental {  Heading { 'Late fee'      } Justify { Right } Total }
                }
   }
