Products {
   BaseBanking {
      DontBuild
      SubGroup { 'Banking' }
   }

   BaseBankDep {
      DontBuild
      BasedOn { BaseBanking }
      BitMap {  '..\IMAGES\P_Deposit.bmp' }
      Domains {
         AccountName
         AccountNumber
         OpeningBalance
         Amount
         FinalBalance
      }
      Items {
         'Complete'
      }
      //Customer { 'Amount','P',Amount }
      Snippets { CalcBankDep,BankDepositLog,AccountNumberVars,AccountNumberPostVal }
   //   LogAs { BankDeposit }

   }


   BaseBankWith {
      DontBuild
      BasedOn { BaseBanking }
      BitMap {  '..\IMAGES\P_Withdraw.bmp' }
      Domains {
         AccountName
         AccountNumber
         CustomerIdentification
         OpeningBalance
         Amount
         Warrant
         FinalBalance
      }
      Items {
         'Complete'
      }
     Snippets { CalcBankWith, LogBankWith,AccountNumberVars,AccountNumberPostVal  }
   }

   BaseBankOpen {
      DontBuild
      BasedOn { BaseBanking }
      BitMap { '..\images\P_OpenAccount.bmp' }
 		Domains {
         AccountName
         AccountNumber
         CustomerIdentification
         Amount
		}
      Snippets{ CalcBankOpen,AccountNumberVars,AccountNumberPostVal,LogBankOpen }
      //LogAs { BankOpen }
      //PLU { PLU_SavingsAccountOpen }
	}


	BaseBankClose {
      DontBuild
      BasedOn { BaseBanking }
      BitMap { '..\images\P_CloseAccount.bmp' }
 		Domains {
	      AccountName
         AccountNumber
         CustomerIdentification
         Warrant
         FinalInputBalance
      }
      Snippets { CalcBankClose,AccountNumberVars,AccountNumberPostVal,LogBankClose }
      //PLU { PLU_SavingsAccountClose }
   }


//
// -----------------------------------------------------------------------------
//             ORDINARY
// -----------------------------------------------------------------------------
//

   BankOrdDep {
      Caption      { 'BSB - Ordinary A/C Deposit' }
      Description  { 'BSB - Ordinary A/C Deposit' }
      Title        { 'BSB - Ordinary A/C Deposit' }
      BasedOn{ BaseBankDep }
      Snippets { BankOrdDep }
      PLU      { PLU_BankOrdDep }

   }
   BankOrdWith {
      Caption      { 'BSB - Ordinary A/C Withdraw' }
      Description  { 'BSB - Ordinary A/C Withdraw' }
      Title        { 'BSB - Ordinary A/C Withdraw' }
      BasedOn{ BaseBankWith }
      Snippets{ BaseOrdWith, ExecuteBankWith }
      PLU     { PLU_BankOrdWith }
   }
   BankOrdOpen {
      Caption      { 'Open New Ordinary Account' }
      Description  { 'Open New Ordinary Account' }
      Title        { 'Open New Ordinary Account' }
      BasedOn{ BaseBankOpen }
      Snippets { BankOrdOpen }
      PLU  { PLU_BankOrdOpen }
   }
   BankOrdClose {
      Caption      { 'Close Ordinary Account' }
      Description  { 'Close Ordinary Account' }
      Title        { 'Close Ordinary Account' }
      BasedOn{ BaseBankClose }
      Snippets     { BankClose }
      PLU  { PLU_BankOrdClose }
   }

//
// -----------------------------------------------------------------------------
//            TRUST
// -----------------------------------------------------------------------------
//

   BankTrsDep {
      Caption      { 'BSB - Trust A/C Deposit' }
      Description  { 'BSB - Trust A/C Deposit' }
      Title        { 'BSB - Trust A/C Deposit' }
      BasedOn{ BaseBankDep }
      Snippets { BankOrdDep }
      PLU      { PLU_BankTrsDep }
   }
   BankTrsWith {
      Caption      { 'BSB - Trust A/C Withdraw' }
      Description  { 'BSB - Trust A/C Withdraw' }
      Title        { 'BSB - Trust A/C Withdraw' }
      BasedOn{ BaseBankWith }
      Snippets { BaseTrstWith }
      PLU      { PLU_BankTrsWith }
   }
   BankTrsOpen {
      Caption      { 'Open New Trust Account' }
      Description  { 'Open New Trust Account' }
      Title        { 'Open New Trust Account' }
      BasedOn{ BaseBankOpen }
      Snippets { BankOrdOpen }
      PLU  { PLU_BankTrsOpen }
   }
   BankTrsClose {
      Caption      { 'Close Trust Account' }
      Description  { 'Close Trust Account' }
      Title        { 'Close Trust Account' }
      BasedOn{ BaseBankClose }
      Snippets     { BankClose }
      PLU  { PLU_BankTrsClose }
   }

//
// -----------------------------------------------------------------------------
//            SPECIAL
