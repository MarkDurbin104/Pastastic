   LogLostBankBook {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
           TxnLog.LogTransaction ( Index,
                                   0, // Quantity
                                   Get_PLU, // PLU
