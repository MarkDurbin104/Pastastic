//
// -----------------------------------------------------------------------------
//            SAVE AS YOU EARN
// -----------------------------------------------------------------------------
//

   BankSAYEDep {
      BasedOn      { BaseBanking }
      Caption      { 'BSB - SAYE Deposit' }
      Description  { 'BSB - SAYE Deposit' }
      Title        { 'BSB - SAYE Deposit' }
      BitMap       {  '..\IMAGES\P_Deposit.bmp' }
      Domains      {  AccountName
                      AccountNumber
                      Amount
                     }
      Items        { 'Complete'      }
      //Customer     { 'Amount P',Amount}
      Snippets     { CalcBankDepSAYE,BankDepositLogSAYE,AccountNumberVars,AccountNumberPostVal }
      Snippets     { BankSAYEDDep }
      PLU          { PLU_BankSAYEDep }
   }


AcceptBankBook {
      BasedOn { BaseBanking }
      Caption      { 'BSB - Accept Bank Book' }
      Description  { 'BSB - Accept Bank Book' }
      Title        { 'BSB - Accept Bank Book' }
      BitMap       {  '..\IMAGES\P_Withdraw.bmp' }
      Domains      { AccountName
                     AccountNumber
                     CustomerIdentification
                    }
      Snippets     { CalcBankBookAccept
                     AccountNumberVars
                     AccountNumberPostVal
                     LogBankBookAccept
                    }
      //PLU { PLU_SavingsAccountClose }
   }

LostBankBook {
      BasedOn { BaseBanking }
      Caption      { 'BSB - Lost Bank Book' }
      Description  { 'BSB - Lost Bank Book' }
      Title        { 'BSB - Lost Bank Book' }
      BitMap       {  '..\IMAGES\P_Withdraw.bmp' }
      Domains      { AccountName
                     AccountNumber
                     CustomerIdentification
                     BankAccType
                     BSBLostBookFee
                    }
      Snippets     { CalcLostBankBook
                     AccountNumberVars
                     AccountNumberPostVal
                     LogLostBankBook
                    }
      PLU          { PLU_BSBLostBook }
   }

