//

   BankSpcDep {
      Caption      { 'BSB - Special A/C Deposit' }
      Description  { 'BSB - Special A/C Deposit' }
      Title        { 'BSB - Special A/C Deposit' }
      BasedOn{ BaseBankDep }
      Snippets { BankOrdDep }
      PLU      { PLU_BankSpcDep }
   }
   BankSpcWith {
      Caption      { 'BSB - Special A/C Withdraw' }
      Description  { 'BSB - Special A/C Withdraw' }
      Title        { 'BSB - Special A/C Withdraw' }
