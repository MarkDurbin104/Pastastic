  CashRecDef {
    InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
    CodeBlock {
    [*
      procedure {PClass}TCashRecProduct.TriggerBarCode(Value:String);
      begin
        ProdForm.BankList.Ignore            := True;
        ProdForm.CashList.Ignore            := False;
        ProdForm.BankList.ItemIndex         := ProdForm.BankList.Items.IndexOf(Value);
        FlagComplete(ProdForm.Validate);
        FUIEventSink.DataChanged(Self,ProdForm.CashList.LineEditData,False);
      end;
    *]
    }
  }

  CashRecGetExecData {
    InsertBetween { '{ListGetDataStart}','{ListGetDataEnd}' }
