   }
   OverDelListDef {
      InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
      CodeBlock {
      [*
         procedure {PClass}TDeleteStockItemProduct.TriggerBarCode(Value:String);
         begin
            if Copy(Value,Length(Value)-9,10) =' <- DELETE' then
            begin
               ProdForm.DeleteList.Items[ProdForm.DeleteList.Items.IndexOf(Value)]:=Copy(Value,1,Length(Value)-10);
            end
            else
            begin
               ProdForm.DeleteList.Items[ProdForm.DeleteList.Items.IndexOf(Value)]:=Value+' <- DELETE';
            end;
            FlagComplete(ProdForm.Validate);
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
         end;
      *]
      }
   }
   DelListValidate {
      InsertBetween { '{ValidateStart}','{ValidateEnd}' }
