      *]
      }
   }

   OverAddModListDef {
      InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
      CodeBlock {
      [*
         procedure {PClass}TAddModStockItemProduct.TriggerBarCode(Value:String);
         var
            SL:TStringList;
         begin
            ProdForm.AddModStockList.Ignore:=True;
            ProdForm.StockDescription.Ignore:=False;
            ProdForm.StockPrice.Ignore      :=False;
            SL:=TStringList.Create;
            ProdForm.AddModStockList.ItemIndex:=ProdForm.AddModStockList.Items.IndexOf(Value);
            ProdForm.StockDescription.Text:=Value;
            // 0=Description 1=Price 2=Group 3=AccountID 4=Agency 5=ReportLine 6=PLU 7=ProgID
            SL.CommaText:=GetStockItemDetails(Value);
            AdditionalInfo:=SL.CommaText;
            if SL.Count > 1 then
            begin
               ProdForm.StockPrice.Text:=SL[1];
            end;
            SL.Free;
            FlagComplete(ProdForm.Validate);
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
         end;
      *]
      }
   }

   AddModListComplete {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
          SL:=TStringList.Create;
          SL.CommaText:=AdditionalInfo;
          // 0=Description 1=Price 2=Group 3=AccountID 4=Agency 5=ReportLine 6=PLU 7=ProgID
          AddStockItem(TxnLog,ProdForm.StockDescription.Text,SL[2],SL[3],SL[4],SL[5],SL[7],StrToIntDef(SL[6],0),StrToCurrDef(ProdForm.StockPrice.Text,0));

          SL.Free;
      *]
      }
   }

