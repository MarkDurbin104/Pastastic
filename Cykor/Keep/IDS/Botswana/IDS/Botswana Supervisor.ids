   FillDelList {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         if UIEventSink <> nil then
         begin
            if not GetAvailableStock(ProdForm.DeleteList,UIEventSink.User,'!CashAcc,Set') then
            begin
               ProdForm.DeleteList.Clear;
               ProdForm.DeleteList.Text:='No Stock Available';
            end
            else
            begin
               SL:=TPackStringList.Create;
               for I:=0 to ProdForm.DeleteList.Items.Count-1 do
               begin
                  SL.PackText:=ProdForm.DeleteList.Items[I];
                  if SL.Count > 9 then
                     ProdForm.DeleteList.Items[I]:=SL[9]; // original description
               end;
               SL.Free;
            end;
         end;
      *]
      }
   }

