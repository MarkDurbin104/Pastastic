//------------------------------------------------------------------------------
// Snippets
//------------------------------------------------------------------------------

Snippets {

  CashAccAdjEXECVAR {
    InsertBetween { '{ExecuteVarStart}','{ExecuteVarEnd}' }
    CodeBlock {
    [*
      var
        StockItemIndex : Integer;
    *]
    }
  }

  CashAccAdjISLIST {
    InsertBetween { '{IsListStart}','{IsListEnd}' }
    CodeBlock {
    [*
      try
        //Office number
        ProdForm.CashAccAdjOffice.Text := GetGPCSRegString('OfficeInfo', 'Office ID','0');

        //fill user list
        if UIEventSink <> nil then
        begin
          ProdForm.CashAccAdjPerson.Items.CommaText:=UIEventSink.ReferenceData('Users');
          if ProdForm.CashAccAdjPerson.Items.IndexOf('Supervisor') = -1 then
            ProdForm.CashAccAdjPerson.Items.Add('Supervisor');
        end ;


        //fill picklist with cash acc lines and plus
        ReportParams.Stock:=CreateStock;
        With TStringList.Create do
        begin
          try
            ProdForm.CashAccAdjList.Items.CommaText := ReportParams.Stock.ListAllStock('Supervisor','CashAcc');
            StockItemIndex := 0;
            While StockItemIndex <= ProdForm.CashAccAdjList.Items.Count -1 do
            begin
              CommaText := ProdForm.CashAccAdjList.Items[StockItemIndex]; //grab the stock line
              ProdForm.CashAccAdjList.Items.InsertObject(StockItemIndex,Strings[0], TObject(StrToIntDef(Strings[3],0)));
              ProdForm.CashAccAdjList.Items.Delete(StockItemIndex+1);
              Inc(StockItemIndex);
            end;
          finally
            Free;
            ReportParams.Stock:=nil;
          end;
        end;
      except
        On E : Exception do RaiseGUIDException('{D274DE64-E726-4087-9625-85F956528BEB}', E);  // Error in Stock
      end;
    *]
    }
  }

  CashAccAdjVAL {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      Result:=CheckMaskEdits(Self);
      If Result and (StrToCurrDef(CashAccAdjAmount.Text,0) = 0) then
      begin
        Result := False;
        MoveFocusTo(CashAccAdjAmount);
      end;
    *]
    }
  }

  CashAccAdjLOG {
    InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
    CodeBlock {
    [*
      If ProdForm.CashAccAdjType.Text = 'Decrease' then
        ProdForm.CashAccAdjAmount.Text := '-' + ProdForm.CashAccAdjAmount.Text;
      TxnLog.WriteFullTransaction(
          StrToIntDef(GetGPCSRegString('Workstation','Ident','0'),0),//wsnumber
          DateTimeToPeriod(StrToDateTime(ProdForm.CashAccAdjDate.text)),
          Index, //recindex
          StrToInt(ProdForm.CashAccAdjOffice.Text), //Office
          'CashAccAdj',
          ProdForm.CashAccAdjPerson.Text,
          1,
          Integer(ProdForm.CashAccAdjList.Items.Objects[ProdForm.CashAccAdjList.ItemIndex]),    //PLU of cash account line to be adjusted
          StrToCurrDef(ProdForm.CashAccAdjAmount.Text,0),
          StrToCurrDef(ProdForm.CashAccAdjAmount.Text,0),
          Get_Description,
          '',
          Get_ProgramId,
          '',
          Enumerate(ProdForm));
      Inc(Index);
    *]
    }
  }

  ViewStockPostVarExecute {
    InsertBetween { '{ExecuteVarStart}','{ExecuteVarEnd}' }
    CodeBlock {
    [*
     var
        TempList: TPackStringList;
        I:integer;
    *]
    }
  }

  ViewStockPostExecute {
    InsertBetween { '{PostExecuteStart}','{PostExecuteEnd}' }
    CodeBlock {
    [*
                                                        // This line is in here instead of a separate snippet
                                                        // because this snippet already inserts code
      ProdForm.UserName.Items.Insert(0,'All');          // between PostExecuteStart and PostExecuteEnd
      ProdForm.UserName.Items.Insert(1,'Vendor');      // This snippet is only used with ViewStockCash
                                                        // Compare with ViewStockStamps etc.
      //delete cash breakdown and move cheques to second line
      TempList:=TPackStringList.Create;
      With ProdForm.StockList do
      begin
        if (Items.Count > 2) then
        begin
          I := 0 ;
          while I <= Items.Count-1 do
          begin
            TempList.PackText := Items[I];  //grab the stock item
            //delete cash breakdown lines
            if LeftOf(TempList[5],'Product.Cash') then
              Items.Delete( I )
            //move the cheque line
            else if (TempList[5]='Product.Cheque')  then
            begin
              if I = 1 then
                Inc( I ) // in case it is already in that position
              else
              begin
                Items.Move( I, 1  );  //move cheque to 2nd position
                I := Items.Count;     //force break
              end;
            end //if cheque
            else
              Inc( I );
          end;  //while more stock items
        end;  //if more than 2 stock items in list
      end;  //with stocklist
      TempList.Free;
    *]
    }
  }



  PaySalaryVal {
    InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
    CodeBlock {
    [*
      ClearFocus(self);
      CheckDomain(AmountPaid,StrToCurrDef( AmountPaid.Text, 0 ) > 0, Result);
    *]
    }
  }


    SetCashOrder {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         if UIEventSink <> nil then
         begin
            if not GetAvailableStock(ProdForm.TransCash,UIEventSink.User,'Cash,Transfer,<Supervisor') then
            begin
               ProdForm.TransCash.Clear;
               ProdForm.TransCash.Text:='No Stock Available';
            end;
         end;
         ProdForm.TransCash.AssociatedProgId:='<Supervisor';
      *]
      }
   }

   LogStockCash {
