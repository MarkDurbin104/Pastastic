   AcceptTranUserList {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         if UIEventSink <> nil then
         begin
            ProdForm.TransList.Ignore:=True;
            if not CheckTransfersAvail(ProdForm.ToUser,'Supervisor') then
            begin
               UIEventSink.Restore;
               Exit;
            end;
            I := 0;
            while I < ProdForm.ToUser.Items.Count do
            begin
                 //if ProdForm.ToUser.Items[ I ][ 13 ]= 'T' then
                 if Pos( 'Transfer', ProdForm.ToUser.Items[ I ] ) > 0 then
                    ProdForm.ToUser.Items.Delete( I )
                 else
                     Inc( I )
            end;
            if ProdForm.ToUser.Items.Count = 0 then
            begin
               UIEventSink.Restore;
               Exit;
            end;


         end;
      *]
      }
   }

