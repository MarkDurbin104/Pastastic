    [*
      if not ProdForm.CashList.Ignore then
        Result:=ProdForm.CashList.LineEditData
      else
        Result:=GetFormData(ProdForm);
    *]
    }
  }

  CashRecVAL {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      Result                    := (BankList.Text <> '');
      CashList.Ignore           := (BankList.Text = '');
      CashList.AssociatedProgID := 'Receive ' + BankList.Text;
    *]
    }
  }

  CashRecLOG {
    InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
    CodeBlock {
    [*
      ReferenceData('SET(RemittanceDest,' + ProdForm.BankList.Text + ')');
      LogStock(TxnLog,ProdForm.CashList);
      ReferenceData('SET(RemittanceDest,)');
      Inc(Index);
    *]
    }
  }

  CashDepVAL {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
