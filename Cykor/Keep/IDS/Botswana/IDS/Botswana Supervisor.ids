   TransferToVerdorsOverDef {
      InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
      CodeBlock {
      [*
         procedure {PClass}TTransferToVendorsProduct.TriggerBarCode(Value:String);
         begin
            ProdForm.ToVendorsList.Text:=Value;
            ProdForm.ToVendorsList.Ignore := True ;
            ProdForm.ToVendorStockList.Ignore:=False;
            //GetTransferDetails(ProdForm.ToVendorStockList,'Supervisor',ProdForm.ToVendorsList.Text );
            FlagComplete(ProdForm.Validate);
            FUIEventSink.DataChanged(Self,ProdForm.ToVendorStockList.LineEditData,False);
         end;
      *]
      }
   }

   TransferToVendorsExe {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         if UIEventSink <> nil then
         begin
            if not GetAvailableStock(ProdForm.ToVendorStockList,UIEventSink.User,'"Stamps,PostalOrd,Retail",Transfer') then
            begin
               ProdForm.ToVendorStockList.Clear;
               ProdForm.ToVendorStockList.Text:='No Stock Available';
            end;
         end;
         ProdForm.ToVendorStockList.Ignore:=True;
      *]
      }
   }

   TransferVenGetExecData {
      InsertBetween { '{ListGetDataStart}','{ListGetDataEnd}' }
      CodeBlock {
      [*
         if ProdForm.ToVendorsList.Text <> '' then
            Result:=ProdForm.ToVendorStockList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }

   TransferVenSetExecData {
      InsertBetween { '{ListSetDataStart}','{ListSetDataEnd}' }
      CodeBlock {
      [*
         if ProdForm.ToVendorsList.Text <> '' then
            ProdForm.ToVendorStockList.SetLineEditData(Value)
         else
            SetFormData(Value,ProdForm);
         ProdForm.CurrentLine:=FUIEventSink.CurrentLine;
         if not ProdForm.Validate then FlagError:=True;
         if ProdForm.ToVendorsList.Text <> '' then
            Result:=ProdForm.ToVendorStockList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }

   TransferVenToComplete {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         ProdForm.ToVendorStockList.AssociatedProgId := '*'+ PeriodToDateStr(GetCurrentPeriod) +
                                                             '  Request From '+'Vendor:'+ProdForm.ToVendorsList.Text ;
         LogStock(TxnLog,ProdForm.ToVendorStockList);
      *]
      }
   }

   TransferVenFromComplete {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         ProdForm.ToVendorStockList.AssociatedProgId := '*'+ PeriodToDateStr(GetCurrentPeriod) +
                                                             '  Transfer From '+'Vendor:'+ProdForm.ToVendorsList.Text ;
         LogStock(TxnLog,ProdForm.ToVendorStockList);
      *]
      }
   }



   TransferVenValid {
      InsertBetween { '{ValidateStart}','{ValidateEnd}' }
      CodeBlock {
      [*
         result := (ToVendorsList.Text <> '');
      *]
      }
   }


}

//------------------------------------------------------------------------------
// Domains
//------------------------------------------------------------------------------


Domains {

  CashAccAdjOffice {
    Title     { 'Office Code'           }
    Prompt    { 'Office Code'           }
    Hint      { 'Enter the Office Code' }
    Error     { 'Invalid Office Code'   }
    Format    {  None                   }
    InputFrom { 'Keyboard'              }
  }

  CashAccAdjPerson {
    Title         { 'Person'                }
    Prompt        { 'Person'                }
    Hint          { 'Select the Person'     }
    Error         { 'Invalid Person'        }
    Format        {  PickList { Users }     }
    DefaultValue  { 'Supervisor' }
  }

  CashAccAdjDate {
    Title         { 'Date'              }
    Prompt        { 'Enter Date'        }
    Hint          { 'Please enter date' }
    Error         { 'Invalid Date'      }
    Format        { Date                }
    DefaultValue  { 'Now'               }
  }

  CashAccAdjList {
    Title     { 'Cash Account Line' }
    Prompt    { 'Cash Account Line' }
    Hint      { 'Select the Cash Account Line'        }
    Error     { 'Select a Valid Cash Account Line'    }
    Format    {  PickList { 'PickList.CashAccAdj' }   }
    InputFrom { 'Keyboard' }
  }

  CashAccAdjAmount {
    Title         { 'Adjustment Amount' }
    Prompt        { 'Adjustment Amount' }
    Hint          { 'Enter the Adjustment Amount'        }
    Error         { 'Enter a Valid Adjustment Amount'    }
    Format        {  Currency { '-9999999,9999999' } }
    InputFrom     { 'Keyboard' }
    DefaultValue  { '0' }
  }

  CashAccAdjType {
    Title         { 'Adjustment Type' }
    Prompt        { 'Adjustment Type' }
    Hint          { 'Enter the Adjustment Type'        }
    Error         { 'Enter a Valid Adjustment Type'    }
    Format        { PickList  { 'PickList.CashAccAdjType' } }
    DefaultValue  { 'Increase' }
  }

   OfficeCode {
      Title  { 'Office Code' }
      Prompt { 'Office Code' }
      Hint   { 'Enter the Office Code' }
      Error  { 'Enter a Valid Office Code' }
      Format {
         Range { '0,9999' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   ToUser {
      Title { 'Destination Person' }
      Prompt { 'Transfer to' }
      Hint { 'Select the Destination Person' }
      Error { 'The Destination Person you have Selected is invalid' }
      Format {
         PickList { Users }
      }
   }

   DeleteList {
      Title { 'Delete Stock Item' }
      Prompt { 'Select Item to Permanently Delete' }
      Hint { 'Select Item to Permanently Delete^Warning This process is IRREVERSIBLE' }
      Error { 'Select Item to Permanently Delete' }
      Format {
         List { '!CashAcc' }
      }
   }

   AddModStockList {
      Title    { 'Add or Modify Stock Item' }
      Prompt   { 'Select Item to Add or Modify' }
      Hint     { 'Select Item to Add or Modify' }
      Error    { 'Select Item to Add or Modify' }
      Format {
         List { '!CashAcc' }
      }
   }

    StockDescription {
      Title { 'Stock Item Description' }
      Prompt { 'Description' }
      Hint { 'Enter the Stock Item Description' }
      Error { 'Invalid Stock Item Description' }
      Format {
         None
      }
      InputFrom {
         'Keyboard'
      }
   }

   StockPrice {
      Title { 'Stock Item Price' }
      Prompt { 'Price' }
      Hint { 'Enter the Stock Item Price' }
      Error { 'Invalid Stock Item Price' }
      Format {
         Currency { '0,999999' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   UserName{
      Title  { 'User Name' }
      Prompt { 'User Name' }
      Hint   { 'Select a User from the list' }
      Error  { 'This user has no stock requests outstanding' }
      Format {
         PickList  { '' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   NewPass {
      Title { 'New Password' }
      Prompt { 'New Password' }
      Hint { 'Enter your New Password' }
      Error { 'Invalid New Password' }
      Format {
         None
      }
      InputFrom {
         'Keyboard'
      }
