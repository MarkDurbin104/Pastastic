Products {

   BaseServices {
      DontBuild
      SubGroup { 'Services' }
   }

   BaseAdministration {
      DontBuild
      SubGroup { 'Administration' }
   }

  CashAccAdj {
    BasedOn       { BaseAdministration            }
    Caption       { 'Cash Account Adjustment'     }
    BitMap        { '..\IMAGES\P_CashAccAdj.bmp'  }
    Description   { 'Cash Account Adjustment'     }
    Title         { 'Cash Account Adjustment'     }
    Prompt        { 'Cash Account Adjustment'     }
    Hint          { 'Cash Account Adjustment'     }
    PLU           { PLU_CashAccAdj                }
    Domains       { CashAccAdjOffice
                    CashAccAdjPerson
                    CashAccAdjDate
                    CashAccAdjList
                    CashAccAdjAmount
                    CashAccAdjType}
    Items         { 'Complete'                    }
    Snippets      { CashAccAdjEXECVAR
                    CashAccAdjISLIST
                    CashAccAdjVAL
                    CashAccAdjLOG}
  }

