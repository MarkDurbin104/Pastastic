   }

  ViewStockDef {
    InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
    CodeBlock {
    [*
      procedure {PClass}TUserStockProduct.TriggerBarCode(Value:String);
      var
        TempList: TPackStringList;
        I:integer;
      begin
        ProdForm.UserName.Ignore:=True;
        ProdForm.StockList.Ignore:=False;
        ProdForm.UserName.ItemIndex:=ProdForm.UserName.Items.IndexOf(Value);
        GetAvailableStock(ProdForm.StockList,Value,ProdForm.Stocklist.AssociatedProgID);

        //delete cash breakdown and move cheques to second line
        TempList:=TPackStringList.Create;
        With ProdForm.StockList do
        begin
          I := 0 ;
          if (Items.Count > 2) then
          begin
            while I <= Items.Count-1 do
            begin
              TempList.PackText := Items[I];
              //delete cash breakdown lines
              if Copy( TempList[5],1, 12 ) = 'Product.Cash' then
                Items.Delete( I )
              //move the cheque line
              else if (TempList[5]='Product.Cheque')  then
              begin
                 if  (FUIEventSink.User <> 'Supervisor') 
                 and (UpperCase(Copy(GetGPCSRegString('','System Name',''),1,8)) = 'BOTSWANA')
                 and (GetGPCSRegString('','Show Cash Balance','N') <> 'Y') then 
                 begin
                    Items.Delete(I);
                 end
                 else 
                 begin
                    if I = 1 then
                       Inc( I ) // in case it is already in that position
                    else
                       Items.Move(I,1) ; 
                       // next line commented out because above check for Cash items
                       // I := Items.Count; // Once its found, it will finish.
                 end;
              end //if cheque
              else
                Inc( I );
            end;
          end; //if more than 2 stock items in list
          if  (FUIEventSink.User <> 'Supervisor') 
          and (UpperCase(Copy(GetGPCSRegString('','System Name',''),1,8)) = 'BOTSWANA')
          and (GetGPCSRegString('','Show Cash Balance','N') <> 'Y') then 
             Items.Delete(0);
        end;  //with stocklist
        TempList.Free;

        FlagComplete(ProdForm.Validate);
        FUIEventSink.DisplayItemInfo(Self,1,'',ResItem01,0,0,True,False);
        FUIEventSink.DataChanged(Self,ProdForm.StockList.LineEditData,False);
      end;
      *]
    }
  }

