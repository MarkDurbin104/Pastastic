   ViewStockSetData {
      InsertBetween { '{ListSetDataStart}','{ListSetDataEnd}' }
      CodeBlock {
      [*
         if not ProdForm.StockList.Ignore then
            ProdForm.StockList.SetLineEditData(Value)
         else
            SetFormData(Value,ProdForm);
         ProdForm.CurrentLine:=FUIEventSink.CurrentLine;
         if not ProdForm.Validate then FlagError:=True;
         if not ProdForm.StockList.Ignore then
            Result:=ProdForm.StockList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }

   ViewStockGetData {
      InsertBetween { '{ListGetDataStart}','{ListGetDataEnd}' }
      CodeBlock {
      [*
         if not ProdForm.StockList.Ignore then
            Result:=ProdForm.StockList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }

   ViewStockResItem {
      InsertBetween { '{ItemResStart}','{ItemResEnd}' }
      CodeBlock {
      [*
         riItemBase     : if ValidateOK then Result:=ResItem00 else Result:='';
         riItemBase+1   : if ProdForm.StockList.Ignore then Result:='' else Result:=ResItem01;
      *]
      }
   }

   ViewStockReport {
      InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*

         if Name = 'Report' then
         begin
            Res:=TPackStringList.Create;
            Res.Add('"Detailed Stock Report"');
            Res.Add('" "," "');
            SL :=TPackStringList.Create;
            Total:=0;
            for I:=0 to ProdForm.StockList.Items.Count-1 do
            begin
              // 0,Description 1,Input Quantity 2,Focused  3,Enabled 4,Price
              // 5,ProgID      6,StockQ         7,Declared 8,PLU
              // 9,Original Description
               SL.PackText:=ProdForm.StockList.Items[I];
               if Copy(SL[5],1,12) <> 'Product.Cash' then
               begin
                  if SL[0] = 'Cash On Hand' then
                  begin
                     Qty:=1;
                     Price:=StrToCurrDef(SL[1],0);
                  end
                  else
                  begin
                     Qty:=Trunc(StrToCurrDef(SL[1],0));
                     if Qty = 0 then Qty:=1;
                     Price:=StrToCurrDef(SL[4],0);
                     if Price = 0 then Price:=1;
                  end;
                  LineTot:=Price*Qty;
                  Total:=Total+LineTot;
//                  Res.Add('"'+LeftPad(IntToStr(Qty),5,' ')+' '+SL[0]+'","'+CurrToStrF(LineTot,ffNumber,2)+'"');
                  Res.Add('"'+SL[0]+'","'+LeftPad(IntToStr(Qty),5,' ')+'","'+CurrToStrF(LineTot,ffNumber,2)+'"');
//                  Res.Add('"+SL[0]+"
//                          ,"'+LeftPad(IntToStr(Qty),5,' ')'"
//                          ,"'+CurrToStrF(LineTot,ffNumber,2)+'"');
               end;
            end;
            Res.Add('" "," "');
            Res.Add('"Total Value","'+CurrToStrF(Total,ffNumber,2)+'"');
            if  (FUIEventSink.User = 'Supervisor') 
            or (UpperCase(Copy(GetGPCSRegString('','System Name',''),1,8)) <> 'BOTSWANA')
            or (GetGPCSRegString('','Show Cash Balance','N') = 'Y') then 
               PrintReportStandard('1000','-900,-350,-500',Res.CommaText);
            //PrintReport(Res);
            Res.Free;
            SL .Free;
            Exit;
         end;
      *]
      }
   }

