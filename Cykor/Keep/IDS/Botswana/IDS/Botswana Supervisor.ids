   DeleteTranLogVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
      [*
         var
            DeleteTranList:TDomainCombo;
            Value : String ;
            I : Integer ;
      *]
      }
   }

   DeleteTranComplete {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

	      DeleteTranList := TDomainCombo.Create( nil ) ;
         ProdForm.InsertControl(DeleteTranList);

         for I := 0 to ProdForm.CancelList.Items.Count -1 do
         begin

            Value := ProdForm.CancelList.Items[ I ];
            if Copy(Value,Length(Value)-9,10) =' <- CANCEL' then
            begin
               ProdForm.CancelList.Items[ I ]:=Copy(Value,1,Length(Value)-10);
               DeleteTranList.Items.Clear ;
               GetTransferDetails(DeleteTranList,UIEventSink.User,ProdForm.CancelList.Items[ I ]);
               DeleteTranList.AssociatedProgId:='*'+ProdForm.CancelList.Items[ I ];
               CancelTransfer( TxnLog,DeleteTranList );
            end;
         end;

         ProdForm.RemoveControl(DeleteTranList);
         DeleteTranList.Free ;


      *]
      }
   }
   FillAddModList {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         if UIEventSink <> nil then
         begin
            if not GetAvailableStock(ProdForm.AddModStockList,UIEventSink.User,'!CashAcc,Set') then
            begin
               ProdForm.AddModStockList.Clear;
               ProdForm.AddModStockList.Text:='No Stock Available';
            end
            else
            begin
               SL:=TPackStringList.Create;
               for I:=0 to ProdForm.AddModStockList.Items.Count-1 do
               begin
                  SL.PackText:=ProdForm.AddModStockList.Items[I];
                  if SL.Count > 9 then
                     ProdForm.AddModStockList.Items[I]:=SL[9]; // original description
               end;
               SL.Free;
               ProdForm.StockDescription.Ignore:=True;
               ProdForm.StockPrice.Ignore      :=True;
            end;
         end;
      *]
      }
   }

