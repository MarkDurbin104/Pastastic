   DeleteTranOverDef {
      InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
      CodeBlock {
      [*
         procedure {PClass}TDeleteTranProduct.TriggerBarCode(Value:String);
         begin
            if Copy(Value,Length(Value)-9,10) =' <- CANCEL' then
            begin
               ProdForm.CancelList.Items[ProdForm.CancelList.Items.IndexOf(Value)]:=Copy(Value,1,Length(Value)-10);
            end
            else
            begin
               ProdForm.CancelList.Items[ProdForm.CancelList.Items.IndexOf(Value)]:=Value+' <- CANCEL';
            end;
            FlagComplete(ProdForm.Validate);
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
         end;
      *]
      }
