   VendorCompleteClick {
      InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
         if Name = 'Complete' then
         begin
            ProdForm.StampsList.Ignore         :=True;
            ProdForm.DiscountStampValue.Ignore :=False;
            ProdForm.StampDiscount.Ignore      :=False;
            ProdForm.TotalStampValue.Ignore    :=False;
            ProdForm.TotalStampValue.Text:=TotalStockValue(ProdForm.StampsList.Items);
            ProdForm.StampDiscount.Text:=CurrToStrF(Round((StrToCurrDef(ProdForm.TotalStampValue.Text,0)/110)*10),ffNumber,2);
            ProdForm.DiscountStampValue.Text:=CurrToStrF(StrToCurrDef(ProdForm.TotalStampValue.Text,0)-StrToCurrDef(ProdForm.StampDiscount.Text,0),ffNumber,2);
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
            FUIEventSink.DisplayItemInfo(Self,0,'','Complete',0,0,False,False);
            Exit;
         end;
      *]
      }
   }
   VendorSetData {
      InsertBetween { '{ListSetDataStart}','{ListSetDataEnd}' }
      CodeBlock {
      [*
         if not ProdForm.StampsList.Ignore then
            ProdForm.StampsList.SetLineEditData(Value)
         else
            SetFormData(Value,ProdForm);
         ProdForm.CurrentLine:=FUIEventSink.CurrentLine;
         if not FlagComplete(ProdForm.Validate) then FlagError:=True;
         if not ProdForm.StampsList.Ignore then
            Result:=ProdForm.StampsList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }

   VendorGetData {
      InsertBetween { '{ListGetDataStart}','{ListGetDataEnd}' }
      CodeBlock {
      [*
         FlagComplete(ProdForm.Validate);
         if not ProdForm.StampsList.Ignore then
            Result:=ProdForm.StampsList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }

   VendorLogStock {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(
               Index,
               1, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Discounted Items:', // Description
               '', // Additional Info
               'VendorDiscount', // ProgID
               ''); // Domain Info
         IndentStampLog:=1;
         LogStock(TxnLog,ProdForm.StampsList);
         IndentStampLog:=0;
         Index:=0;
         TxnLog.LogTransaction(
               Index,
               1, // Quantity
               2008000, // PLU
               0-StrToCurrDef(ProdForm.StampDiscount.Text,0), // Value
               0-StrToCurrDef(ProdForm.StampDiscount.Text,0), // Price
               'Discount', // Description
               '', // Additional Info
               'VendorDiscount', // ProgID
               ''); // Domain Info
      *]
      }
   }

   PaySalaryLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                Get_PLU, // PLU
                -(FQuantity*StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Value
                -(StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Price
                Get_Description, // Description
                '', // Additional Info
                Get_ProgramID, // ProgID
                Enumerate(ProdForm)); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Payee Name -', // Description
                ProdForm.PayeeName.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Payroll Number -', // Description
                ProdForm.PayrollNumber.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);

      *]
      }
   }

