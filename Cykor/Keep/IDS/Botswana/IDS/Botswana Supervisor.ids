  StockSetList {
    Title   { 'View/Modify Current Stock Level' }
    Prompt  { 'View/Modify Current Stock Level' }
    Hint    { 'Type the quantities required,^against each item Shown' }
    Error   { 'Select the quantities of stamps required' }
    Format  {
      List { '!CashAcc',Set}
    }
  }
   CancelList {
      Title { 'Cancel Outstanding Stock Requests' }
      Prompt { 'Select Stock Request to Cancel' }
      Hint { 'Select Stock Request to Cancel by pressing "ENTER"^Then press "Complete" to cancel them' }
      Error { 'Select Stock Request to Cancel' }
      Format {
         List { '!CashAcc' }
      }
   }

   Value {
      Title  { 'Value' }
      Prompt { 'Value' }
      Hint   { 'Enter the Value' }
      Error  { 'Enter a Valid Value' }
      Format {
         Range { '0,100000000' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   PFNumber {
      Title  { 'Personal File Number' }
      Prompt { 'Personal File Number' }
      Hint   { 'Enter the Payee''s Personal File Number' }
      Error  { 'Invalid Personal File Number' }
      Format {
         Mask { '99999' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   ReceiveList {
      Title { 'Remittances Received' }
      Prompt { 'Enter Quantity Received' }
      Hint { 'Type the quantities of items received,^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { '!CashAcc',Receive } // Add }
      }
   }

  CashList {
    Title   { 'Cash Received' }
    Prompt  { 'Enter Cash Received' }
    Hint    { 'Type the quantities of items received,^against each item shown' }
    Error   { 'Invalid Quantity' }
    Format  { List { 'Cash', Receive }  }
  }

  IssueList {
      Title { 'Remittances Dispatched' }
      Prompt { 'Enter Quantity to Dispatch' }
      Hint { 'Please Enter Quantity to Dispatch,^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { '!CashAcc',Return } // Remove }
      }
   }

   TotalStampValue {
      Title  { 'Total Value of Stamps' }
      Prompt { 'Total Value of Stamps' }
      Hint   { 'Total Value of Stamps' }
   }

   StampDiscount {
      Title  { 'Discount' }
      Prompt { 'Discount' }
      Hint   { 'Discount' }
   }

   DiscountStampValue {
      Title  { 'Discounted Value of Stamps' }
      Prompt { 'Discounted Value of Stamps' }
      Hint   { 'Discounted Value of Stamps' }
   }

   ItemAmount {
      Title  { 'Amount' }
      Prompt { 'Amount' }
      Format {
         Range { '0,999999' }
      }
      InputFrom {
         'Keyboard'
      }
      TotalIn { TotalFee }
   }

   ItemCommission {
      Title  { 'Commission' }
      Prompt { 'Commission' }
      Format {
         Range { '0,999999' }
      }
      InputFrom {
         'Keyboard'
      }
      TotalIn { TotalFee }
   }

   ToVendorsList {
      Title         { 'To Agency' }
      Prompt        { 'To Agency' }
      Hint          { 'Enter the Agency Name' }
      Error         { 'Enter a Valid Agency Name' }
      Format        { PickList  { 'PickList.ToVendorsNames' } }
   }

  ToVendorStockList {
               Prompt { 'Enter Desired Quantity'  }
               Error  { 'Invalid Quantity - Insufficient Stock' }
               Title  { 'Stock Transfer From Stock' }
               Format {  List { 'PostalOrd', Transfer }  }
             }


  RunEndOfDayQuestion {
    Title         { 'Enter Yes to run end of day' }
    Prompt        { 'Enter Yes or No' }
    Hint          { 'Enter Yes to run end of day'        }
    Error         { 'Enter Yes or No'    }
    Format        { PickList  { 'PickList.YesOrNo' } }
    DefaultValue  { 'No' }
  }

}

PickLists {

 CashAccAdjType { Increase {'Increase'}
                  Decrease {'Decrease'}
                 }

 ToVendorsNames { Items { 'Mosomane'
                          'Kumakwane'
                         }
                  }

 YesOrNo { Yes {'Yes'}
           No  {'No'}
          }

}


