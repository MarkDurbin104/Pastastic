   LogEMail {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.WriteTransaction('*TxnTotal',0,0, Get_PLU,
                                   StrToCurrDef(ProdForm.Amount.Text,0),
                                   0, Get_Description,'*Supervisor', Get_ProgramID,'');
         TxnLog.WriteTransaction('*TxnTotal',0,0, 0,
                                   StrToCurrDef(ProdForm.Amount.Text,0),
                                   0,Get_Description+' Cash','*Supervisor','Product.Cash','');
      *]
      }
   }

   LogTeleGraph {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.WriteTransaction('*TxnTotal',0,0, Get_PLU,
                                   StrToCurrDef(ProdForm.ItemAmount.Text,0),
                                   0, Get_Description,'*Supervisor', Get_ProgramID,'');
         TxnLog.WriteTransaction('*TxnTotal',0,0, Get_PLU+10,
                                   StrToCurrDef(ProdForm.ItemCommission.Text,0),
                                   0, Get_Description+' Commission','*Supervisor', Get_ProgramID,'');
         TxnLog.WriteTransaction('*TxnTotal',0,0, 0,
                                   StrToCurrDef(ProdForm.ItemAmount.Text,0),
                                   0,Get_Description+' Cash','*Supervisor','Product.Cash','');
         TxnLog.WriteTransaction('*TxnTotal',0,0, 0,
                                   StrToCurrDef(ProdForm.ItemCommission.Text,0),
                                   0,Get_Description+' Commission Cash','*Supervisor','Product.Cash','');
      *]
