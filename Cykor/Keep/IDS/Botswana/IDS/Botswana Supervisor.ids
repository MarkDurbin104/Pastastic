Domains {

   CashSentToBank {
      Title { 'List Cash Sent To bank' }
      Prompt { 'Enter The Cash And Cheques Sent To The Bank' }
      Hint { 'Please Enter Quantity^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { 'Cash',Return }
      }
   }

   DecCash {
      Title { 'Declare Cash Order' }
      Prompt { 'Enter Quantity to declare' }
      Hint { 'Please Enter Quantity to declare^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { 'Cash',Declare }
      }
   }

   DecPostalOrd {
      Title { 'Declare Postal Order' }
      Prompt { 'Enter Quantity to declare' }
      Hint { 'Please Enter Quantity to declare^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { 'PostalOrd',Declare }
      }
   }

   DecStamps {
      Title { 'Declare Stamps' }
      Prompt { 'Enter Quantity to declare' }
      Hint { 'Please Enter Quantity to declare^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { 'Stamps',Declare }
      }
   }

   DecStockBWCourier {
      Title { 'Declare Stock - BW Courier' }
      Prompt { 'Enter Quantity to declare' }
      Hint { 'Please Enter Quantity to declare^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { '*BWCourier',Declare }
      }
   }

   DecStockMerchandise {
      Title { 'Declare Stock - Merchandise' }
      Prompt { 'Enter Quantity to declare' }
      Hint { 'Please Enter Quantity to declare^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { '*Merchandise',Declare }
      }
   }

   DecStockRetailOther {
      Title { 'Declare Stock - Retail' }
      Prompt { 'Enter Quantity to declare' }
      Hint { 'Please Enter Quantity to declare^against each item Shown' }
      Error { 'Invalid Quantity' }
      Format {
         List { '*Retail',Declare }
      }
   }

   DecPhilFDC {
      Title   { 'Declare Philatelic - FDC' }
      Prompt  { 'Enter Quantity to declare' }
      Hint    { 'Please Enter Quantity to declare^against each item Shown' }
      Error   { 'Invalid Quantity' }
      Format  {  List { '*FDCover',Declare }      }
   }

   DecPhilSouvSheets {
      Title   { 'Declare Philatelic - Souvenir Sheets' }
      Prompt  { 'Enter Quantity to declare' }
      Hint    { 'Please Enter Quantity to declare^against each item Shown' }
      Error   { 'Invalid Quantity' }
      Format  {  List { '*SouvSheet',Declare }      }
   }

   DecPhilYearPacks {
      Title   { 'Declare Philatelic - Year Packs' }
      Prompt  { 'Enter Quantity to declare' }
      Hint    { 'Please Enter Quantity to declare^against each item Shown' }
      Error   { 'Invalid Quantity' }
      Format  {  List { '*YearPack',Declare }      }
   }

   DecPhilOtherPhil {
      Title   { 'Declare Philatelic - Other Items' }
      Prompt  { 'Enter Quantity to declare' }
      Hint    { 'Please Enter Quantity to declare^against each item Shown' }
      Error   { 'Invalid Quantity' }
      Format  {  List { '*PhilOther',Declare }      }
   }


   SerialNumber {
      Title  { 'Serial Number' }
      Prompt { 'Serial Number' }
      Hint   { 'Enter the Serial Number' }
      Error  { 'Enter a Valid Serial Number' }
      Format { //None
         Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' }
      }
      InputFrom {
         'Keyboard'
      }
   }

}
Users {

   Supervisor {
      Items {
         'Group.SMain'
         'Group.SuperAdmin'
         'Group.StockRemittances'
         'Group.SuperEndOfDay'
         'Group.Services'
         'Group.SuperReport'
         'Group.ModifyStock'
         'Group.SupCALines'
         'Group.CashAccount'
         'Group.SuperDeclare'
         'Group.ClerkDeclareStock'
         'Group.ClerkDeclarePhil'
         // 'Group.SuperUtils'
         'Group.VendorSales'
         'Group.Supervisor__A'
         //'Group.Supervisor_C_'
         //'Group.Supervisor_CA'
         //'Group.SupervisorS__'
         //'Group.SupervisorS_A'
         //'Group.SupervisorSC_'
         //'Group.SupervisorSCA'
         'Group.Pays'
         'Group.GOVSuperMain'
         'Group.MOSuperMain'         
         'Group.ViewStock'
         'Group.ViewPhilItems'
         'Group.ViewStockItems'
      }
   }
}

Groups {

   Supervisor__A {
      BitMap  { '..\images\G_Altkey.bmp'   }
      Title { 'ALT-HOTKEYS'            }
     Items {
       'Product.Cash'
       'Receipt'
       'End Customer'
       'Exit'
       'Product.Cheque'
       'Product.AccountPay'
       'Product.AccountGOVPay'
     }
   }

   SMain {
     Caption { 'Main' }
     BitMap { '..\IMAGES\SmallLogo.bmp' }
     Title        { 'Botswana Post - Supervisor' }
     Prompt       { 'Select a Menu Item:' }
     Hint         { 'Select a menu item by pressing the Function Key^or by using the [Up] and [Down] arrows and [Enter]' }
     Items {
       'Product.AcceptOrder'
       'Product.AcceptReturn'
       'Group.VendorSales'
       'Group.CashAccount'
       'Group.SuperAdmin'
       'Group.SuperReport'
//       'Product.SupEndOfDay'
       'Exit'
       'Shutdown Workstation'
       'Product.DeleteTran'
       'Product.CashAccAdj'
     }
   }
   CashAccount {
     Caption { 'Cash Account' }
     BitMap {  '..\IMAGES\P_OrderPrint.bmp' }
     Title        { 'Cash Account' }
     Prompt       { 'Select a Menu Item:' }
     Hint         { 'Select a menu item by pressing the Function Key^or by using the [Up] and [Down] arrows and [Enter]' }
     Items {
//       'Product.GPOCashAccount'
       'Product.FullCashAccount'
       'Product.NATellerAcc'
       'Product.AnOfficeCashAccount'
       'Product.SubsCashAccount'
//       'Product.SubOfficeAcc'
     }
   }
   SuperAdmin {
     Caption { 'Administration' }
     BitMap { '..\IMAGES\G_SuperAdmin.bmp' }
     Title        { 'Administration' }
     Prompt       { 'Select a Menu Item:' }
     Hint         { 'Select a menu item by pressing the Function Key^or by using the [Up] and [Down] arrows and [Enter]' }
     Items {
       'Product.SetExcngRates'
       'Group.ModifyStock'
       'Group.StockRemittances'
       'Group.SuperEndOfDay'
       'Group.ViewStock'
       'Group.Pays'
       'Group.GOVSuperMain'
       'Group.MOSuperMain'
       'Product.ReversalTran'
       'Copy On Distribution Files'
     }
   }

   StockRemittances {
     Caption { 'Stock Remittances' }
     BitMap { '..\IMAGES\G_SuperAdmin.bmp' }
     Title        { 'Stock Remittances' }
     Prompt       { 'Select a Menu Item:' }
     Hint         { 'Select a menu item by pressing the Function Key^or by using the [Up] and [Down] arrows and [Enter]' }
     Items {
       'Product.RemRec'
       'Product.RemDisp'
       'Product.TransferFromVendors'
       'Product.TransferToVendors'
       'Product.CashRecBank'
       'Product.CashDepBank'       
     }
   }

   SuperEndOfDay {
     Caption { 'End Of Day Functions' }
     BitMap { '..\IMAGES\G_SuperAdmin.bmp' }
     Title        { 'End Of Day Functions' }
     Prompt       { 'Select a Menu Item:' }
     Hint         { 'Select a menu item by pressing the Function Key^or by using the [Up] and [Down] arrows and [Enter]' }
     Items {
       'Group.CashAccount'
       'Group.SuperDeclare'
//       'Product.TrialBalance'
       'Shutdown All Workstations'     
     }
   }

   Pays {
     Caption { 'Payments' }
     BitMap { '..\IMAGES\G_Pension.bmp' }
     Title        { 'Payments' }
     Prompt       { 'Select a Menu Item:' }
     Hint         { 'Select a menu item by pressing the Function Key^or by using the [Up] and [Down] arrows and [Enter]' }
