   PayHumanaLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                Get_PLU, // PLU
                -(FQuantity*StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Value
                -(StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Price
                Get_Description, // Description
                '', // Additional Info
                Get_ProgramID, // ProgID
                Enumerate(ProdForm)); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Employee No. -', // Description
                ProdForm.EmployeeNumber.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Employee Name -', // Description
                ProdForm.EmployeeName.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Omang No. -', // Description
                ProdForm.CustID_Number.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
         If ProdForm.Comment.Text <> ''
         then begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   0, // PLU
                   0, // Value
                   0, // Price
                   'Comment -', // Description
                   ProdForm.Comment.Text, // Additional Info
                   '', // ProgID
                   ''); // Domain Info
             Inc(Index);
          end ;         
          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }

  ClaimsLog {
    InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
    CodeBlock {
    [*
      If Get_Description = 'Imprest and Travel Claims' then
        TxnLog.LogTransaction( Index, FQuantity, Get_PLU,
                              -FQuantity*StrToCurrDef(ProdForm.AmountPaid.Text,0),
                              -StrToCurrDef(ProdForm.AmountPaid.Text,0), // Price
                              Get_Description, '', Get_ProgramID, Enumerate(ProdForm)) // Domain Info
      else  //ImprestTraveleReceipt
        TxnLog.LogTransaction( Index, FQuantity, Get_PLU,
                              FQuantity*StrToCurrDef(ProdForm.AmountPaid.Text,0),
                              StrToCurrDef(ProdForm.AmountPaid.Text,0), // Price
                              Get_Description, '', Get_ProgramID, Enumerate(ProdForm)); // Domain Info

      Inc(Index);

      TxnLog.LogTransaction(Index,FQuantity,Get_PLU,0,0,'Payee Name -',ProdForm.PayeeName.Text,Get_ProgramId,''); Inc(Index);
      TxnLog.LogTransaction(Index,FQuantity,Get_PLU,0,0,'Payee Identification -',ProdForm.PayeeIdentification.Text,Get_ProgramId,''); Inc(Index);
      if ProdForm.Comment.Text <> '' then
        TxnLog.LogTransaction(Index,FQuantity,Get_PLU,0,0,'Comment -',ProdForm.Comment.Text,Get_ProgramId,'');Inc(Index);
      if CombineList <> nil then
        CombineList.LogTransactions(Index,TxnLog);
    *]
    }
  }

  RemDispGetExecData {
    InsertBetween { '{ListGetDataStart}','{ListGetDataEnd}' }
    CodeBlock {
    [*
      if not ProdForm.IssueList.Ignore then
        Result:=ProdForm.IssueList.LineEditData
      else
        Result:=GetFormData(ProdForm);
    *]
    }
  }

   RemDispSetExecData {
      InsertBetween { '{ListSetDataStart}','{ListSetDataEnd}' }
      CodeBlock {
      [*
         if not ProdForm.IssueList.Ignore then
            ProdForm.IssueList.SetLineEditData(Value)
         else
            SetFormData(Value,ProdForm);
         ProdForm.CurrentLine:=FUIEventSink.CurrentLine;
         if not ProdForm.Validate then FlagError:=True;
         if not ProdForm.IssueList.Ignore then
            Result:=ProdForm.IssueList.LineEditData
         else
            Result:=GetFormData(ProdForm);
      *]
      }
   }



   RemDispDec {
     InsertBetween { '{OverrideDecStart}','{OverrideDecEnd}' }
     CodeBlock {
       [*
          procedure TriggerBarCode(Value:String); override;
       *]
     }
   }

   RemDispDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*
          procedure {PClass}TRemDispProduct.TriggerBarCode(Value:String);
          begin
             ProdForm.PostOffice.Ignore:=True;
             ProdForm.IssueList.Ignore:=False;
             ProdForm.PostOffice.ItemIndex:=ProdForm.PostOffice.Items.IndexOf(Value);
             ProdForm.IssueList.AssociatedProgID := ProdForm.IssueList.AssociatedProgID  +  ' ' + ProdForm.PostOffice.Text;
             FlagComplete(ProdForm.Validate);
             FUIEventSink.DataChanged(Self,ProdForm.IssueList.LineEditData,False);
          end;
       *]
     }
   }



  RemDispVAL {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      Result:=(PostOffice.Text <> '');
      IssueList.Ignore :=(PostOffice.Text = '');
      IssueList.Hint:='Enter Quantities against each item^Total Value so far P'+TotalStockValue(IssueList.Items);
    *]      
    }
  }

  RemDispLOG {
    InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
    CodeBlock {
    [*
      ReferenceData('SET(RemittanceDest,' + ProdForm.PostOffice.Text + ')');
      LogStock(TxnLog,ProdForm.IssueList);
      ReferenceData('SET(RemittanceDest,)');
    *]
    }
  }



