 NatSavCertPPayPreVal {
              InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
                    CodeBlock {
                    [*
            Result:=CheckMaskEdits(Self);
            MonthsDif := 0 ;
            try

            Date2 := Date;
            Date1 := StrToDateTime( DateOfIssue.Text );
            DecodeDate( Date1, YearWork, MonthWork, DayWork ) ;
            if YearWork > 2050 then
            begin
                YearWork := YearWork - 100 ;
                Date1 := EncodeDate( YearWork, MonthWork, DayWork ) ;
            end ;


            if Date2 < Date1 then
                result := false
            else
            begin

              DateWork := Date1 ;
              DecodeDate( DateWork, YearWork, MonthWork, DayWork ) ;
              while DateWork < Date2 do
              begin
                if MonthWork = 12 then
                begin
                  MonthWork := 1 ;
                  Inc( YearWork );
                end
              else
               Inc( MonthWork ) ;

             FoundDay := False ;
             DayTry := DayWork ;

             while not FoundDay do
             begin
                try
                   // Endcode Date brakes if there is not  31 in the moth
                   DateWork := EncodeDate( YearWork, MonthWork, DayTry ) ;
                   FoundDay := True ;
                except
                   Dec( DayTry );
                end ;
             end ;

            if DateWork <= Date2 then
              Inc( MonthsDif ) ;
            end ;

            end ;


            except
              MonthsDif := 0;
              result :=false;
            end ;

              if (MonthsDif= 0) and (DateOfIssue.Text <> '') then
              begin
                Result := False ;
                MoveFocusTo( DateOfIssue );
              end;

            if PaymentAmount.Text <> ''  then
            begin
              if ((StrToIntDef(PaymentAmount.Text,0) mod 50) <> 0) or (StrToIntDef(PaymentAmount.Text, 0) > StrToIntDef(CertValue.Text, 0)) then
              begin
                Result := False ;
                MoveFocusTo(PaymentAmount);
              end;
            end;

            //HiddenPayment.Text := PaymentAmount.Text ;
            MonthsDiff.Text := IntToStr(MonthsDif);

              *]
            }
       }


   NatSavCertPPayPostVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
       HiddenPayment.Text := PaymentAmount.Text ;
       if not result and (MonthsDif= 0) and ( CurrentFieldName= 'DateOfIssue' )then
          MoveFocusTo( DateOfIssue );
       if Result and
         ((PaymentAmount.Text <> '') and
         (StrToIntDef(PaymentAmount.Text, 0) >= StrToIntDef(CertValue.Text, 0))) then
       begin
           Result := False;
       end;

      try
         InterestTotal:=InterestTotal*StrToCurr(PaymentAmount.Text)/StrToCurr(CertValue.Text);
      except
      end ;
      if PaymentAmount.Text = '' then
         InterestValue.Text := ''
      else
         InterestValue.Text:= CurrToStrF( InterestTotal, ffNumber, 2 );

       if Result and (StrToIntDef(PaymentAmount.Text, 0) = 0) then
          Result := False;
      *]
      }
    }

    NatSavCertFPayPosVal {
          InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
          CodeBlock {
          [*
            HiddenPayment.Text := CertValue.Text ;
         *]
      }
    }

    NatSavCertFPayVal {
          InsertBetween { '{ValidateStart}','{ValidateEnd}' }
          CodeBlock {
          [*

            if ( CertificateNumber.Text <> '') then
            begin
               I :=0;
               while ( I < CertValue.Items.count -1 ) and (TStringObject(CertValue.Items.Objects[I]).Value<>Copy(CertificateNumber.Text,1,1)) do
                  Inc( I );
               if (TStringObject(CertValue.Items.Objects[I]).Value=Copy(CertificateNumber.Text,1,1)) then
               begin
                  CertValue.ItemIndex:=I;
               end ;
            end ;

            InterestTotal:=0;
            if ( CertValue.Text <> '' ) and  ( MonthsDiff.Text <> '' ) then
            begin
               MonthCal := StrToInt( MonthsDiff.Text );
               
               if ( MonthCal > 36 ) then MonthCal:=36; // Ibo says!
         
               while ( MonthCal > 36 ) do
               begin
                  InterestTotal := InterestTotal + StrToCurrDef( LookUp(TStringObject(CertValue.Items.Objects[CertValue.ItemIndex]).Value,'36','CertValues',MonthsDiff,Result), 0 );
                  Dec( MonthCal, 36 );
               end ;
               InterestTotal := InterestTotal + StrToCurrDef( LookUp(TStringObject(CertValue.Items.Objects[CertValue.ItemIndex]).Value,IntToStr(MonthCal),'CertValues',MonthsDiff,Result), 0 );
               InterestValue.Text:= CurrToStrF( InterestTotal, ffNumber, 2 );
            end;
// Date of issue cannot be before '23/06/99'
//  This test assumes the system will not be in place after 2040!
            if ( DateOfIssue.Text <> '') then
            begin
              if    (Copy(DateOfIssue.Text,7,2) > '40')
                and (StrToDate(DateOfIssue.Text)<StrToDate('23/06/99')) then
              begin
               result := false;
               MoveFocusTo( DateOfIssue );
              end ;
           end ;
           *]
           }
    }

      
  NatSavCertPPayLog {
         InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
         CodeBlock {     
         [*
         
            TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               FQuantity*(-StrToCurrDef(ProdForm.HiddenPayment.Text,0)), // Value
               -StrToCurrDef(ProdForm.HiddenPayment.Text,0), // Price
               Get_Description+'  ', // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);
      TxnLog.LogTransaction(
                       Index,
                       FQuantity, // Quantity
                       Get_PLU, // PLU
                       0, // Value
                       0, // Price
                       'Certificate Number. -       ', // Description
                       ProdForm.CertificateNumber.Text, // Additional Info
                       Get_ProgramID, // ProgID
                       ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
                       Index,
                       FQuantity, // Quantity
                       Get_PLU, // PLU
                       0, // Value
                       0, // Price
                       'Customer Name. -       ', // Description
                       ProdForm.CustomerName.Text, // Additional Info
                       Get_ProgramID, // ProgID
                       ''); // Domain Info
        Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Omang Number. -       ', // Description
               ProdForm.CustID_Number.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
    //    TxnLog.LogTransaction(
    //           Index,
    //           FQuantity, // Quantity
    //           0, // PLU
    //           0, // Value
    //           0, // Price
    //           'Certificate Number. - ', // Description
    //           ProdForm.CertificateNumber.Text, // Additional Info
    //           '', // ProgID
    //           ''); // Domain Info
    //     Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Date Of Issue. -      ', // Description
               ProdForm.DateOfIssue.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);        
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               -StrToCurrDef(ProdForm.InterestValue.Text,0), // Value
               -StrToCurrDef(ProdForm.InterestValue.Text,0), // Price
               'Interest Value. -     ', // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);       
         *]
         }
      }

   //---------------------------------------------------------------------------

   ///////// Bermuda -----------------------------------------------------------

   //---------------------------------------------------------------------------

   LogCertFPayVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
      [*
         var

            SL:TPackStringList;
            I:Integer;
            CustomerName:String;
            CustID_Number:String;
            CertificateNumber:String;
            DateOfIssue:String;
            CertValue:String;
            //MonthsDiff:Integer;
            HiddenPayment:String;
            InterestValue:String;

      *]
      }
   }
   NatSavCertFPayLog  {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*


           if (ProdForm.Validate) and (StrToIntDef(ProdForm.CertValue.Text,0) <> 0) then
           begin
              SL:=TPackStringList.Create;
              SL.PackText:=AdditionalInfo;
              SL.Add(ProdForm.CustomerName.Text);
              SL.Add(ProdForm.CustID_Number.Text);
              SL.Add(ProdForm.CertificateNumber.Text);
              SL.Add(ProdForm.DateOfIssue.Text);
              SL.Add(ProdForm.CertValue.Text);
              //SL.Add(ProdForm.MonthsDiff.Text);
              SL.Add(ProdForm.HiddenPayment.Text);
              SL.Add(ProdForm.InterestValue.Text);
              AdditionalInfo:=SL.PackText;
              SL.Free;
           end;

           if AdditionalInfo <> '' then
           begin

              SL:=TPackStringList.Create;
              SL.PackText:=AdditionalInfo;
              for I:=0 to ((SL.Count-1) div 7) do
              begin
                 CustomerName       := SL[I*7+0] ;
                 CustID_Number      := SL[I*7+1] ;
                 CertificateNumber  := SL[I*7+2] ;
                 DateOfIssue        := SL[I*7+3] ;
                 CertValue          := SL[I*7+4] ;
                 //MonthsDiff         := StrToIntDef(SL[I*7+5],0) ;
                 HiddenPayment      := SL[I*7+5] ;
                 InterestValue      := SL[I*7+6] ;

                 if Index = 0 then
                 begin
                       TxnLog.LogTransaction(Index,0,Get_PLU,
                                             0,0,
                                             Get_Description,
                                             '',
                                             Get_ProgramID,
                                             '' {AdditionalInfo} );
                       Inc(Index);

                       TxnLog.LogTransaction(Index,0,Get_PLU,
                                             0,0,
                                             'Omang Number -',
                                             CustID_Number,
                                             Get_ProgramID,
                                             '' {AdditionalInfo} );
                        Inc(Index);
                       TxnLog.LogTransaction(Index,0,Get_PLU,
                                             0,0,
                                             'Customer Name -',
                                             CustomerName,
                                             Get_ProgramID,
                                             '' {AdditionalInfo} );
                        Inc(Index);


                 end;

                 TxnLog.LogTransaction(
                          Index,
                          FQuantity, // Quantity
                          Get_PLU, // PLU
                          -StrToCurrDef(HiddenPayment,0), // Value
                          -StrToCurrDef(HiddenPayment,0), // Price
                          'Certificate. -', // Description
                          CertificateNumber, // Additional Info
                          Get_ProgramID, // ProgID
                          ''); // Domain Info
                 Inc(Index);

                 TxnLog.LogTransaction(
                          Index,
                          0, // Quantity
                          Get_PLU, // PLU
                          0, // Value
                          0, // Price
                          'Date Of Issue. -', // Description
                          DateOfIssue, // Additional Info
                          Get_ProgramID, // ProgID
                          ''); // Domain Info
                 Inc(Index);

                 TxnLog.LogTransaction(
                        Index,
                        FQuantity, // Quantity
                        Get_PLU, // PLU
                        -StrToCurrDef(InterestValue,0), // Value
                        -StrToCurrDef(InterestValue,0), // Price
                        'Interest Value', // Description
                        '', // Additional Info
                        Get_ProgramID, // ProgID
                        ''); // Domain Info
                  Inc(Index);


                 //TxnLog.LogTransaction(Index,Quantity,0,
                 //                      HiddenPayment,HiddenPayment),
                 //                      ,'','','');
                 //   TValue   :=TValue+HiddenPayment;
                    Inc(Index);
              end;
              SL.Free;
              AdditionalInfo:='';
           end;

      *]
      }
   }

