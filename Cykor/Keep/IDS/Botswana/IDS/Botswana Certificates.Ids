   NotifyCertVars {
      InsertBetween { '{NotifyVarStart}','{NotifyVarEnd}' }
      CodeBlock {
      [*
         SL:TPackStringList;
      *]
      }
   }

   NotifyCert {
      InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
         if Name = 'Next Certificate' then
         begin
            if ProdForm.Validate then
            begin

               if StrToIntDef(ProdForm.CertValue.Text,0) <> 0 then
               begin
                  SL:=TPackStringList.Create;
                  SL.PackText:=AdditionalInfo;
                  SL.Add(ProdForm.CustomerName.Text);
                  SL.Add(ProdForm.CustID_Number.Text);
                  SL.Add(ProdForm.CertificateNumber.Text);
                  SL.Add(ProdForm.DateOfIssue.Text);
                  SL.Add(ProdForm.CertValue.Text);
                  //SL.Add(ProdForm.MonthsDiff.Text);
                  SL.Add(ProdForm.HiddenPayment.Text);
                  SL.Add(ProdForm.InterestValue.Text);

                  AdditionalInfo:=SL.PackText;
                  SL.Free;
               end;

               ProdForm.CertificateNumber.Text:='';
               ProdForm.DateOfIssue.Text:='';
               ProdForm.CertValue.Text:='';
               //ProdForm.MonthsDiff.Text:='';
               ProdForm.HiddenPayment.Text:='';
               ProdForm.InterestValue.Text:='' ;
               ProdForm.TotalFee.Text:='0.00';

               MoveFocusTo(ProdForm.CertificateNumber);
               FlagComplete(ProdForm.Validate);
               FUIEventSink.DataChanged(Self,GetFormData(ProdForm),not ValidateOK);
            end;
            Exit;
         end;
      *]
      }
   }

   FlagCert {
      InsertBetween { '{EnableCompleteStart}','{EnableCompleteEnd}' }
      CodeBlock {
      [*
         if Value then
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','Complete',0,0,False,False);
            FUIEventSink.DisplayItemInfo(Self,1,'',Get_Item(1),0,0,True,False);
         end
         else
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
         end;
      *]
      }
   }

  CertCertUses {
    InsertBetween { '{UsesStart}','{UsesEnd}' }
    CodeBlock {
      [*
         uses StringUtil;
      *]
    }
  }


}





