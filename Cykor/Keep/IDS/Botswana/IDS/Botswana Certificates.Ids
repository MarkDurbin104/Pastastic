PickLists
{
  SavCertValues { A { 50 }
                  B { 250 }
                  C { 500 }
                 }
}

LookUps {

  CertValues {
   Range {   5       8       11       14      17      20      23       26       29       32       35     36      }
   A   {  '0.00'  '2.45'  '3.70'   '5.00'  '6.35'  '7.70'  '9.10'  '10.50'  '12.00'  '13.45'  '15.00'  '16.55'      }
   B  {  '0.00' '12.20' '18.55' '25.00'  '31.65' '38.45' '45.40'  '52.50'  '59.80'  '67.30'  '74.95'  '82.75'       }
   C  {  '0.00' '24.40' '37.05' '50.00'  '63.30' '76.85' '90.75' '105.00' '119.60' '134.55' '149.85' '165.50' }
   }
   
}
Domains {

   PaymentAmount {
             Title  { 'Amount' }
             Prompt { 'Amount' }
             Hint   { 'Enter the Amount' }
             Error  { 'Enter a Valid Amount' }
          //   DefaultValue { 50 }
             Format { Currency { 0,999999999 } }
             InputFrom {'Keyboard'}
        }
   
   SavingsAmount {
          Title  { 'Amount' }
          Prompt { 'Amount' }
          Hint   { 'Enter the Amount' }
          Error  { 'Enter a Valid Amount' }
//          DefaultValue { 50 }
          Format { Currency { 0,50000 } }
          InputFrom {'Keyboard'}
     }
     
    CertificateNumber {
          Title  { ' Certificate Number ' }
          Prompt { ' Certificate Number ' }
          Hint   { ' Enter the Certificate Number ' }
          Error  { ' Enter valid format (ABC)9999999 Certificate Number' }
          Format { Mask { '[ABC]9999999' }  }
          InputFrom {'Keyboard'}

     }
     
     DateOfIssue {
          Title  { 'Date Of Issue' }
          Prompt { 'Date Of Issue' }
          Hint   { ' Enter the Date Of Issue ' }
          Error  { ' Enter a valid Date Of Issue ' }
          Format { Date }
          InputFrom {'Keyboard'}
          }
      CertValue {
          Title  { 'Certificate Value' }
          Prompt { 'Certificate Value' }
          Format { PickList { 'PickList.SavCertValues' } }
       }
      MonthsDiff {
          Title  { 'Months Difference' }
          Prompt { 'Months Difference' }
          Hint   { 'Months Difference' }
          Error  { 'Invalid Months Difference' }
       }           

       InterestValue
       {
          Title     { 'Interest Value' }
          Prompt    { 'Interest Value' }
          InputFrom { Params         }
          TotalIn   { TotalFee }
       } 
       HiddenPayment
       {
           Title     { 'Hidden Payment' }
           Prompt    { 'Hidden Payment' }
           TotalIn   { TotalFee }
       } 

       
 }

Products
{

   NatSavCert {
          BasedOn     { BaseCertificates }
          BitMap      { '..\images\P_SavCertificate.bmp' }
          Caption     { 'Saving Certificates' }
          Description { 'Saving Certificates' }
          Title       { 'Saving Certificates' }
          Domains {
            CustomerName
            CustID_Number
            SavingsAmount
          }
          Snippets { NatSavCertPostVal,NatSavCertLog }
          //Customer { 'Sav. Certificate','^','Total ','P',SavingsAmount }
          PLU         {  PLU_NatSavCert }
    }


 NatSavCertFPay {
          BasedOn     { BaseCertificates }
          BitMap      { '..\images\P_SavCertificate.bmp' }
          Caption     { 'Savings Certificate Full Payment' }
          Description { 'Savings Certificate Full Payment' }
          Title       { 'Savings Certificate Full Payment' }
          items {
            'Complete'
            'Next Certificate'
          }
          Domains {
            CustomerName
            CustID_Number
            CertificateNumber
            DateOfIssue
            CertValue
            MonthsDiff
            HiddenPayment
            InterestValue { MonthsDiff,CertValue,'LookUp.CertValues' }
    }
    Snippets { NatSavCertFPayPreVal
               NatSavCertFPayVarVal
               NatSavCertFPayVal
               NatSavCertFPayPosVal
               NatSavCertFPayExecute
               NotifyCertVars
               NotifyCert
               FlagCert
               CertCertUses
               LogCertFPayVars
               NatSavCertFPayLog
             }
    //Customer { 'Sav.Cert Full Payment.','^','Total ','P',TotalFee }
    PLU         {  PLU_NatSavCertFPay }

  }

NatSavCertPPay {
          BasedOn     { BaseCertificates }
      BitMap      { '..\images\P_SavCertificate.bmp' }
          Caption     { 'Savings Certificate Part Payment' }
          Description { 'Savings Certificate Part Payment' }
          Title       { 'Savings Certificate Part Payment' }
          Domains {
            CustomerName
            CertificateNumber
            CustID_Number
            DateOfIssue
            CertValue
            PaymentAmount
            MonthsDiff
            HiddenPayment         
            InterestValue { MonthsDiff,CertValue,'LookUp.CertValues' }
    }
   Snippets { NatSavCertPPayPreVal, NatSavCertFPayVarVal,NatSavCertFPayVal,NatSavCertPPayPostVal, NatSavCertPPayExecute, NatSavCertPPayLog }
   //Customer { 'Sav.Cert Part. Payment.','^','Total ','P',TotalFee }
   PLU         {  PLU_NatSavCertPPay }

  }

}

Snippets {

      NatSavCertPostVal {
       InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
             CodeBlock {
             [*

                   If Result then
                   begin
                     if (StrToIntDef(SavingsAmount.Text, 0) < 50) or (StrToIntDef(SavingsAmount.Text, 0) > 50000)  then
                     begin
                        Result := False ;
                        MoveFocusTo(SavingsAmount);
                     end
                     else
                     begin
                       if StrToIntDef(SavingsAmount.Text,0) mod 50 = 0 then
                       begin
                         Result := True
                       end
                       else
                       begin
                         Result := False;
                         MoveFocusTo(SavingsAmount);
                       end;
                     end;
                   end;

             *]
         }
       }

       NatSavCertFPayPreVal {
              InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
                    CodeBlock {
                    [*
                        Result:=CheckMaskEdits(Self);
                        MonthsDif := 0 ;
                        try

                   Date2 := Date;
                   Date1 := StrToDateTime( DateOfIssue.Text );

                   DecodeDate( Date1, YearWork, MonthWork, DayWork ) ;
                   if YearWork > 2050 then
                   begin
                      YearWork := YearWork - 100 ;
                      Date1 := EncodeDate( YearWork, MonthWork, DayWork ) ;
                   end ;

                   if Date2 <= Date1 then
                   begin
                      result := false;
                      MoveFocusTo( DateOfIssue );
                   end
                   else
                   begin


                      DateWork := Date1 ;
                      DecodeDate( DateWork, YearWork, MonthWork, DayWork ) ;
                      while DateWork < Date2 do
                      begin

                         if MonthWork = 12 then
                         begin
                            MonthWork := 1 ;
                            Inc( YearWork );
                         end
                         else
                            Inc( MonthWork ) ;

                         FoundDay := False ;
                         DayTry := DayWork ;

                         while not FoundDay do
                         begin
                            try
                               // Endcode Date brakes if there is not  31 in the moth
                               DateWork := EncodeDate( YearWork, MonthWork, DayTry ) ;
                               FoundDay := True ;
                            except
                               Dec( DayTry );
                            end ;
                         end ;

                         if DateWork <= Date2 then
                            Inc( MonthsDif ) ;
                     end ;

                   end ;


                except
                   MonthsDif := 0;
                   result :=false;
                end ;

                //HiddenPayment.Text := CertValue.Text ;
                MonthsDiff.Text := IntToStr(MonthsDif);

                  *]
                }
       }


   NatSavCertFPayPostVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*

       if not result and (MonthsDif= 0) and ( CurrentFieldName= 'DateOfIssue' )then
          MoveFocusTo( DateOfIssue );
      *]
      }
    }


   NatSavCertFPayVarVal {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
         Date1,Date2:TDateTime;
         DateWork : TDateTime ;
         YearWork, MonthWork, DayWork, DayTry : word;
         MonthsDif  : integer  ;
         FoundDay : boolean ;
         I : integer ;
         MonthCal : integer;
         InterestTotal : Real ;

       *]
       }
    }


   NatSavCertPPayExecute {
         InsertBetween { '{SetProgStart}','{SetProgEnd}' }
         CodeBlock {
         [*
             ProdForm.HiddenPayment.Ignore := TRUE ;
             ProdForm.CertValue.enabled:=false;
         *]
         }
      }
   NatSavCertFPayExecute {
         InsertBetween { '{SetProgStart}','{SetProgEnd}' }
         CodeBlock {
         [*
             ProdForm.HiddenPayment.Ignore := TRUE ;
             ProdForm.CertValue.enabled:=false;
              AdditionalInfo:='';
         *]
         }
      }
  NatSavCertLog {
         InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
         CodeBlock {     
         [*  
            TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               FQuantity*StrToCurrDef(ProdForm.SavingsAmount.Text,0), // Value
               StrToCurrDef(ProdForm.SavingsAmount.Text,0), // Price
               Get_Description, // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Customer Name - ', // Description
               ProdForm.CustomerName.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Omang No. - ', // Description
               ProdForm.CustID_Number.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
         if CombineList <> nil then
       CombineList.LogTransactions(Index,TxnLog);
         *]
         }
      }

