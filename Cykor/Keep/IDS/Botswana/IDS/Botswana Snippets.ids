//                               0-StrToCurrDef(ProdForm.AmountPaidTotal.Text,0),
//                               0-StrToCurrDef(ProdForm.AmountPaidTotal.Text,0),
//                               Get_Description,'',{PProgID}'Product.Cash',
//                               Enumerate(ProdForm));
//         Inc(Index);
//
//      *]
//      }
//   }

