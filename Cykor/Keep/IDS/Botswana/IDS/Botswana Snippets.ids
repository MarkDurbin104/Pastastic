   ValidateVarSetDemurrageOnParcel {
       InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
       CodeBlock {
       [*
         var
            NumDays : integer ;
       *]
       }
     }
   ValidateSetDemurrageOnParcel {
       InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
       CodeBlock {
       [*

          if Result then
            try
               NumDays:= Trunc( Date - StrToDate( DateArrival.Text ) );
               NumberDays.Text := IntToStr( NumDays );
               if NumDays > 30 then
                  DemurrageOnParcelFee.Text := CurrToStrF( (NumDays-30)*1.70, ffNumber, 2 )
               else
                  DemurrageOnParcelFee.Text := '0.00';

            except
            end ;

          BaseProduct.UIEventSink.ReferenceData('SET(DemurrageOnParcelFee,'+DemurrageOnParcelFee.Text+')');
       *]
       }
     }

   ExecVARVendorSales {
       InsertBetween { '{ExecuteVarStart}','{ExecuteVarEnd}' }
       CodeBlock {
       [*
          var
            TempStock:String;
            AnyStockAvailable,
            StockAvailable:Boolean;
            StockGroups:TStringList;
            i:Integer;
       *]
       }
     }

   ExecVendorSales {
       InsertBetween { '{IsListStart}','{IsListEnd}' }
       CodeBlock {
       [*
          if UIEventSink <> nil then
          begin
            StockGroups:=TStringList.Create;
            StockGroups.CommaText:='"PostalOrd","Retail","*PhilOther","*YearPack","*SouvSheet","*FDCover"';
            AnyStockAvailable:=FALSE;
            for i:=0 to StockGroups.Count-1 do
            begin
               StockAvailable:=GetAvailableStock(ProdForm.VendorRetailList,UIEventSink.User,StockGroups.Strings[i]);
               AnyStockAvailable:=AnyStockAvailable or StockAvailable;
               if ProdForm.VendorRetailList.Items.CommaText <> '' then
               begin
                  if TempStock = '' then // dont join 1st string
                    TempStock:=ProdForm.VendorRetailList.Items.CommaText
                  else
                    TempStock:=TempStock + ',' + ProdForm.VendorRetailList.Items.CommaText;
               end;
            end;
            ProdForm.VendorRetailList.Items.CommaText:=TempStock;
            StockGroups.Free;
            if not AnyStockAvailable then
            begin
               ProdForm.VendorRetailList.Clear;
               ProdForm.VendorRetailList.Text:='No Stock Available';
            end
          end;
       *]
       }
     }

   ExecVARVendorStampSales {
       InsertBetween { '{ExecuteVarStart}','{ExecuteVarEnd}' }
       CodeBlock {
       [*
//          var
//             TempStock:String;
       *]
       }
     }

   ExecVendorStampSales {
       InsertBetween { '{IsListStart}','{IsListEnd}' }
       CodeBlock {
       [*
          if UIEventSink <> nil then
          begin
//             GetAvailableStock(ProdForm.VendorRetailList,UIEventSink.User,'Stamps');
//             TempStock := ProdForm.VendorRetailList.Items.CommaText;
             if not GetAvailableStock(ProdForm.VendorRetailList,UIEventSink.User,'Stamps') then
             begin
                ProdForm.VendorRetailList.Clear;
                ProdForm.VendorRetailList.Text:='No Stock Available';
             end;
//             else
  //              ProdForm.VendorRetailList.Items.CommaText :=  TempStock + ',' + ProdForm.VendorRetailList.Items.CommaText;
          end;
       *]
       }
     }

   LogVendorStampSales {
       InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
       CodeBlock {
       [*
          LogStock(TxnLog,ProdForm.VendorRetailList);
          TxnLog.LogTransaction(
                   0, // Index
                   FQuantity, // Quantity
                   Get_PLU, // PLU
                   0-(Round((StrToCurrDef(TotalStockValue(ProdForm.VendorRetailList.Items),0) * 0.05) * 100) / 100), // Value
                   0-(Round((StrToCurrDef(TotalStockValue(ProdForm.VendorRetailList.Items),0) * 0.05) * 100) / 100), // Price
                   'Vendor Discount - 5%', // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm));  // Domain Info
          Inc(Index);
       *]
       }
     }

   ValidateSetCODTradeCharge {
       InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
       CodeBlock {
       [*
          if UpperCase( MailCODOrigin.Text ) = 'BOTSWANA' then
          begin
             CODHandChargeFee.Ignore := True ;
             CODHandChargeFee.Text := '0';
             BaseProduct.UIEventSink.ReferenceData('SET(CODHandChargeFee,'+CODHandChargeFee.Text+')');
             BaseProduct.UIEventSink.ReferenceData('SET(CODTradeChargeFee,'+CODTradeChargeFee.Text+')');
          end
          else
          begin
             CODHandChargeFee.Ignore := False ;
             CODHandChargeFee.Text := CurrToStrF( prodform.baseproduct.get_unitprice, ffNumber, 2 ) ;
             BaseProduct.UIEventSink.ReferenceData('SET(CODHandChargeFee,'+CODHandChargeFee.Text+')');
             BaseProduct.UIEventSink.ReferenceData('SET(CODTradeChargeFee,'+CODTradeChargeFee.Text+')');
          end ;
       *]
       }
     }

   DeliveryItemPreLog {
      InsertBetween { '{PreLogTransactionStart}','{PreLogTransactionEnd}' }
      CodeBlock {
      [*
         if StrToCurrDef( ProdForm.CashFee.Text, 0 ) > 0 then
         begin
                TxnLog.SubLogVisible:=False;
                TxnLog.LogTransaction(
                         Index,
                         FQuantity, // Quantity
                         Get_PLU, // PLU
                         0, // Value
                         0, // Price
                         Get_Description, // Description
                         '', // Additional Info
                         Get_ProgramID, // ProgID
                         Enumerate(ProdForm));  // Domain Info
                Inc(Index);

               CustomerName:='';
               if ProdForm.FindComponent('CustomerName') <> nil then
                  if not TDomainEdit( ProdForm.FindComponent('CustomerName')).Ignore then
                   CustomerName:= TDomainEdit( ProdForm.FindComponent('CustomerName')).Text ;

                if (CustomerName <> '') then
                begin
                   TxnLog.LogTransaction(
                            Index,
                            FQuantity, // Quantity
                            Get_PLU, // PLU
                            0, // Value
                            0, // Price
                            'Customer Name', // Description
                            CustomerName, // Additional Info
                            Get_ProgramID, // ProgID
                            Enumerate(ProdForm));  // Domain Info
                   Inc(Index);
                end ;

               CustID_Delivery:='';
               if ProdForm.FindComponent('CustID_Delivery') <> nil then
                  if not TDomainEdit( ProdForm.FindComponent('CustID_Delivery')).Ignore then
                   CustID_Delivery:= TDomainEdit( ProdForm.FindComponent('CustID_Delivery')).Text ;


                if (CustID_Delivery <> '') then
                begin
                   TxnLog.LogTransaction(
                            Index,
                            FQuantity, // Quantity
                            Get_PLU, // PLU
                            0, // Value
                            0, // Price
                            'Identity Number', // Description
                            CustID_Delivery, // Additional Info
                            Get_ProgramID, // ProgID
                            Enumerate(ProdForm));  // Domain Info
                   Inc(Index);
                end ;

                if ProdForm.FindComponent('MailSurOrigin') <> nil then CountryOrg := TDomainEdit( ProdForm.FindComponent('MailSurOrigin')).Text ;
                if ProdForm.FindComponent('MailAirOrigin') <> nil then CountryOrg := TDomainCombo( ProdForm.FindComponent('MailAirOrigin')).Text ;
                if ProdForm.FindComponent('MailCODOrigin') <> nil then CountryOrg := TDomainCombo( ProdForm.FindComponent('MailCODOrigin')).Text ;                

                TxnLog.LogTransaction(
                         Index,
                         FQuantity, // Quantity
                         Get_PLU, // PLU
                         0, // Value
                         0, // Price
                         'Country', // Description
                         CountryOrg, // Additional Info
                         Get_ProgramID, // ProgID
                         Enumerate(ProdForm));  // Domain Info
                Inc(Index);


                if CombineList <> nil then
                   CombineList.LogTransactions(Index,TxnLog);

         end ;


       *]
       }
     }

   EmptyItemPreLog {
      InsertBetween { '{PreLogTransactionStart}','{PreLogTransactionEnd}' }
      CodeBlock {
      [*
       *]
       }
     }

   CustomerVoucherLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                Get_PLU, // PLU
                FQuantity*(-StrToCurrDef(ProdForm.AmountPaid.Text,0)), // Value
                -StrToCurrDef(ProdForm.AmountPaid.Text,0), // Price
                Get_Description, // Description
                '', // Additional Info
                Get_ProgramID, // ProgID
                Enumerate(ProdForm)); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Voucher Reference - ', // Description
                ProdForm.VoucherReference.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'Reason for Refund - ', // Description
                ProdForm.ReasonforRefund.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);
       *]
       }
     }


//  MailStampTriggerVar {
//      InsertBetween { '{TriggerStatusDevice0VarStart}','{TriggerStatusDevice0VarEnd}' }
//      CodeBlock {
//      [*
//         SL:TPackStringList;
//         I:Integer;
//         PrePayStampsFee:Currency;
//
//
//       *]
//       }
//     }

   MailStampTrigger {
      InsertBetween { '{TriggerStatusDevice0Start}','{TriggerStatusDevice0End}' }
      CodeBlock {
      [*
        SL:=TPackStringList.Create;
        SL.PackText:=Value;
        CombineList.ButtonFlags:=SL[2];
        SetFormData(SL[1],ProdForm);
        SwapData:='';
        if SL.Count > 3 then SwapData:=SL[3];

        for I:=1 to Length(SL[2]) do
           if SL[2][I] = '1' then
              FUIEventSink.DisplayItemInfo(Self,I,'','',0,BUTTON_ENABLED_DOWN,False,False);
        FlagComplete(ProdForm.Validate);

        //if StrToIntDef(ProdForm.BulkQuantity.Text,0) > 1 then
        // begin
        //   PrePayStampsFee:=0;
        // end
        // else
        // begin
        //   PrePayStampsFee := StrToCurrDef( FUIEventSink.ReferenceData('GET(PrePayStampsFee)'), 0 ) ;
        // end ;

       if ( SL[0] = 'Exit' ) and
          (CurrToStrF(GranTotal,ffNumber,2)=CurrToStrF(TotalStockSelected( SwapData ), ffNumber, 2))  then
          //(CurrToStrF(GranTotal+PrePayStampsFee,ffNumber,2)=CurrToStrF(TotalStockSelected( SwapData ), ffNumber, 2))  then
        begin
           UIEventSink.Restore
        end
        else
        begin
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
        end;
        SL.Free;

       *]
       }
     }

   GranVarAU {
      InsertBetween { '{VarAUStart}','{VarAUEnd}' }
      CodeBlock {
      [*
         var
            GranTotal:Currency;

       *]
       }
     }



}




