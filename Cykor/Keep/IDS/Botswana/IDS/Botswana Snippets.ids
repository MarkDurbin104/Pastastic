	ValidChangeMaskLetterReg {
  	InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
    CodeBlock {
       [*

        International := TRUE ;
        if FindComponent('MailAirDestination') <> nil then
        begin
          International := Not( UpperCase( TDomainCombo(FindComponent('MailAirDestination')).Text) = 'BOTSWANA' );
        end;
        if FindComponent('MailSurDestination') <> nil then
        begin
          International := Not( UpperCase( TDomainCombo(FindComponent('MailSurDestination')).Text ) = 'BOTSWANA' );
        end;

        if International then
        begin
          IntLetterRegFirstID.Validation := 'Mask(Rx@xxxxxxxxxx)' ;
          IntLetterRegLastID.Validation  := 'Mask(Rx@xxxxxxxxxx)'  ;
          PostOffice.ignore := true ;
        end
        else
        begin
          PostOffice.ignore := false ;
          IntLetterRegFirstID.Validation := 'Mask(Rx@xxxxxxxxxx)' ;
          IntLetterRegLastID.Validation  := 'Mask(Rx@xxxxxxxxxx)'  ;
        end ;

        if (StrToIntDef(BulkQuantity.Text,1) > 1) then
        begin
           IntRecipientName.Ignore:=true;
           if ((CurrentFieldName <> 'IntLetterRegLastID' ) or (CurrentFieldName = 'IntLetterRegLastID') and (IntLetterRegLastID.Text = '' ))
               and (IntLetterRegFirstID.Text <> '')  then
              IntLetterRegLastID.Text:=BaseProduct.CalcIDRange(IntLetterRegFirstID.Text,StrToIntDef(BulkQuantity.Text,1)-1);
           IntLetterRegLastID.Ignore:=False;
        end
        else
        begin
           IntLetterRegLastID.Ignore:=True;
           IntRecipientName.Ignore:=false;
        end;

        Result := True ;
//        if not IntLetterRegFirstID.Ignore then
//          Result := BaseProduct.CheckRegSum( IntLetterRegFirstID.Text ) ;

//        if Result and not IntLetterRegLastID.Ignore then
//           Result := ( BaseProduct.CheckRegSum( IntLetterRegLastID.Text ) and
//                       BaseProduct.ChequeIDRange( IntLetterRegFirstID.Text, IntLetterRegLastID.Text, StrToIntDef(BulkQuantity.Text,0) ) );

      *]
   }
   }

