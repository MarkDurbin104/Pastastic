   //PrePayStampsVALVar {
   //   InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
   //   CodeBlock {
   //   [*
   //      var
   //         TotalValue:Real;
   //   *]
   //   }
   //}


   PrePayStampsVAL {
      InsertBetween { '{ValidateStart}','{ValidateEnd}' }
      CodeBlock {
      [*
         Result:=CheckMaskEdits(Self);
         if not Result then
           MoveFocusTo(PrePaidStampValue);

         if (StrToCurrDef(PrePaidStampValue.Text, 0) > 0) then
         begin
           //result := (Trunc( StrToCurrDef(PrePaidStampValue.Text,0)*100 ) Mod 5) = 0  ;
           PrePaidStampValue.Text:=CurrToStrF(0 - StrToCurrDef(PrePaidStampValue.Text, 0),ffNumber,2);
         end ;

         BaseProduct.UIEventSink.ReferenceData('SET(PrePayStampsFee,'+PrePaidStampValue.Text+')');

      *]
      }
   }

   PrePayStampsLOG {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
        TxnLog.LogTransaction(
               Index,
               1, // Quantity
               Get_PLU, // PLU
               StrToCurrDef(ProdForm.PrePaidStampValue.Text,0), // Value
               StrToCurrDef(ProdForm.PrePaidStampValue.Text,0), // Price
               Get_Description, // Description
               CurrToStrF(Abs(StrToCurrDef(ProdForm.PrePaidStampValue.Text,0)),ffNumber,2),
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
        Inc(Index);
        if CombineList <> nil then
           CombineList.LogTransactions(Index,TxnLog);
    *]
    }
  }

