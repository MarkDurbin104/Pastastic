//------------------------------------------------------------------------------------------
//                                 Snippets for Stamp Sales
//------------------------------------------------------------------------------------------
//


   StampValidateVars {
      InsertBetween { '{PublicVarStart}','{PublicVarEnd}' }
      CodeBlock {
      [*
         TotalRequired:String;
      *]
      }
   }

//
//------------------------------------------------------------------------------------------
//
  StampValidate {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      Result := SufficientStockLeft(StampsList.Items,CurrentLine);
      If not Result then
      begin
        StampsList.ErrorText := 'Stamps not available';
      end;

      if TotalRequired <> '' then
      begin
        StampsList.Hint:='Enter Desired Quantities against each item^Total Value so far P'+TotalStockValue(StampsList.Items)+' , Postage Required P'+TotalRequired;
        If Result //stamps available but not selected
        and (StrToCurrDef(TotalStockValue(StampsList.Items),0) < StrToCurrDef(TotalRequired,999999)) then
        begin
          StampsList.ErrorText := 'Insufficient Stamps Selected^Total Value so far P'+TotalStockValue(StampsList.Items)+' , Postage Required P'+TotalRequired;
          Result := False;
        end;
      end
      else
        StampsList.Hint:='Enter Desired Quantities against each item^Total Value so far P'+TotalStockValue(StampsList.Items);
    *]
    }
  }

//
//------------------------------------------------------------------------------------------
//

   StampSwapVars {
      InsertBetween { '{PrivVarDecStart}','{PrivVarDecEnd}' }
      CodeBlock {
      [*
         BeenCancelled:Boolean;
         ProductName:String;
         ProductData:String;
         ButtonStates:String;
         CanExit:Boolean;
      *]
      }
   }

//
//------------------------------------------------------------------------------------------
//

   StampFillList {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         CanExit:=True;
         BeenCancelled:=False;
         ProdForm.TotalRequired:='';
         if UIEventSink <> nil then
         begin
            if not GetAvailableStock(ProdForm.StampsList,UIEventSink.User,'Stamps') then
            begin
               ProdForm.StampsList.Clear;
               ProdForm.StampsList.Text:='No Stock Available';
            end;
         end;
      *]
      }
   }

//
//------------------------------------------------------------------------------------------
//

   StampEnableComplete {
      InsertBetween { '{EnableCompleteStart}','{EnableCompleteEnd}' }
      CodeBlock {
      [*
         if Value then
         begin
            if CanExit then
               FUIEventSink.DisplayItemInfo(Self,0,'',ResItem00,0,0,False,False)
            else
               FUIEventSink.DisplayItemInfo(Self,0,'',ResItem00,0,0,True,False);
         end
         else
            FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
      *]
      }
   }

//
//------------------------------------------------------------------------------------------
//

   StampSwapTo {
      InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
         if Name = ResItem00 then
         begin
            CanExit:=True;
            if BeenCancelled then
               FUIEventSink.SwapTo(ProductName,#8+'Stay'+#8+ProductData+#8+ButtonStates+#8)
            else
               FUIEventSink.SwapTo(ProductName,#8+'Exit'+#8+ProductData+#8+ButtonStates+#8+ProdForm.StampsList.Items.CommaText);
            Exit;
         end;
      *]
      }
   }

//
//------------------------------------------------------------------------------------------
//

   StampOverrideDec {
      InsertBetween { '{OverrideDecStart}','{OverrideDecEnd}' }
      CodeBlock {
      [*
         procedure TriggerStatusDevice0(Value:String); override;
         function Get_CanTerminate:WordBool; override;
      *]
      }
   }

//
//------------------------------------------------------------------------------------------
//

  StampOverrideDef {
    InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
    CodeBlock {
    [*
      procedure {PClass}TStampsProduct.TriggerStatusDevice0(Value:String);
      var
        SL            : TPackStringList;
        BulkQuantity  : Integer;
      begin
        SL            := TPackStringList.Create;
        SL.PackText   := Value;
        ProductName   := SL[1];
        ProductData   := SL[2];
        If SL.Count > 3 then ButtonStates :=  SL[3];
        BulkQuantity  := 1;
        If SL.Count > 4 then BulkQuantity :=  StrToIntDef(SL[4],1);

        CanExit :=False;
        BeenCancelled :=False;
        //CalcStockDenoms(ProdForm.StampsList.Items,StrToCurrDef(SL[0],0));
        CalcMultiStockDenoms(ProdForm.StampsList.Items, StrToCurrDef(SL[0],0), BulkQuantity);
        ProdForm.TotalRequired := CurrToStrF(StrToCurrDef(SL[0],0) * BulkQuantity, ffNumber, CurrencyDecimals);
        if ProdForm.Validate then
          FUIEventSink.DisplayItemInfo(Self,0,'',ResItem00,0,0,True,False)
        else
          FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
        FUIEventSink.DataChanged(Self,ProdForm.StampsList.LineEditData,False);
        SL.Free;
      end;

      function {PClass}TStampsProduct.Get_CanTerminate:WordBool;
      begin
        Result:=CanExit;
        BeenCancelled:=True;
        if not CanExit then
        begin
          CanExit:=True;
          FUIEventSink.SwapTo(ProductName,#8+'Stay'+#8+ProductData+#8+ButtonStates+#8);
        end;
      end;
      *]
      }
   }


