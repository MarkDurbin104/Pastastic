   MailItemLogStamps {
      InsertBetween { '{PostLogTransactionStart}','{PostLogTransactionEnd}' }
      CodeBlock {
      [*
         try

            TxnLog.SubLogVisible:=False;
            if SwapData <> '' then
            begin

               List:=TDomainCombo.Create(nil);
               ProdForm.InsertControl(List);
               List.AssociatedProgId :='Log';
               List.Items.CommaText:=SwapData;
               SwapData:='';
               IndentStampLog:=Index;
               LogStock(TxnLog,List);
               IndentStampLog:=0;
               ProdForm.RemoveControl(List);
               List.Free;
            end;
         except
            on E:Exception do ShowMessage(E.Message);
         end;
      *]
      }
   }



   MailItemLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

         if ProdForm.FindComponent('BulkQuantity') <> nil then
         begin
            if StrToIntDef(TDomainEdit( ProdForm.FindComponent('BulkQuantity')).Text,0) < 1 then
               TDomainEdit( ProdForm.FindComponent('BulkQuantity')).Text:='1';
               FQuantity:=StrToIntDef( TDomainEdit(ProdForm.FindComponent('BulkQuantity')).Text,1)
         end 
         else
            FQuantity:=1;

         FUIEventSink.ReferenceData('SET(Quantity,'+IntToStr(FQuantity)+')');

         if ProdForm.FindComponent('StandardFee') <> nil then
         begin
             TxnLog.LogTransaction(
                      Index,
                      FQuantity, // Quantity
                      Get_PLU, // PLU
                      FQuantity*StrToCurrDef(TDomainEdit( ProdForm.FindComponent('StandardFee')).Text,0), // Value
                      StrToCurrDef(TDomainEdit( ProdForm.FindComponent('StandardFee')).Text,0), // Price
                      Get_Description, // Description
                      ProdForm.Weight.Text+' '+'g', // Additional Info
                      Get_ProgramID, // ProgID
                      Enumerate(ProdForm));  // Domain Info
             Inc(Index);
         end
         else if ProdForm.FindComponent('IndividualFee') <> nil then
         begin
             TxnLog.LogTransaction(
                      Index,
                      FQuantity, // Quantity
                      Get_PLU, // PLU
                      FQuantity*StrToCurrDef(TDomainEdit( ProdForm.FindComponent('IndividualFee')).Text,0), // Value
                      StrToCurrDef(TDomainEdit( ProdForm.FindComponent('IndividualFee')).Text,0), // Price
                      Get_Description, // Description
                      ProdForm.Weight.Text+' '+'g', // Additional Info
                      Get_ProgramID, // ProgID
                      Enumerate(ProdForm));  // Domain Info
             Inc(Index);
          end ;
          if ProdForm.FindComponent('CustomerName') <> nil then
          begin
             TxnLog.LogTransaction(
                      Index,
                      1, // Quantity
                      Get_PLU, // PLU
                      0, // Value
                      0, // Price
                      'Customer Name -', // Description
                      TDomainEdit( ProdForm.FindComponent('CustomerName')).Text, // Additional Info
                      Get_ProgramID, // ProgID
                      Enumerate(ProdForm));  // Domain Info
             Inc(Index);

          end;
          //if ProdForm.FindComponent('CustomerAddress') <> nil then
          //begin
          //   TxnLog.LogTransaction(
          //            Index,
          //            1, // Quantity
          //            Get_PLU, // PLU
          //            0, // Value
          //            0, // Price
          //            'Customer Address -', // Description
          //            TDomainEdit( ProdForm.FindComponent('CustomerAddress')).Text, // Additional Info
          //            Get_ProgramID, // ProgID
          //            Enumerate(ProdForm));  // Domain Info
          //   Inc(Index);
          //end;
          if ProdForm.FindComponent('AddresseeName') <> nil then
          begin
             TxnLog.LogTransaction(
                      Index,
                      FQuantity, // Quantity
                      Get_PLU, // PLU
                      0, // Value
                      0, // Price
                      'Recipient Name -', // Description
                      TDomainEdit( ProdForm.FindComponent('AddresseeName')).Text, // Additional Info
                      Get_ProgramID, // ProgID
                      Enumerate(ProdForm));  // Domain Info
             Inc(Index);

          end;
          if ProdForm.FindComponent('ParcelNumber') <> nil then
             begin
                TxnLog.LogTransaction(
                         Index,
                         FQuantity, // Quantity
                         Get_PLU, // PLU
                         0, // Value
                         0, // Price
                         'Parcel Number -', // Description
                         TDomainEdit( ProdForm.FindComponent('ParcelNumber')).Text, // Additional Info
                         Get_ProgramID, // ProgID
                         Enumerate(ProdForm));  // Domain Info
                Inc(Index);
             end;
      if ProdForm.FindComponent('MailSurDestination') <> nil then
      begin
             TxnLog.LogTransaction(
                    Index,
                    1, // Quantity
                    Get_PLU, // PLU
                    0, // Value
                    0, // Price
                    'To', // Description
                    TDomainCombo(ProdForm.FindComponent('MailSurDestination')).Text, // Additional Info
                    Get_ProgramID, // ProgID
                    ''); // Domain Info
              Inc(Index);
          end
          else
          if ProdForm.FindComponent('MailAirDestination') <> nil then
          begin
             TxnLog.LogTransaction(
                    Index,
                    1, // Quantity
                    Get_PLU, // PLU
                    0, // Value
                    0, // Price
                    'To', // Description
                    TDomainCombo(ProdForm.FindComponent('MailAirDestination')).Text, // Additional Info
                    Get_ProgramID, // ProgID
                    ''); // Domain Info
              Inc(Index);
          end
          else if ProdForm.FindComponent('ParAirDestination') <> nil then
          begin
             TxnLog.LogTransaction(
                    Index,
                    1, // Quantity
                    Get_PLU, // PLU
                    0, // Value
                    0, // Price
                    'To', // Description
                    TDomainCombo(ProdForm.FindComponent('ParAirDestination')).Text, // Additional Info
                    Get_ProgramID, // ProgID
                    ''); // Domain Info
              Inc(Index);
          end
          else if ProdForm.FindComponent('ParSurDestination') <> nil then
          begin
             TxnLog.LogTransaction(
                    Index,
                    1, // Quantity
                    Get_PLU, // PLU
                    0, // Value
                    0, // Price
                    'To', // Description
                    TDomainCombo(ProdForm.FindComponent('ParSurDestination')).Text, // Additional Info
                    Get_ProgramID, // ProgID
                    ''); // Domain Info
              Inc(Index);
          end ;

         if ( ProdForm.FindComponent('DiscountBulk') <> nil ) and
            ( StrToCurrDef( TDomainEdit(ProdForm.FindComponent('DiscountBulk')).Text,0) <> 0 ) then
          begin
             TxnLog.LogTransaction(
                    Index,
                    1, // Quantity
                    Get_PLU, // PLU
                    StrToCurrDef( TDomainEdit(ProdForm.FindComponent('DiscountBulk')).Text,0), // Value
                    StrToCurrDef( TDomainEdit(ProdForm.FindComponent('DiscountBulk')).Text,0), // Price
                    'Discount', // Description
                    '', // Additional Info
                    Get_ProgramID, // ProgID
                    ''); // Domain Info
              Inc(Index);
          end;

         if ( ProdForm.FindComponent('PostOffice') <> nil ) then
            if not ( TDomainCombo(ProdForm.FindComponent('PostOffice')).ignore ) then
            begin
               TxnLog.LogTransaction(
                      Index,
                      1, // Quantity
                      Get_PLU, // PLU
                      0, // Value
                      0, // Price
                      'Post Office ', // Description
                      TDomainCombo(ProdForm.FindComponent('PostOffice')).Text, // Additional Info
                      Get_ProgramID, // ProgID
                      ''); // Domain Info
                Inc(Index);
            end;


          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);

         FUIEventSink.ReferenceData('SET(Quantity,1)');
      *]
      }
   }

