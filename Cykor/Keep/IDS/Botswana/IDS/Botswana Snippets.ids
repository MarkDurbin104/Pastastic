   RegLogStart {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

        if ProdForm.FindComponent('IntLetterRegFirstID') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   Get_PLU, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
           if StrToIntDef(ProdForm.BulkQuantity.Text,1) = 1 then
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID '+' '+TDomainEdit(ProdForm.FindComponent('IntLetterRegFirstID')).Text, // Description
                     '', // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)) // Domain Info
            else
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID'+' '+TDomainEdit(ProdForm.FindComponent('IntLetterRegFirstID')).Text, // Description
                     ' - '+TDomainEdit(ProdForm.FindComponent('IntLetterRegLastID')).Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
         end ;


        if ProdForm.FindComponent('IntFrankRegFirstID') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   1, // Quantity
                   Get_PLU, // PLU
                   0, // Value
                   0, // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
           if StrToIntDef(ProdForm.BulkQuantity.Text,1) = 1 then
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID '+' '+TDomainEdit(ProdForm.FindComponent('IntFrankRegFirstID')).Text, // Description
                     '', // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)) // Domain Info
            else
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID'+' '+TDomainEdit(ProdForm.FindComponent('IntFrankRegFirstID')).Text, // Description
                     ' - '+TDomainEdit(ProdForm.FindComponent('IntFrankRegLastID')).Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
         end ;


        if ProdForm.FindComponent('IntAerogrammeRegFirstID') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   Get_PLU, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
           if StrToIntDef(ProdForm.BulkQuantity.Text,1) = 1 then
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID '+' '+TDomainEdit(ProdForm.FindComponent('IntAerogrammeRegFirstID')).Text, // Description
                     '', // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)) // Domain Info
            else
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID'+' '+TDomainEdit(ProdForm.FindComponent('IntAerogrammeRegFirstID')).Text, // Description
                     ' - '+TDomainEdit(ProdForm.FindComponent('IntAerogrammeRegLastID')).Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
         end ;


        if ProdForm.FindComponent('IntPostCardRegFirstID') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   Get_PLU, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
           if StrToIntDef(ProdForm.BulkQuantity.Text,1) = 1 then
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID '+' '+TDomainEdit(ProdForm.FindComponent('IntPostCardRegFirstID')).Text, // Description
                     '', // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)) // Domain Info
            else
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID'+' '+TDomainEdit(ProdForm.FindComponent('IntPostCardRegFirstID')).Text, // Description
                     ' - '+TDomainEdit(ProdForm.FindComponent('IntPostCardRegLastID')).Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
         end ;

        if ProdForm.FindComponent('IntPrintedPaperRegFirstID') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   Get_PLU, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
           if StrToIntDef(ProdForm.BulkQuantity.Text,1) = 1 then
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID '+' '+TDomainEdit(ProdForm.FindComponent('IntPrintedPaperRegFirstID')).Text, // Description
                     '', // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)) // Domain Info
            else
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID'+' '+TDomainEdit(ProdForm.FindComponent('IntPrintedPaperRegFirstID')).Text, // Description
                     ' - '+TDomainEdit(ProdForm.FindComponent('IntPrintedPaperRegLastID')).Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
         end ;

        if ProdForm.FindComponent('IntSmallPacketRegFirstID') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   Get_PLU, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('RegFee')).Text,0), // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
           if StrToIntDef(ProdForm.BulkQuantity.Text,1) = 1 then
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID '+' '+TDomainEdit(ProdForm.FindComponent('IntSmallPacketRegFirstID')).Text, // Description
                     '', // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)) // Domain Info
            else
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'ID'+' '+TDomainEdit(ProdForm.FindComponent('IntSmallPacketRegFirstID')).Text, // Description
                     ' - '+TDomainEdit(ProdForm.FindComponent('IntSmallPacketRegLastID')).Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
         end ;

        if ProdForm.FindComponent('PostOffice') <> nil then
           if not TDomainEdit(ProdForm.FindComponent('PostOffice')).ignore then
           begin
                 TxnLog.LogTransaction(
                        Index,
                        1, // Quantity
                        Get_PLU, // PLU
                        0, // Value
                        0, // Price
                        'Post Office ', // Description
                        TDomainEdit(ProdForm.FindComponent('PostOffice')).Text, // Additional Info
                        Get_ProgramID, // ProgID
                        Enumerate(ProdForm)); // Domain Info

               Inc(Index);
           end ;

        if not ProdForm.IntRecipientName.ignore then
        begin
              TxnLog.LogTransaction(
                     Index,
                     1, // Quantity
                     Get_PLU, // PLU
                     0, // Value
                     0, // Price
                     'Recipient Name ', // Description
                     ProdForm.IntRecipientName.Text, // Additional Info
                     Get_ProgramID, // ProgID
                     Enumerate(ProdForm)); // Domain Info

            Inc(Index);
        end ;






        if CombineList <> nil then
           CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }


