	ChequeProdFormCreated {
    InsertBetween { '{ProdFormCreatedStart}','{ProdFormCreatedEnd}' }
    CodeBlock {
    [*
    	ProdForm.TxnLog := TxnLog;
			ProdForm.TotalToPay.Text:=CurrToStrF(CurrentTxnTotal,ffNumber,2);

