   BagNewRentalLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

         if ProdForm.FindComponent('NumberYears') <> nil then
            FQuantity:=StrToIntDef( TDomainEdit(ProdForm.FindComponent('NumberYears')).Text,1)
         else
            FQuantity:=1;

         if ProdForm.FindComponent('PrivBagPurchase') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   1, // Quantity
                   Get_PLU, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('PrivBagPurchase')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('PrivBagPurchase')).Text,0), // Price
                   Get_Description, // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
         end ;

         if ProdForm.FindComponent('PrivBagAnnualRentFee') <> nil then
         begin
            TxnLog.LogTransaction(
                   Index,
                   FQuantity, // Quantity
                   030000030, // PLU
                   FQuantity*StrToCurrDef(TDomainEdit(ProdForm.FindComponent('PrivBagAnnualRentFee')).Text,0), // Value
                   StrToCurrDef(TDomainEdit(ProdForm.FindComponent('PrivBagAnnualRentFee')).Text,0), // Price
                   'Private Bag - Annual Rent', // Description
                   '', // Additional Info
                   Get_ProgramID, // ProgID
                   Enumerate(ProdForm)); // Domain Info
             Inc(Index);
         end  ;

         TxnLog.LogTransaction(
                Index,
                1, // Quantity
                030000030, // PLU
                0, // Value
                0, // Price
                'Bag Number ', // Description
                ProdForm.PrivBagNumber.Text, // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);

         TxnLog.LogTransaction(
                Index,
                1, // Quantity
                030000030, // PLU
                0, // Value
                0, // Price
                'Location -', // Description
                ProdForm.PostOffice.Text, // Additional Info
                Get_ProgramID, // ProgID
                ''); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                1, // Quantity
                030000030, // PLU
                0, // Value
                0, // Price
                'Customer Name -', // Description
                ProdForm.CustomerName.Text, // Additional Info
                Get_ProgramID, // ProgID
                ''); // Domain Info
          Inc(Index);
         TxnLog.LogTransaction(
                Index,
                1, // Quantity
                030000030, // PLU
                0, // Value
                0, // Price
                'Customer Telephone no. -', // Description
                ProdForm.CustomerTelNo.Text, // Additional Info
                Get_ProgramID, // ProgID
                ''); // Domain Info
          Inc(Index);
          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);

      *]
      }
   }


