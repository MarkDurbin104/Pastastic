//
//------------------------------------------------------------------------------------------
//

	ChequeFormVars {
    InsertBetween { '{PublicVarStart}','{PublicVarEnd}' }
    CodeBlock {
    [*
			TxnLog : ITransactionLog;
    *]
    }
   }

//
//------------------------------------------------------------------------------------------
//

	ChequeValidVars {
    InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
    CodeBlock {
    [*
    	var
      	Chg										: System.Currency;
        CashPaid							: System.Currency;
        TxnLogIndex 					: Integer;
        TxnLogPackStringList	: TPackStringList;
        TxnLinePackStringList	: TPackStringList;
    *]
    }
   }

//
//------------------------------------------------------------------------------------------
//

	ValidCheque {
  	InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      if AmountPaid.Text = '' then
         AmountPaid.Text:=CurrToStrF(BaseProduct.CurrentTxnTotal,ffNumber,2);
			Result := False;
      ClearFocus(ProdForm);
//--------------------------------------------------------------
      //calc cash paid in customer session
      CashPaid := 0;
      If TxnLog = nil then Exit;
      Result := True;
      TxnLogPackStringList 	:= TPackStringList.Create;
      TxnLinePackStringList := TPackStringList.Create;
      try
        //grab on-screen txnlog
        TxnLogPackStringList.PackText := TxnLog.Contents;

        //go back through txns
        For TxnLogIndex := TxnLog.ItemCount -1  downto 0 do
        begin
          //grab txnline
          TxnLinePackStringList.PackText :=TxnLogPackStringList.Strings[TxnLogIndex];
          //add custom duty value
          If (TxnLinePackStringList.Count > 7)
          and ((TxnLinePackStringList[7] = 'Product.Cash'    )
          or   (TxnLinePackStringList[7] = 'Product.Currency')) then
            CashPaid := CashPaid + StrToCurrDef(TxnLinePackStringList[4],0);
        end;
        //nb cashpaid is -ve

      finally
        TxnLinePackStringList.Free;
        TxnLogPackStringList.Free;
      end;
//--------------------------------------------------------------------

      if (StrToCurrDef(AmountPaid.Text,0) > BaseProduct.CurrentTxnTotal - CashPaid) then
      begin
         MoveFocusTo(AmountPaid);
         Result:=False;
      end
      else if (AccountNumber.Text = '') then
      begin
         MoveFocusTo(AccountNumber);
         Result:=False;
      end
      else if (ChequeNumber.Text = '') then
      begin
         MoveFocusTo(ChequeNumber);
         Result:=False;
      end
      else
      begin
					Chg   := StrToCurrDef(AmountPaid.Text,0) - BaseProduct.CurrentTxnTotal;
          if Chg > 0 then
              Change.Text:=CurrToStrF(Chg,ffNumber,2)
           else
              Change.Text:='0.00';
      end;
    *]
     }
   }

//
//------------------------------------------------------------------------------------------
//

   LogChequeVars {
   		InsertBetween { '{LogTransactionVarStart}', '{LogTransactionVarEnd}' }
      CodeBlock {
      [*
      	var
            SL : TPackStringList;
  				SLCommaText : String;
            Stock:IStock;
      *]
      }
   }


//
//------------------------------------------------------------------------------------------
//

   LogCheque {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
      //Endorse Cheque-----------------------------------------------------------------------
          SL:=TPackStringList.Create;
          try
            SL.Add('                                   BotswanaPost');
            SL.Add('                                   ' + DateTimeToStr(Now));
            SL.Add('                                   ' + 'Amount Paid : ' + ' P' + ProdForm.AmountPaid.Text);
            SL.Add('                                   ' + 'Clerk : ' + FUIEventSink.User );
            SL.Add('                                   '
                    + Format(
                    				'%5.5d%2.2d%7.7d',
				            				[
                            	StrToIntDef(GetGPCSRegString('OfficeInfo', 'Office ID','0'),0),
										StrToIntDef(GetGPCSRegString('Workstation', 'Ident', '0'),0),
                              StrToIntDef(GetGPCSRegString('Counters\Customer Session', 'CurrentValue','0'),0)
                            ]
                    )
            );
            FUIEventSink.DisplayInstructions(isBMPRightText,
                                            'Insert the Cheque into the slip printer, until the green light comes on',
                                            'Insert Receipt');
            SLCommaText := SL.CommaText;
            SL.Free;
            If not FUIEventSink.Endorse(0,0,0,SLCommaText) then
            begin
              FUIEventSink.DisplayInstructions(isRestore,'','');
              TerminateExecute(TxnLog);
              Exit;	//failed to ensdorse
            end;
            FUIEventSink.DisplayInstructions(isRestore,'','');
          finally
          end;
       //---------------------------------------------------------------------
          TxnLog.LogTransaction( Index
                                ,FQuantity
                                ,Get_PLU
                                ,0-StrToCurrDef(ProdForm.AmountPaid.Text,0)
                                ,0-StrToCurrDef(ProdForm.AmountPaid.Text,0)
                                ,Get_Description
                                ,''
                                ,{PProgID}'Product.Cheque'
                                ,Enumerate(ProdForm));
          Inc(Index);
          TxnLog.LogTransaction( Index
                                ,FQuantity
                                ,Get_PLU
                                ,0
                                ,0
                                ,'Account Number :'
                                ,ProdForm.AccountNumber.Text
                                ,{PProgID}'Product.Cheque'
                                ,Enumerate(ProdForm));
          Inc(Index);
          TxnLog.LogTransaction( Index
                                ,FQuantity
                                ,Get_PLU
                                ,0
                                ,0
                                ,'Cheque Number :'
                                ,ProdForm.ChequeNumber.Text
                                ,{PProgID}'Product.Cheque'
                                ,Enumerate(ProdForm));
          Inc(Index);
          if StrToCurrDef(ProdForm.Change.Text,0) > 0 then
          begin
            TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                                  StrToCurrDef(ProdForm.Change.Text,0),
                                  StrToCurrDef(ProdForm.Change.Text,0),
                                  ProdForm.Change.PromptLabel.Caption,
                                  '',{PProgID}'Product.Cheque','Change');
            Inc(Index);
          end;


         Stock:=CreateStock;
         TxnLog.WriteTransaction('StockUsed'
                                ,0
                                ,-Trunc((StrToCurrDef(ProdForm.AmountPaid.Text,0))*100)
                                ,6100000
                                ,0.01
                                ,0.01
                                ,'Cheques'
                                ,''
                                ,'Product.Cheque'
                                ,'');

         try
            Stock.AdjustStockLevel(TxnLog.User
                                  ,'*Cheques'
                                  ,-Trunc((StrToCurrDef(ProdForm.AmountPaid.Text,0))*100));
         except
            // Error in Stock
         end;
         Stock := nil ;

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);

          FUIEventSink.OpenCashDrawer;
      *]
      }
   }


