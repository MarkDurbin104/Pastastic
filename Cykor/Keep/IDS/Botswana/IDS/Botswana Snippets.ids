  ParcelMailSWAPTO {
    InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*

         if (Name = 'Product.Stamps') then
         begin

            if (CombineList.IndexOf('Product.PrePaidStamps') >= 0) and
               CombineList.IsEnabled('Product.PrePaidStamps') then
               if ( StrToCurrDef( ProdForm.TotalFee.Text,0 ) <= 0 ) then
                  ValidateOK := False
               else
                  ValidateOK := (Trunc( StrToCurrDef(ProdForm.TotalFee.Text,0)*100 ) Mod 5) = 0  ;

            if ValidateOK and (FindTotalField(ProdForm) <> nil) then
               FUIEventSink.SwapTo(Name,#8+TotalWithoutAdvDel(ProdForm)+#8+Get_ProgramID+#8+GetFormData(ProdForm)+#8+CombineList.ButtonFlags)
            else
            begin
               FUIEventSink.DisplayItemInfo(Self,Index,'','',0,BUTTON_ENABLED_UP,False,False);
               FlagComplete(ProdForm.Validate);
            end ;

            Exit;

         end;

      *]
    }
  }


  MailSWAPTO {
    InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*

      GranTotal := StrToCurrDef( ProdForm.TotalFee.Text,0 )*StrToIntDef(ProdForm.BulkQuantity.Text,0);
      if (Name = 'Product.Stamps') then
      begin

         if (CombineList.IndexOf('Product.PrePaidStamps') >= 0) and
            CombineList.IsEnabled('Product.PrePaidStamps') then
            if ( StrToCurrDef( ProdForm.TotalFee.Text,0 ) <= 0 ) then
               ValidateOK := False
            else
               ValidateOK := (Trunc( StrToCurrDef(ProdForm.TotalFee.Text,0)*100 ) Mod 5) = 0  ;

            //pass bulk quantity to swapto
            if ValidateOK and (FindTotalField(ProdForm) <> nil) then
               FUIEventSink.SwapTo(Name,
                                    #8+ProdForm.TotalFee.Text+
                                    #8+Get_ProgramID+
                                    #8+GetFormData(ProdForm)+
                                    #8+CombineList.ButtonFlags+
                                    #8+ProdForm.BulkQuantity.Text)
              //FUIEventSink.SwapTo(ProductName,#8+'Exit'+#8+ProductData+#8+ButtonStates+#8+ProdForm.StampsList.Items.CommaText+#8+ProdForm.BulkMailQuantity.Text);
            else
            begin
               FUIEventSink.DisplayItemInfo(Self,Index,'','',0,BUTTON_ENABLED_UP,False,False);
               FlagComplete(ProdForm.Validate);
            end ;

            exit;
      end;

      *]
    }
  }

  AirLetterNOTIFYVAR {
    InsertBetween { '{NotifyVarStart}','{NotifyVarEnd}' }
      CodeBlock {
      [*
         TotalFee,
         PrePayVal,
         IRCVal    : Currency;
      *]
    }
  }

  AirLetterSWAPTO {
    InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
         GranTotal := StrToCurrDef( ProdForm.TotalFee.Text,0 )*StrToIntDef(ProdForm.BulkQuantity.Text,0);
         if (Name = 'Product.Stamps') then
         begin
            if (CombineList.IndexOf('Product.PrePaidStamps') >= 0) and
               CombineList.IsEnabled('Product.PrePaidStamps') then
            begin
               TotalFee :=StrToCurrDef(ProdForm.TotalFee.Text,-100);
               PrePayVal:=StrToCurrDef(FUIEventSink.ReferenceData('GET(PrePayStampsFee)'),0);
               IRCVal   :=StrToCurrDef(FUIEventSink.ReferenceData('GET(IRCValue)'),0);
               if CombineList.IsSelected('Product.PrePaidStamps')=FALSE then
                 PrePayVal:=0;
               if CombineList.IsSelected('Product.AirLetterRedeemIRC')=FALSE then
                 IRCVal:=0;
               if (StrToCurrDef(ProdForm.TotalFee.Text,0) <= 0) or
                  (abs(PrePayVal + IRCVal) > (TotalFee + abs(PrePayVal))) then
                  ValidateOK := False
               else
                  ValidateOK := (Trunc( StrToCurrDef(ProdForm.TotalFee.Text,0)*100 ) Mod 5) = 0;
            end;
            //pass bulk quantity to swapto
            if ValidateOK and (FindTotalField(ProdForm) <> nil) then
               FUIEventSink.SwapTo(Name,
                                    #8+ProdForm.TotalFee.Text+
                                    #8+Get_ProgramID+
                                    #8+GetFormData(ProdForm)+
                                    #8+CombineList.ButtonFlags+
                                    #8+ProdForm.BulkQuantity.Text)
            else
            begin
               FUIEventSink.DisplayItemInfo(Self,Index,'','',0,BUTTON_ENABLED_UP,False,False);
               FlagComplete(ProdForm.Validate);
            end;

            exit;
         end;
      *]
    }
  }

  DeliverySWAPTO {
    InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
      MutualAction( Name, 'CustomsDutySA,CustomsDutyBotswana,CustomsDutySANoHandling,CustomsDutyBotswanaNoHandling', [maDeSelect] ) ;

      //if Name = 'Product.CustomsDutyBotswana' then
      //   if CombineList.IsSelected('Product.CustomsDutySA') and
      //      CombineList.IsEnabled('Product.CustomsDutySA') then
      //      CombineList.ForceDeSelect('Product.CustomsDutySA');

      //if Name = 'Product.CustomsDutySA' then
      //   if CombineList.IsSelected('Product.CustomsDutyBotswana') and
      //      CombineList.IsEnabled('Product.CustomsDutyBotswana') then
      //      CombineList.ForceDeSelect('Product.CustomsDutyBotswana');

      if (Name = 'Product.Stamps') then
      begin
        //pass bulk quantity to swapto
        if ValidateOK and (FindTotalField(ProdForm) <> nil) then
           FUIEventSink.SwapTo(Name,
                                 #8+ProdForm.StampFee.Text+
                                 #8+Get_ProgramID+
                                 #8+GetFormData(ProdForm)+
                                 #8+CombineList.ButtonFlags+
                                 #8+'1')

        else
           FUIEventSink.DisplayItemInfo(Self,Index,'','',0,BUTTON_ENABLED_UP,False,False);
        Exit;
      end;
      *]
    }
  }



  BulkNotifyChild {
    InsertBetween { '{SwapToStart}','{SwapToEnd}' }
    CodeBlock {
    [*
      // Happened Opposite because it receives the event before changing
      if  ( ProdForm.IndividualFee.Text <> 'Invalid' ) then
      begin
        if ( StrToIntDef( ProdForm.BulkQuantity.Text, 0 ) < 500 ) then
        begin
         ProdForm.DiscountBulk.Text := '0.00' ;
        end
        else
        begin
          if ( ProdForm.IndividualFee.Text <> '' ) and (ProdForm.BulkQuantity.Text<> '') then
            if not ProdForm.BaseProduct.CombineList.IsSelected('Product.Sorted') then // will change to Selected
              ProdForm.DiscountBulk.Text := CurrToStrF( -( StrToCurr(ProdForm.IndividualFee.Text)*
                                                           StrToCurr(ProdForm.BulkQuantity.Text) *
                                                           (5/100)
                                                            ),ffNumber,2)

            else
               //ProdForm.DiscountBulk.Text := CurrToStrF( -( StrToCurr(ProdForm.IndividualFee.Text)*
               //                                             StrToCurr(ProdForm.BulkQuantity.Text) *
               //                                             (2/100)
               //                                             ),ffNumber,2) ;
               ProdForm.DiscountBulk.Text := '0.00';  // no discount for unsorted as from 1 May 2004
            end ;
        end;
        //FlagComplete(ProdForm.Validate);
        MutualAction( Name, 'Sorted,UnSorted', [maDeSelect] ) ;        
        FUIEventSink.DataChanged(Self,GetFormData(ProdForm),not ValidateOK);
      *]
    }
  }

