//
//------------------------------------------------------------------------------------------
//

  CalcChangeVars { InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
                   CodeBlock     { [*
                                      var
                                         Amount:Currency;
                                         Cng   :Currency;
                                         Total :Currency;
                                    *] }
                  }
//
//------------------------------------------------------------------------------------------
//

   CalcChange {
      InsertBetween { '{ValidateStart}','{ValidateEnd}' }
      CodeBlock {
      [*
          AmountPaid.Hint:='Amount to pay: '+CurrToStrF(ApplyRounding(BaseProduct.CurrentTxnTotal),ffNumber,2);
          if StrToInt(BaseProduct.UIEventSink.ReferenceData('ClerkLevel')) >= 2 then
          begin
             if AmountPaid.Text = '' then
                AmountPaid.Text:=CurrToStrF(ApplyRounding(BaseProduct.CurrentTxnTotal),ffNumber,2);
          end;
          if AmountPaid.Text = '' then
             Result:=False
          else
             Result:=True;
          if (ApplyRounding(BaseProduct.CurrentTxnTotal) <> BaseProduct.CurrentTxnTotal) then
          begin
             Thebe5Adjustment.Ignore:=False;
             Thebe5Adjustment.Text:=CurrToStrF(ApplyRounding(BaseProduct.CurrentTxnTotal) - BaseProduct.CurrentTxnTotal,ffNumber,2);
          end
          else
             Thebe5Adjustment.Ignore:=True;

            Total :=ApplyRounding(BaseProduct.CurrentTxnTotal);
          Amount:=StrToCurrDef(AmountPaid.Text,0);
          Cng   :=Amount-Total;
          if Cng > 0 then
              Change.Text:=CurrToStrF(Cng,ffNumber,2)
           else
              Change.Text:='0.00';
      *]
      }
   }
//
//------------------------------------------------------------------------------------------
//

   LogNegativeCash {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         if TxnLog.Total < 0 then
         begin
            ProdForm.AmountPaid.Text := CurrToStrF(ApplyRounding(TxnLog.Total), ffNumber, 2 ) ;
            ProdForm.Validate;
            ProdForm.AmountPaid.Text := CurrToStrF(ApplyRounding(TxnLog.Total), ffNumber, 2 ) ;
            UIEventSink.Restore ;
         end ;
      *]
      }
   }

   LogCash5ThebeVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
       [*
               var
               ThebeAdjustmentPLU:Integer;
       *]
     }
   }

   LogCash {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         FUIEventSink.OpenCashDrawer;
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                               0-StrToCurrDef(ProdForm.AmountPaid.Text,0),
                               0-StrToCurrDef(ProdForm.AmountPaid.Text,0),
                               Get_Description,'',{PProgID}'Product.Cash',
                               Enumerate(ProdForm));
         Inc(Index);

         ThebeAdjustmentPLU := 0;
         if StrToCurrDef(ProdForm.Thebe5Adjustment.Text,0) <> 0 then
         begin

                             //  Check the 5 thebe adjustment in relation to a receipt or a payment
                             //  and set the PLU accordingly.
                             //  This is needed for the Cash Account

            if StrToCurrDef(ProdForm.Amountpaid.Text, 0) > 0 then        // "Receipt" type product
            begin
               if StrToCurrDef(ProdForm.Thebe5Adjustment.Text,0) >0 then
                  ThebeAdjustmentPLU := 1000001 // Receipt
               else // <0
                  ThebeAdjustmentPLU := 1000002; // Payment
            end;
            if StrToCurrDef(ProdForm.Amountpaid.Text, 0) < 0 then       // "Payment" type product
            begin
               if StrToCurrDef(ProdForm.Thebe5Adjustment.Text,0) >0 then
                  ThebeAdjustmentPLU := 1000004  // Payment
               else // <0
                  ThebeAdjustmentPLU := 1000003;  // Receipt
            end;

            TxnLog.LogTransaction( Index
                                  ,FQuantity
                                  ,ThebeAdjustmentPLU
                                  ,StrToCurrDef(ProdForm.Thebe5Adjustment.Text,0)
                                  ,StrToCurrDef(ProdForm.Thebe5Adjustment.Text,0)
                                  ,'5 Thebe Adjustment'
                                  ,''
                                  ,{PProgID}'Product.Thebe5Adj'
                                  ,Enumerate(ProdForm));
            Inc(Index);
         end ;

          if StrToCurrDef(ProdForm.Change.Text,0) > 0 then
         begin
            TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                                  StrToCurrDef(ProdForm.Change.Text,0),
                                  StrToCurrDef(ProdForm.Change.Text,0),
                                  ProdForm.Change.PromptLabel.Caption,
                                  '',{PProgID}'Product.Cash','Change');
            Inc(Index);
         end;
      *]
      }
   }
