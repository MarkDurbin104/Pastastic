      Title { 'Postal Order Customers' }
      Prompt { 'Select a Service or Menu' }
      Hint { 'Select a service by pressing a Function Key^or by using the arrow keys and pressing [ENTER]' }
      Bitmap { '..\images\G_POSuperMain.bmp' }
      Items {
         'Product.AddModPOCust'
         'Product.DelPOCust'
         //'Product.CustPOStatement'
         //'Product.CustPOTransact'
      }
   }
}


