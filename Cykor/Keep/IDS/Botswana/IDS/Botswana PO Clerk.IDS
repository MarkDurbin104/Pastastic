   AddModPOCust {
      BasedOn{ BasePOSuper }
      Caption { 'Add/Modify Postal Order Customer' }
      Bitmap { '..\images\P_AddModStockItem.bmp' }
      Description  { 'Add/Modify Postal Order Customer' }
      Title        { 'Add/Modify Postal Order Customer' }
      Domains {
         CustomerList
         CustomerName
         CustomerPOType
         CustomerNumber
         CustomerAdd1
         CustomerAdd2
         CustomerPOBox
         CustomerTelNo
      }
      Items {
         'Complete'
      }
      Snippets {
         CustomerPOListFill
         CustomerListDec
         CustomerPOListDef
         CustomerListUses
         CustomerListVars
         CustomerPOListLog
      }
      PLU { PLU_POAddModCust }
   }

   DelPOCust {
      BasedOn{ BasePOSuper }
      Caption { 'Delete Postal Order Customer' }
      Bitmap { '..\images\P_DelStockItem.bmp' }
