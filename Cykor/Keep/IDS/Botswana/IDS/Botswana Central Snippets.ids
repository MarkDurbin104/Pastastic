	 	         end;
	 	         with TStringList.Create do
	 	         begin
	 	            for i:=0 to ReportLines.Count-1 do
	 	            begin
	 	               CommaText:=ReportLines[i];
	 	               TotalVal   := TotalVal  + StrToCurrDef(Strings[2],0);
	 	               TotalComm  := TotalComm + StrToCurrDef(Strings[3],0);
	 	               TotalPaid  := TotalPaid + (StrToCurrDef(Strings[2],0) + StrToCurrDef(Strings[3],0));
	 	               Strings[0] := '<' + Strings[0];
	 	               Strings[1] := '<' + Strings[1];
	 	               Strings[2] := '<' + CurrToStrF(StrToCurrDef(Strings[2],0),ffNumber,2);
	 	               Strings[3] := '<' + CurrToStrF(StrToCurrDef(Strings[3],0),ffNumber,2);
