	 	                           + ' and Teller = ''' + ProdForm.UserName.Text + ''''
	 	                           + ' and Period = ' + StrToPeriod(ProdForm.StartDomainEdit.Text));
	 	               end
	 	               else
	 	               begin
	 	               Lines := TTxnTranslate.TranslateQuery('',
	 	                             ' select * from TxnLog'
	 	                           + ' where PLU IN(50021006)'
	 	                           + ' and Period = ' + StrToPeriod(ProdForm.StartDomainEdit.Text));
	 	               end;
	 	               Lines.ConvertToTable('C:\Botswana\Database','ReportResult');
	 	               with TQueryMap.Create do
	                   begin
	 	                  DataAlias := 'C:\Botswana\DataBase';
	 	                  ClearMaps;
	                   if Lines.Count > 0 then
	                   begin
	                      SelectFields := 'OrderNumber,Identification,CountryOfOrigin,ItemValue';
	                      ResultFields := 'OrderNumber,Identification,CountryOfOrigin,ItemValue';
	                      if ProdForm.UserName.Text <> 'All' then
	                      begin
	                         SQL :=
	                         '  select OrderNumber,Identification,CountryOfOrigin,ItemValue from ReportResult'
	                       + ' where PLU = 50021006 and Teller = ''' + ProdForm.UserName.Text + '''';
	                      end
	                      else
