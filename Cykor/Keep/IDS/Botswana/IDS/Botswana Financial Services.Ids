   BulkMOPaymentsLog  {
   InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
        CodeBlock {
        [*
     TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0-(FQuantity*StrToCurrDef(ProdForm.Amount.Text,0)), // Value
               0-StrToCurrDef(ProdForm.Amount.Text,0), // Price
               Get_Description, // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Company Name -', // Description
               ProdForm.BulkMOCompany.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Collected by -', // Description
               ProdForm.BulkMORepName.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Identification -', // Description
               ProdForm.BulkMORepID.Text, // Additional Info
               Get_ProgramID, // ProgID
               ''); // Domain Info
         Inc(Index);
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
           *]
        }
    }

   CustomerFillPO {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         SL:=TPackStringList.Create;
         SL.PackText:=GetLocalList('Customer','MOD');
         ProdForm.BulkMOCompany.Items.Text:=SL.Text;
         SL.Free;
      *]
      }
   }

   BulkMOPaymentExeVar {
      InsertBetween { '{ExecuteVarStart}','{ExecuteVarEnd}' }
      CodeBlock {
      [*
         var
            SL:TPackStringList;
      *]
      }
   }


}



