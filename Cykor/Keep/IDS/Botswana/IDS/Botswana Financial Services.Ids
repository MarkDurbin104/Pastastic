      POSerialNumber
      PostalOrderValue
      POValue
    }
    Items { 'Complete' }
    PLU { PLU_PostalOrderPay }
    Snippets {
      BulkBoxUses
      PostalOrderPayValidate
      PostalOrderPayValidateVar
      PostalOrderTrigger
      PostalOrderPayTriggerDef
      PostalOrderPayExecute
      PostalOrderPayLog
    }
    Customer { 'Postal Order Pay ','^','Total ','P',TotalFee }
  }

  PostalOrderPayInt {
    BasedOn     { BaseFinancial                                            }
    Caption { 'Pay Foreign Postal Order' }
