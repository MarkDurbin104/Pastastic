//---------------------------------------------------------------------------------
//



  PostalOrderBulkPay {
    BasedOn { BaseFinancial                                   }
    Caption { 'Pay Bulk Postal Orders'                        }
    BitMap  { 'e:\projects\botswana\images\P_PostalOrder.bmp' }
    Domains {
      PostalOrderBulkPayCompany
      PostalOrderBulkPayRepName
      PostalOrderBulkPayRepID
      POSerialNumber
      PostalOrderValue
      POValue
    }
    Items {
      'Complete'
      'Next Postal Order'
    }
    PLU   { PLU_PostalOrderPayBulk }
    Snippets {
      BulkBoxUses
      PostalOrderBulkPayEXECUTE
      PostalOrderPayValidate
      PostalOrderPayValidateVar
      PostalOrderBulkPayNOTIFY
      PostalOrderTrigger
      PostalOrderBulkPayTriggerDef
      PostalOrderPayExecute
      PostalOrderBulkPayLOG
    }
    Customer { 'Postal Order Pay ','^','Total ','P',TotalFee }
  }

  PostalOrderPay {
    BasedOn     { BaseFinancial                                            }
    Caption { 'Pay Postal Order' }
    BitMap      { 'e:\projects\botswana\images\P_PostalOrder.bmp'          }
