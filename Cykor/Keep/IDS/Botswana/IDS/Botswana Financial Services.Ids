   PostalOrderTrigger {
     InsertBetween { '{OverrideDecStart}','{OverrideDecEnd}' }
     CodeBlock {
       [*
          procedure TriggerBarCode(Value:String); override;
       *]
     }
   }

//--------

   PostalOrderTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*

     procedure {PClass}TFinPostalOrderProduct.TriggerBarCode(Value:String);
         var
            b : WordBool ;
         begin
            ProdForm.POSerialNumber.Text := Value ;

            SetExecData( GetExecData, b );

            //CompleteExecute ;

            if not FlagComplete(ProdForm.Validate) then
               FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False)
            else
            begin
               FUIEventSink.Restore ;
            end ;

         end;

       *]
     }
   }

   PostalOrderPayTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*

         procedure {PClass}TPostalOrderPayProduct.TriggerBarCode(Value:String);
         begin
            ProdForm.POSerialNumber.Text := Value;
            MoveFocusTo(ProdForm.PostalOrderValue);
            FlagComplete(ProdForm.Validate);
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
         end;

       *]
     }
   }

   PostalOrderBulkPayTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*

         procedure {PClass}TPostalOrderPayProduct.TriggerBarCode(Value:String);
         begin
            ProdForm.POSerialNumber.Text := Value;
            MoveFocusTo(ProdForm.PostalOrderValue);
//            FlagComplete(ProdForm.Validate);
            FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
            if (ProdForm.Validate) then
            begin
              //save this postal orders details
              if StrToFloatDef(ProdForm.POValue.Text,0) <> 0 then
              begin
                With TPackStringList.Create do
                begin
                  try
                    PackText:=AdditionalInfo; //previous postal orders
                    Add(ProdForm.POSerialNumber.Text);
                    Add(ProdForm.PostalOrderValue.Text);
                    Add(ProdForm.POValue.Text);
                    AdditionalInfo := PackText;
                  finally
                    Free;
                  end;
                end; //with TPackStringList
              end;  //PO Value filled

              //blank the screen
              ProdForm.POSerialNumber.Text    := '';
              ProdForm.PostalOrderValue.Text  := '';
              ProdForm.POValue.Text           := '';
              ProdForm.TotalFee.Text          := '0.00';

              FlagComplete(True);
              FUIEventSink.DataChanged(Self,GetFormData(ProdForm),not ValidateOK);
            end
            else
            begin
              ProdForm.POSerialNumber.Text    := Value;
              ProdForm.PostalOrderValue.Text  := '';
              ProdForm.POValue.Text           := '';
              ProdForm.TotalFee.Text          := '0.00';
              if (AdditionalInfo <> '') then  // allow to complete as long as at leat one PO added to list
                FlagComplete(True);
            end;
         end;

       *]
     }
   }

   PostalOrderPayExecute {
     InsertBetween { '{PostExecuteStart}','{PostExecuteEnd}' }
     CodeBlock {
       [*
         ProdForm.PostalOrderValue.Enabled := False ;
       *]
     }
   }

   PostalOrderExecute {
     InsertBetween { '{PostExecuteStart}','{PostExecuteEnd}' }
     CodeBlock {
       [*
         ProdForm.PostalOrderValue.Enabled := False ;
       *]
     }
   }


//--------


   EndorsePostalOrder {
      InsertBetween { '{EndorseStart}','{EndorseEnd}' }
      CodeBlock {
      [*

         FUIEventSink.DisplayInstructions(isBMPRightText,'"Insert the Postal Order into the slip printer, until the green light comes on"','Insert Postal Order');

         SL:=TStringList.Create;
         SL.Add('   ');
         SL.Add('                                                       '+IntToStr(FUIEventSink.Office));
         SL.Add('                                                     '+DateToStr(Now));
         SL.Add('                                                     '+TimeToStr(Now));
         SL.Add('                                                     '+FUIEventSink.User);
         SL.Add('                                                       '+ProdForm.Commission.Text);
         FUIEventSink.Endorse(0,0,2,SL.CommaText);
         FUIEventSink.DisplayInstructions(isRestore,'','');

         SL.Free; {CodeChange}
      *]
      }
   }

   LogPostVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
      [*
         var
            Value:Currency;
            SL:TStringList;
            Stock:IStock;
      *]
      }
   }

   PostalOrderLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
        Value:=StrToCurrDef(ProdForm.POValue.Text,0);
        TxnLog.LogTransaction(Index,FQuantity,5100000+Trunc(Value*10),Value,Value,Get_Description,
                               ' No. '+ProdForm.POSerialNumber.Text,
                               Get_ProgramID,Enumerate(ProdForm));
        Inc( Index ) ;
        Stock:=CreateStock;
        TxnLog.WriteTransaction('StockUsed',0,FQuantity,5100000+Trunc(Value*10),
                                 FQuantity*Value,Value,'P'+CurrToStrF(Value, ffNumber, 2)+' Postal Order','','Product.PostOrd','');
        try
          Stock.AdjustStockLevel(TxnLog.User,'*'+'P'+CurrToStrF(Value, ffNumber, 2)+' Postal Order',0-FQuantity);
        except
         On E : Exception do
          RaiseGUIDException('{849CE0E4-D769-467C-96E8-45AD4F1A8F2D}', E);  // Error in Stock
        end;
        Stock := nil ;

        Value:=StrToCurrDef(ProdForm.Commission.Text,0);
        Inc( Index ) ;
        TxnLog.LogTransaction(Index,FQuantity,100021,Value,Value,ProdForm.Commission.PromptLabel.Caption,
                             '','PostOrd Commission','LogSeparatelyToAccounts');
        Inc( Index );
        if CombineList <> nil then
          CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }
   PostalOrderValidateVar {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
            n : integer ;
      *]
      }
   }

   PostalOrderPayValidateVar {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
            n : integer ;
            ValueP : String ;
      *]
      }
   }


  PostalOrderValidate {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      Result := False;
      MoveFocusTo(ProdForm.POSerialNumber);
      if POSerialNumber.Text <> '' then
      begin
        for n := 0 to PostalOrderValue.Items.Count -1 do                            //go through picklist of denominations
        begin
          if 'P'+CurrToStr( StrToInt( LeftString( POSerialNumber.Text,5) ) / 100 )  //12345999999 -> ValueP = P123.45
             = DelimitedString( PostalOrderValue.Items[n], ' ', False) then         //compare up to space in description
          begin
            Result := True;
            PostalOrderValue.Text := PostalOrderValue.Items[n] ;
            POValue.Text:=Copy(PostalOrderValue.Text,2,Pos(' ',PostalOrderValue.Text)-2);
            Commission.Text:=LookUp('Value',CurrToStr(StrToCurr(POValue.Text)*10),'DomPostalOrder',POValue,Result)
          end;
        end;
      end;

      if not Result then
      begin
        PostalOrderValue.Text := '';
        POValue.Text          := '';
        Commission.Text       := '';
      end;

      Result := CheckMaskEdits(self);
    *]
    }
  }


  PostalOrderPayValidate {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {
    [*
      MoveFocusTo(ProdForm.POSerialNumber);
      PostalOrderValue.Text := '';
      POValue.Text := '';

      //check previously scanned barcodes
      With TPackStringList.Create do
      begin
        try
          PackText := BaseProduct.AdditionalInfo;
          If IndexOf(ProdForm.POSerialNumber.Text) <> -1 then
            ProdForm.POSerialNumber.Text := ''
        finally
          Free;
        end;
      end;

      if POSerialNumber.Text <> '' then
      begin
        ValueP := 'P'+CurrToStr( StrToInt( LeftString( POSerialNumber.Text,5) ) / 100 );  //build the denomination pattern
        for n := 0 to PostalOrderValue.Items.Count -1 do
        begin
          if  LeftOf( PostalOrderValue.Items[n], ValueP+' ') then //found the denomination
          begin
            PostalOrderValue.Text := PostalOrderValue.Items[n] ;
            POValue.Text :=Copy(PostalOrderValue.Text,2,Pos(' ',PostalOrderValue.Text)-2)
          end;
        end;
      end;
      Result := CheckMaskEdits(Self) and (POValue.Text <> '');

    *]
    }
  }

   IntPostalOrderPayValidate {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
         try

            if ( POVAlueInput.Text <> '' ) and  ( ExchangeRate.Text <> '' ) and Result then
            begin
               StrToCurr( ExchangeRate.Text ) ;
               GrossPay.Text := CurrToStr( StrToCurr(  POValueInput.Text ) * StrToCurr( ExchangeRate.Text ) );
            end ;
         except
            GrossPay.Text := '' ;
            result := False ;
         end ;

      *]
      }
   }

   IntPostalOrderPayExecute {
     InsertBetween { '{PostExecuteStart}','{PostExecuteEnd}' }
     CodeBlock {
       [*
         ProdForm.GrossPay.Ignore := True ;
       *]
     }
   }


   PostalOrderPayLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
       [*
          TxnLog.LogTransaction(
                 Index,
                 FQuantity, // Quantity
                 Get_PLU, // PLU
                 FQuantity*(-StrToCurrDef(ProdForm.TotalFee.Text,0)), // Value
                 -StrToCurrDef(ProdForm.TotalFee.Text,0), // Price
                 Get_Description, // Description
                 ' No '+ProdForm.POSerialNumber.Text, // Additional Info
                 Get_ProgramID, // ProgID
                 Enumerate(ProdForm)); // Domain Info
           Inc(Index);
           if CombineList <> nil then
              CombineList.LogTransactions(Index,TxnLog);
       *]
     }
   }

   PostalOrderPayIntLogVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
       [*
               var
               PostalOrderPayIntPLU:Integer;
       *]
     }
   }


   PostalOrderPayIntLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
       [*

         If ( ProdForm.RatesPosOrdCountry.Text = 'United Kingdom' )
         then PostalOrderPayIntPLU := StrToInt(PLU_PostalOrderPayIntUK)
         else PostalOrderPayIntPLU := StrToInt(PLU_PostalOrderPayIntOther) ;

          TxnLog.LogTransaction(
                 Index,
                 FQuantity, // Quantity
                 PostalOrderPayIntPLU, // PLU
                 FQuantity*(-StrToCurrDef(ProdForm.TotalFee.Text,0)), // Value
                 -StrToCurrDef(ProdForm.TotalFee.Text,0), // Price
                 Get_Description, // Description
                 '', // Additional Info
                 Get_ProgramID, // ProgID
                 Enumerate(ProdForm)); // Domain Info
           Inc(Index);

          TxnLog.LogTransaction(
                 Index,
                 1, // Quantity
                 PostalOrderPayIntPLU, // PLU
                 0, // Value
                 0, // Price
                 'Serial Number  ', // Description
                 ProdForm.IntPosOrdSerialNumber.Text, // Additional Info
                 Get_ProgramID, // ProgID
                 ''); // Domain Info
           Inc(Index);

          TxnLog.LogTransaction(
                 Index,
                 1, // Quantity
                 PostalOrderPayIntPLU, // PLU
                 0, // Value
                 0, // Price
                 'Postal Order Value ', // Description
                 ProdForm.POValueInput.Text, // Additional Info
                 Get_ProgramID, // ProgID
                 ''); // Domain Info
           Inc(Index);

           if not ProdForm.SAAuthorityNumber.Ignore
           then begin
                  TxnLog.LogTransaction(Index
                                       ,1
                                       ,PostalOrderPayIntPLU
                                       ,0
                                       ,0
                                       ,'Authority Number',ProdForm.SAAuthorityNumber.Text
                                       ,Get_ProgramID
                                       ,'');
                  Inc(Index);
                end ;

          TxnLog.LogTransaction(
                 Index,
                 1, // Quantity
                 PostalOrderPayIntPLU, // PLU
                 0, // Value
                 0, // Price
                 'Exchange Value ', // Description
                 ProdForm.ExchangeRate.Text, // Additional Info
                 Get_ProgramID, // ProgID
                 ''); // Domain Info
           Inc(Index);

          TxnLog.LogTransaction(
                 Index,
                 1, // Quantity
                 PostalOrderPayIntPLU, // PLU
                 0, // Value
                 0, // Price
                 'Country of Origin ', // Description
                 ProdForm.RatesPosOrdCountry.Text, // Additional Info
                 Get_ProgramID, // ProgID
                 ''); // Domain Info
           Inc(Index);

           if CombineList <> nil then
              CombineList.LogTransactions(Index,TxnLog);
       *]
     }
   }

   DomMoneyOrderRefundLog {
   InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
   CodeBlock {
        [*
      TxnLog.LogTransaction(
             Index,
             FQuantity, // Quantity
             Get_PLU, // PLU
             FQuantity*(-StrToCurrDef(ProdForm.MoneyOrderValue.Text,0)), // Value
             -StrToCurrDef(ProdForm.MoneyOrderValue.Text,0), // Price
             Get_Description, // Description
             '- Number'+' '+ProdForm.MoneyOrderNumber.Text, // Additional Info
             Get_ProgramID, // ProgID
             Enumerate(ProdForm)); // Domain Info
       Inc(Index);
      TxnLog.LogTransaction(
             Index,
             FQuantity, // Quantity
             Get_PLU, // PLU
             0, // Value
             0, // Price
             'Sender Name - ', // Description
             ProdForm.MOSenderName.Text, // Additional Info
             Get_ProgramID, // ProgID
             ''); // Domain Info
       Inc(Index);
       if CombineList <> nil then
          CombineList.LogTransactions(Index,TxnLog);
         *]
      }
   }

   DomMoneyOrderExec {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         ProdForm.COREValue.Validation := 'Format(Currency)';
          Prodform.CORESerialNumber.Validation := 'Mask(9999999)' ;
         //UIEventSink.Restore ;

      *]
      }
   }

   MOChangeRecipientExec {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         Prodform.CORESerialNumber.Validation := 'Mask(9999999)' ;
         ProdForm.COREValueNoTotal.Validation := 'Format(Currency)';
         //UIEventSink.Restore ;

      *]
      }
   }

}

