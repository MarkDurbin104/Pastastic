               ''); // Domain Info
         Inc(Index);
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }

   MOChangeRecipientLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

      TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          Get_PLU, // PLU
          FQuantity*StrToCurrDef(ProdForm.COREStandardFee.Text,0), // Value
          StrToCurrDef(ProdForm.COREStandardFee.Text,0), // Price
          Get_Description, // Description
          '  '+' '+ProdForm.CORESerialNumber.Text, // Additional Info
          Get_ProgramID, // ProgID
          Enumerate(ProdForm)); // Domain Info
    Inc(Index);
   TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          0, // PLU
          0, // Value
          0, // Price
          'Value ', // Description
          ProdForm.COREValueNoTotal.Text, // Additional Info
          '', // ProgID
          ''); // Domain Info
    Inc(Index);
   TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          0, // PLU
          0, // Value
          0, // Price
          'Original Name ', // Description
          ProdForm.COREOriginalName.Text, // Additional Info
          '', // ProgID
          ''); // Domain Info
    Inc(Index);
   TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          0, // PLU
          0, // Value
          0, // Price
          'Original Address ', // Description
          ProdForm.COREOriginalAddress.Text, // Additional Info
          '', // ProgID
          ''); // Domain Info
    Inc(Index);
   TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          0, // PLU
          0, // Value
          0, // Price
          'New Name ', // Description
          ProdForm.CORENewName.Text, // Additional Info
          '', // ProgID
          ''); // Domain Info
    Inc(Index);
   TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          0, // PLU
          0, // Value
          0, // Price
          'New Address ', // Description
          ProdForm.CORENewAddress.Text, // Additional Info
          '', // ProgID
          ''); // Domain Info
    Inc(Index);
   TxnLog.LogTransaction(
          Index,
          FQuantity, // Quantity
          0, // PLU
          0, // Value
          0, // Price
          'New Telephone ', // Description
          ProdForm.CORENewTelephone.Text, // Additional Info
          '', // ProgID
          ''); // Domain Info
    Inc(Index);
    if CombineList <> nil then
       CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }

 CoreSerialNumberChangeMaskExec
 { InsertBetween { '{IsListStart}'
                   '{IsListEnd}'
                  }
       CodeBlock { [*
                     Prodform.CORESerialNumber.Validation := 'Mask(9999999)' ;
                   *]
                  }
  }

 CoreMoneyOrderNumberChangeMaskExec
 { InsertBetween { '{IsListStart}'
                   '{IsListEnd}'
                  }
       CodeBlock { [*
                     Prodform.COREMoneyOrderNumber.Validation := 'Mask(9999999)' ;
                   *]
                  }
