 SerialNumberPostVars {
  InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
  CodeBlock {
  [*

  var Index : Integer;
  *]
  }
 }
 
 SerialNumberPostVal {
 InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
 CodeBlock {
 [*
   if result then
   if result then
         begin
           for Index := 1 to Length(SerialNumber.Text)  do
            begin
            Try 
             Case StrToInt(SerialNumber.Text[Index]) of
             0..9 : begin 
               		if Length(SerialNumber.Text) <= 11 then 
               		begin
               		  Result := True; 
               		end 
               		else 
               		begin 
               		MoveFocusTo(SerialNumber);
               		Result := False ;
               		end;
                    end;
             else
              MoveFocusTo(SerialNumber);
              Result := False ;
             end;
            Except on Exception do begin MoveFocusTo(SerialNumber);Result := False ;Break;end;
            end;
           end;
   end;
 *]
 }
 }

//----
   PostalOrderPayIntPreVal {
      InsertBetween { '{PreValidateStart}','{PreValidateEnd}' }
      CodeBlock {
      [*
// Ask for the authority number if origin is South Africa and amount = 300 or above
         ProdForm.SAAuthorityNumber.Ignore := True;
         If ( RatesPosOrdCountry.Text = 'South Africa' ) then
            SAAuthorityNumber.Ignore :=( StrToCurrDef( POValueInput.Text, 0 ) < 300 );
      *]
      }
   }

   PostalOrderPayIntValVar {
      InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
      CodeBlock {
      [*
         var
            //Total:Currency;
            //Rate:Currency;
            //CompMan:ICompMan;
            //LookUp:ILookUp;
            //DollarCommission:Currency;
            ExchangeRateServer:IExchangeRateServer;
      *]
      }
   }


    PostalOrderPayIntVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*

          ClearFocus(self);
          //Total:=0;
          //Result:=True;
          //DollarCommission:=-1;
          //CompMan:=CreateCompMan;
          //if CompMan <> nil then
          //begin
             If Length(Trim(IntPosOrdSerialNumber.Text)) < 1 then
             begin
                If Result then MoveFocusTo(IntPosOrdSerialNumber);
                Result := False;
             end;
             ExchangeRateServer:=CreateRemoteExchangeRateServer(GetGPCSRegString('','ServerName',GetLocalMachineName));
             ExchangeRate.Text:=CurrToStr(ExchangeRateServer.RateFor(RatesPosOrdCountry.Text));

             TotalFee.Text := CurrToStrF( StrToCurrDef( ExchangeRate.Text, 0 ) * StrToCurrDef( POValueInput.Text, 0 ), ffNumber, 2 ) ;

