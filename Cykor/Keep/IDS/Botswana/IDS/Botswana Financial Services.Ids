   }


}

Snippets {

   MOIssueUses {
      InsertBetween { '{AutoUsesStart}','{AutoUsesEnd}' }
      CodeBlock {
      [*
         StringUtil,
      *]
      }
   }

   EndorseExpressSlip {
      InsertBetween { '{EndorseStart}','{EndorseEnd}' }
      CodeBlock {
      [*
          SL:=TStringList.Create;
          SL.Add('                              BOTSWANA POST');
          SL.Add('                              '+Copy(DateTimeToStr(Now),1,Length(DateTimeToStr(Now))-3));
          SL.Add('                              '+Get_Description);
          SL.Add('                              No: '+ProdForm.SerialNumber.Text);
          SL.Add('                              Value: '+CurrToStrF(StrToCurr(ProdForm.Value.Text),ffNumber,2));
          SL.Add('                              Commission: '+ProdForm.Commission.Text);
          if ( CombineList <> nil ) and ( CombineList.IsSelected( 'Product.ExpAdvDely' ) ) then
             SL.Add('                              Advice of Delivery Req.');


          FUIEventSink.DisplayInstructions(isBMPRightText,'"Insert the Receipt into the slip printer, until the green light comes on"','Insert Receipt');
          FUIEventSink.Endorse(0,0,2,SL.CommaText);
          FUIEventSink.DisplayInstructions(isRestore,'','');
          SL.Free;
      *]
      }
   }

   LogMOReport {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         ResultCR := MOReportData( ProdForm.StartDomainEdit.Text , ProdForm.EndDomainEdit.Text,
                                   FUIEventSink.User, IntToStr(FUIEventSink.Office), FALSE );
         try
            ReceiptPrinter:=FUIEventSink.GetComponentReference(GUIDToString(Class_ReceiptDevice)) as IDevice;
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultCR,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
         finally
            ReceiptPrinter := nil;
         end ;
      *]
      }
   }
   LogMFReport {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         ResultCR := MFReportData( ProdForm.StartDomainEdit.Text , ProdForm.EndDomainEdit.Text,
                                   FUIEventSink.User, IntToStr(FUIEventSink.Office), FALSE );
         try
            ReceiptPrinter:=FUIEventSink.GetComponentReference(GUIDToString(Class_ReceiptDevice)) as IDevice;
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultCR,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
         finally
            ReceiptPrinter := nil;
         end ;
      *]
      }
   }
   MOPrivVar {
      InsertBetween { '{PrivVarDecStart}','{PrivVarDecEnd}' }
      CodeBlock {
      [*
        MoneyOrders:TMoneyOrders;
      *]
      }
   }


   MOPaidUses {
      InsertBetween { '{AutoUsesStart}','{AutoUsesEnd}' }
      CodeBlock {
      [*
         Indigo3U,MOItemsU,StringUtil,Indigo3_TLB,
      *]
      }
   }

   MOPaidExec {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         MoneyOrders:=TMoneyOrders.Create(False);
         ProdForm.SerialNumber.Ignore     :=False;
         ProdForm.Identification.Ignore   :=True;
         ProdForm.MOResultsList.Ignore    :=True;
         ProdForm.MOSenderName.Ignore     :=True;
         ProdForm.MOSenderStreet.Ignore   :=True;
         ProdForm.MOSenderPOBox.Ignore    :=True;
         ProdForm.MOSenderTelephone.Ignore:=True;
         ProdForm.MOSenderMessage.Ignore:=True;
         ProdForm.MOPayeeName.Ignore      :=True;
         ProdForm.MOPayeeStreet.Ignore    :=True;
         ProdForm.MOIssueOffice.Text:='ANY';
      *]
      }
   }
   MFPaidExec {
      InsertBetween { '{IsListStart}','{IsListEnd}' }
      CodeBlock {
      [*
         MoneyOrders:=TMoneyOrders.Create(False);
         ProdForm.SerialNumber.Ignore     :=False;
         ProdForm.Identification.Ignore   :=True;
         ProdForm.MOResultsList.Ignore    :=True;
         ProdForm.MOSenderName.Ignore     :=True;
         ProdForm.MOSenderStreet.Ignore   :=True;
         ProdForm.MOSenderPOBox.Ignore    :=True;
         ProdForm.MOSenderTelephone.Ignore:=True;
         ProdForm.MOSenderMessage.Ignore:=True;
         ProdForm.MOPayeeName.Ignore      :=True;
         ProdForm.MOPayeeStreet.Ignore    :=True;
         ProdForm.MFIssueOffice.Text:='ANY';
      *]
      }
   }
   MOPaidTerminate {
      InsertBetween { '{TerminateCleanUpStart}','{TerminateCleanUpEnd}' }
      CodeBlock {
      [*
      if MoneyOrders <> nil then
      begin
         MoneyOrders.Free;
         MoneyOrders:=nil;
      end;
      *]
      }
   }
   MOPaidValidate {
      InsertBetween { '{ValidateStart}','{ValidateEnd}' }
      CodeBlock {
      [*
         if not Identification.Ignore then
            Result:=CheckMaskEdits(Self)
         else
            Result:=True;
      *]
      }
   }
   MOPaidEnableComplete {
      InsertBetween { '{EnableCompleteStart}','{EnableCompleteEnd}' }
      CodeBlock {
      [*
         if (ProdForm.MOResultsList.Ignore) and (ProdForm.Identification.Ignore) then
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','Search',0,0,True,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','Search Paid',0,0,True,False);
         end
         else if (Value) and (ProdForm.MOResultsList.Ignore) then
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','Complete',0,0,False,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
         end
         else
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
         end;
      *]
      }
   }
   MOPaidCompleteResitem {
      InsertBetween { '{ItemResStart}','{ItemResEnd}' }
      CodeBlock {
      [*
         riItemBase     :
            if (ProdForm.MOResultsList.Ignore) and (ProdForm.Identification.Ignore) then
               Result:='Search'
            else if ValidateOK and (ProdForm.MOResultsList.Ignore) then
               Result:=ResItem00
            else
               Result:='';
         riItemBase+1   :
            if (ProdForm.MOResultsList.Ignore) and (ProdForm.Identification.Ignore) then
               Result:='Search Paid'
            else
               Result:='';
      *]
      }
   }
   MOPaidSearchClick {
      InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
         if Name = 'Search' then
         begin
            PopulateMOList(False);
            Exit;
         end
         else if Name = 'Search Paid' then
         begin
            PopulateMOList(True);
            Exit;
         end;
      *]
      }
   }

   MOPaidTriggerDec {
     InsertBetween { '{OverrideDecStart}','{OverrideDecEnd}' }
     CodeBlock {
       [*
          procedure TriggerBarCode(Value:String); override;
          procedure PopulateMOList(IncludePaid:Boolean);
          procedure FillForm(MOItem:TMOIssued);
          procedure GetMOValues(Value:String);
          function MOPaidSlip:String;
       *]
     }
   }
   MOPaidTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*
          procedure {PClass}TFaxOrdPaidProduct.TriggerBarCode(Value:String);
          begin
             GetMOValues(Value);
          end;
          procedure {PClass}TFaxOrdPaidProduct.PopulateMOList(IncludePaid:Boolean);
          var
            SL,NSL:TPackStringList;
            MOItemList:TMOItemList;
            MOItem:TMOIssued;
            I:Integer;
            IO:String;
          begin
             if ProdForm.MFIssueOffice.Text = 'ANY' then
                IO:=''
             else
                IO:=ProdForm.MFIssueOffice.Text;
             if IO <> '' then
                IO:=Copy(TStringObject(ProdForm.MFIssueOffice.Items.Objects[ProdForm.MFIssueOffice.Items.IndexOf(IO)]).Value,2,999);
             MOItemList:=TMOItemList.Create(nil);
             if IncludePaid then
                MOItemList.Details:=MoneyOrders.IssuedMOList(ProdForm.MOIssueDate.Text,IO,IntToStr(FUIEventSink.Office),'',ProdForm.MOValue.Text,'FAX',ProdForm.MOPayeeTelephone.Text,ProdForm.MOPayeePOBox.Text,ProdForm.SerialNumber.Text)
             else
                MOItemList.Details:=MoneyOrders.UnPaidMOList(ProdForm.MOIssueDate.Text,IO,IntToStr(FUIEventSink.Office),'',ProdForm.MOValue.Text,'FAX',ProdForm.MOPayeeTelephone.Text,ProdForm.MOPayeePOBox.Text,ProdForm.SerialNumber.Text);
             if MOItemList.Count = 1 then
             begin
                FillForm(TMOIssued(MOItemList[0]));
             end
             else if MOItemList.Count > 1 then
             begin
                SL:=TPackStringList.Create;
                NSL:=TPackStringList.Create;
                for I:=0 to MOItemList.Count-1 do
                begin
                   MOItem:=TMOIssued(MOItemList[I]);
                   SL.Add( '-1'); SL.Add(CurrToStrF(MOItem.Value,ffFixed,0));
                   SL.Add('100'); SL.Add(' ');
                   NSL.PackText:=MOItem.SendersName;
                   SL.Add('102'); 
                   if NSL.Count > 1 then
                      SL.Add(NSL[1]+' '+NSL[0])
                   else
                      SL.Add(' ');
                   SL.Add('372'); SL.Add('>');
                   NSL.PackText:=MOItem.RecipientsName;
                   SL.Add('383');
                   if NSL.Count > 1 then
                      SL.Add(NSL[1]+' '+NSL[0])
                   else
                      SL.Add(' ');
                   SL.Add('999');
                   SL.Add(IntToStr(I));
                   ProdForm.MOResultsList.Items.AddObject(SL.PackText,MOItem);
                   SL.Clear;
                end;
                SL.Free;
                NSL.Free;
                ProdForm.SerialNumber.Ignore     :=True;
                ProdForm.MOResultsList.Ignore    :=False;
                ProdForm.MFIssueOffice.Ignore    :=True;
                ProdForm.MOIssueDate.Ignore      :=True;
                ProdForm.MOPayeeTelephone.Ignore :=True;
                ProdForm.MOPayeePOBox.Ignore     :=True;
                ProdForm.MOValue.Ignore          :=True;
                FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
                FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
                FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
             end;
          end;
          procedure {PClass}TFaxOrdPaidProduct.FillForm(MOItem:TMOIssued);
          var
            IO:String;
            SL:TPackStringList;
            I:Integer;
          begin 
             if MOItem = nil then Exit;
             ProdForm.SerialNumber.Text       :=MOItem.Identifier;
             ProdForm.MOValue.Text            :=CurrToStrF(MOItem.Value,ffFixed,0);

             IO:=IntToStr(MOItem.IssuingOffice);
             for I:=0 to ProdForm.MFIssueOffice.Items.Count-1 do
             begin
                if TStringObject(ProdForm.MFIssueOffice.Items.Objects[I]).Value = 'O'+IO then
                begin
                   IO:=ProdForm.MFIssueOffice.Items[I];
                   break;
                end;
             end;
             ProdForm.MFIssueOffice.Text      :=IO;
             ProdForm.MOIssueDate.Text        :=DateToStr(MOItem.DateTime);
             SL:=TPackStringList.Create;
             SL.PackText:=MOItem.SendersName;
             if SL.Count > 1 then
                ProdForm.MOSenderName.Text       :=Trim(SL[1]+' '+SL[0]);
             SL.PackText:=MOItem.SendersAddress;
             if SL.Count > 1 then
                ProdForm.MOSenderStreet.Text     :=Trim(SL[0]+' '+SL[1]);
             if SL.Count > 2 then
                ProdForm.MOSenderTelephone.Text  :=Trim(SL[2]);
             if SL.Count > 3 then
                ProdForm.MOSenderPOBox.Text      :=Trim(SL[3]);
             ProdForm.MOSenderMessage.Text:=MOItem.Information;
             SL.PackText:=MOItem.RecipientsName;
             if SL.Count > 1 then
                ProdForm.MOPayeeName.Text        :=Trim(SL[1]+' '+SL[0]);
             SL.PackText:=MOItem.RecipientsAddress;
             if SL.Count > 1 then
                ProdForm.MOPayeeStreet.Text      :=Trim(SL[0]+' '+SL[1]);
             ProdForm.MOPayeePOBox.Text       :=MOItem.RContact2;
             ProdForm.MOPayeeTelephone.Text   :=MOItem.RContact1;
             SL.Free;
             
             ProdForm.MOResultsList.Ignore    :=True;
             ProdForm.SerialNumber.Ignore     :=False;
             ProdForm.Identification.Ignore   :=False;
             ProdForm.MFIssueOffice.Ignore    :=False;
             ProdForm.MOIssueDate.Ignore      :=False;
             ProdForm.MOSenderName.Ignore     :=False;
             ProdForm.MOSenderStreet.Ignore   :=False;
             ProdForm.MOSenderPOBox.Ignore    :=False;
             ProdForm.MOSenderTelephone.Ignore:=False;
             ProdForm.MOSenderMessage.Ignore:=False;
             ProdForm.MOPayeeName.Ignore      :=False;
             ProdForm.MOPayeeStreet.Ignore    :=False;
             ProdForm.MOPayeeTelephone.Ignore :=False;
             ProdForm.MOPayeePOBox.Ignore     :=False;
             ProdForm.MOValue.Ignore          :=False;
             
             ProdForm.SerialNumber.Enabled     :=False;
             ProdForm.MFIssueOffice.Enabled    :=False;
             ProdForm.MOIssueDate.Enabled      :=False;
             ProdForm.MOSenderName.Enabled     :=False;
             ProdForm.MOSenderStreet.Enabled   :=False;
             ProdForm.MOSenderPOBox.Enabled    :=False;
             ProdForm.MOSenderTelephone.Enabled:=False;
             ProdForm.MOSenderMessage.Enabled:=False;
             ProdForm.MOPayeeName.Enabled      :=False;
             ProdForm.MOPayeeStreet.Enabled    :=False;
             ProdForm.MOPayeeTelephone.Enabled :=False;
             ProdForm.MOPayeePOBox.Enabled     :=False;
             ProdForm.MOValue.Enabled          :=False;
             FlagComplete(ProdForm.Validate);
             FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
          end;

          procedure {PClass}TFaxOrdPaidProduct.GetMOValues(Value:String);
          var
            Index:Integer;
          begin 
             Index:=ProdForm.MOResultsList.Items.IndexOf(Value);
             if Index >=0 then
             begin
                FillForm(TMOIssued(ProdForm.MOResultsList.Items.Objects[Index]));
             end;
          end;
          function {PClass}TFaxOrdPaidProduct.MOPaidSlip:String;
          var
             SL:TStringList;
             Status:MOStatus;
          begin
                SL:=TPackStringList.Create;
                SL.Add('"Money Fax Authorization Form",""');
                SL.Add('"",""');
                MoneyOrders.GetMOStatus(ProdForm.SerialNumber.Text,2001,Status);
                case Status of
                   mosNone   : SL.Add('"Status NA",""');
                   mosIssued : SL.Add('"Status OK",""');
                   mosPaid   : SL.Add('"Status PP",""');
                end;
                SL.Add('"Serial Number","'+ProdForm.SerialNumber.Text +'"');
                SL.Add('"Value","'        +ProdForm.MOValue.Text      +'"');
                SL.Add('"Issue Office","' +ProdForm.MFIssueOffice.Text+'"');
                SL.Add('"Issue Date","'   +ProdForm.MOIssueDate.Text  +'"');
                SL.Add('"Sender:",""');
                SL.Add('"Name  :'+ProdForm.MOSenderName     .Text+'",""');
                SL.Add('"Street:'+ProdForm.MOSenderStreet   .Text+'",""');
                SL.Add('"Tel   :'+ProdForm.MOSenderTelephone.Text+'",""');
                SL.Add('"POBox :'+ProdForm.MOSenderPOBox    .Text+'",""');
                SL.Add('"Payee:",""');
                SL.Add('"ID    :'+ProdForm.Identification  .Text+'",""');
                SL.Add('"Name  :'+ProdForm.MOPayeeName     .Text+'",""');
                SL.Add('"Street:'+ProdForm.MOPayeeStreet   .Text+'",""');
                SL.Add('"Tel   :'+ProdForm.MOPayeeTelephone.Text+'",""');
                SL.Add('"POBox :'+ProdForm.MOPayeePOBox    .Text+'",""');
                SL.Add('"",""');
                SL.Add('"Message :",""');
                SL.Add('"'+ProdForm.MOSenderMessage.Text+'",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"I Certify that I am the designated",""');
                SL.Add('"recipient of the above Money Order",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Name:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Signature:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"FOR OFFICIAL USE:",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Authorised by:",""');
                SL.Add('"","__________________________________"');
                Result:=SL.CommaText;
                SL.Free;
          end;
       *]
     }
   }
   MoneyFaxLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         Value:=StrToCurrDef(ProdForm.MOValue.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,2000030,Value,Value,Get_Description,
                               'No. '+ProdForm.SerialNumber.Text,
                               Get_ProgramID,Enumerate(ProdForm));
         Inc(Index);
         Value:=StrToCurrDef(ProdForm.Commission.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,2000040,
                           Value,Value,ProdForm.Commission.PromptLabel.Caption,
                           '','Money Fax Comm.','');
         Inc(Index);
         Value:=StrToCurrDef(ProdForm.StandardFee.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,70000020,
                           Value,Value,'Fee',
                           '','Money Fax Fee','');
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Pay Office '+ProdForm.PayOffice.Text+' ('+Copy(TStringObject(ProdForm.PayOffice.Items.Objects[ProdForm.PayOffice.Items.IndexOf(ProdForm.PayOffice.Text)]).Value,2,999)+')',
                           '','Pay Office','');
         Inc(Index);
         TxnLog.WriteTransaction('MFIssue',0,Trunc(StrToCurrDef(ProdForm.StandardFee.Text,-1)),0,
                                 StrToCurrDef(ProdForm.Commission.Text,0),
                                 StrToCurrDef(ProdForm.MOValue.Text,0),
                                 ProdForm.SerialNumber.Text,
                                 Copy(TStringObject(ProdForm.PayOffice.Items.Objects[ProdForm.PayOffice.Items.IndexOf(ProdForm.PayOffice.Text)]).Value,2,999),
                                 'MFIssue','');
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }
   MFLogPaid {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                               0-StrToCurrDef(ProdForm.MOValue.Text,0),
                               0-StrToCurrDef(ProdForm.MOValue.Text,0),
                               Get_Description,ProdForm.SerialNumber.Text,Get_ProgramID,
                               Enumerate(ProdForm));
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Issue Office '+ProdForm.MFIssueOffice.Text+' ('+Copy(TStringObject(ProdForm.MFIssueOffice.Items.Objects[ProdForm.MFIssueOffice.Items.IndexOf(ProdForm.MFIssueOffice.Text)]).Value,2,999)+')',
                           '','Issue Office','');
         Inc(Index);
         ResultList:=MOPaidSlip;
         TxnLog.WriteTransaction('*MFPaid',0,0,0,StrToCurrDef(ProdForm.MOValue.Text,0),0,
                               ProdForm.SerialNumber.Text,ProdForm.SerialNumber.Text,'MFPaid','');
         TxnLog.WriteTransaction('MFPaid',0,0,0,0-StrToCurrDef(ProdForm.MOValue.Text,0),0,
                               ProdForm.SerialNumber.Text,ProdForm.SerialNumber.Text,'MFPaid Complete',ResultList);

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);

         try
            ReceiptPrinter:=FUIEventSink.GetComponentReference(GUIDToString(Class_ReceiptDevice)) as IDevice;
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
         finally
            ReceiptPrinter := nil;
         end ;
      *]
      }
   }
   MFLogPaidVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
      [*
         var
            ResultList:String;
            ReceiptPrinter:IDevice;
      *]
      }
   }
   MOPaidItemCount {
      InsertBetween { '{ItemResCountStart}','{ItemResCountEnd}' }
      CodeBlock {
      [*
       riCount        : Result:='2';
      *]
      }
   }
   EndorseMFSlip {
      InsertBetween { '{EndorseStart}','{EndorseEnd}' }
      CodeBlock {
      [*
          SL:=TStringList.Create;
          SL.Add('                              BOTSWANA POST');
          SL.Add('                              '+Copy(DateTimeToStr(Now),1,Length(DateTimeToStr(Now))-3));
          SL.Add('                              '+Get_Description);
          SL.Add('                              No: '+ProdForm.SerialNumber.Text);
          SL.Add('                              Value: '+CurrToStrF(StrToCurr(ProdForm.MOValue.Text),ffNumber,2));
          SL.Add('                              Commission: '+ProdForm.Commission.Text);
          SL.Add('                              Fee: '+ProdForm.StandardFee.Text);
          if ( CombineList <> nil ) and ( CombineList.IsSelected( 'Product.ExpAdvDely' ) ) then
             SL.Add('                              Advice of Delivery Req.');


          FUIEventSink.DisplayInstructions(isBMPRightText,'"Insert the Receipt into the slip printer, until the green light comes on"','Insert Receipt');
          FUIEventSink.Endorse(0,0,2,SL.CommaText);
          FUIEventSink.DisplayInstructions(isRestore,'','');
          SL.Free;
      *]
      }
   }

   MoneyOrdLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         Value:=StrToCurrDef(ProdForm.Value.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,Value,Value,Get_Description,
                               'No. '+ProdForm.SerialNumber.Text,
                               {PProgID}Get_ProgramID,Enumerate(ProdForm));
                              // {PProgID}'Product.ExpMonOrd',Enumerate(ProdForm));

         Value:=StrToCurrDef(ProdForm.Commission.Text,0);
         Inc(Index);
         TxnLog.LogTransaction(1,FQuantity,100003,
                           Value,Value,ProdForm.Commission.PromptLabel.Caption,
                           '','Money Order Commission','LogSeparatelyToAccounts');
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Pay Office '+ProdForm.MOPayOffice.Text+' ('+Copy(TStringObject(ProdForm.MOPayOffice.Items.Objects[ProdForm.MOPayOffice.Items.IndexOf(ProdForm.MOPayOffice.Text)]).Value,2,999)+')',
                           '','Pay Office','');
         Inc(Index);
         TxnLog.WriteTransaction('MOIssue',0,0,0,
                                 StrToCurrDef(ProdForm.Commission.Text,0),
                                 StrToCurrDef(ProdForm.Value.Text,0),
                                 ProdForm.SerialNumber.Text,
                                 Copy(TStringObject(ProdForm.MOPayOffice.Items.Objects[ProdForm.MOPayOffice.Items.IndexOf(ProdForm.MOPayOffice.Text)]).Value,2,999),
                                 'MOIssue','');
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }
   MOrdLogPaid {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                               0-StrToCurrDef(ProdForm.MOValue.Text,0),
                               0-StrToCurrDef(ProdForm.MOValue.Text,0),
                               Get_Description,ProdForm.SerialNumber.Text,Get_ProgramID,
                               Enumerate(ProdForm));
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Issue Office '+ProdForm.MOIssueOffice.Text+' ('+Copy(TStringObject(ProdForm.MOIssueOffice.Items.Objects[ProdForm.MOIssueOffice.Items.IndexOf(ProdForm.MOIssueOffice.Text)]).Value,2,999)+')',
                           '','Issue Office','');
         Inc(Index);
         ResultList:=MOPaidSlip;
         TxnLog.WriteTransaction('*MOPaid',0,0,0,StrToCurrDef(ProdForm.MOValue.Text,0),0,
                               ProdForm.SerialNumber.Text,ProdForm.SerialNumber.Text,'MOPaid','');
         TxnLog.WriteTransaction('MOPaid',0,0,0,0-StrToCurrDef(ProdForm.MOValue.Text,0),0,
                               ProdForm.SerialNumber.Text,ProdForm.SerialNumber.Text,'MOPaid Complete',ResultList);

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);

         try
            ReceiptPrinter:=FUIEventSink.GetComponentReference(GUIDToString(Class_ReceiptDevice)) as IDevice;
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
         finally
            ReceiptPrinter := nil;
         end ;
      *]
      }
   }

   ExpMOPaidTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*
          procedure {PClass}TDomMoneyOrderPayProduct.TriggerBarCode(Value:String);
          begin
             GetMOValues(Value);
          end;
          procedure {PClass}TDomMoneyOrderPayProduct.PopulateMOList(IncludePaid:Boolean);
          var
            SL,NSL:TPackStringList;
            MOItemList:TMOItemList;
            MOItem:TMOIssued;
            I:Integer;
            IO:String;
          begin
             if ProdForm.MOIssueOffice.Text = 'ANY' then
                IO:=''
             else
                IO:=ProdForm.MOIssueOffice.Text;
             if IO <> '' then
                IO:=Copy(TStringObject(ProdForm.MOIssueOffice.Items.Objects[ProdForm.MOIssueOffice.Items.IndexOf(IO)]).Value,2,999);
             MOItemList:=TMOItemList.Create(nil);
             if IncludePaid then
                MOItemList.Details:=MoneyOrders.IssuedMOList(ProdForm.MOIssueDate.Text,IO,IntToStr(FUIEventSink.Office),'',ProdForm.MOValue.Text,'EXP',ProdForm.MOPayeeTelephone.Text,ProdForm.MOPayeePOBox.Text,ProdForm.SerialNumber.Text)
             else
                MOItemList.Details:=MoneyOrders.UnPaidMOList(ProdForm.MOIssueDate.Text,IO,IntToStr(FUIEventSink.Office),'',ProdForm.MOValue.Text,'EXP',ProdForm.MOPayeeTelephone.Text,ProdForm.MOPayeePOBox.Text,ProdForm.SerialNumber.Text);
             if MOItemList.Count = 1 then
             begin
                FillForm(TMOIssued(MOItemList[0]));
             end
             else if MOItemList.Count > 1 then
             begin
                SL:=TPackStringList.Create;
                NSL:=TPackStringList.Create;
                for I:=0 to MOItemList.Count-1 do
                begin
                   MOItem:=TMOIssued(MOItemList[I]);
                   SL.Add( '-1'); SL.Add(CurrToStrF(MOItem.Value,ffFixed,0));
                   SL.Add('100'); SL.Add(' ');
                   NSL.PackText:=MOItem.SendersName;
                   SL.Add('102');
                   if NSL.Count > 1 then
                      SL.Add(NSL[1]+' '+NSL[0])
                   else
                      SL.Add(' ');
                   SL.Add('372'); SL.Add('>');
                   NSL.PackText:=MOItem.RecipientsName;
                   SL.Add('383');
                   if NSL.Count > 1 then
                      SL.Add(NSL[1]+' '+NSL[0])
                   else
                      SL.Add(' ');
                   SL.Add('999');
                   SL.Add(IntToStr(I));
                   ProdForm.MOResultsList.Items.AddObject(SL.PackText,MOItem);
                   SL.Clear;
                end;
                SL.Free;
                NSL.Free;
                ProdForm.MOResultsList.Ignore    :=False;
                ProdForm.SerialNumber.Ignore     :=True;
                ProdForm.MOIssueOffice.Ignore    :=True;
                ProdForm.MOIssueDate.Ignore      :=True;
                ProdForm.MOPayeeTelephone.Ignore :=True;
                ProdForm.MOPayeePOBox.Ignore     :=True;
                ProdForm.MOValue.Ignore          :=True;
                FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
                FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
                FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
             end;
          end;
          procedure {PClass}TDomMoneyOrderPayProduct.FillForm(MOItem:TMOIssued);
          var
            IO:String;
            SL:TPackStringList;
            I:Integer;
          begin
             if MOItem = nil then Exit;
             ProdForm.SerialNumber.Text       :=MOItem.Identifier;
             ProdForm.MOValue.Text            :=CurrToStrF(MOItem.Value,ffFixed,0);

             IO:=IntToStr(MOItem.IssuingOffice);
             for I:=0 to ProdForm.MOIssueOffice.Items.Count-1 do
             begin
                if TStringObject(ProdForm.MOIssueOffice.Items.Objects[I]).Value = 'O'+IO then
                begin
                   IO:=ProdForm.MOIssueOffice.Items[I];
                   break;
                end;
             end;
             ProdForm.MOIssueOffice.Text      :=IO;
             ProdForm.MOIssueDate.Text        :=DateToStr(MOItem.DateTime);
             SL:=TPackStringList.Create;
             SL.PackText:=MOItem.SendersName;
             if SL.Count > 1 then
                ProdForm.MOSenderName.Text       :=Trim(SL[1]+' '+SL[0]);
             SL.PackText:=MOItem.SendersAddress;
             if SL.Count > 1 then
                ProdForm.MOSenderStreet.Text     :=Trim(SL[0]+' '+SL[1]);
             if SL.Count > 2 then
                ProdForm.MOSenderTelephone.Text  :=Trim(SL[2]);
             if SL.Count > 3 then
                ProdForm.MOSenderPOBox.Text      :=Trim(SL[3]);
             SL.PackText:=MOItem.RecipientsName;
             if SL.Count > 1 then
                ProdForm.MOPayeeName.Text        :=Trim(SL[1]+' '+SL[0]);
             SL.PackText:=MOItem.RecipientsAddress;
             if SL.Count > 1 then
                ProdForm.MOPayeeStreet.Text      :=Trim(SL[0]+' '+SL[1]);
             ProdForm.MOPayeePOBox.Text       :=MOItem.RContact2;
             ProdForm.MOPayeeTelephone.Text   :=MOItem.RContact1;
             ProdForm.MOSenderMessage.Text    :=MOItem.Information;
             SL.Free;

             ProdForm.MOResultsList.Ignore    :=True;
             ProdForm.SerialNumber.Ignore     :=False;
             ProdForm.Identification.Ignore   :=False;
             ProdForm.MOIssueOffice.Ignore    :=False;
             ProdForm.MOIssueDate.Ignore      :=False;
             ProdForm.MOSenderName.Ignore     :=False;
             ProdForm.MOSenderStreet.Ignore   :=False;
             ProdForm.MOSenderPOBox.Ignore    :=False;
             ProdForm.MOSenderTelephone.Ignore:=False;
             ProdForm.MOSenderMessage.Ignore:=False;
             ProdForm.MOPayeeName.Ignore      :=False;
             ProdForm.MOPayeeStreet.Ignore    :=False;
             ProdForm.MOPayeeTelephone.Ignore :=False;
             ProdForm.MOPayeePOBox.Ignore     :=False;
             ProdForm.MOValue.Ignore          :=False;

             ProdForm.SerialNumber.Enabled     :=False;
             ProdForm.MOIssueOffice.Enabled    :=False;
             ProdForm.MOIssueDate.Enabled      :=False;
             ProdForm.MOSenderName.Enabled     :=False;
             ProdForm.MOSenderStreet.Enabled   :=False;
             ProdForm.MOSenderPOBox.Enabled    :=False;
             ProdForm.MOSenderTelephone.Enabled:=False;
             ProdForm.MOSenderMessage.Enabled:=False;
             ProdForm.MOPayeeName.Enabled      :=False;
             ProdForm.MOPayeeStreet.Enabled    :=False;
             ProdForm.MOPayeeTelephone.Enabled :=False;
             ProdForm.MOPayeePOBox.Enabled     :=False;
             ProdForm.MOValue.Enabled          :=False;
             FlagComplete(ProdForm.Validate);
             FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
          end;

          procedure {PClass}TDomMoneyOrderPayProduct.GetMOValues(Value:String);
          var
            Index:Integer;
          begin
             Index:=ProdForm.MOResultsList.Items.IndexOf(Value);
             if Index >=0 then
             begin
                FillForm(TMOIssued(ProdForm.MOResultsList.Items.Objects[Index]));
             end;
          end;
          function {PClass}TDomMoneyOrderPayProduct.MOPaidSlip:String;
          var
             SL:TStringList;
             Status:MOStatus;
          begin
                SL:=TPackStringList.Create;
                SL.Add('"Money Order Authorization Form",""');
                SL.Add('"",""');
                MoneyOrders.GetMOStatus(ProdForm.SerialNumber.Text,2001,Status);
                case Status of
                   mosNone   : SL.Add('"Status NA",""');
                   mosIssued : SL.Add('"Status OK",""');
                   mosPaid   : SL.Add('"Status PP",""');
                end;
                SL.Add('"Serial Number","'+ProdForm.SerialNumber.Text +'"');
                SL.Add('"Value","'        +ProdForm.MOValue.Text      +'"');
                SL.Add('"Issue Office","' +ProdForm.MOIssueOffice.Text+'"');
                SL.Add('"Issue Date","'   +ProdForm.MOIssueDate.Text  +'"');
                SL.Add('"Sender:",""');
                SL.Add('"Name  :'+ProdForm.MOSenderName     .Text+'",""');
                SL.Add('"Street:'+ProdForm.MOSenderStreet   .Text+'",""');
                SL.Add('"Tel   :'+ProdForm.MOSenderTelephone.Text+'",""');
                SL.Add('"POBox :'+ProdForm.MOSenderPOBox    .Text+'",""');
                SL.Add('"Payee:",""');
                SL.Add('"ID    :'+ProdForm.Identification  .Text+'",""');
                SL.Add('"Name  :'+ProdForm.MOPayeeName     .Text+'",""');
                SL.Add('"Street:'+ProdForm.MOPayeeStreet   .Text+'",""');
                SL.Add('"Tel   :'+ProdForm.MOPayeeTelephone.Text+'",""');
                SL.Add('"POBox :'+ProdForm.MOPayeePOBox    .Text+'",""');
                SL.Add('"",""');
                SL.Add('"Message :",""');
                SL.Add('"'+ProdForm.MOSenderMessage.Text+'",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"I Certify that I am the designated",""');
                SL.Add('"recipient of the above Money Order",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Name:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Signature:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"FOR OFFICIAL USE:",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Authorised by:",""');
                SL.Add('"","__________________________________"');
                Result:=SL.CommaText;
                SL.Free;
          end;
       *]
     }
   }
