   DomMoneyOrderValVar {
         InsertBetween { '{ValidateVarStart}','{ValidateVarEnd}' }
         CodeBlock {
         [*
            var
            TotalValue : Real ;
            TotalCommission : Real;

         *]
         }
   }

  DomMoneyOrderVal {
    InsertBetween { '{ValidateStart}','{ValidateEnd}' }
    CodeBlock {[*
      Result := True;
      CheckDomain(CORESerialNumber,CORESerialNumber.ValidationComplete, Result);
      CheckDomain(COREValue,COREValue.ValidationComplete, Result);
      CheckDomain(COREPayeesSearchName,COREPayeesSearchName.ValidationComplete, Result);
      CheckDomain(COREPayeesOtherNames,COREPayeesOtherNames.Text <> '', Result);
      CheckDomain(COREMOPayOffice,COREMOPayOffice.Text <> '', Result);
      CheckDomain(COREPayeesPOBox,COREPayeesPOBox.Text <> '', Result);
      CheckDomain(CORESendersSearchName,CORESendersSearchName.ValidationComplete, Result);
      CheckDomain(CORESendersOtherNames,CORESendersOtherNames.ValidationComplete, Result);
      TotalValue := StrToCurrDef( CoreValue.Text, 0 ) ;
      TotalCommission := 0 ;
      while TotalValue > 500 do
      begin
       TotalCommission :=TotalCommission + StrToCurrDef( LookUp('Value','50000','DomMoneyOrder',COREValue,Result), 0 );
       TotalValue := TotalValue - 500 ;
      end ;
      TotalCommission :=TotalCommission + StrToCurrDef( LookUp('Value',CurrToStr(TotalValue*100) ,'DomMoneyOrder',COREValue,Result), 0 );
      CORECommission.Text := CurrToStrF( TotalCommission, ffNumber, 2 );
    *]}
  }

   IntMoneyOrderVal {
         InsertBetween { '{ValidateStart}','{ValidateEnd}' }
         CodeBlock {
         [*
             Result:=CheckMaskEdits(Self);
             TotalValue := StrToCurrDef( COREMoneyOrderValue.Text, 0 ) ;

             TotalCommission := 0 ;
             while TotalValue > 500 do
             begin
               TotalCommission :=TotalCommission + StrToCurrDef( LookUp('Value','50000','IntMoneyOrder',COREMoneyOrderValue,Result), 0 );
               TotalValue := TotalValue - 500 ;
             end ;
             TotalCommission :=TotalCommission + StrToCurrDef( LookUp('Value',CurrToStr(TotalValue*100) ,'IntMoneyOrder',COREMoneyOrderValue,Result), 0 );
             CORECommission.Text := CurrToStrF( TotalCommission, ffNumber, 2 );
         *]
         }
   }


    CeasePaymnetExec {
