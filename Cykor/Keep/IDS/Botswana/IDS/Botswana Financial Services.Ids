LookUps {
   IntSpdCash {
     SubGroup { 'Money Order' }
     Range { 50, 100, 300, 500, 1000 }
     Value { 5, 10, 20, 25, 50 }
   }

}

// ----

LogFormats {
   MOOAdviceRecipient { 'Name',MOOAdviceRecipientFee }
   MOOAdvicePayment { 'Name',MOOAdvicePaymentFee }
   MOTransmission { 'Name',MOTransmissionFee }
}

// ----

Domains {

  PostalOrderBulkPayCompany {
    Title     { 'Company Name' }
    Prompt    { 'Company Name' }
    Hint      { 'Enter the Company Name' }
    Error     { 'Enter a Valid Company Name' }
    Format    { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
    InputFrom { 'Keyboard' }
  }

  PostalOrderBulkPayRepName {
    Title     { 'Representative Name'               }
    Prompt    { 'Representative Name'               }
    Hint      { 'Enter the Representative''s Name'  }
    Error     { 'Enter a Valid Representative Name' }
    Format    { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
    InputFrom { 'Keyboard'                          }
  }

  PostalOrderBulkPayRepID {
    Title     { 'Representative Identification'               }
    Prompt    { 'Representative Identification'               }
    Hint      { 'Enter the Representative''s Identification'  }
    Error     { 'Enter a Valid Representative Identification' }
    Format    { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
    InputFrom { 'Keyboard'                                    }
  }

  DestinationValue {
    Title  { 'Destination Value' }
    Prompt { 'Destination Value' }
    Hint   { 'Enter the Destination Value' }
    Error  { 'Enter a Valid Destination Value' }
    Format { Range { '0,99999999' } }
    InputFrom { 'Keyboard' }
   }

   Commission {
      Title  { 'Commission' }
      Prompt { 'Commission' }
      InputFrom {
         'Params'
      }
      TotalIn { TotalFee }
   }
   DollarRate{
      Title  { 'Dollar exchange Rate' }
      Prompt { 'Dollar exchange Rate' }
      Hint   { 'Enter the Commission' }
      Error  { 'Enter a Valid Commission' }
   }

   DollarComm{
      Title  { 'Commission in Dollars' }
      Prompt { 'Commission in Dollars' }
      Hint   { 'Enter the Commission' }
      Error  { 'Enter a Valid Commission' }
   }


   MOTransmissionFee {
      Title     { 'Transmission Fee' }
      Prompt    { 'Transmission Fee' }
      InputFrom { Params }
      TotalIn   { TotalFee }
   }

   MOOAdviceRecipientFee {
      Title     { 'Advise Recipient Fee' }
      Prompt    { 'Advise Recipient Fee' }
      InputFrom { Params }
      TotalIn   { TotalFee }
   }

   MOOAdvicePaymentFee {
      Title     { 'Advice Payment Fee' }
      Prompt    { 'Advice Payment Fee' }
      InputFrom { Params }
      TotalIn   { TotalFee }
   }


   MonOrdModFee {
     Title     { 'Money Order Modify Fee'    }
     Prompt    { 'Modify Fee'                }
     Hint      { 'Enter the Modify Fee'      }
     Error     { 'Invalid Modify Fee'        }
     Format    { Currency { 0,9999999999 }   }
     InputFrom { 'Keyboard'                  }
   }

   POSerialNumber {
      Title  { 'Serial Number' }
      Prompt { 'Serial Number' }
      Hint   { 'Enter the Serial Number' }
      Error  { 'Enter a Valid Serial Number' }
      Format {
         Mask { '99999999999' }
      }
      InputFrom { 'Keyboard' }
   }

   MOPayOffice {
      Title  { 'Payment Office' }
      Prompt { 'Payment Office' }
      Hint   { 'Select the Payment Office' }
      Error  { 'Select the Payment Office' }
      Format {
         PickList  { 'PickList.MoneyOrderOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   Identification {
      Title { 'Identification' }
      Prompt { 'Enter Details of Identification Used' }
      Hint { 'Enter Details of Identification Used^e.g PASSPORT No. 500161289 or ID CARD 1234567' }
      Error { 'Invalid Identification ' }
      Format { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
      InputFrom { 'Keyboard' }
   }

   MOValue {
      Title  { 'Value' }
      Prompt { 'Value' }
      Hint   { 'Enter the Value' }
      Error  { 'Enter a Valid Value' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxx' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   MOIssueOffice {
      Title  { 'Issuing Office' }
      Prompt { 'Issuing Office' }
      Hint   { 'Select the Issuing Office' }
      Error  { 'Select the Issuing Office' }
      Format {
         PickList  { 'PickList.MoneyOrderOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   MOIssueDate {
      Title { 'Issue Date' }
      Prompt { 'Enter the issue date range' }
      Hint { 'Enter the issue date range in the format^050201-080201 or 050201 i.e. 5th Feb 2001' }
      Error { 'Invalid issue date range' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOSenderName {
      Title { 'Sender''s Name' }
      Prompt { 'Enter The Sender''s Name' }
      Hint { 'Enter The Sender''s Name' }
      Error { 'Invalid Sender''s Name' }
      Format { 'xxxxxxxxxxxxxxxxxxxxxxxxx' }
      InputFrom { 'Keyboard' }
   }

   MOSenderStreet {
      Title { 'Sender''s Street' }
      Prompt { 'Enter The Sender''s Street' }
      Hint { 'Enter The Sender''s Street' }
      Error { 'Invalid Sender''s Street' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOSenderPOBox {
      Title { 'Sender''s POBox Number' }
      Prompt { 'Enter The Sender''s POBox Number' }
      Hint { 'Enter The Sender''s POBox Number' }
      Error { 'Invalid Sender''s POBox Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOSenderTelephone {
      Title { 'Sender''s Telephone Number' }
      Prompt { 'Enter The Sender''s Telephone Number' }
      Hint { 'Enter The Sender''s Telephone Number' }
      Error { 'Invalid Sender''s Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOSenderMessage {
      Title { 'Sender''s Message' }
      Prompt { 'Enter The Sender''s Message' }
      Hint { 'Enter The Sender''s Message' }
      Error { 'Invalid Sender''s Message' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOPayeeName {
      Title { 'Payee''s Name' }
      Prompt { 'Enter The Payee''s Name' }
      Hint { 'Enter The Payee''s Name' }
      Error { 'Invalid Payee''s Name' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOPayeeStreet {
      Title { 'Payee''s Street' }
      Prompt { 'Enter The Payee''s Street' }
      Hint { 'Enter The Payee''s Street' }
      Error { 'Invalid Payee''s Street' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOPayeePOBox {
      Title { 'Payee''s POBox Number' }
      Prompt { 'Enter The Payee''s POBox Number' }
      Hint { 'Enter The Payee''s POBox Number' }
      Error { 'Invalid Payee''s POBox Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOPayeeTelephone {
      Title { 'Payee''s Telephone Number' }
      Prompt { 'Enter The Payee''s Telephone Number' }
      Hint { 'Enter The Payee''s Telephone Number' }
      Error { 'Invalid Payee''s Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   MOResultsList {
      Title  { 'Results List' }
      Prompt { 'Results List' }
      Hint   { 'Select a Money Order from the list' }
      Error  { 'Invalid Money Order' }
      Format {
         PickList  { '' }
      }
      InputFrom {
         'Keyboard'
      }
   }

}


// ----

Snippets {

  PostalOrderBulkPayEXECUTE {
    InsertBetween { '{SetProgStart}','{SetProgEnd}' }
    CodeBlock {
    [*
      AdditionalInfo:='';
    *]
    }
  }

  PostalOrderBulkPayNOTIFY {
    InsertBetween { '{SwapToStart}','{SwapToEnd}' }
    CodeBlock {
    [*
      if Name = 'Next Postal Order' then
      begin
        if ProdForm.Validate then
        begin
          //save this postal orders details
          if StrToFloatDef(ProdForm.POValue.Text,0) <> 0 then
          begin
            With TPackStringList.Create do
            begin
              try
                PackText:=AdditionalInfo; //previous postal orders
                Add(ProdForm.POSerialNumber.Text);
                Add(ProdForm.PostalOrderValue.Text);
                Add(ProdForm.POValue.Text);
                AdditionalInfo := PackText;
              finally
                Free;
              end;
            end; //with TPackStringList
          end;  //PO Value filled

          //blank the screen
          ProdForm.POSerialNumber.Text    := '';
          ProdForm.PostalOrderValue.Text  := '';
          ProdForm.POValue.Text           := '';
          ProdForm.TotalFee.Text          := '0.00';

          MoveFocusTo(ProdForm.POSerialNumber);
          FlagComplete(true);  // already validated
          FUIEventSink.DataChanged(Self,GetFormData(ProdForm),not ValidateOK);

        end;  //if validate
        Exit;
      end;  //IF NAME = 'Next Postal Order'
    *]
    }
  }

  PostalOrderBulkPayLOG {
    InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
    CodeBlock {
    [*
      //description
      TxnLog.LogTransaction(Index, 0, Get_PLU, 0, 0, Get_Description, '', Get_ProgramID, Enumerate(ProdForm));
      Inc(Index);

      //company
      TxnLog.LogTransaction(Index, 0, Get_PLU, 0, 0,
                            ProdForm.PostalOrderBulkPayCompany.Text,
                            '', Get_ProgramID, '');
      Inc(Index);
      // representative
      TxnLog.LogTransaction(Index, 0, Get_PLU, 0, 0,
                            ProdForm.PostalOrderBulkPayRepName.Text,
                            ', ID - ' + ProdForm.PostalOrderBulkPayRepId.Text, Get_ProgramID, '');
      Inc(Index);

      //log each recorded PO
      With TPackStringList.Create do
      begin
        try
          Packtext := AdditionalInfo; //grab previously entered POs

          //save the last postal orders details only if not already added by barcode trigger
          //Trigger barcode adds all Ser Numbers to list if not alrady in list
          if StrToFloatDef(ProdForm.POValue.Text,0) <> 0 then
          begin
            Add(ProdForm.POSerialNumber.Text);
            Add(ProdForm.PostalOrderValue.Text);
            Add(ProdForm.POValue.Text);
            AdditionalInfo := PackText;
          end;  //PO Value filled

          //extract fields in groups of four
          //0 = POSerialNumber
          //1 = PostalOrderValue
          //2 = POValue

          While (AdditionalInfo <> '') and (Count > 0) do
          begin
            TxnLog.LogTransaction(Index, 1, Get_PLU,
                                  -StrToCurrDef(Strings[2],0),
                                  -StrToCurrDef(Strings[2],0),
                                  'No ' + Strings[0], //serial number
                                  '',  // MOIssueOffice
                                  Get_ProgramID, '');
            Inc(Index);
            Delete(0);Delete(0);Delete(0);  //delete the stored PO  (3 fields)
          end;
        finally
          Free;
        end;

      end;
      if CombineList <> nil then
        CombineList.LogTransactions(Index,TxnLog);
       *]
     }
   }


  MoneyOrderUses {
    InsertBetween { '{UsesStart}','{UsesEnd}' }
    CodeBlock {
      [*
         uses stdctrls;
      *]
    }
  }

   ChangeCaptionPosExecute {
      InsertBetween { '{PostExecuteStart}','{PostExecuteEnd}' }
      CodeBlock {
      [*

         if ProdForm.FindComponent('COREMoneyOrderNumberLabel') <> nil then
            TLabel( ProdForm.FindComponent('COREMoneyOrderNumberLabel')).Caption := 'Order Number';

         if ProdForm.FindComponent('SerialNumberLabel') <> nil then
            TLabel( ProdForm.FindComponent('SerialNumberLabel')).Caption := 'Order Number';

         if ProdForm.FindComponent('CORESerialNumberLabel') <> nil then
            TLabel( ProdForm.FindComponent('CORESerialNumberLabel')).Caption := 'Order Number';

      *]
      }
   }

   PreCeasePaymnetPostVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
         if Result then
          try
            StrToDate( COREMOIssueDate.Text ) ;
          except
            MoveFocusTo( COREMOIssueDate );
            Result := False ;
          end ;
         TotalFee.Text := CurrToStrF( StrToCurrDef( CORERefundFee.Text, 0 ), ffnumber, 2 ) ;
      *]
      }
   }

   PreAOPAfterIssuePostVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
         TotalFee.Text := CurrToStrF( StrToCurrDef( MOOAdvicePaymentFee.Text, 0 ), ffnumber, 2 ) ;
      *]
      }
   }

   MoneyOrderRefundPostVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
         if Result then
          try
            StrToDate( COREMOIssueDate.Text ) ;
          except
            MoveFocusTo( COREMOIssueDate );
            Result := False ;
          end ;
      *]
      }
   }

   CeasePaymnetLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               StrToCurrDef(ProdForm.CORERefundFee.Text,0), // Value
               StrToCurrDef(ProdForm.CORERefundFee.Text,0), // Price
               Get_Description, // Description
               ProdForm.CORESerialNumber.Text, // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Value  '+ProdForm.COREValueNoTotal.Text, // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Issue Date - ', // Description
               ProdForm.COREMOIssueDate.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Office - ', // Description
               ProdForm.COREMOPayOffice.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }


   AOPAfterIssueLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               StrToCurrDef(ProdForm.MOOAdvicePaymentFee.Text,0), // Value
               StrToCurrDef(ProdForm.MOOAdvicePaymentFee.Text,0), // Price
               Get_Description, // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               'Order No. '+ProdForm.CORESerialNumber.Text+'  Value  '+ProdForm.COREValueNoTotal.Text, // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Payee''s Name - ', // Description
               ProdForm.COREMOPayeeName.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Payment Office - ', // Description
               ProdForm.COREMOPayOffice.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }


   MoneyOrderRefundLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
