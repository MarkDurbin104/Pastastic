   AddModMOCust {
      BasedOn{ BaseMOSuper }
      Caption { 'Add/Modify Money Order Customer' }
      Bitmap { '..\images\P_AddModStockItem.bmp' }
      Description  { 'Add/Modify Money Order Customer' }
      Title        { 'Add/Modify Money Order Customer' }
      Domains {
         CustomerList
         CustomerName
         CustomerMOType
         CustomerNumber
         CustomerAdd1
         CustomerAdd2
         CustomerPOBox
         CustomerTelNo
      }
      Items {
         'Complete'
      }
      Snippets {
         CustomerMOListFill
         CustomerListDec
         CustomerMOListDef
         CustomerListUses
         CustomerListVars
         CustomerMOListLog
      }
      PLU { PLU_MOAddModCust }
   }

