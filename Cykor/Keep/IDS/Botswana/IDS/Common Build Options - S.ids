                                    's:\corvus\Source\Packages\CompInspector.pas'
                                    's:\corvus\Source\Packages\CompressU.pas'
                                    's:\corvus\Source\Packages\Bin2String.pas'
                                    's:\corvus\Source\Base Components\BaseProduct.pas'
                                    's:\corvus\Source\Base Components\ProdDesign.pas'
                                    's:\corvus\Source\Component Designer\Product Designer\ProdGenU.pas'
