   Cheque {
		BasedOn { BaseAdmin }
      Title { 'Cheque Payment' }
      Bitmap { '..\Images\P_Cheque.bmp' }
      Domains { TotalToPay, AccountNumber, ChequeNumber,AmountPaid,Change }
      Items { 'Complete' }
      Customer { 'Cheque P',AmountPaid }
      Snippets { ChequeProdFormCreated,ChequeFormVars,ChequeValidVars,ValidCheque,LogChequeVars,LogCheque }
      PLU { PLU_Cheque   }
