Products
{

//
//------------------------------------------------------------------------------------------
//

  StartOfDay { BasedOn     { BaseAdmin                                      }
               RegDesc     { 'CORVUS Start Of Day Product'                  }
               Caption     { 'Start of Day'                                 }
               Description { 'Start of Day'                                 }
               Title       { 'Start of Day'                                 }
               BitMap      { '..\images\P_StartOfDay.bmp' }
               Domains     { StartCash
                             StartStock      }
               Items       { 'Complete'      }
               Snippets    { StartOfDayPVar
                             StartOfDayEVar
                             StartOfDayCVar
                             StartOfDayComp
                             StartOfDayExec  }
               PLU         { PLU_StartOfDay  }
              }

