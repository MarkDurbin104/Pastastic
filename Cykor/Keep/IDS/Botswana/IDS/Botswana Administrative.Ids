                   RegDesc     { 'GPCS CancelCustomer Product'                      }
                   Caption     { 'Cancel Customer'                                  }
                   BitMap      { '..\images\P_CancelCustomer.bmp' }
                   Description { 'Cancel Customer'                                  }
                   Title       { 'Cancel Customer'                                  }
                   PLU         { PLU_CancelCustomer }
                  }
