//
//                                International EMS
//-------------------------------------------------------------------------------
//

 IntEMSCash { SubGroup { EMS }
              Range    {  0  500    20000 }
//              Zone01   { -1  55.00  ' 55.00 +  5.50 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone02   { -1  46.20  ' 46.20 +  5.50 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone03   { -1  49.50  ' 49.50 +  5.50 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone04   { -1  60.50  ' 60.50 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone05   { -1  52.80  ' 52.80 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone06   { -1  52.80  ' 52.80 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone07   { -1  52.80  ' 52.80 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone08   { -1  52.80  ' 52.80 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone09   { -1  63.80  ' 63.80 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
//              Zone10   { -1  58.30  ' 58.30 + 11.00 * (1+ Trunc( (LookVal-501) / 500 ))' }
              Zone01   { -1   70    'stepcalc( 501, 500, LookVal,  70,  5)' }
              Zone02   { -1   80    'stepcalc( 501, 500, LookVal,  80,  7)' }
              Zone03   { -1   90    'stepcalc( 501, 500, LookVal,  90, 11)' }
              Zone04   { -1  100    'stepcalc( 501, 500, LookVal, 100, 20)' }
              Zone05   { -1  105    'stepcalc( 501, 500, LookVal, 105, 22)' }
             }

 IntEMSContract { SubGroup { EMS }
                  Range    {  0  500    20000 }
//                  Zone01   { -1  44.00  ' 44.00 + 4.4 * (1+ Trunc( (LookVal-501) / 500 ))' }
//                  Zone02   { -1  37.40  ' 37.40 + 4.4 * (1+ Trunc( (LookVal-501) / 500 ))' }
//                  Zone03   { -1  39.60  ' 39.60 + 4.4 * (1+ Trunc( (LookVal-501) / 500 ))' }
//                  Zone04   { -1  48.40  ' 48.40 + 8.8 * (1+ Trunc( (LookVal-501) / 500 ))' }
