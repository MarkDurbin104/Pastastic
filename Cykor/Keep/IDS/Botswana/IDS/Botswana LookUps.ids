//                  Zone09   { -1  50.60  ' 50.60 + 8.8 * (1+ Trunc( (LookVal-501) / 500 ))' }
//                  Zone10   { -1  46.20  ' 46.20 + 8.8 * (1+ Trunc( (LookVal-501) / 500 ))' }
                  Zone01   { -1  66.50  '0.95 * stepcalc( 501, 500, LookVal,  70,  5)' }
                  Zone02   { -1  76.00  '0.95 * stepcalc( 501, 500, LookVal,  80,  7)' }
                  Zone03   { -1  85.50  '0.95 * stepcalc( 501, 500, LookVal,  90, 11)' }
