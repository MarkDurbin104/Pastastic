BuildOptions {
   RootSrcOutputDir { 'E:\Projects\Core\Source' }
   EXEOutputDir     { 'E:\Projects\Core\Binary' }
   DCUOutputDir     { 'E:\Projects\Core\Binary\DCU' }
   BuildAllUnits    { 'N' }
   CommandLine      { 'D:\MinDelphi\DCC32.EXE' }
   Aliases {
      WinTypes { 'Windows' }
      WinProcs { 'Windows' }
      DbiProcs { 'BDE' }
      DbiTypes { 'BDE' }
      DbiErrs  { 'BDE' }
   }
   LibraryPath {
      'D:\MinDelphi'
      'E:\corvusV3\corvus\Source\Base Type Library'
      'E:\corvusV3\corvus\Source\Support Components\Error Handler'
      'E:\corvusV3\corvus\Source\Support Components\DatabaseServer'
