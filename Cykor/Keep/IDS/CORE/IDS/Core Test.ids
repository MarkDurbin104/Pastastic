      'E:\corvusV3\corvus\Source\Packages'                     
      'E:\corvusV3\corvus\Source\Base Components'
      'E:\Indigo3'
   }
   SearchPath {
      'D:\MinDelphi'
      'E:\Projects\Uganda\IDS'
      'E:\corvusV3\corvus\Source\Packages'
      'E:\corvusV3\corvus\Source\Base Type Library'
      'E:\corvusV3\corvus\Source\Support Components\Error Handler'
