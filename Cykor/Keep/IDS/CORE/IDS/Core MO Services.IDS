   COREForceMFaxLogPaid {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         FUIEventSink.OpenCashDrawer;
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                               0-StrToCurrDef(ProdForm.COREMOValue.Text,0),
                               0-StrToCurrDef(ProdForm.COREMOValue.Text,0),
                               'Money FaxPay',ProdForm.CORESerialNumber.Text,'Product.FaxOrdPaid',
                               Enumerate(ProdForm));
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Issue Office'+ProdForm.COREMFIssueOffice.Text+'('+Copy(TStringObject(ProdForm.COREMFIssueOffice.Items.Objects[ProdForm.COREMFIssueOffice.Items.IndexOf(ProdForm.COREMFIssueOffice.Text)]).Value,2,999)+')',
                           '','Issue Office','');
         Inc(Index);
         ResultList:=MFPaidSlip;
         TxnLog.WriteTransaction('*MFPaid',0,0,0,StrToCurrDef(ProdForm.COREMOValue.Text,0),0,
         ProdForm.CORESerialNumber.Text,ProdForm.CORESerialNumber.Text,'MFPaid','');
         TxnLog.WriteTransaction('MFPaid',0,0,0,0-StrToCurrDef(ProdForm.COREMOValue.Text,0),0,
         ProdForm.CORESerialNumber.Text,ProdForm.CORESerialNumber.Text,'MFPaidComplete',ResultList);

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);

         try
         ReceiptPrinter:=FUIEventSink.GetComponentReference(GUIDToString(Class_ReceiptDevice))as IDevice;
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
         finally
            ReceiptPrinter := nil;
         end ;
         Inc(Index);
      *]
      }
   }
   COREForceMFPaidTriggerDec {
     InsertBetween { '{OverrideDecStart}','{OverrideDecEnd}' }
     CodeBlock {
       [*
          function MFPaidSlip:String;
       *]
     }
   }
   COREForceMFPaidTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*
          function {PClass}TMFForcePaidProduct.MFPaidSlip:String;
          var
             SL:TStringList;
          begin
                SL:=TPackStringList.Create;
                SL.Add('"Money Fax Authorization Form",""');
                SL.Add('"",""');
                SL.Add('"Status NA",""');
                //SL.Add('"Serial Number","'+ProdForm.CORESerialNumber.Text+'"');
                SL.Add('"'+ProdForm.CORESerialNumberLabel.Caption+'","'+ProdForm.CORESerialNumber.Text +'"');
                SL.Add('"Value","'        +ProdForm.COREMOValue.Text+'"');
                SL.Add('"Issue Office","'+ProdForm.COREMFIssueOffice.Text+'"');
                SL.Add('"Payee ID:'+ProdForm.COREIdentification.Text+'",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"I Certify that I am the designated",""');
                SL.Add('"recipient of the above Money Order",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Name:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Signature:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"FOR OFFICIAL USE:",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Authorised by:",""');
                SL.Add('"","__________________________________"');
                Result:=SL.CommaText;
                SL.Free;
          end;
       *]
     }
   }
   COREExternalFuncUses {
      InsertBetween { '{UsesStart}','{UsesEnd}' }
      CodeBlock {
      [*
         uses ExternalFunc;
      *]
      }
   }
   CORELogClientReturnsVars {
      InsertBetween { '{LogTransactionVarStart}','{LogTransactionVarEnd}' }
      CodeBlock {
      [*
         var
            ResultCR : String;
            ReceiptPrinter : IDevice;
      *]
      }
   }

   COREIntMoneyOrderLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                Get_PLU, // PLU
                FQuantity*StrToCurrDef(ProdForm.COREMoneyOrderValue.Text,0), // Value
                StrToCurrDef(ProdForm.COREMoneyOrderValue.Text,0), // Price
                Get_Description, // Description
                '- Number'+' '+ProdForm.COREMoneyOrderNumber.Text, // Additional Info
                Get_ProgramID, // ProgID
                Enumerate(ProdForm)); // Domain Info
          Inc(Index);

         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                100003, // PLU
                StrToCurrDef(ProdForm.CORECommission.Text,0), // Value
                StrToCurrDef(ProdForm.CORECommission.Text,0), // Price
                ProdForm.CORECommission.PromptLabel.Caption + ' ', // Description
                '', // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);

         TxnLog.LogTransaction(
                Index,
                FQuantity, // Quantity
                0, // PLU
                0, // Value
                0, // Price
                'To ', // Description
                ProdForm.COREIntMoneyOrderDestination.Text , // Additional Info
                '', // ProgID
                ''); // Domain Info
          Inc(Index);
          if CombineList <> nil then
             CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }


}

