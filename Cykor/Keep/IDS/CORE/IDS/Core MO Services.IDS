   COREEndorseMFSlip {
      InsertBetween { '{EndorseStart}','{EndorseEnd}' }
      CodeBlock {
      [*
          SL:=TStringList.Create;
          SL.Add('                                 '+GetGPCSRegString('OfficeInfo','Title','Tanzania Post Corporation'));
          SL.Add('                                 '+Copy(DateTimeToStr(Now),1,Length(DateTimeToStr(Now))-3));
          SL.Add('                                 '+Get_Description);
          SL.Add('                              No:'+ProdForm.CORESerialNumber.Text);
          SL.Add('                              Value:'+CurrToStrF(StrToCurr(ProdForm.COREMOValue.Text),ffNumber,2));
          SL.Add('                              Commission:'+ProdForm.CORECommission.Text);
          SL.Add('                              Fee:'+ProdForm.COREStandardFee.Text);
          if ( CombineList <> nil ) and ( CombineList.IsSelected('Product.ExpAdvDely' ) ) then
             SL.Add('                              Advice of Delivery Req.');

          FUIEventSink.DisplayInstructions(isBMPRightText,'"Insert the Receipt into the slip printer, until the green light comes on"','Insert Receipt');
          FUIEventSink.Endorse(0,0,2,SL.CommaText);
          FUIEventSink.DisplayInstructions(isRestore,'','');
          SL.Free;
      *]
      }
   }

   COREMoneyOrdLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         S:=EncodeMoneyOrder(ProdForm.CORESerialNumber.Text,StrToCurr(ProdForm.COREValue.Text),
                             UIEventSink.Office,
                             StrToInt(Copy(TStringObject(ProdForm.COREMOPayOffice.Items.Objects[ProdForm.COREMOPayOffice.Items.IndexOf(ProdForm.COREMOPayOffice.Text)]).Value,2,999)),
                             0,moNone,Now,False);
                             
         MoneyOrder:=TMoneyOrder.Create;
         MoneyOrder.Series:=S;
         MoneyOrder.SaveToList(UIEventSink.Office);
         MoneyOrder.Free;

         Value:=StrToCurrDef(ProdForm.COREValue.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,Value,Value,Get_Description,
                               'No. '+ProdForm.CORESerialNumber.Text,

         {PProgID}'Product.ExpMonOrd',Enumerate(ProdForm));
         Value:=StrToCurrDef(ProdForm.CORECommission.Text,0);
         Inc(Index);
         TxnLog.LogTransaction(1,FQuantity,100003,
         Value,Value,ProdForm.CORECommission.PromptLabel.Caption,
                           '','Money Order Commission','LogSeparatelyToAccounts');
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Pay Office '+ProdForm.COREMOPayOffice.Text+' ('+Copy(TStringObject(ProdForm.COREMOPayOffice.Items.Objects[ProdForm.COREMOPayOffice.Items.IndexOf(ProdForm.COREMOPayOffice.Text)]).Value,2,999)+')',
                           '','Pay Office','');
         Inc(Index);
         TxnLog.WriteTransaction('MOIssue',0,0,0, StrToCurrDef(ProdForm.CORECommission.Text,0),
                                 StrToCurrDef(ProdForm.COREValue.Text,0),
                                 S+' '+ProdForm.CORESerialNumber.Text, Copy(TStringObject(ProdForm.COREMOPayOffice.Items.Objects[ProdForm.COREMOPayOffice.Items.IndexOf(ProdForm.COREMOPayOffice.Text)]).Value,2,999),
                                 'MOIssue',GetFormData(ProdForm));
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }
