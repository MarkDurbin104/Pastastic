// define picklist :
// MoneyOrderOffices, IntMoneyOrderCountries
// define lookup :
// DomMoneyOrder, IntMoneyOrder

Constants {
   PLU_MODetails   { 043000000 }
}

LogFormats {
   GenericFinancial  { 'Name',COREStandardFee }
   MCChangePayLoc  { 'Name,CORESerialNumber,^,
                     "*Original Pay office ",COREMOriginalPayOffice,^,
                     "*New Pay Office ",COREMOPayOffice',COREStandardFee }
   MOOptionalService { 'Name',COREMOOptionalServiceFee }
   MOChangeRecipient { 'Name,"*  ",CORESerialNumber,^,
                       "*Value ", COREValue,^,
                       "*Original Name ", COREOriginalName,^,
                       "*Original Address ", COREOriginalAddress,^,
                       "*New Name ", CORENewName,^,
                       "*New Address ", CORENewAddress,^,
                       "*New Telephone ", CORENewTelephone',
                       COREStandardFee
                   }
}

//-------------------------------------------------------------------------------
Products
{
   COREBaseMoneyOrd {
      DontBuild
      SubGroup { 'CORE MoneyOrder' }
   }

   COREDomMoneyOrder {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Domestic Money Order' }
      BitMap {  '..\..\core\images\P_MonOrd.bmp' }
      Description  { 'Domestic Money Order' }
      Title        { 'Domestic Money Order' }
      PLU          { PLU_DomMoneyOrd }
      LogAs { CommisionProd }
      Domains {
         CORESerialNumber
         COREValue
         COREPayeesSearchName
         COREPayeesOtherNames
         COREMOPayOffice
         COREPayeesPOBox
         CORESendersSearchName
         CORESendersOtherNames
         CORESendersMessage
         CORECommission { COREValue, 'LookUp.DomMoneyOrder' }
      }
      Items {
         'Complete'
      //   'Product.COREMonOrdDetails'
      }
      //Customer { 'Serial Number ',CORESerialNumber,'Total',TotalFee,'P' }
      Snippets {
         COREMOIssueUses
         COREEndorseExpressSlip
         CORELogTranVars
         COREMoneyOrdLog
      }
   }
   COREDomMoneyOrderNoCommission {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Domestic Money Order' }
      BitMap {  '..\..\core\images\P_MonOrd.bmp' }
      Description  { 'Domestic Money Order' }
      Title        { 'Domestic Money Order' }
      PLU          { PLU_DomMoneyOrdNoComm }
      LogAs { CommisionProd }
      Domains {
         CORESerialNumber
         COREValue
         COREMOPayOffice
      }
      Items {
         'Complete'
      //   'Product.COREMonOrdDetails'
      }
      Customer { 'Serial Number ',CORESerialNumber,'Total',TotalFee,'P' }
      Snippets {
         COREMOIssueUses
         COREEndorseExpressSlip
         CORELogTranVars
         COREMoneyOrdNoCommLog
      }
   }

   COREMonOrdDetails {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Sender/Payee Details' }
      BitMap {  '..\..\core\images\P_MODet.bmp' }
      Description  { 'Sender/Payee Details' }
      Title        { 'Sender/Payee Details' }
      PLU          { PLU_MODetails }
      Domains {
         CORESendersPOBox
         CORESendersTelephone
         CORESendersAddress
         COREPayeesTelephone
         COREPayeesAddress
      }
      //Snippets { COREMonOrdDetailsLog }
      //LogAs { COREMonOrdDetails }
   }
   COREDomMoneyOrderPay {
     DontBuild
     BasedOn { COREBaseMoneyOrd }
     Caption { 'Domestic Money Order Pay' }
     BitMap {  '..\..\core\images\P_MonOrd.bmp' }
     Description  { 'Domestic Money Order Pay' }
     Title        { 'Domestic Money Order Pay' }
     PLU          { PLU_DomMoneyOrderPay }
     Domains {
        CORESerialNumber
        COREIdentification
        COREMOValue
        COREMOIssueOffice
        COREMOPayeeName
        COREMOPayeeStreet
        COREMOPayeeTelephone
        COREMOPayeePOBox
        COREMOIssueDate
        COREMOSenderName
        COREMOSenderStreet
        COREMOSenderPOBox
        COREMOSenderTelephone
        COREMOSenderMessage
        COREMOResultsList
     }
     Items {
        'Complete'
     }
     Snippets {
        COREMOPaidExec
        COREMFLogPaidVars
        COREMOrdLogPaid
        COREMOPaidValidate
        COREMOPaidEnableComplete
        COREMOPaidSearchClick
        COREMOPaidCompleteResitem
        COREMOPaidTriggerDec
        COREExpMOPaidTriggerDef
        COREMOPaidUses
        COREMOPrivVar
        COREMOPaidTerminate
        COREMOPaidItemCount
     }
  }
  COREDomMoneyOrderMod {
     DontBuild
     BasedOn     { COREBaseMoneyOrd }
     Caption     { 'Domestic Money Order Modify' }
     BitMap      { '..\..\core\images\P_DomMoneyOrderMod.bmp' }
     Description { 'Domestic Money Order Modify' }
     Title       { 'Domestic Money Order Modify' }
     Domains     {
        COREMoneyOrderNumber
        COREMonOrdModFee
     }
  }
  COREDomMoneyOrderRefund {
     DontBuild
     BasedOn     { COREBaseMoneyOrd                               }
     Caption     { 'Domestic Money Order Refund'                  }
     BitMap      { '..\..\core\images\P_DomMoneyOrderRefund.bmp'}
     Description { 'Domestic Money Order Refund'                  }
     Title       { 'Domestic Money Order Refund'                  }
     Domains     {
        COREMoneyOrderNumber
        COREMoneyOrdervalue
     }
  }
   COREFaxMonOrd {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Money Fax Issue' }
      BitMap {  '..\IMAGES\P_ExpMonOrd.bmp' }
      Description  { 'Money Fax Issue' }
      Title        { 'Money Fax Issue' }
      PLU          { PLU_FaxMonOrd }
      Domains {
         CORESerialNumber
         COREMFPayOffice
         COREMOValue
         CORECommission { COREMOValue, 'LookUp.EMSMonFax' }
         COREStandardFee { COREMOValue, 'LookUp.EMSMFTxFee' }
      }
      Items {
         'Complete'
      }
      Customer { 'Money Fax',COREValue,'^','Total Inc. Fees',TotalFee,'/-' }
      Snippets {
         COREMOIssueUses
         CORELogTranVars
         COREEndorseMFSlip
         COREMoneyFaxLog
      }
   }
   COREFaxOrdPaid {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Money Fax Pay' }
      BitMap {  '..\IMAGES\P_ExpOrdPaid.bmp' }
      Description  { 'Money Fax Pay' }
      Title        { 'Money Fax Pay' }
      PLU          { PLU_FaxOrdPaid }
      Domains {
         CORESerialNumber
         COREIdentification
         COREMOValue
         COREMFIssueOffice
         COREMOPayeeName
         COREMOPayeeStreet
         COREMOPayeeTelephone
         COREMOPayeePOBox
         COREMOIssueDate
         COREMOSenderName
         COREMOSenderStreet
         COREMOSenderPOBox
         COREMOSenderTelephone
         COREMOSenderMessage
         COREMOResultsList
      }
      Items {
         'Complete'
      }
      Snippets {
        COREMFPaidExec
        COREMFLogPaidVars
        COREMFLogPaid
        COREMOPaidValidate
        COREMOPaidEnableComplete
        COREMOPaidSearchClick
        COREMOPaidCompleteResitem
        COREMOPaidTriggerDec
        COREMOPaidTriggerDef
        COREMOPaidUses
        COREMOPrivVar
        COREMOPaidTerminate
        COREMOPaidItemCount
      }
   }

   COREMOReport {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Money Order Report' }
      BitMap {  '..\IMAGES\MOReport.bmp' }
      Description  { 'Money Order Report' }
      Title        { 'Money Order Report' }
      Prompt       { 'Money Order Report' }
      Hint         { 'Money Order Report' }
      PLU          { PLU_FullBalance }
      Domains {
         COREStartDomainEdit
         COREEndDomainEdit
      }
      Items {
         'Complete'
      }
      Snippets {
        COREExternalFuncUses
        CORELogClientReturnsVars
        CORELogMOReport
      }
   }

   COREIntMoneyOrder {
      DontBuild
      BasedOn     { COREBaseMoneyOrd }
      Caption     { 'International Money Order' }
      BitMap      { '..\..\core\images\P_Cash.bmp' }
      Description { 'International Money Order' }
      Title       { 'International Money Order' }
      Domains     {
         COREMoneyOrderNumber
         COREMoneyOrderValue
         COREIntMoneyOrderDestination
         //COREStandardFee { COREMoneyOrderValue 'LookUp.IntMoneyOrder' }
         CORECommission { COREMoneyOrderValue 'LookUp.IntMoneyOrder' }
      }
      Items       {
                     'Complete'
                     // 'Product.COREMOOptionalService'
                  }
      Snippets { COREIntMoneyOrderLog  }
      PLU         { PLU_IntMoneyOrder }
      //LogAs       { IntMonOrd }
   }
   //COREChangePayeeName {
   //   DontBuild
   //   BasedOn     { COREBaseMoneyOrd }
   //   Caption     { 'Change of Payee Name' }
   //   BitMap      { '..\..\core\images\P_ChangePayeeName.bmp' }
   //   Description { 'Change of Payee Name' }
   //   Title       { 'Change of Payee Name' }
   //   UnitPrice   { 10.00 }
   //   Domains     { COREStandardFee { UnitPrice } }
   //   LogAs       { GenericFinancial }
   //}
   COREChangeRecipient {
      DontBuild
      BasedOn     { COREBaseMoneyOrd }
      Caption     { 'Change of Recipient' }
      BitMap      { '..\..\core\images\P_ChangePayeeName.bmp' }
      Description { 'Change of Recipient' }
      Title       { 'Change of Recipient' }
      UnitPrice   { 10.00 }
      Domains     {
                     CORESerialNumber
                     COREValue
                     COREOriginalName
                     COREOriginalAddress
                     CORENewName
                     CORENewAddress
                     CORENewTelephone
                     COREStandardFee { UnitPrice }
                   }
      LogAs       { MOChangeRecipient }
   }

   COREChangePayeeLocation {
      DontBuild
      BasedOn     { COREBaseMoneyOrd }
      Caption     { 'Change of Payee Location' }
      BitMap      { '..\..\core\images\P_ChangePayeeName.bmp' }
      Description { 'Change of Payee Location' }
      Title       { 'Change of Payee Location' }
      Domains     {
         CORESerialNumber
         COREMOriginalPayOffice
         COREMOPayOffice
         COREStandardFee { UnitPrice }
      }
      LogAs       { MCChangePayLoc }
   }
   CORECeasePaymnet {
      DontBuild
      BasedOn     { COREBaseMoneyOrd }
      Caption     { 'Cease Payment and Refund' }
      BitMap      { '..\..\core\images\P_CeasePaymnet.bmp' }
      Description { 'Cease Payment and Refund' }
      Title       { 'Cease Payment and Refund' }
      UnitPrice   { 10.00 }
      Domains     {
                     CORESerialNumber
                     COREValueNoTotal
                     COREMOPayOffice
                     COREMOIssueDate
                     CORERefundFee { UnitPrice }
                     TotalFee
                  }
      Snippets    {
                     CORECeasePaymnetLog
                     COREPreCeasePaymnetPostVal
                  }

   //GenericFinancial }
   }
   COREPaymentCopy {
      DontBuild
      BasedOn     { COREBaseMoneyOrd }
      Caption     { 'Certificate Payment Copy' }
      BitMap      { '..\..\core\images\P_PaymentCopy.bmp' }
      Description { 'Certificate Payment Copy' }
      Title       { 'Certificate Payment Copy' }
      UnitPrice   { 5.00 }
      Domains     { COREStandardFee { UnitPrice } }
      LogAs       { GenericFinancial }
   }
   COREMOOptionalService {
      DontBuild
      BasedOn     { COREBaseMoneyOrd }
      Caption     { 'Optional Service' }
      BitMap      { '..\..\core\images\P_MOOptionalService.bmp' }
      Description { 'Optional Service' }
      Title       { 'Optional Service' }
      UnitPrice   { 2.00 }
      Domains     { COREMOOptionalServiceFee { UnitPrice } }
      LogAs       { MOOptionalService }
   }

   COREMOForcePaid {
      DontBuild
      BasedOn { COREBaseMoneyOrd }
      Caption { 'Money Order Force Pay' }
      BitMap {  '..\IMAGES\P_ExpOrdPaid.bmp' }
      Description  { 'Money Order Force Pay' }
      Title        { 'Money Order Force Pay' }
      PLU          { PLU_ExpOrdPaid }
      Domains {
         CORESerialNumber
         COREIdentification
         COREMOValue
         COREMOIssueOffice
      }
      Items {
         'Complete'
      }
      Snippets {
         COREMOIssueUses
         COREMFLogPaidVars
         COREForceMOrdLogPaid
         COREForceMOPaidTriggerDec
         COREForceMOPaidTriggerDef
      }
   }

}

Domains {
   CORESendersSearchName {
      Title { 'Sender''s Family Name' }
      Prompt { 'Enter The Sender''s Family Name' }
      Hint { 'Enter The Sender''s Family Name' }
      Error { 'Invalid Sender''s Family Name' }
      Format { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
      InputFrom { 'Keyboard' }
   }
   CORESendersOtherNames {
      Title { 'Sender''s Other Names' }
      Prompt { 'Enter The Sender''s Other Names' }
      Hint { 'Enter The Sender''s Other Names' }
      Error { 'Invalid Sender''s Other Names' }
      Format { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
      InputFrom { 'Keyboard' }
   }
   CORESendersAddress {
      Title { 'Sender''s Address' }
      Prompt { 'Enter The Sender''s Address' }
      Hint { 'Enter The Sender''s Address' }
      Error { 'Invalid Sender''s Address' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   CORESendersPOBox {
      Title { 'Sender''s POBox Number' }
      Prompt { 'Enter The Sender''s POBox Number' }
      Hint { 'Enter The Sender''s POBox Number' }
      Error { 'Invalid Sender''s POBox Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   CORESendersTelephone {
      Title { 'Sender''s Telephone Number' }
      Prompt { 'Enter The Sender''s Telephone Number' }
      Hint { 'Enter The Sender''s Telephone Number' }
      Error { 'Invalid Sender''s Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   CORESendersMessage {
      Title { 'Sender''s Message' }
      Prompt { 'Enter The Sender''s Message' }
      Hint { 'Enter The Sender''s Message' }
      Error { 'Invalid Sender''s Message' }
      Format { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
      InputFrom { 'Keyboard' }
   }
   COREPayeesSearchName {
      Title { 'Payee''s Family Name' }
      Prompt { 'Enter The Payee''s Family Name' }
      Hint { 'Enter The Payee''s Family Name' }
      Error { 'Invalid Payee''s Family Name' }
      Format { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
      InputFrom { 'Keyboard' }
   }
   COREPayeesOtherNames {
      Title { 'Payee''s Other Names' }
      Prompt { 'Enter The Payee''s Other Names' }
      Hint { 'Enter The Payee''s Other Names' }
      Error { 'Invalid Payee''s Other Names' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREPayeesAddress {
      Title { 'Payee''s Address' }
      Prompt { 'Enter The Payee''s Address' }
      Hint { 'Enter The Payee''s Address' }
      Error { 'Invalid Payee''s Address' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREPayeesPOBox {
      Title { 'Payee''s POBox Number' }
      Prompt { 'Enter The Payee''s POBox Number' }
      Hint { 'Enter The Payee''s POBox Number' }
      Error { 'Invalid Payee''s POBox Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREPayeesTelephone {
      Title { 'Payee''s Telephone Number' }
      Prompt { 'Enter The Payee''s Telephone Number' }
      Hint { 'Enter The Payee''s Telephone Number' }
      Error { 'Invalid Payee''s Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREOriginalName {
      Title { 'Original Family Name' }
      Prompt { 'Enter The Original Family Name' }
      Hint { 'Enter The Original Family Name' }
      Error { 'Invalid Original Family Name' }
      Format { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
      InputFrom { 'Keyboard' }
   }
   COREOriginalAddress {
      Title { 'Original Address' }
      Prompt { 'Enter The Original Address' }
      Hint { 'Enter The Original Address' }
      Error { 'Invalid Original Address' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   CORENewName {
      Title { 'New Family Name' }
      Prompt { 'Enter The New Family Name' }
      Hint { 'Enter The New Family Name' }
      Error { 'Invalid New Family Name' }
      Format { Mask { 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' } }
      InputFrom { 'Keyboard' }
   }
   CORENewAddress {
      Title { 'New Address' }
      Prompt { 'Enter The New Address' }
      Hint { 'Enter The New Address' }
      Error { 'Invalid New Address' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   CORENewTelephone {
      Title { 'New Telephone Number' }
      Prompt { 'Enter The New Telephone Number' }
      Hint { 'Enter The New Telephone Number' }
      Error { 'Invalid New Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   CORESerialNumber {
      Title  { 'Serial Number' }
      Prompt { 'Serial Number' }
      Hint   { 'Enter the Serial Number' }
      Error  { 'Enter a Valid Serial Number' }
      Format {
         Range { '0, 9999999' }
      }
      InputFrom {
         'Keyboard'
      }
   }
   COREValue {
      Title  { 'Value' }
      Prompt { 'Value' }
      Hint   { 'Enter the Value' }
      Error  { 'Enter a Valid Value' }
      Format {
         Range { '0,100000000' }
      }
      InputFrom {
         'Keyboard'
      }
      TotalIn { TotalFee }
   }

   COREValueNoTotal {
      Title  { 'Value' }
      Prompt { 'Value' }
      Hint   { 'Enter the Value' }
      Error  { 'Enter a Valid Value' }
      Format {
         Range { '0,100000000' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   COREMOPayOffice {
      Title  { 'Payment Office' }
      Prompt { 'Payment Office' }
      Hint   { 'Select the Payment Office' }
      Error  { 'Select the Payment Office' }
      Format {
         PickList  { 'PickList.MoneyOrderOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }
   COREMFPayOffice {
      Title  { 'Issue Payment Office' }
      Prompt { 'Issue Payment Office' }
      Hint   { 'Select Issue Payment Office' }
      Error  { 'Select Issue Payment Office' }
      Format {
         PickList  { 'PickList.MFIssueOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   COREMOriginalPayOffice {
      Title  { 'Original Payment Office' }
      Prompt { 'Original Payment Office' }
      Hint   { 'Select Original Payment Office' }
      Error  { 'Select Original Payment Office' }
      Format {
         PickList  { 'PickList.MoneyOrderOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   CORECommission{
      Title  { 'Commission' }
      Prompt { 'Commission' }
      InputFrom {
         'Params'
      }
      TotalIn { TotalFee }
   }

   COREIdentification {
      Title { 'Identification' }
      Prompt { 'Enter Details of Identification Used' }
      Hint { 'Enter Details of Identification Used^e.g PASSPORT No. 500161289 or ID CARD 1234567' }
      Error { 'Invalid Identification ' }
      Format { Mask {'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'} }
      InputFrom { 'Keyboard' }
   }
   COREMOValue {
      Title  { 'Value' }
      Prompt { 'Value' }
      Hint   { 'Enter the Value' }
      Error  { 'Enter a Valid Value' }
      Format {
         Mask { 'xxxxxxxxxxxxxxxxxxxx' }
      }
      InputFrom {
         'Keyboard'
      }
   }
   COREMFIssueOffice {
      Title  { 'Issuing Office' }
      Prompt { 'Issuing Office' }
      Hint   { 'Select the Issuing Office' }
      Error  { 'Select the Issuing Office' }
      Format {
         PickList  { 'PickList.MFIssueOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }
   COREMOIssueOffice {
      Title  { 'Issuing Office' }
      Prompt { 'Issuing Office' }
      Hint   { 'Select the Issuing Office' }
      Error  { 'Select the Issuing Office' }
      Format {
         PickList  { 'PickList.MoneyOrderOffices' }
      }
      InputFrom {
         'Keyboard'
      }
   }
   COREMOPayeeName {
      Title { 'Payee''s Name' }
      Prompt { 'Enter The Payee''s Name' }
      Hint { 'Enter The Payee''s Name' }
      Error { 'Invalid Payee''s Name' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREMOPayeeStreet {
      Title { 'Payee''s Street' }
      Prompt { 'Enter The Payee''s Street' }
      Hint { 'Enter The Payee''s Street' }
      Error { 'Invalid Payee''s Street' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREMOPayeeTelephone {
      Title { 'Payee''s Telephone Number' }
      Prompt { 'Enter The Payee''s Telephone Number' }
      Hint { 'Enter The Payee''s Telephone Number' }
      Error { 'Invalid Payee''s Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREMOPayeePOBox {
      Title { 'Payee''s POBox Number' }
      Prompt { 'Enter The Payee''s POBox Number' }
      Hint { 'Enter The Payee''s POBox Number' }
      Error { 'Invalid Payee''s POBox Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREMOIssueDate {
      Title { 'Issue Date' }
      Prompt { 'Enter the issue date range' }
      Hint { 'Enter the issue date range in the format^050201-080201 or 050201 i.e. 5th Feb 2001' }
      Error { 'Invalid issue date range' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREMOSenderName {
      Title { 'Sender''s Name' }
      Prompt { 'Enter The Sender''s Name' }
      Hint { 'Enter The Sender''s Name' }
      Error { 'Invalid Sender''s Name' }
      Format { None }
      InputFrom { 'Keyboard' }
   }
   COREMOSenderStreet {
      Title { 'Sender''s Street' }
      Prompt { 'Enter The Sender''s Street' }
      Hint { 'Enter The Sender''s Street' }
      Error { 'Invalid Sender''s Street' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   COREMOSenderPOBox {
      Title { 'Sender''s POBox Number' }
      Prompt { 'Enter The Sender''s POBox Number' }
      Hint { 'Enter The Sender''s POBox Number' }
      Error { 'Invalid Sender''s POBox Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   COREMOSenderTelephone {
      Title { 'Sender''s Telephone Number' }
      Prompt { 'Enter The Sender''s Telephone Number' }
      Hint { 'Enter The Sender''s Telephone Number' }
      Error { 'Invalid Sender''s Telephone Number' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   COREMOSenderMessage {
      Title { 'Sender''s Message' }
      Prompt { 'Enter The Sender''s Message' }
      Hint { 'Enter The Sender''s Message' }
      Error { 'Invalid Sender''s Message' }
      Format { None }
      InputFrom { 'Keyboard' }
   }

   COREMOResultsList {
      Title  { 'Results List' }
      Prompt { 'Results List' }
      Hint   { 'Select a Money Order from the list' }
      Error  { 'Invalid Money Order' }
      Format {
         PickList  { '' }
      }
      InputFrom {
         'Keyboard'
      }
   }

   COREMonOrdModFee {
     Title     { 'Money Order Modify Fee'    }
     Prompt    { 'Modify Fee'                }
     Hint      { 'Enter the Modify Fee'      }
     Error     { 'Invalid Modify Fee'        }
     Format    { Currency { 0,9999999999 }   }
     InputFrom { 'Keyboard'                  }
   }

   COREIntMoneyOrderDestination {
      Title  { 'Destination Country'}
      Prompt { 'Destination'}
      Hint   { 'Select the Destination Country'}
      Error  { 'The Destination Country you have Selected is invalid' }
      Format {
         PickList { 'PickList.IntMoneyOrderCountries' }
      }
   }
   COREStandardFee {
      Title     { 'Standard Fee' }
      Prompt    { 'Standard Fee' }
      InputFrom { Params         }
      TotalIn   { TotalFee       }
   }

   CORERefundFee {
      Title     { 'Refund Fee' }
      Prompt    { 'Refund Fee' }
      InputFrom { Attrib { UnitPrice }     }
   }

   COREMoneyOrderValue {
     Title     { 'Money Order Value'      }
     Prompt    { 'Value of Money Order'   }
     TotalIn   { TotalFee                 }
     Format    { Currency { 0,9999999999 }}
     InputFrom { 'Keyboard'               }
   }
   COREMoneyOrderNumber {
     Title     { 'Money Order Number'         }
     Prompt    { 'Money Order Number'         }
     Hint      { 'Money Order Number'         }
     Error     { 'Invalid Money Order Number' }
     Format    {
        Range { '0, 9999999' }
     }
     InputFrom {
        'Keyboard'
     }
   }
   COREMOOptionalServiceFee {
      Title     { 'Optional Service Fee' }
      Prompt    { 'Optional Service Fee' }
      InputFrom { Params }
      TotalIn   { TotalFee }
   }
}


Snippets {


   COREPreCeasePaymnetPostVal {
      InsertBetween { '{PostValidateStart}','{PostValidateEnd}' }
      CodeBlock {
      [*
         if Result then
          try
            StrToDate( COREMOIssueDate.Text ) ;
          except
            MoveFocusTo( COREMOIssueDate );
            Result := False ;
          end ;
         TotalFee.Text := CurrToStrF( StrToCurrDef( COREValueNoTotal.Text, 0 ) - StrToCurrDef( CORERefundFee.Text, 0 ), ffnumber, 2 ) ;
      *]
      }
   }



   CORECeasePaymnetLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               0, // Value
               0, // Price
               Get_Description, // Description
               ProdForm.CORESerialNumber.Text, // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               -StrToCurrDef(ProdForm.COREValueNoTotal.Text,0), // Value
               -StrToCurrDef(ProdForm.COREValueNoTotal.Text,0), // Price
               'Value', // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               Get_PLU, // PLU
               StrToCurrDef(ProdForm.CORERefundFee.Text,0) , // Value
               StrToCurrDef(ProdForm.CORERefundFee.Text,0), // Price
               'Refund Fee ', // Description
               '', // Additional Info
               Get_ProgramID, // ProgID
               Enumerate(ProdForm)); // Domain Info
         Inc(Index);

        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Issue Date - ', // Description
               ProdForm.COREMOIssueDate.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);
        TxnLog.LogTransaction(
               Index,
               FQuantity, // Quantity
               0, // PLU
               0, // Value
               0, // Price
               'Office - ', // Description
               ProdForm.COREMOPayOffice.Text, // Additional Info
               '', // ProgID
               ''); // Domain Info
         Inc(Index);
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }


