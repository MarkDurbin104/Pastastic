   }
   COREMOPaidEnableComplete {
      InsertBetween { '{EnableCompleteStart}','{EnableCompleteEnd}' }
      CodeBlock {
      [*
         if (ProdForm.COREMOResultsList.Ignore) and (ProdForm.COREIdentification.Ignore) then
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','Search',0,0,True,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','Search Paid',0,0,True,False);
         end
         else if (Value) and (ProdForm.COREMOResultsList.Ignore) then
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','Complete',0,0,False,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
         end
         else
         begin
            FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
            FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
         end;
      *]
      }
   }
   COREMOPaidCompleteResitem {
      InsertBetween { '{ItemResStart}','{ItemResEnd}' }
      CodeBlock {
      [*
            riItemBase :
            if (ProdForm.COREMOResultsList.Ignore) and (ProdForm.COREIdentification.Ignore) then
               Result:='Search'
            else if ValidateOK and (ProdForm.COREMOResultsList.Ignore) then
               Result:=ResItem00
            else
               Result:='';
         riItemBase+1   :
            if (ProdForm.COREMOResultsList.Ignore) and (ProdForm.COREIdentification.Ignore) then
               Result:='Search Paid'
            else
               Result:='';
      *]
      }
   }
   COREMOPaidSearchClick {
      InsertBetween { '{SwapToStart}','{SwapToEnd}' }
      CodeBlock {
      [*
         if Name = 'Search' then
         begin
            PopulateMOList(False);
            Exit;
         end
         else if Name = 'Search Paid' then
         begin
            PopulateMOList(True);
            Exit;
         end;
      *]
      }
   }

   COREMOPaidTriggerDec {
     InsertBetween { '{OverrideDecStart}','{OverrideDecEnd}' }
     CodeBlock {
       [*
          procedure TriggerBarCode(Value:String); override;
          procedure PopulateMOList(IncludePaid:Boolean);
          procedure FillForm(MOItem:TMOIssued);
          procedure GetMOValues(Value:String);
          function MOPaidSlip:String;
       *]
     }
   }
   COREMOPaidTriggerDef {
     InsertBetween { '{OverrideDefStart}','{OverrideDefEnd}' }
     CodeBlock {
       [*
          procedure
         {PClass}TCOREFaxOrdPaidProduct.TriggerBarCode(Value:String);
          begin
             GetMOValues(Value);
          end;
          procedure
         {PClass}TCOREFaxOrdPaidProduct.PopulateMOList(IncludePaid:Boolean);
          var
            SL,NSL:TPackStringList;
            MOItemList:TMOItemList;
            MOItem:TMOIssued;
            I:Integer;
            IO:String;
          begin
             if ProdForm.COREMFIssueOffice.Text = 'ANY' then
                IO:=''
             else
                IO:=ProdForm.COREMFIssueOffice.Text;
             if IO <> '' then
               IO:=Copy(TStringObject(ProdForm.COREMFIssueOffice.Items.Objects[ProdForm.COREMFIssueOffice.Items.IndexOf(IO)]).Value,2,999);
             MOItemList:=TMOItemList.Create(nil);
             if IncludePaid then
               MOItemList.Details:=MoneyOrders.IssuedMOList(ProdForm.COREMOIssueDate.Text,IO,IntToStr(FUIEventSink.Office),'',ProdForm.COREMOValue.Text,'FAX',ProdForm.COREMOPayeeTelephone.Text,ProdForm.COREMOPayeePOBox.Text,ProdForm.CORESerialNumber.Text)
             else
               MOItemList.Details:=MoneyOrders.UnPaidMOList(ProdForm.COREMOIssueDate.Text,IO,IntToStr(FUIEventSink.Office),'',ProdForm.COREMOValue.Text,'FAX',ProdForm.COREMOPayeeTelephone.Text,ProdForm.COREMOPayeePOBox.Text,ProdForm.CORESerialNumber.Text);
             if MOItemList.Count = 1 then
             begin
                FillForm(TMOIssued(MOItemList[0]));
             end
             else if MOItemList.Count > 1 then
             begin
                SL:=TPackStringList.Create;
                NSL:=TPackStringList.Create;
                for I:=0 to MOItemList.Count-1 do
                begin
                   MOItem:=TMOIssued(MOItemList[I]);
                   SL.Add( '-1');
                   SL.Add(CurrToStrF(MOItem.Value,ffFixed,0));
                   SL.Add('100'); SL.Add(' ');
                   NSL.PackText:=MOItem.SendersName;
                   SL.Add('102');
                   if NSL.Count > 1 then
                      SL.Add(NSL[1]+' '+NSL[0])
                   else
                      SL.Add(' ');
                   SL.Add('372'); SL.Add('>');
                   NSL.PackText:=MOItem.RecipientsName;
                   SL.Add('383');
                   if NSL.Count > 1 then
                      SL.Add(NSL[1]+' '+NSL[0])
                   else
                      SL.Add(' ');
                   SL.Add('999');
                   SL.Add(IntToStr(I));
                   ProdForm.COREMOResultsList.Items.AddObject(SL.PackText,MOItem);
                   SL.Clear;
                end;
                SL.Free;
                NSL.Free;
                ProdForm.CORESerialNumber.Ignore     :=True;
                ProdForm.COREMOResultsList.Ignore    :=False;
                ProdForm.COREMFIssueOffice.Ignore    :=True;
                ProdForm.COREMOIssueDate.Ignore      :=True;
                ProdForm.COREMOPayeeTelephone.Ignore :=True;
                ProdForm.COREMOPayeePOBox.Ignore     :=True;
                ProdForm.COREMOValue.Ignore          :=True;
                FUIEventSink.DisplayItemInfo(Self,0,'','',0,0,True,False);
                FUIEventSink.DisplayItemInfo(Self,1,'','',0,0,True,False);
                FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
             end;
          end;
          procedure
         {PClass}TCOREFaxOrdPaidProduct.FillForm(MOItem:TMOIssued);
          var
            IO:String;
            SL:TPackStringList;
            I:Integer;
          begin
             if MOItem = nil then Exit;
             ProdForm.CORESerialNumber.Text       :=MOItem.Identifier;
             ProdForm.COREMOValue.Text:=CurrToStrF(MOItem.Value,ffFixed,0);
             IO:=IntToStr(MOItem.IssuingOffice);
             for I:=0 to ProdForm.COREMFIssueOffice.Items.Count-1 do
             begin
                if TStringObject(ProdForm.COREMFIssueOffice.Items.Objects[I]).Value = 'O'+IO then
                begin
                   IO:=ProdForm.COREMFIssueOffice.Items[I];
                   break;
                end;
             end;
             ProdForm.COREMFIssueOffice.Text      :=IO;
             ProdForm.COREMOIssueDate.Text        :=DateToStr(MOItem.DateTime);
             SL:=TPackStringList.Create;
             SL.PackText:=MOItem.SendersName;
             if SL.Count > 1 then
                ProdForm.COREMOSenderName.Text    :=Trim(SL[1]+' '+SL[0]);
             SL.PackText:=MOItem.SendersAddress;
             if SL.Count > 1 then
                ProdForm.COREMOSenderStreet.Text     :=Trim(SL[0]+' '+SL[1]);
             if SL.Count > 2 then
                ProdForm.COREMOSenderTelephone.Text  :=Trim(SL[2]);
             if SL.Count > 3 then
                ProdForm.COREMOSenderPOBox.Text      :=Trim(SL[3]);
             ProdForm.COREMOSenderMessage.Text:=MOItem.Information;
             SL.PackText:=MOItem.RecipientsName;
             if SL.Count > 1 then
                ProdForm.COREMOPayeeName.Text        :=Trim(SL[1]+' '+SL[0]);
             SL.PackText:=MOItem.RecipientsAddress;
             if SL.Count > 1 then
                ProdForm.COREMOPayeeStreet.Text      :=Trim(SL[0]+' '+SL[1]);
             ProdForm.COREMOPayeePOBox.Text       :=MOItem.RContact2;
             ProdForm.COREMOPayeeTelephone.Text   :=MOItem.RContact1;
             SL.Free;

             ProdForm.COREMOResultsList.Ignore    :=True;
             ProdForm.CORESerialNumber.Ignore     :=False;
             ProdForm.COREIdentification.Ignore   :=False;
             ProdForm.COREMFIssueOffice.Ignore    :=False;
             ProdForm.COREMOIssueDate.Ignore      :=False;
             ProdForm.COREMOSenderName.Ignore     :=False;
             ProdForm.COREMOSenderStreet.Ignore   :=False;
             ProdForm.COREMOSenderPOBox.Ignore    :=False;
             ProdForm.COREMOSenderTelephone.Ignore:=False;
             ProdForm.COREMOSenderMessage.Ignore:=False;
             ProdForm.COREMOPayeeName.Ignore      :=False;
             ProdForm.COREMOPayeeStreet.Ignore    :=False;
             ProdForm.COREMOPayeeTelephone.Ignore :=False;
             ProdForm.COREMOPayeePOBox.Ignore     :=False;
             ProdForm.COREMOValue.Ignore          :=False;

             ProdForm.CORESerialNumber.Enabled     :=False;
             ProdForm.COREMFIssueOffice.Enabled    :=False;
             ProdForm.COREMOIssueDate.Enabled      :=False;
             ProdForm.COREMOSenderName.Enabled     :=False;
             ProdForm.COREMOSenderStreet.Enabled   :=False;
             ProdForm.COREMOSenderPOBox.Enabled    :=False;
             ProdForm.COREMOSenderTelephone.Enabled:=False;
             ProdForm.COREMOSenderMessage.Enabled:=False;
             ProdForm.COREMOPayeeName.Enabled      :=False;
             ProdForm.COREMOPayeeStreet.Enabled    :=False;
             ProdForm.COREMOPayeeTelephone.Enabled :=False;
             ProdForm.COREMOPayeePOBox.Enabled     :=False;
             ProdForm.COREMOValue.Enabled          :=False;
             FlagComplete(ProdForm.Validate);
             FUIEventSink.DataChanged(Self,GetFormData(ProdForm),False);
          end;

          procedure
         {PClass}TCOREFaxOrdPaidProduct.GetMOValues(Value:String);
          var
            Index:Integer;
          begin
             Index:=ProdForm.COREMOResultsList.Items.IndexOf(Value);
             if Index >=0 then
             begin
               FillForm(TMOIssued(ProdForm.COREMOResultsList.Items.Objects[Index]));
             end;
          end;
          function {PClass}TCOREFaxOrdPaidProduct.MOPaidSlip:String;
          var
             SL:TStringList;
             Status:MOStatus;
          begin
                SL:=TPackStringList.Create;
                SL.Add('"Money Fax Authorization Form",""');
                SL.Add('"",""');
                MoneyOrders.GetMOStatus(ProdForm.CORESerialNumber.Text,2001,Status);
                case Status of
                   mosNone   : SL.Add('"Status NA",""');
                   mosIssued : SL.Add('"Status OK",""');
                   mosPaid   : SL.Add('"Status PP",""');
                end;
                //SL.Add('"Serial Number","'+ProdForm.CORESerialNumber.Text +'"');
                SL.Add('"'+ProdForm.CORESerialNumberLabel.Caption+'","'+ProdForm.CORESerialNumber.Text +'"');
                SL.Add('"Value","'        +ProdForm.COREMOValue.Text +'"');
                SL.Add('"Issue Office","' +ProdForm.COREMFIssueOffice.Text+'"');
                SL.Add('"Issue Date","'   +ProdForm.COREMOIssueDate.Text +'"');
                SL.Add('"Sender:",""');
                SL.Add('"Name  :'+ProdForm.COREMOSenderName.Text+'",""');
                SL.Add('"Street:'+ProdForm.COREMOSenderStreet.Text+'",""');
                SL.Add('"Tel:'+ProdForm.COREMOSenderTelephone.Text+'",""');
                SL.Add('"POBox :'+ProdForm.COREMOSenderPOBox.Text+'",""');
                SL.Add('"Payee:",""');
                SL.Add('"ID    :'+ProdForm.COREIdentification.Text+'",""');
                SL.Add('"Name  :'+ProdForm.COREMOPayeeName.Text+'",""');
                SL.Add('"Street:'+ProdForm.COREMOPayeeStreet.Text+'",""');
                SL.Add('"Tel:'+ProdForm.COREMOPayeeTelephone.Text+'",""');
                SL.Add('"POBox :'+ProdForm.COREMOPayeePOBox.Text+'",""');
                SL.Add('"",""');
                SL.Add('"Message :",""');
                SL.Add('"'+ProdForm.COREMOSenderMessage.Text+'",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"I Certify that I am the designated",""');
                SL.Add('"recipient of the above Money Order",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Name:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Signature:",""');
                SL.Add('"","__________________________________"');
                SL.Add('"",""');
                SL.Add('"FOR OFFICIAL USE:",""');
                SL.Add('"",""');
                SL.Add('"",""');
                SL.Add('"Authorised by:",""');
                SL.Add('"","__________________________________"');
                Result:=SL.CommaText;
                SL.Free;
          end;
       *]
     }
   }
   COREMoneyFaxLog {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         Value:=StrToCurrDef(ProdForm.COREMOValue.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,2000030,Value,Value,Get_Description,
                               'No. '+ProdForm.CORESerialNumber.Text,
                               Get_ProgramID,Enumerate(ProdForm));
         Inc(Index);
         Value:=StrToCurrDef(ProdForm.CORECommission.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,2000040,Value,Value,ProdForm.CORECommission.PromptLabel.Caption,
                           '','Money Fax Comm.','');
         Inc(Index);
         Value:=StrToCurrDef(ProdForm.COREStandardFee.Text,0);
         TxnLog.LogTransaction(Index,FQuantity,70000020,
                           Value,Value,'Fee',
                           '','Money Fax Fee','');
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Pay Office '+ProdForm.COREMFPayOffice.Text+'('+Copy(TStringObject(ProdForm.COREMFPayOffice.Items.Objects[ProdForm.COREMFPayOffice.Items.IndexOf(ProdForm.COREMFPayOffice.Text)]).Value,2,999)+')',
                           '','Pay Office','');
         Inc(Index);
         TxnLog.WriteTransaction('MFIssue',0,Trunc(StrToCurrDef(ProdForm.COREStandardFee.Text,-1)),0,
         StrToCurrDef(ProdForm.CORECommission.Text,0),
                                 StrToCurrDef(ProdForm.COREMOValue.Text,0),
                                 ProdForm.CORESerialNumber.Text,

         Copy(TStringObject(ProdForm.COREMFPayOffice.Items.Objects[ProdForm.COREMFPayOffice.Items.IndexOf(ProdForm.COREMFPayOffice.Text)]).Value,2,999),
                                 'MFIssue','');
         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);
      *]
      }
   }
   COREMFLogPaid {
      InsertBetween { '{LogTransactionStart}','{LogTransactionEnd}' }
      CodeBlock {
      [*
         TxnLog.LogTransaction(Index,FQuantity,Get_PLU,
                               0-StrToCurrDef(ProdForm.COREMOValue.Text,0),
                               0-StrToCurrDef(ProdForm.COREMOValue.Text,0),
         Get_Description,ProdForm.CORESerialNumber.Text,Get_ProgramID,
                               Enumerate(ProdForm));
         Inc(Index);
         TxnLog.LogTransaction(Index,FQuantity,0,
                           0,0,'Issue Office'+ProdForm.COREMFIssueOffice.Text+' ('+Copy(TStringObject(ProdForm.COREMFIssueOffice.Items.Objects[ProdForm.COREMFIssueOffice.Items.IndexOf(ProdForm.COREMFIssueOffice.Text)]).Value,2,999)+')',
                           '','Issue Office','');
         Inc(Index);
         ResultList:=MOPaidSlip;
         TxnLog.WriteTransaction('*MFPaid',0,0,0,StrToCurrDef(ProdForm.COREMOValue.Text,0),0,
         ProdForm.CORESerialNumber.Text,ProdForm.CORESerialNumber.Text,'MFPaid','');
         TxnLog.WriteTransaction('MFPaid',0,0,0,0-StrToCurrDef(ProdForm.COREMOValue.Text,0),0,
         ProdForm.CORESerialNumber.Text,ProdForm.CORESerialNumber.Text,'MFPaid Complete',ResultList);

         if CombineList <> nil then
            CombineList.LogTransactions(Index,TxnLog);

         try
            ReceiptPrinter:=FUIEventSink.GetComponentReference(GUIDToString(Class_ReceiptDevice)) as IDevice;
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
            ReceiptPrinter.WriteDevice(dcInitialise,'',1);
            ReceiptPrinter.WriteDevice(dcList5Data,ResultList,1);
            ReceiptPrinter.WriteDevice(dcShutdown,'',0);
         finally
            ReceiptPrinter := nil;
         end ;
      *]
      }
