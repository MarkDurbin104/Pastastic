<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
    targetNamespace="http://www.nrf-arts.org/IXRetail/namespace/"
    xmlns="http://www.nrf-arts.org/IXRetail/namespace/" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <!-- Go get the Library -->
    <!-- Go get the Library -->
    <!--
        A real piece of infrastructure
    -->
    <xs:simpleType name="POSLogEnumerationExtension">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9A-Za-z][0-9A-Za-z]*:[A-Z][0-9A-Za-z]*"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- 
      Defines a set of complex types for small fundamental
      data elements that're required througout POSLog
        - POSLogCurrencyCode - enumerated list of valid currency codes
    
        - POSLogAmount - Normally just an xs:decimal denoting a monetary amount
                in some default currency. Attributes    @Currency and @ForeignAmount 
                denote the foreign currency and the equivalent monetary amount 
                of the value.
                
        - POSLogQuantity - Normally just an xs:decimal but attributes
                Units & UnitOfMeasureCode help qualify when required.

        - POSLogUnitPrice   - Normally just an xs:decimal but attributes
                Quantity allows it to be used for prices like: 3 for $0.89
                UnitOfMeasureCode allows it to be use for prices like 89c per lb
                Both attributes give prices like: $1.59 per 100g
                        
        - POSLogTransactionLink - 
    
        - POSLogEntryMethod - 
    -->
    <xs:complexType name="RetailTransactionAddress">
        <xs:sequence>
            <xs:element form="qualified" minOccurs="0" name="Name" type="xs:string"/>
            <xs:element form="qualified" maxOccurs="unbounded" name="AddressLine" type="xs:string"/>
            <xs:element form="qualified" minOccurs="0" name="City" type="xs:string"/>
            <xs:element form="qualified" minOccurs="0" name="State" type="xs:string"/>
            <xs:element form="qualified" minOccurs="0" name="PostalCode" type="xs:string"/>
            <xs:element form="qualified" minOccurs="0" name="CountryCode" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="POSLogItemID">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:complexType name="POSLogOperatorID">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute form="unqualified" name="OperatorName" type="xs:string" use="optional"/>
                <xs:attribute form="unqualified" name="EmployeeID" type="xs:string" use="optional"/>
                <xs:attribute form="unqualified" name="OperatorType" type="OperatorTypeType"
                    use="optional"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="POSLogAmount">
        <xs:simpleContent>
            <xs:extension base="xs:decimal">
                <xs:attribute form="unqualified" name="Currency" type="POSLogCurrencyCode"
                    use="optional"/>
                <xs:attribute form="unqualified" name="ForeignAmount" type="xs:decimal"
                    use="optional"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="POSLogQuantity">
        <xs:simpleContent>
            <xs:extension base="xs:decimal">
                <xs:attribute default="1" form="unqualified" name="Units" type="xs:decimal"/>
                <xs:attribute default="Each" form="unqualified" name="UnitOfMeasureCode"
                    type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="POSLogUnitPrice">
        <xs:simpleContent>
            <xs:extension base="POSLogAmount">
                <xs:attribute form="unqualified" name="Quantity" type="xs:decimal" use="optional"/>
                <xs:attribute default="Each" form="unqualified" name="UnitOfMeasureCode"
                    type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="POSLogTotals">
        <xs:sequence>
            <xs:element form="qualified" name="Amount" type="POSLogAmount"/>
            <xs:element form="qualified" minOccurs="0" name="Count" type="xs:integer"/>
            <xs:element form="qualified" minOccurs="0" name="Reason" type="POSLogReason"/>
        </xs:sequence>
    </xs:complexType>
    <!-- ************************************************************ -->
    <!-- ********** Operator ********** -->
    <!--
        Enumerated type for Operator Type attribute
    -->
    <xs:simpleType name="OperatorTypeType">
        <xs:union memberTypes="OperatorTypeTypeEnumeration OperatorTypeTypeExtension"/>
    </xs:simpleType>
    <xs:simpleType name="OperatorTypeTypeEnumeration">
        <xs:restriction base="xs:NMTOKEN">
            <xs:enumeration value="Cashier"/>
            <xs:enumeration value="Checker"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="OperatorTypeTypeExtension">
        <xs:restriction base="POSLogEnumerationExtension"/>
    </xs:simpleType>
