        <xs:attribute form="unqualified" name="CustomerQuestionID"
            type="RetailTransactionRestrictionValidationQuestion" use="required"/>
        <xs:attribute form="unqualified" name="EntryMethod" type="POSLogEntryMethod"/>
    </xs:complexType>
