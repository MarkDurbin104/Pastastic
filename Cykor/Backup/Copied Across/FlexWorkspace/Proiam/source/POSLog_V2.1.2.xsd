    <!-- 
      Defines a complex type POSLogRetailTransaction which is the
      main kind of transaction in the IXRetail POSLog - recording
      the exchange of merchandise & services for tender.
   
      It consists of:
        - a whole lot of header info
        - a collection of line items
    -->
    <xs:complexType name="POSLogRetailTransaction">
        <xs:sequence>
            <xs:element form="qualified" minOccurs="0" name="SpecialOrderNumber" type="xs:string"/>
            <xs:element form="qualified" minOccurs="0" name="ManagerApproval" type="xs:boolean"/>
            <xs:element form="qualified" minOccurs="0" name="ReceiptDateTime" type="xs:dateTime"/>
            <xs:element form="qualified" minOccurs="0" name="TransactionCount" type="xs:integer"/>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0" name="LineItem"
                type="RetailTransactionLineItem"/>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0" name="Total"
                type="RetailTransactionTotal"/>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                name="RestrictionValidation" type="RetailTransactionRestrictionValidation"/>
            <xs:element form="qualified" minOccurs="0" name="Delivery"
                type="RetailTransactionDelivery"/>
            <xs:element form="qualified" minOccurs="0" name="Pickup" type="RetailTransactionPickup"/>
            <xs:element form="qualified" minOccurs="0" name="Customer"
                type="RetailTransactionCustomer"/>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0" name="Associate"
                type="RetailTransactionAssociate"/>
            <xs:element form="qualified" minOccurs="0" name="Hospitality"
                type="RetailTransactionHospitality"/>
            <xs:element form="qualified" minOccurs="0" name="TransactionLink"
                type="POSLogTransactionLink"/>
            <xs:any maxOccurs="unbounded" minOccurs="0" namespace="##other" processContents="lax"/>
        </xs:sequence>
        <xs:attribute fixed="2.1" form="unqualified" name="Version" type="xs:decimal" use="required"/>
        <xs:attribute default="Transaction" form="unqualified" name="TypeCode"
            type="POSLogTransactionTypeCode" use="optional"/>
        <xs:attribute default="Totaled" form="unqualified" name="TransactionStatus"
            type="POSLogTransactionStatus" use="optional"/>
        <xs:attribute default="false" form="unqualified" name="OutsideSalesFlag" type="xs:boolean"
            use="optional"/>
        <xs:attribute default="false" form="unqualified" name="SplitCheckFlag" type="xs:boolean"
            use="optional"/>
    </xs:complexType>
    <xs:complexType name="RetailTransactionRestrictionValidation">
        <xs:sequence>
            <xs:element form="qualified" minOccurs="0" name="QuestionText" type="xs:string"/>
            <xs:choice>
                <xs:element form="qualified" name="QuestionAnswer" type="xs:string"/>
                <xs:element form="qualified" name="Address" type="RetailTransactionAddress"/>
