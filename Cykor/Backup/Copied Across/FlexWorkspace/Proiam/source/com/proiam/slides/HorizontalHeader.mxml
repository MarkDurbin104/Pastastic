<?xml version="1.0" encoding="utf-8"?>
<CanvasButtonAccordionHeader 
	xmlns="flexlib.containers.accordionClasses.*" 
	xmlns:mx="http://www.adobe.com/2006/mxml"
	xmlns:filters="flash.filters.*"
	verticalScrollPolicy="off" horizontalScrollPolicy="off">

	<mx:HBox styleName="mainBox" width="100%" height="100%" 	verticalAlign="bottom" horizontalAlign="left" >
		<mx:Label text="{data.title}" styleName="title" width="40%"  />
		<mx:Text id="targetData" text="{data.description}" styleName="description"	width="60%"   selectable="false" />
	</mx:HBox>
	
	<filters>
		<filters:DropShadowFilter angle="90" alpha=".1" blurX="0" distance="3" />
	</filters>
</CanvasButtonAccordionHeader>
