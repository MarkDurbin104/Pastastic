<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" width="213" height="133"
 	backgroundSize="100%" backgroundImage="{bgImageClass}" 
 	verticalScrollPolicy="off" horizontalScrollPolicy="off"
 	buttonMode="true" useHandCursor="true">
 	<mx:Script>
 		<![CDATA[
			[Embed(source="embedded/ConfAddrButton.png")]
			public var NormalImageClass:Class; 
			[Embed(source="embedded/ErrorConfAddrButton.png")]
			public var ErrorImageClass:Class; 
			[Bindable]
			public var bgImageClass:Class=NormalImageClass;
			public function set error(value:Boolean):void {
				if (value) 
					bgImageClass=ErrorImageClass;
				else
					bgImageClass=NormalImageClass;
			}
 		]]>
 	</mx:Script>
	<mx:String id="title"></mx:String>
	<mx:String id="text"></mx:String>
  	<mx:Label x="10" y="15" text="{title}" fontWeight="bold" fontFamily="Verdana" fontSize="12" color="#496384" width="183" selectable="false" buttonMode="true" useHandCursor="true"/>
  	<mx:Text x="9" y="48" width="194" height="75" alpha="0.0" color="#214134" text="{text}" selectable="false" 
  		fontFamily="Verdana" fontSize="11"  fontWeight="bold" buttonMode="true" useHandCursor="true"/>
  	<mx:Canvas buttonMode="true" width="100%" height="100%" useHandCursor="true"/>
</mx:Canvas>