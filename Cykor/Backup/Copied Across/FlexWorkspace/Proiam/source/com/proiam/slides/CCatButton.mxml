  	<mx:Text x="76" y="48" width="127" height="75" alpha="0.0" color="#214134" text="{text}" selectable="false" 
  		fontFamily="Verdana" fontSize="11" fontWeight="bold" buttonMode="true" useHandCursor="true"/>
  	<mx:Text x="9" y="48" width="74" height="75" alpha="0.0" color="#496384" text="{catagory}" selectable="false" 
  		fontWeight="bold" fontFamily="Verdana" fontSize="11" buttonMode="true" useHandCursor="true" />
  	<mx:Canvas buttonMode="true" width="100%" height="100%" useHandCursor="true"/>
</mx:Canvas>