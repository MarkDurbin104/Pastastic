	mx_internal static var _index_StylesInit_done:Boolean = false;

	mx_internal function _index_StylesInit():void
	{
		//	only add our style defs to the StyleManager once
		if (mx_internal::_index_StylesInit_done)
			return;
		else
			mx_internal::_index_StylesInit_done = true;

		var style:CSSStyleDeclaration;
		var effects:Array;

		// gradientRoundBaseSkin
		style = StyleManager.getStyleDeclaration(".gradientRoundBaseSkin");
		if (!style)
		{
			style = new CSSStyleDeclaration();
			StyleManager.setStyleDeclaration(".gradientRoundBaseSkin", style, false);
		}
		if (style.factory == null)
		{
			style.factory = function():void
			{
				this.textAlign = "left";
				this.color = 0xffffff;
				this.width = 150;
				this.height = 30;
				this.upSkin = base.GradientRoundBaseSkin;
				this.fontSize = 12;
				this.overSkin = base.GradientRoundBaseSkin;
				this.downSkin = base.GradientRoundBaseSkin;
				this.disabledSkin = base.GradientRoundBaseSkin;
				this.fontFamily = "Arial";
			};
		}
		// gradientRectangleSkin
		style = StyleManager.getStyleDeclaration(".gradientRectangleSkin");
		if (!style)
		{
			style = new CSSStyleDeclaration();
			StyleManager.setStyleDeclaration(".gradientRectangleSkin", style, false);
		}
		if (style.factory == null)
		{
			style.factory = function():void
			{
				this.fillColorBB = 0x6c98b5;
				this.width = 150;
				this.upSkin = base.GradientRectangleSkin;
				this.outerEdge = 1;
				this.fontSize = 12;
				this.overSkin = base.GradientRectangleSkin;
				this.gradiantAngle = 90;
				this.fontFamily = "Arial";
				this.textAlign = "left";
				this.fillColorBT = 0xa3c6dc;
				this.color = 0xffffff;
				this.cornerRadius = 12;
				this.height = 30;
				this.fillColorIT = 0xf1f3f0;
				this.fillColorIB = 0xd7e7e7;
				this.fillColorET = 0xc6e0ef;
				this.innerEdge = 1;
				this.downSkin = base.GradientRectangleSkin;
				this.borderThickness = 4;
				this.highlightAngle = 45;
				this.innerEnd = 0.32;
				this.innerStart = 0.32;
				this.disabledSkin = base.GradientRectangleSkin;
				this.fillColorEB = 0x6f9bb8;
			};
		}

		StyleManager.mx_internal::initProtoChainRoots();
	}


