    private function _index_bindingsSetup():Array
    {
        var result:Array = [];
        var binding:Binding;

        binding = new mx.binding.Binding(this,
            function():Object
            {
                return (startBGImage);
            },
            function(_sourceFunctionReturnValue:Object):void
            {
                this.setStyle("backgroundImage", _sourceFunctionReturnValue);
            },
            "this.backgroundImage");
        result[0] = binding;
        binding = new mx.binding.Binding(this,
            function():Object
            {
                return (tmpBGImage);
            },
            function(_sourceFunctionReturnValue:Object):void
            {
                login.setStyle("backgroundImage", _sourceFunctionReturnValue);
            },
            "login.backgroundImage");
        result[1] = binding;

        return result;
    }

    private function _index_bindingExprs():void
    {
        var destination:*;
		[Binding(id='0')]
		destination = (startBGImage);
		[Binding(id='1')]
		destination = (tmpBGImage);
    }

