<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" 
	width="100%" height="65" 
	verticalAlign="middle" horizontalAlign="center" 
	showEffect="Fade" 
	verticalScrollPolicy="off" horizontalScrollPolicy="off"
	click="onClick(event);"
	>
	
	<mx:Script>
		<![CDATA[
			[Bindable]
			public var description:String;
			
			[Bindable]
			public var input:String;
			
			[Bindable]
			public var image:*;

			[Bindable]
			public var title:String;
			
			public function onDeactivate(event:Event):void {
				description=inputTextArea.text;
			}
		]]>
	</mx:Script>
	
	<mx:Style>
		.input {
			font-weight: bold;
			color: #214134;
			font-size: 28;	
		}
	</mx:Style>
	<!--<mx:Image source="{image}"  /> -->
	<mx:TextInput id="inputTextArea" borderStyle="none" text="{input}"  styleName="input" width="100%" valueCommit="onDeactivate(event)" focusThickness="0"/>
</mx:VBox>
