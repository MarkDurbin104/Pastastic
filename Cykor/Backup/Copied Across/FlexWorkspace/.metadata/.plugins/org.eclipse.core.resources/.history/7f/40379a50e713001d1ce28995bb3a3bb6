<?xml version="1.0" encoding="utf-8"?>
<mx:Application xmlns:mx="http://www.adobe.com/2006/mxml" 
	layout="vertical"
	backgroundGradientColors="[#ECF5E7,#ECF5E7]"
	creationComplete="callLater(drawGrid)"
	 verticalAlign="top" horizontalAlign="left">
	<mx:Script>
		<![CDATA[
			import mx.controls.Label;
			private const numDays:int=6;
			private const numItems:int=4;
			private const maxNumDaysPer:int=3;
			private function findSlot(slots:Array,x:int,itemLength:int,itemHeight:int):int {
				if (itemHeight==1) {
					for (var i:int=0;i<slots.length;i++) {
						if (slots[i].length<=x) {
							for (var j:int=slots[i].length;j<x;j++) slots[i].push(0);
							for (j=0;j<itemLength;j++) slots[i].push(1);
							return i;
						}
					}
					slots.push(new Array());
					i=slots.length-1
					for (j=0;j<x;j++) slots[i].push(0);
					for (j=0;j<itemLength;j++) slots[i].push(1);
					return i;
				} else {
					for (i=0;i<slots.length-1;i++) {
						if ((slots[i].length<=x)&&(slots[i+1].length<=x)) {
							for (j=slots[i].length;j<x;j++) slots[i].push(0);
							for (j=0;j<itemLength;j++) slots[i].push(1);
							for (j=slots[i+1].length;j<x;j++) slots[i+1].push(0);
							for (j=0;j<itemLength;j++) slots[i+1].push(1);
							return i;
						}
					}
					if ((slots.length>0)&&(slots[slots.length-1].length<=x)) {
						for (j=slots[i].length;j<x;j++) slots[i].push(0);
						for (j=0;j<itemLength;j++) slots[i].push(1);
						slots.push(new Array());
						i=slots.length-1
						for (j=0;j<x;j++) slots[i].push(0);
						for (j=0;j<itemLength;j++) slots[i].push(1);
						return i-1;
					}
					slots.push(new Array());
					i=slots.length-1
					for (j=0;j<x;j++) slots[i].push(0);
					for (j=0;j<itemLength;j++) slots[i].push(1);
					slots.push(new Array());
					i=slots.length-1
					for (j=0;j<x;j++) slots[i].push(0);
					for (j=0;j<itemLength;j++) slots[i].push(1);
					return i-1;
				}
			}
			public var day:String="Today";
			private function getDayName(offset:int):String
			{
				if (offset == -1) return day; // not using offset, setting day directly

				var days:Array = new Array("Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday","Tomorrow");
				var now:Date =new Date();
				var dayToShow:int = now.day;
				
			    if (offset == 0) 
			    	return days[7];  // show tomorrow it as "tomorrow"
			    else
					return days[(dayToShow+offset)%7];
			}
			private function drawGrid():void {
				calgrid.validateNow();
				var slots:Array=new Array();
				var itemLength:int;
				var maxYOfs:int=0;
				var days:Array=new Array;
				for (var i:int=0;i<numDays;i++) {
					days.push(new Array);
					for (var j:int=0;j<numItems;j++) {
						itemLength=Math.round((Math.random()*maxNumDaysPer));
						var itemSize:int=Math.round((Math.random()*1)+1);
						if ((itemLength > 0)&&(days[i].length<4)) {
							var yOfs:int=findSlot(slots,i,itemLength,itemSize);
							maxYOfs=Math.max(maxYOfs,yOfs+itemSize);
							days[i].push({length:itemLength,yofs:yOfs,height:itemSize});
						}
					}
				}
				var dayWidths:Array=[3,2,3,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2];
//				for (i=0;i<numDays+maxNumDaysPer-1;i++) 
//					dayWidths[i]=2+Math.round(Math.random());

				var overallWidth:Number=0;
				for (i=0;i<numDays+maxNumDaysPer-1;i++) overallWidth+=dayWidths[i];
				var unitWidth:Number=calgrid.width/overallWidth;
				var xofs:int=0;
				calgrid.removeAllChildren();
				calgrid.graphics.clear();
				for (i=0;i<numDays+maxNumDaysPer-1;i++) {
					var dayLabel:Label=new Label();
					dayLabel.text=getDayName(i);
					dayLabel.setStyle("color","#FFFFFF");
					dayLabel.setStyle("fontSize","12");
					dayLabel.setStyle("fontWeight","bold");
					calgrid.addChild(dayLabel);
					dayLabel.validateNow();
					var drawableHeight:Number=calgrid.height-(6+dayLabel.textHeight);
					dayLabel.x=xofs+((dayWidths[i]*unitWidth)-dayLabel.textWidth)/2;
					dayLabel.y=4;
					
					with (calgrid.graphics) {
						beginFill(0xF5FAF4,1);
						lineStyle(1,0xF5FAF4);
						drawRoundRect(xofs+4,2,(dayWidths[i]*unitWidth)-8,drawableHeight+(6+dayLabel.textHeight),20,20);
						endFill();
						beginFill(0x3172A5,1);
						lineStyle(1,0x3172A5);
						drawRoundRect(xofs+5,5,(dayWidths[i]*unitWidth)-10,dayLabel.textHeight+2,18,18);
						endFill();
					}
					xofs+=dayWidths[i]*unitWidth;
				}
				var itemHeight:Number=drawableHeight/maxYOfs;
				xofs=0;
				for (i=0;i<numDays;i++) {
					var yofs:int=8+dayLabel.textHeight
					for (j=0;j<days[i].length;j++) {
						with (calgrid.graphics) {
							beginFill(0xD7E7E8,0.75);
							lineStyle(5,0x7DAECC);
							var itemWidth:Number=0;
							for (var k:int=0;k<days[i][j].length;k++) {
								itemWidth+=dayWidths[i+k];
							} 
							drawRoundRect(xofs+5,yofs+days[i][j].yofs*itemHeight+5,(unitWidth*itemWidth)-10,itemHeight*days[i][j].height-10,10,10);
							endFill();
						}
					}
					xofs+=dayWidths[i]*unitWidth;
				}
			}
			private function onRefreshClick(event:Event):void {
				drawGrid();
			}
		]]>
	</mx:Script>
	<mx:HBox>
		<mx:Button label="Refresh" click="onRefreshClick(event);"/>
	</mx:HBox>
	<mx:Canvas id="calgrid" width="100%" height="100%">
	</mx:Canvas>
	
</mx:Application>
