Button {
    upSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    overSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    downSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    disabledSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    selectedUpSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    selectedOverSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    selectedDownSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
    selectedDisabledSkin:ClassReference('flexlib.skins.EnhancedButtonSkin');
}

.customButtonStyle {
     cornerRadii: 0, 0, 16, 21;
     borderColors: #006699, #006699;
     overBorderColors: #003399, #003399;
     selectedBorderColors: #003399, #003399;
     borderThickness: 1;
     fillColors: #003399, #0033CC, #0033FF, #0099FF;
     fillAlphas: 0.7, 0.75, 0.5, 0.6;
     fillColorRatios: 0, 48, 179, 255;
     overFillColors: #FCFFF4, #006699, #0066CC, #00CCFF;
     overFillAlphas: 0.5, 0.5, 0.5, 0.5;
     overFillColorRatios: 0, 67, 170, 255;
     selectedFillColors: #FCFFF4, #006699;
     selectedFillAlphas: 0.5, 0.5;
     selectedFillColorRatios: 0, 255;
     highlightAlphas: 0.6, 0;
     color: #FFFFCC;
     textRollOverColor: #FFFFFF;
     fontSize: 15;
}

.flatColorRectangleSkin {
	
    fontFamily: Arial;
    fontSize: 12;
    color: #FFFFFF;
    textAlign:left;
    width:150;
    height:30;
    
    upSkin:ClassReference('programmaticSkinClasses.FlatColorRectangleSkin');
	downSkin:ClassReference('programmaticSkinClasses.FlatColorRectangleSkin');
	overSkin:ClassReference('programmaticSkinClasses.FlatColorRectangleSkin');
	disabledSkin:ClassReference('programmaticSkinClasses.FlatColorRectangleSkin');
}

