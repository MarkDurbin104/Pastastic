	<mx:TextInput id="txtSearch" x="656" y="10" text="West Pier Lighthouse"/>
	<mx:Button label="SEARCH ON FLICKR" id="btnSearch" click="getImages()" x="519" y="10"/>
	<mx:TileList width="495" height="718" id="picsList" dataProvider="{photos}" itemRenderer="IconRenderer" click="onClick(event)"  x="519" y="40"/>
	<mx:VSlider x="20" y="20" allowTrackClick="true" minimum="1" maximum="20" snapInterval=".1" enabled="true" liveDragging="true" change="zoomTracker(event)" id="zoomer"/>
</mx:Application>