			private function onMapPreinitialize(event:Event):void {          
				var myMapOptions:MapOptions = new MapOptions();          
				myMapOptions.zoom = 5;          
				myMapOptions.center = new LatLng(53.3,-6.14);          
				myMapOptions.mapType = MapType.NORMAL_MAP_TYPE;
				this.map.setInitOptions(myMapOptions);        
			}                

			private var api_key:String = "97aab8c16eebec05be87ec0502653767";
			private var maxResult:Number = 50;
			
			private var service:FlickrService = new FlickrService( api_key );
			
			Security.allowDomain(["api.flickr.com", "flickr.com", "*"]);
			Security.allowInsecureDomain(["api.flickr.com", "flickr.com", "*"]);
			
			import mx.collections.ArrayCollection;
			[Bindable] public var photos:ArrayCollection;
			
			private function getImages():void {
			  var service:FlickrService = new FlickrService( api_key );
			   service.addEventListener( FlickrResultEvent.PHOTOS_SEARCH, onPhotosSearch );
			   service.photos.search("", "","any",txtSearch.text,null,null,null,null,-1,"date-posted-desc",-1,"",-1,-1,-1,"","","","","","","",true);
			}
			
			private function onPhotosSearch( event:FlickrResultEvent ):void {
				if (event.success) {
				  var photoList:PagedPhotoList = event.data.photos;
				  photoList.perPage = maxResult;
				  photos = new ArrayCollection( photoList.photos );
			  }
			}
			private function onClick(event:MouseEvent):void {
				var photo:Photo = Photo(TileList(event.currentTarget).selectedItem);
			   	service.photos.getLocation(photo.id);
 			   	service.addEventListener( FlickrResultEvent.PHOTOS_GET_EXIF, onPhotosInfo);
			}
			private function onPhotosInfo( event:FlickrResultEvent ):void {
				if (event.success) {
					var photo:Photo = Photo(event.data.photo);
		  			var ll:LatLng=new LatLng(Number(photo.latitude), Number(photo.longitude));
		  			map.setCenter(ll, 13, MapType.NORMAL_MAP_TYPE);
		  		}  
			}
			private function zoomTracker(event:Event):void {
				map.setZoom(zoomer.value);
			}
		]]>  
	</mx:Script>
	<maps:Map xmlns:maps="com.google.maps.*"  
		mapevent_mappreinitialize="onMapPreinitialize(event)"          
