			private var selectedControl:Button=null;
			private function changeCursor(overCanvas:Boolean):void {
				if (CursorManager.currentCursorID > 0) CursorManager.removeCursor(CursorManager.currentCursorID);
				if ((overCanvas)&&(selectedControl!=null)&&(selectedControl.id!="Arrow")) {
					switch (selectedControl) {
						case Magnify,
								UnMagnify,
								Line,
								Text 						: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-10,	-10	); break;
						case PrimaryService		: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-1,	-11	); break;
						case SecondaryService	: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-1,	-11	); break;
						case LookUp					: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-10,	-10	); break;
						case Input						: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-2,	-16	); break;
						case Fee							: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-2,	-14	); break;
						case ORGate					: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-7,	-7		); break;
						case ANDGate					: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-7,	-7		); break;
						case NORGate					: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-5,	-7		); break;
						case NANDGate				: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-5,	-7		); break;
						case XORGate					: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-4,	-7		); break;
						case XNORGate				: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-2,	-7		); break;
						case NOTGate					: 	CursorManager.setCursor(Class(selectedControl.getStyle("icon")),2,	-10,	-12	); break;
						default 							:	CursorManager.setCursor(Class(selectedControl.getStyle("icon")));
					}
				}
			}
			private function controlClick(event:MouseEvent):void {
				var control:Button = Button(event.currentTarget);
				for (var i:int=0;i<control.parent.numChildren;i++) {
					var child:DisplayObject=control.parent.getChildAt(i);
					if ((child is Button)&&(child!=control)) {
						Button(child).selected=false;
					} 
				}	
				control.selected=true;
				selectedControl=control;
				circuitDesigner.cursorType=control.id;
				circuitDesigner.selecting=control==Arrow;
				circuitDesigner.stickyCursor=event.ctrlKey;
			}
			private function cursorOff(event:MouseEvent):void {
				if (CursorManager.currentCursorID != 0) {
					changeCursor(false);
					circuitDesigner.cursorType=Arrow.id;
				} 
			}
			private function cursorOn(event:MouseEvent):void {
				if (CursorManager.currentCursorID == 0) {
					changeCursor(true);
					if (selectedControl!=null)
					circuitDesigner.cursorType=selectedControl.id;
				} 
			}
			private function onDesignerClicked(event:MouseEvent):void {
				if (CursorManager.currentCursorID != 0) {
					if ((!circuitDesigner.stickyCursor)&&(selectedControl!=Magnify)&&(selectedControl!=UnMagnify)&&(selectedControl!=Line)&&(selectedControl!=Text)) { 
						changeCursor(false);
						for (var i:int=0;i<Arrow.parent.numChildren;i++) {
							var child:DisplayObject=Arrow.parent.getChildAt(i);
							if ((child is Button)&&(child!=Arrow)) {
								Button(child).selected=false;
							} 
						}	
						Arrow.selected=true;
						selectedControl=Arrow;
						circuitDesigner.selecting=true;
						circuitDesigner.cursorType=Arrow.id;
					}
				}
			}
		]]>
