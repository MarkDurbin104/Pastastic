<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" width="100" height="160" xmlns:filters="flash.filters.*"
	verticalScrollPolicy="off" horizontalScrollPolicy="off"
	backgroundColor="#DAE7DD" borderColor="#8FB898" color="#8FB898"  
	borderStyle="solid" cornerRadius="10" 
	fontFamily="Verdana"  fontWeight="bold" fontSize="15" 
	borderThickness="5">
	<mx:Script>
		<![CDATA[
			[Bindable]
			public var title:String="";
			[Bindable]
			public var caption:String="";
			[Bindable]
			public var interleave:String="";
			[Bindable]
			public var source:Object=null;
		]]>
	</mx:Script>
	<mx:Label text="{title}"  width="90" textAlign="center"/>
	<mx:Image source="{source}" horizontalCenter="0" scaleContent="false" autoLoad="true" y="28"/>
	<mx:Text selectable="false" text="{caption}"  width="90" textAlign="center" y="80" height="70" fontSize="11"/>
	<mx:Text selectable="false" text="{interleave}"  width="90" textAlign="center" y="96" height="50" fontSize="11" color="#000000"/>
	<mx:filters>
		<filters:DropShadowFilter angle="45" alpha=".1" distance="4" blurX="0" blurY="0"/>
	</mx:filters>
</mx:Canvas>
