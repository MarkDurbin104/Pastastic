<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml"
	width="1024" height="768"
	 xmlns:slides="com.proiam.slides.*" color="#496384" fontFamily="Arial" xmlns:CoverFlow="com.cykorsystems.CoverFlow.*" xmlns:utils="com.cykorsystems.utils.*">
	<mx:Metadata>
        [Event(name="nextClicked", type="flash.events.Event")]
        [Event(name="cancelClicked", type="flash.events.Event")]
    </mx:Metadata>
		
	<mx:Script>
		<![CDATA[
			import flash.events.Event;
			public function fireNextClicked(event:Event):void {
                dispatchEvent(new Event("nextClicked"));
            }
			public function fireCancelClicked(event:Event):void {
                dispatchEvent(new Event("cancelClicked"));
            } 
            public function setUpAccordion(formData:XML):void {
            	accordionPanel.setupAccordion(formData);
            	itemImage.reset();
            }
            public function formData():XML {
            	return accordionPanel.formData();
            }
		]]>
	</mx:Script>
	<mx:Canvas backgroundImage="@Embed(source='embedded/Change Origin address.jpg')" backgroundSize="100%" x="0" top="80" width="1024" height="688" />
	<mx:Canvas x="883" y="686" width="121" height="71" click="fireNextClicked(event);" buttonMode="true"/>
	<mx:Canvas x="744" y="686" width="121" height="71" click="fireCancelClicked(event);" buttonMode="true"/>
	<CoverFlow:KeyBoardCanvas x="25" y="397"/>
	<slides:AccordionPanel  id="accordionPanel" x="414" y="80" width="590" height="315"/>
	
 	<mx:Canvas id="itemImageCanvas" x="27" y="94" width="370" height="295" borderStyle="solid" borderThickness="2" borderColor="#B2D2C7"	>
 	 	<!--mx:Image x="0" y="0" width="100%" height="100%" id="itemImage" scaleContent="true"/-->
 	 	<mx:Canvas x="0" y="0" width="100%" height="100%" id="itemOverImage"/>
		<utils:ImageZoom
			id="itemImage" 
			fadeDuration="10" 
			bottom="0" left="0" top="0" right="0"
			zoomIncrement="1"
			imageDoubleClickEnabled="true"
			mouseWheelEnabled="true"
			mouseFollow="true" />

 	</mx:Canvas>
</mx:Canvas>
