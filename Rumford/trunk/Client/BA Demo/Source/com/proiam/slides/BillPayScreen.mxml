        [Event(name="nextClicked", type="flash.events.Event")]
        [Event(name="originChange", type="flash.events.Event")]
        [Event(name="destinationChange", type="flash.events.Event")]
        [Event(name="contactChange", type="flash.events.Event")]
        [Event(name="infoClicked", type="flash.events.Event")]
        [Event(name="showShoppingBasket", type="flash.events.Event")]
