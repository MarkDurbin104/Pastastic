 	<mx:Text x="16" y="536" text="Source" color="#FFFFFF" fontWeight="normal" fontSize="11" width="64" height="125" id="tiCatagory" />
 	<mx:Text x="81" y="357" text="Type" color="#FFFFFF" fontWeight="bold" fontSize="11" width="130" height="125" id="piText"/>
 	<mx:Text x="81" y="536" text="Source" color="#FFFFFF" fontWeight="bold" fontSize="11" width="130" height="125" id="tiText" />
