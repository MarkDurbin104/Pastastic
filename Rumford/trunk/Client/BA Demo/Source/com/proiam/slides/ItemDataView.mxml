	<mx:Script>
		<![CDATA[
			import com.proiam.mails.ItemData;
			import mx.controls.SWFLoader;
			import mx.graphics.ImageSnapshot;
			import mx.core.BitmapAsset;
			import flash.sampler.NewObjectSample;
			import flash.utils.ByteArray;
			import mx.utils.Base64Decoder;
			import mx.core.UIComponent;
			import mx.controls.Image;
			import flash.events.Event;
			import com.cykorsystems.utils.*;
			
			private var addressData:ItemData;
			private var imageScale:Number=0;
			public var tariffData:String="";
			public var validDestAddress:Boolean=true;
			public var validOriginAddress:Boolean=true;
			public var destination:String="";
			public var lastImageFile:String="";
			
            private var _mono:Boolean=false;
            [Bindable]
            // monochrome filter to display reciept
            public function set mono(value:Boolean):void {
            	_mono=value;
            	if (value) {
            		var intensity:Number=1;
					var red:Number 		= 0.3086*intensity; // luminance contrast value for red
					var green:Number 	= 0.6940*intensity; // luminance contrast value for green
					var blue:Number 		= 0.0820*intensity; // luminance contrast value for blue
					var mono:ColorMatrixFilter=new ColorMatrixFilter([red, green, blue, 0, 0, red, green, blue, 0, 0, red, green, blue, 0, 0, 0, 0, 0, 1, 0]);
		            var myFilters:Array = new Array();
		            myFilters.push(mono);
		            itemImageCanvas.filters = myFilters;
		            
            		intensity=0.8;
					red		= 0.3086*intensity; // luminance contrast value for red
					green	= 0.6940*intensity; // luminance contrast value for green
					blue		= 0.0820*intensity; // luminance contrast value for blue
					mono=new ColorMatrixFilter([red, green, blue, 0, 0, red, green, blue, 0, 0, red, green, blue, 0, 0, 0, 0, 0, 1, 0]);
		            myFilters= new Array();
		            myFilters.push(mono);
		            typeImage.filters = myFilters;
            	} else {
		            itemImageCanvas.filters = null;
            	}
            }
            public function get mono():Boolean {
            	return _mono;
            }
            [Bindable]
            // return a string of a DateTime
			private function get date():String {
				var now:Date=new Date;
				var months:Array = new Array("Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec");
				return now.day+" "+months[now.month]+" "+now.fullYear;				
			}
			private function set date(value:String):void {
				// just to remove compiler warnings - ignore
			}
			
			
			// populates mail item data with address data
			public function SetItemData(value:ItemData):Boolean {
				var result:Boolean=true; 
				addressData=value
				
				if (validOriginAddress) {
					originBox.title="Origin adddress";
				} else {
					originBox.title="Origin adddress - ZIP Error";
				}
				if (value != null) originBox.text=addressData.origin.asText(); else originBox.text="";
				originBox.error=!validOriginAddress;
				
				if (validDestAddress) {
					destBox.title="Destination adddress";
				} else {
					destBox.title="Destination adddress - ZIP Error";
				}
				if (value != null) destBox.text=addressData.destination.asText(); else destBox.text="";
				
				destBox.error=!validDestAddress;
				
				result=(!validDestAddress) || (!validOriginAddress);
				
				contactBox.title="Contact information" 
				contactBox.catagory="Origin:\n\nDest:";
				if (value != null) 
					contactBox.text=addressData.origin.contact()+"\n"+addressData.destination.contact();
				else
					contactBox.text="";
				
				if (value != null)  
					postage.text=(addressData.postage!=""?addressData.postage:"None found")
				else
					postage.text="None found";
				var services:String="";
				if (value != null) { 
					for (var i:int=0;i<addressData.addedServices.length;i++) {
						services+=addressData.serviceTypes[addressData.addedServices[i].index][1]+":\nID:"+addressData.addedServices[i].id+"\n";
					}
				}
				preapplied.text=(services!=""?services:"None found");

			    piCatagory.text="Weight:\nSize:\nLen+Girth:\nType:"; 
				if (value != null) { 
				    piText.text=	addressData.weight.lbOzString+"\n"+
				    						addressData.dimensions.inchesString()+"\n"+
				    						addressData.dimensions.girthInInches()+"\n"+
				    						addressData.dimensions.itemType(addressData.weight.weightInOunces);
				    if (currentState == "Paper")  {
				    	var path:String="resources/graphics/mails_types/OnWhite/";
				    } else {
				    	path="resources/graphics/mails_types/OnBlue/";
				    }
				    switch (addressData.dimensions.itemType(addressData.weight.weightInOunces)) {
						case "Undersize"				: typeImage.source=path+"Letter_Long.png"; 				break;
						case "Postcard"				: typeImage.source=path+"Postcard.png"; 					break;
						case "Letter"						: typeImage.source=path+"Letter.png"; 						break;
						case "UndersizeSQ"			: typeImage.source=path+"Letter_Large.png"; 			break;
						case "Square"					: typeImage.source=path+"Letter_Square.png"; 			break;
						case "Long"						: typeImage.source=path+"Letter_Long.png"; 				break;
						case "Large Letter"			: typeImage.source=path+"Letter_Large.png"; 			break;
						case "Large Square"		: typeImage.source=path+"Letter_Square.png"; 			break;
						case "Large Long"			: typeImage.source=path+"Letter_Long.png"; 				break;
						case "Package"					: typeImage.source=path+"Package.png"; 					break;
						case "Oversize Parcel"	: typeImage.source=path+"Package_Oversize.png"; 	break;
						case "Parcel"						: typeImage.source=path+"Package_Large.png"; 		break;
						case "Oversize"				: typeImage.source=path+"Package_Oversize.png"; 	break;
						default								: typeImage.source=path+"Letter.png"; 
				    }
			 	} else {
			 		piText.text="";
			 		typeImage.source="";
			 	}
			    tiCatagory.text="Source:\nDest:\nZone:\nInterBMC:\nOrigin:\nStatus:";
				if (value != null) { 
				    tiText.text=tariffData+"\n"+addressData.status;
				} else {
				    tiText.text="";
				}
			    if (value != null) {
					if (addressData.imageFile.length > 255) { // not a filename - must be an image
						try {
							var s:String=addressData.imageFile;
							if (s.indexOf("base64") > 0) {
								s=s.slice(s.indexOf("base64")+6); // remove: "MIME-Version: 1.0	Content-Type: image/jpeg	Content-Transfer-Encoding: base64"
							}
			                var byteArr:ByteArray;
			                var base64Dec:Base64Decoder = new Base64Decoder();
			                base64Dec.decode(s);
			                byteArr = base64Dec.toByteArray();
					    	itemImage.addEventListener(Event.COMPLETE,imageLoaded);
			                itemImage.load(byteArr);
				    		lastImageFile="";
//			                imageLoaded(null);
		    			}	catch (error:Error) {
						    itemOverImage.graphics.clear();
					    	itemImage.addEventListener(Event.COMPLETE,imageLoaded);
							itemImage.source="data/Empty.jpg"; 
				    		lastImageFile="";
		                }
					} else  {
						if (value.local) {
						    itemOverImage.graphics.clear();
					    	itemImage.addEventListener(Event.COMPLETE,imageLoaded);
					    	if (itemImage.source=="data/"+addressData.imageFile)
					    		drawBoxes();
					    	itemImage.source="data/"+addressData.imageFile;
				    		lastImageFile="";
						} else {
							var unique:int=new Date().getTime();
							if (addressData.imageFile == "") {
							    itemOverImage.graphics.clear();
						    	itemImage.addEventListener(Event.COMPLETE,imageLoaded);
					    		lastImageFile=addressData.imageFile;
								itemImage.source="data/Empty.jpg"; 
							}	else	if (addressData.imageFile != lastImageFile) { 
							    itemOverImage.graphics.clear();
						    	itemImage.addEventListener(Event.COMPLETE,imageLoaded);
					    		itemImage.source="http://"+value.IPAddress+":8000//"+addressData.imageFile+"?unique="+unique;
					    		lastImageFile=addressData.imageFile;
					    		value.imageFileProcessed=true;
					  		/*} else {
				                imageLoaded(null);*/
					  		}
						}
					}
				} else {
				    itemOverImage.graphics.clear();
				}
				return result;
			}
			private function imageLoaded(event:Event):void {
			    drawBoxes();
			}
			//  draw elipses on mail items and draw a cross on a barcode
			private function drawBoxes():void {
			    itemOverImage.graphics.clear();
			    if (currentState != "Paper") {
			    	try {
						if ((addressData!=null)&&(addressData.imageFile != "")) {
							imageScale=itemImage.height/Math.max(itemImage.measuredHeight,itemImage.contentHeight);
						    itemOverImage.graphics.lineStyle(2,0x0000C0);//0xB2D2C7);
						    var inRect:Rectangle=addressData.destination.inRect;
						    if ((inRect.left != inRect.right) && (inRect.top != inRect.bottom))  
							    itemOverImage.graphics.drawEllipse	((inRect.left-(inRect.width*0.15))*imageScale,(inRect.top-(inRect.height*0.15))*imageScale,
							    																		inRect.width*1.3*imageScale,inRect.height*1.3*imageScale);
						    inRect=addressData.origin.inRect;
						    if ((inRect.left != inRect.right) && (inRect.top != inRect.bottom))  
							    itemOverImage.graphics.drawEllipse	((inRect.left-(inRect.width*0.15))*imageScale,(inRect.top-(inRect.height*0.15))*imageScale,
								    																	inRect.width*1.3*imageScale,inRect.height*1.3*imageScale);
						    for (var i:int=0;i<addressData.addedServices.length;i++) {
								var locations:Array=addressData.addedServices[i].location.split(', ');
								if (locations.length == 2) {
									    itemOverImage.graphics.moveTo(locations[0]*imageScale,locations[1]*imageScale-20);
									    itemOverImage.graphics.lineTo(locations[0]*imageScale,locations[1]*imageScale+20);
									    itemOverImage.graphics.moveTo(locations[0]*imageScale-20,locations[1]*imageScale);
									    itemOverImage.graphics.lineTo(locations[0]*imageScale+20,locations[1]*imageScale);
								}
						    }
						}
			    	} catch (error:Error) {
						trace(error.message);
					}
			 	}
			}
			private function onCreationComplete(event:Event):void {
				//UIUtils.addExpand(originBox,1.1,1);
				//UIUtils.addExpand(destBox,1.1,20);
				//UIUtils.addExpand(contactBox,1.1,20);
			}			
			public function fireNextClicked(event:MouseEvent):void {
                dispatchEvent(new Event("nextClicked"));
            }
			public function fireOriginChange(event:Event):void {
                dispatchEvent(new Event("originChange"));
            }
			public function fireDestinationChange(event:Event):void {
                dispatchEvent(new Event("destinationChange"));
            }
			public function fireContactChange(event:Event):void {
                dispatchEvent(new Event("contactChange"));
            }
			public function fireInfoClicked(event:Event):void {
                dispatchEvent(new Event("infoClicked"));
            }
            //  spinny graphics
            public function simulateLazyLoad(event:Event):void {
            	if (currentState==null) {
            		var lazyTimer:Timer=new Timer(4000,3);
            		lazyTimer.addEventListener(TimerEvent.TIMER,nextLazyStep);
            		lazyTimer.start();
            		currentState="Wait State 1";
            	}
            }
            public function nextLazyStep(event:TimerEvent):void {
            	if (currentState=="Wait State 1")
            		currentState="Wait State 2";
            	else if (currentState=="Wait State 2")
            		currentState="Wait State 3";
            	else 
            		currentState=null;
            }
			private var myPrintJob:PrintJob = null;
			private var printSprite:Sprite;
            public function onImageClick(event:Event):void {
            	if (currentState=="Paper") {
            		myPrintJob = new PrintJob();
		            if (myPrintJob.start()) {
						try {
							
					        var screenDPI:Number = Capabilities.screenDPI;
					        var scale:Number = 200 / screenDPI;
					        if (scale > (ImageSnapshot.MAX_BITMAP_DIMENSION/width)) {
					        	scale=ImageSnapshot.MAX_BITMAP_DIMENSION/width;
					        }
	        				var matrix:Matrix = new Matrix(scale, 0, 0, scale);
							var data:BitmapData = new BitmapData((width*scale),height*scale, true, 0x00000000);
							data.draw(this,matrix);
            				var bmp:Bitmap=new Bitmap(data);
					        var itemScale:Number=(myPrintJob.pageWidth/data.width)*0.75;
							var sprite:Sprite=new Sprite();
							sprite.x=5;
							sprite.y=5;
							sprite.addChild(bmp);
							sprite.scaleX=itemScale;
							sprite.scaleY=itemScale;
		            		myPrintJob.addPage(sprite);
		            		
						} catch (error:Error) {
							trace(error.message);
						}
		            	myPrintJob.send(); 
		            }
            	} else {
            		fireInfoClicked(event);
            	}
            }
		]]>
	</mx:Script>
