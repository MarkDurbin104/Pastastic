			<mx:AddChild position="lastChild">
				<mx:Canvas x="10" y="516" width="195" height="142" borderStyle="solid" borderColor="#808080">
				</mx:Canvas>
			</mx:AddChild>
			<mx:AddChild position="lastChild">
				<mx:Canvas x="521" y="335" width="173" height="323" borderStyle="solid" borderColor="#808080">
					<mx:Canvas x="10" y="167" width="151" height="144" borderStyle="solid" borderColor="#C0C0C0">
