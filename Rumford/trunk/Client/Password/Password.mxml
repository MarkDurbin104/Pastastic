<?xml version="1.0" encoding="utf-8"?>
<mx:Application xmlns:mx="http://www.adobe.com/2006/mxml" layout="absolute"
	xmlns:crypto="crypto.*" >
	<mx:Script>
		<![CDATA[
			import crypto.MD5;
			import crypto.Hex;
			private function toHash(data:String):String
			{
				var md5:MD5 = new MD5;
				var src:ByteArray = new ByteArray;
				src.writeMultiByte(data,"UTF-8");
				var digest:ByteArray = md5.hash(src);
				return Hex.fromArray(digest).toUpperCase();
			}
			 
		]]>
	</mx:Script>
	<mx:Label x="120" y="84" text="Password"/>
	<mx:TextInput x="184" y="82" id="password" editable="true" change="md5output.text=toHash(password.text)"/>
	<mx:Label x="120" y="110" text="MD5"/>
	<mx:TextInput id="md5output" x="184" y="108" editable="true"/>

</mx:Application>
