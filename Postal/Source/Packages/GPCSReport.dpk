package GPCSReport;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl30,
  VclSmp30;

contains
  DatabaseServer_TLB,
  CombineU,
  EvSinkBaseU,
  ComServ2,
  Domain,
  Utils,
  GPCSBaseAU,
  GPCSErrorCode,
  SAvePosFormU,
  RegistryEx,
  StringUtil,
  Preview,
  GPCSErrorLine,
  GPCSGUID,
  MethodNameU,
  PackStrListU,
  GPCSBase_TLB,
  Umanager_tlb,
  ReportPreviewF,
  BaseProduct,
  PrintReportU;

end.
